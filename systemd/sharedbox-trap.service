[Unit]
Description=sharedbox trap: decoy ports, bait URLs, AI-crawler maze
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
ExecStart=/usr/lib/sharedbox/sharedbox-trap serve
Restart=always
RestartSec=10
# talks to attackers, so it gets as little as possible
User=sharedbox
Group=sharedbox
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/sharedbox/trap
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0022
MemoryMax=512M
TasksMax=32
LimitNOFILE=8192
CPUWeight=20
Nice=10

[Install]
WantedBy=multi-user.target
