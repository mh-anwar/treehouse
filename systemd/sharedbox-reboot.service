[Unit]
Description=sharedbox: scheduled reboot, SCHEDULED_REBOOT_DAYS (clears memory leaks and processes on old libraries)

[Service]
Type=oneshot
# never reboot a box that just came up (e.g. an update reboot a few minutes earlier)
ExecCondition=/bin/sh -c 'test "$(cut -d. -f1 /proc/uptime)" -gt 3600'
# waits (up to 2 hours) while a friend's agent is mid-turn, then: shutdown -r +5 with a broadcast
ExecStart=/usr/lib/sharedbox/sharedbox-janitor reboot
TimeoutStartSec=3h
