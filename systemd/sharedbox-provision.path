[Unit]
Description=sharedbox: watch for join requests and admin requests

[Path]
PathExistsGlob=/var/lib/sharedbox/spool/req-*.json
# `box invite` from ADMIN_USERS accounts (no sudo)
PathExistsGlob=/var/lib/sharedbox/admin/*.json
# `box shared` from friends and admins (group-owned shared servers)
PathExistsGlob=/var/lib/sharedbox/shared-drop/*.json

[Install]
WantedBy=multi-user.target
