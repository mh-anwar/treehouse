[Unit]
Description=sharedbox tripwire: decoy secrets, alert the owner and whoever opens them
After=local-fs.target

[Service]
Type=simple
ExecStartPre=/usr/lib/sharedbox/sharedbox-canary plant
ExecStart=/usr/lib/sharedbox/sharedbox-canary watch
Restart=always
RestartSec=5
Nice=-5
# never the first thing the OOM killer picks
OOMScoreAdjust=-500
# Runs as root: fanotify needs CAP_SYS_ADMIN, reading other users' /proc/PID/{environ,exe,cwd}
# needs CAP_SYS_PTRACE, and `systemctl freeze` talks to PID 1 over its private socket.
# CAP_SETUID/SETGID: refresh the friend's agent rules as the friend (setpriv), never as root.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_CHOWN CAP_SETUID CAP_SETGID
NoNewPrivileges=yes
# /usr, /boot, /etc read-only; /srv/backups and /var/lib/sharedbox stay writable
ProtectSystem=full
PrivateTmp=yes
# no PrivateDevices: the alert is written to the friend's open terminals (/dev/pts)
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# D-Bus/systemd (unix) + SMTP (inet)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M

[Install]
WantedBy=multi-user.target
