[Unit]
Description=sharedbox Wi-Fi on %I (any USB dongle; started by udev when the interface appears)
# stops when the dongle is unplugged; udev starts it again when it (or another dongle) comes back
BindsTo=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device
Before=network.target
Wants=network.target
ConditionPathExists=/etc/sharedbox/wifi/wpa_supplicant.conf
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/sbin/wpa_supplicant -c /etc/sharedbox/wifi/wpa_supplicant.conf -i %I -D nl80211,wext
Restart=always
RestartSec=3
