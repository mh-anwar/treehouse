[Unit]
Description=sharedbox public front door (behind Tailscale Funnel; only runs with PUBLIC_URL set)
After=network-online.target tailscaled.service sharedbox-web.service
Wants=network-online.target sharedbox-web.service

[Service]
User=sharedbox
Group=sharedbox
ExecStart=/usr/lib/sharedbox/sharedbox-gate
Restart=on-failure
RestartSec=5
# hardening: listens on 127.0.0.1 only; reads the gate records, writes only provisioning requests
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/sharedbox/spool
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# it only ever talks to localhost and friends' T3 on this box's tailnet address
IPAddressDeny=any
IPAddressAllow=localhost 100.64.0.0/10 fd7a:115c:a1e0::/48
LockPersonality=yes
LimitNOFILE=8192
MemoryMax=512M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
