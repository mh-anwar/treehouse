[Unit]
Description=sharedbox public front door (behind Cloudflare Tunnel + Access)
After=network-online.target tailscaled.service sharedbox-web.service
Wants=network-online.target sharedbox-web.service

[Service]
User=sharedbox
Group=sharedbox
ExecStart=/usr/lib/sharedbox/sharedbox-gate
Restart=on-failure
RestartSec=5
# hardening: listens on 127.0.0.1 only; reads the gate records, writes only provisioning requests and
# t3-seen/<user> timestamps (when each friend last used their T3 Code; "-" = fine if it doesn't exist yet)
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/sharedbox/spool -/var/lib/sharedbox/t3-seen
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# it only ever talks to localhost and friends' T3 on this box's tailnet address
# (PUBLIC_MODE=cloudflare adds sharedbox-gate.service.d/cloudflare.conf: outbound HTTPS for Access signing keys)
IPAddressDeny=any
IPAddressAllow=localhost 100.64.0.0/10 fd7a:115c:a1e0::/48
LockPersonality=yes
LimitNOFILE=8192
MemoryMax=512M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
