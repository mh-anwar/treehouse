# ---------- portal: everything a new friend needs, in the browser ----------

def cores(pct):
    try:
        return f"{float(str(pct).rstrip('%')) / 100:g}"
    except ValueError:
        return str(pct)


def safe_url(u, schemes=("https://", "http://")):
    u = str(u or "")
    return u if u.startswith(schemes) and len(u) < 4096 else ""


def portal_page(ip, who, name, rec, result=None, welcome=False):
    """The friend's home page: open T3, log in to an AI and GitHub. No terminal anywhere."""
    e = html.escape
    tok = token_for(ip, who["id"])
    gate = bool(who.get("session") or who.get("cf_jwt"))
    base = "/_box" if gate else ""
    st = portal_call(ip, who, "status")
    logins, t3 = st.get("logins") or {}, st.get("t3")
    if gate and t3:
        t3 = dict(t3, url=PUBLIC + "/")

    def btn(action, label, key="", extra="", primary=True):
        style = "" if primary else ' style="background:#252b35;color:var(--fg)"'
        return f"""<form method="post" action="{base}/me" style="display:inline">
<input type="hidden" name="token" value="{tok}"><input type="hidden" name="action" value="{action}">
<input type="hidden" name="key" value="{e(key)}">{extra}<button{style}>{e(label)}</button></form>"""

    def done(ok):
        return '<span class="pill ok">done ✓</span>' if ok else '<span class="pill warn">to do</span>'

    out = []
    if welcome:
        out.append(f"<h2>Welcome, {e(name)} 🎉</h2><p>Two quick steps and you're building.</p>")
    else:
        out.append(f"<h2>Hi {e(who['display'])}</h2><p class='mut'>Your account on {e(HOST)} is "
                   f"<b>{e(name)}</b>.</p>")
    if result:
        out.append(portal_result(result, btn, base))
    ai = [k for k in ("claude", "codex") if k in logins]
    ai_ok = any(logins[k]["ok"] for k in ai)
    out.append(f"<h2>1. Connect your AI {done(ai_ok)}</h2>")
    if not ai:
        out.append("<p class='mut'>No coding agents are installed on the box yet. Ask the owner.</p>")
    elif ai_ok:
        out.append("<p class='mut'>Logged in: " + ", ".join(e(logins[k]["label"]) for k in ai if logins[k]["ok"])
                   + ".</p>")
    else:
        out.append("<p>Pick the one you pay for. You only do this once.</p><p>")
        if "claude" in logins:
            out.append(btn("login", "Log in with Claude", "claude") + " ")
        if "codex" in logins:
            out.append(btn("login", "Log in with ChatGPT (Codex)", "codex") + " ")
        out.append("</p>")
        if "claude" in logins:
            out.append("<p class='sub'>Pay for Claude by API key (Anthropic Console) instead? "
                       + btn("login", "Console login", "claude",
                             '<input type="hidden" name="console" value="1">', primary=False) + "</p>")
    out.append(f"<h2>2. Open T3 Code {done(bool(t3 and t3.get('running')) and ai_ok)}</h2>")
    if not t3:
        out.append("<p class='mut'>T3 Code isn't available on this box yet. Ask the owner.</p>")
    else:
        out.append("<p>This is where you work: start a chat, pick Claude or Codex, and tell it what to build. "
