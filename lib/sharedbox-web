def session_who(secret):
    """Portal identity for a gateway session token, or None. Root re-checks it on every action."""
    rec, h = sb.gate_lookup("sessions", secret or "")
    users = sb.friend_users() if rec else {}
    frec = sb.active_friend(rec.get("user"), users) if rec else None
    if not frec:
        return None
    return {"id": "gate:" + h, "display": rec["user"], "login": "invite", "node": "",
            "session": secret, "name": rec["user"], "rec": frec}


def cf_who(email, jwt):
    """Portal identity in cloudflare mode: the friend whose registry email the gate-verified token carries."""
    name, frec = sb.user_by_email(email or "")
