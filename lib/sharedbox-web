class GateHandler(Handler):
    """Requests relayed by sharedbox-gate over the unix socket. The gate has already stripped every
    client-supplied X-Sharedbox-* header and only passes a session token it found in the cookie."""

    def send(self, code, body, ctype="text/html; charset=utf-8", headers=()):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Referrer-Policy", "no-referrer")  # the URL may hold a one-time token
        self.send_header("Content-Security-Policy",
                         "default-src 'self'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; "
                         "img-src 'self' data:; form-action 'self'; frame-ancestors 'none'")
        for k, v in headers:
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def redirect(self, where, headers=()):
        self.send(303, "", "text/plain", [("Location", where), *headers])

    def client_ip(self):
        return self.headers.get("X-Sharedbox-Client-IP") or "?"

    def cf_email(self):
        return (self.headers.get("X-Sharedbox-Cf-Email") or "").lower() if CF else None

    def who(self):
        if CF:  # the gate verified the token and strips any client-sent X-Sharedbox-* header
            return cf_who(self.cf_email(), self.headers.get("X-Sharedbox-Cf-Jwt"))
        return session_who(self.headers.get("X-Sharedbox-Session"))

    def route(self):
        path = urllib.parse.urlsplit(self.path).path
        for prefix, kind in (("/i/", "invite"), ("/login/", "login")):
            if path.startswith(prefix) and sb.TOKEN_RE.fullmatch(path[len(prefix):]):
                return kind, path[len(prefix):]
        if path in ("/_box", "/_box/", "/_box/me"):
            return "me", None
        if path in ("/_box/logout", "/_box/healthz"):
            return path[6:], None
        return "landing", path

    def do_GET(self):
        kind, arg = self.route()
        q = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
        if kind == "healthz":
            return self.send(200, "ok", "text/plain")
        if CF and kind in ("invite", "login") and self.who():
            return self.redirect("/_box/me")  # already has an account: nothing to sign up or log in to
        if kind == "invite":
            return self.send(200, invite_page(arg, email=self.cf_email()))
        if kind == "login":
            return self.redirect("/") if CF else self.send(200, login_page(arg))
        who = self.who()
        if kind == "me" and who:
            return self.send(200, portal_page("gate", who, who["name"], who["rec"], welcome="welcome" in q))
        if kind == "landing" and arg not in ("/", "/_box/me", "/_box/", "/_box"):
            return self.send(404, landing(self.cf_email()))
        return self.send(200, landing(self.cf_email()))

    def limited(self, bucket, n=10, window=600):
        q = rate.setdefault(bucket, deque(maxlen=n + 1))
        now = time.time()
        if len([t for t in q if now - t < window]) >= n:
            return True
        q.append(now)
        return False

    def do_POST(self):
        kind, arg = self.route()
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            n = -1
        if not 0 <= n <= 16384:
            return self.send(413, "too large", "text/plain")
        form = {k: v[0] for k, v in urllib.parse.parse_qs(self.rfile.read(n).decode(errors="replace")).items()}
        origin = self.headers.get("Origin")
        if origin is not None and origin != PUBLIC:
            return self.send(403, "bad origin", "text/plain")
        ua = (self.headers.get("User-Agent") or "")[:200]
        if kind == "invite":
            cfm = self.cf_email()
            if CF and self.who():
                return self.redirect("/_box/me")
            if not hmac.compare_digest(form.get("token", ""), token_for("gate", "invite:" + sb.token_hash(arg))):
                return self.send(400, invite_page(arg, "form expired, please submit again", form, cfm))
            if self.limited("gate-join:" + self.client_ip(), 5):
                return self.send(429, invite_page(arg, "too many attempts, wait 10 minutes", form, cfm))
            username = form.get("username", "").strip().lower()
            email, eerr = (cfm, None) if CF else sb.validate_email(form.get("email", ""))
            err = sb.validate_username(username, CFG) or eerr
            if err:
                return self.send(400, invite_page(arg, err, form, cfm))
            req = {"action": "join", "invite": arg, "username": username, "email": email, "ua": ua}
            if CF:  # root verifies the token itself and takes the email from it, not from us
                req["cf_jwt"] = self.headers.get("X-Sharedbox-Cf-Jwt") or ""
            res = spool_call(req, wait=60)
            if CF and res.get("ok"):
                return self.redirect("/_box/me?welcome=1")
            if not res.get("ok") or not res.get("session"):
                return self.send(400, invite_page(arg, res.get("error") or "something went wrong", form, cfm))
            return self.redirect("/_box/me?welcome=1", [("X-Sharedbox-Set-Session", res["session"])])
        if CF and kind in ("login", "logout"):
            return self.redirect("/")
        if kind == "login":
            if not hmac.compare_digest(form.get("token", ""), token_for("gate", "login:" + sb.token_hash(arg))):
                return self.send(400, login_page(arg, "form expired, please try again"))
            if self.limited("gate-login:" + self.client_ip(), 10):
                return self.send(429, login_page(arg, "too many attempts, wait 10 minutes"))
            res = spool_call({"action": "redeem", "login": arg, "ua": ua})
            if not res.get("ok") or not res.get("session"):
                return self.send(400, login_page(arg, res.get("error")))
            return self.redirect("/_box/me", [("X-Sharedbox-Set-Session", res["session"])])
        who = self.who()
        if not who:
            return self.redirect("/")
        if not hmac.compare_digest(form.get("token", ""), token_for("gate", who["id"])):
            return self.send(400, portal_page("gate", who, who["name"], who["rec"],
                                              {"ok": False, "error": "form expired, please try again"}))
        if kind == "logout":
            spool_call({"action": "logout", "session": who["session"]})
            return self.redirect("/", [("X-Sharedbox-Clear-Session", "1")])
        if kind == "me":
            return self.portal_post("gate", who, form)
        return self.send(404, "not found", "text/plain")


class GateServer(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True


def serve_gate():
    """The private socket sharedbox-gate relays public requests to. Only the sharedbox user can reach it."""
    d = os.path.dirname(GATE_SOCK)
    os.makedirs(d, mode=0o700, exist_ok=True)
    try:
        os.unlink(GATE_SOCK)
    except FileNotFoundError:
        pass
    old = os.umask(0o077)
    try:
        srv = GateServer(GATE_SOCK, GateHandler)
    finally:
        os.umask(old)
    print(f"sharedbox-web: public pages for sharedbox-gate on {GATE_SOCK} ({PUBLIC})", flush=True)
    srv.serve_forever()


def main():
    global SELF_IP
    port = sb.cfg_int(CFG, "WEB_PORT")
    bind = CFG["WEB_BIND"]
    SELF_IP = sb.tailscale_ip4()
    if bind == "tailscale":
        bind = SELF_IP
        if not bind:
            sys.exit("tailscale IP not available yet")  # systemd restarts us
    ALLOWED_HOSTS.update(allowed_hosts(bind))
    threading.Thread(target=sampler, daemon=True).start()
    if PUBLIC:
        threading.Thread(target=serve_gate, daemon=True).start()
    fam = socket.AF_INET6 if ":" in bind else socket.AF_INET
    ThreadingHTTPServer.address_family = fam
    srv = ThreadingHTTPServer((bind, port), Handler)
    srv.daemon_threads = True
    print(f"sharedbox-web on http://{bind}:{port}", flush=True)
    srv.serve_forever()


if __name__ == "__main__":
    main()
