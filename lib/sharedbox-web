    """The friend's home page: open T3, log in to an AI and GitHub. No terminal anywhere."""
    e = html.escape
    tok = token_for(ip, who["id"])
    st = portal_call(ip, who, "status")
    logins, t3 = st.get("logins") or {}, st.get("t3")

