def allowed_hosts(bind):
    """Names this box is legitimately reached by: hostname, MagicDNS name, its IPs, WEB_HOSTS."""
    names = {HOST, "localhost", "127.0.0.1", "::1", bind, SELF_IP}
    try:
        st = json.loads(subprocess.run(["tailscale", "status", "--json", "--peers=false"],
                                       capture_output=True, text=True, timeout=5).stdout)
        me = st.get("Self") or {}
        dns = (me.get("DNSName") or "").rstrip(".")
        names |= {dns, dns.split(".")[0], me.get("HostName") or ""}
        names |= set(me.get("TailscaleIPs") or [])
    except (OSError, ValueError, AttributeError, subprocess.TimeoutExpired):
        pass
    names |= {h.strip() for h in CFG.get("WEB_HOSTS", "").split(",")}
    return {n.lower() for n in names if n}


def host_ok(value):
    """Host header (port stripped) checked against ALLOWED_HOSTS."""
    try:
        host = urllib.parse.urlsplit("//" + (value or "")).hostname
    except ValueError:
        return False
    return bool(host) and host.lower() in ALLOWED_HOSTS


class Handler(BaseHTTPRequestHandler):
    server_version = BRAND
    timeout = 30  # slow clients must not pin handler threads forever

    def log_message(self, fmt, *args):
        pass

    def send(self, code, body, ctype="text/html; charset=utf-8", headers=()):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Security-Policy",
                         "default-src 'self'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; "
                         "img-src 'self' data:; form-action 'self'; frame-ancestors 'none'")
        for k, v in headers:
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def ident(self):
        ip = self.client_address[0]
        if ip.startswith("::ffff:"):
            ip = ip[7:]
        if ip in ("127.0.0.1", "::1") or ip == SELF_IP:
            return ip, None  # local users must not be able to sign up as the owner
        who = sb.tailscale_whois(ip)
        return ip, who

    def tailnet_owner(self):
        """True for the owner over Tailscale: the Tailscale user that owns this machine, or one of
        CF_OWNER_EMAILS. Local users (loopback, this box's own IP) are friends too, so never."""
        ip, who = self.ident()
        if not who:
            return False
        return bool(OWNER_TS_ID and who["id"] == OWNER_TS_ID) or who["login"].lower() in sb.owner_emails(CFG)

    def do_GET(self):
        path = urllib.parse.urlsplit(self.path).path
        if path != "/healthz" and not host_ok(self.headers.get("Host")):
            return self.send(421, "unknown host; use this machine's Tailscale name", "text/plain")
        if path == "/":  # everyone's usage: the owner only; friends get their own page
            if not self.tailnet_owner():
                return self.send(303, "", headers=[("Location", "/me")])
            self.send(200, dashboard())
        elif path == "/api/state":
            if not self.tailnet_owner():
                return self.send(403, '{"error": "only the owner"}', "application/json")
            self.send(200, json.dumps(api_state()), "application/json")
        elif path == "/api/box":  # box-level numbers for the owner's other boxes (BOXES), nobody else
            if not peer_allowed(self.client_address[0]):
                return self.send(403, '{"error": "not a box in BOXES"}', "application/json")
            self.send(200, json.dumps(box_summary()), "application/json")
        elif path == "/api/peer/key":  # federation: this box's public roster key, for first-contact pinning
            if not peer_allowed(self.client_address[0]):
                return self.send(403, '{"error": "not a box in BOXES"}', "application/json")
            try:
                with open(os.path.join(sb.STATE_DIR, "fed", "box_key.pub")) as f:
                    body = f.read(4096)
            except OSError:
                return self.send(404, '{"error": "no key yet"}', "application/json")
            self.send(200, body, "text/plain")
        elif path == "/api/peer/roster":  # federation (lib/sbfed.py): root's signed roster, for the other boxes only
            if not peer_allowed(self.client_address[0]):
                return self.send(403, '{"error": "not a box in BOXES"}', "application/json")
            try:
                with open(os.path.join(sb.STATE_DIR, "fed", "roster.json")) as f:
                    body = f.read(256 << 10)
            except OSError:
                return self.send(404, '{"error": "no roster (sharedbox-admin fed-init)"}', "application/json")
            self.send(200, body, "application/json")
        elif path in ("/join", "/me"):
            ip, who = self.ident()
            q = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            result, card = flash_get((q.get("r") or [""])[0], who["id"]) if who else (None, "")
            self.send(200, join_page(ip, who, rng=(q.get("range") or ["24h"])[0], tab=(q.get("tab") or [""])[0],
                                     result=result, card=card))
        elif path == "/healthz":
            self.send(200, "ok", "text/plain")
        else:
            self.send(404, page("not found", "<p>not found</p>"))

    def do_POST(self):
        path = urllib.parse.urlsplit(self.path).path
        if path not in ("/join", "/me"):
            return self.send(404, "not found", "text/plain")
        host = self.headers.get("Host")
        if not host_ok(host):
            return self.send(421, "unknown host; use this machine's Tailscale name", "text/plain")
        origin = self.headers.get("Origin")
        if origin is not None and origin != "null" and urllib.parse.urlsplit(origin).netloc != host:
            return self.send(403, "bad origin", "text/plain")
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            n = -1
        if not 0 <= n <= 16384:
            return self.send(413, "too large", "text/plain")
        body = self.rfile.read(n).decode(errors="replace")
        form = {k: v[0] for k, v in urllib.parse.parse_qs(body).items()}
        self._form = form
        ip, who = self.ident()
        if not who:
            return self.send(403, join_page(ip, None))
        if not hmac.compare_digest(form.get("token", ""), token_for(ip, who["id"])):
            return self.send(400, join_page(ip, who, err="form expired, please submit again", form=form))
        if path == "/me":
            return self.portal_post(ip, who, form)
        q = rate.setdefault(ip, deque(maxlen=10))
        now = time.time()
        if len([t for t in q if now - t < 600]) >= 5:
            return self.send(429, join_page(ip, who, err="too many attempts, wait 10 minutes", form=form))
        q.append(now)
        username = form.get("username", "").strip().lower()
        err = sb.validate_username(username, CFG)
        key, kerr = "", None  # the SSH key is optional
        if form.get("key", "").strip():
            key, kerr = sb.validate_pubkey(form.get("key", ""))
        email, eerr = sb.validate_email(form.get("email", "")[:300])
        if not eerr and not email:
            eerr = "please give your email: it's how you sign in from other devices and get important notices"
        if err or kerr or eerr:
            return self.send(400, join_page(ip, who, err=err or kerr or eerr, form=form))
        res = submit_join(ip, who, username, key, email)
        if not res.get("ok"):
            return self.send(400, join_page(ip, who, err=res.get("error"), form=form))
        name, rec = existing_account(who["id"])
        if not name:
            return self.send(200, join_page(ip, who, msg="<h2>Account created</h2><p>Reload this page.</p>"))
        return self.send(200, portal_page(ip, who, name, rec, welcome=True))

    def redirect(self, where, headers=()):
        self.send(303, "", "text/plain", [("Location", where), *headers])

    def is_fetch(self):
        """The page's own script posting a form (it swaps the card in place): answer with the page, no redirect."""
        return (self.headers.get("X-Requested-With") or "") == "fetch"

    def after_post(self, ip, who, name, rec, result, code=200):
        """A button's result, shown in the card the button was pressed in. From the page's script (fetch): the
        page for that tab with the result in that card, which the script swaps in. Otherwise post/redirect/get:
        the result on a normal GET of the same tab, scrolled to the card (#card), so a refresh never resends a
        button press (no "resend the form?" dialog, no repeated actions)."""
        tab, card = result_place(result, getattr(self, "_form", None), bool(who.get("owner")))
        if self.is_fetch():
            return self.send(code, portal_page(ip, who, name, rec, result, tab=tab, card=card),
                             headers=[("X-Treehouse-Card", card)])
        fid = flash_put(who["id"], result, card)
        return self.redirect(redirect_url("/_box" if ip == "gate" else "", fid, tab, card))

    def portal_post(self, ip, who, form):
        name, rec = (who["name"], who["rec"]) if who.get("cf_jwt") else existing_account(who["id"])
        if not name:
            return self.send(200, join_page(ip, who))
        action, key = form.get("action", ""), form.get("key", "")
        as_json = form.get("format") == "json"
        now = time.time()
        if as_json and action in ("check", "telegram", "peer-check"):  # the page polls these (a login code, Telegram linking)
            last = portal_poll.get(who["id"], 0)
            if now - last < 2:
                return self.send(429, json.dumps({"ok": False}), "application/json")
            portal_poll[who["id"]] = now
        else:
            q = portal_rate.setdefault(who["id"], deque(maxlen=40))
            if len([t for t in q if now - t < 600]) >= 30:
                return self.after_post(ip, who, name, rec, {"ok": False, "error": "too many tries; wait a few minutes"},
                                       code=429)
            q.append(now)
        if who.get("owner") and action not in OWNER_ACTIONS:
            return self.after_post(ip, who, name, rec, {"ok": False, "error": "unknown action"})
        if who.get("owner") and action == "invite":
            email, err = sb.validate_email(form.get("email", "")[:300])
            if err or not email:
                return self.after_post(ip, who, name, rec, {"ok": False, "error": err or "type their email address"})
            res = portal_call(ip, who, "invite", email=email, note=form.get("note", "")[:120])
            return self.after_post(ip, who, name, rec, dict(res, _view="invite"))
        if who.get("owner") and action == "hackathon":
            op = form.get("op", "")
            kw = {"op": op}
            if op == "on":
                hours = form.get("hours", "").strip()
                if hours:
                    try:
                        h = float(hours)
                        if not 0 < h <= 24 * 7:
                            raise ValueError
                    except ValueError:
                        return self.after_post(ip, who, name, rec, {"ok": False, "error": "hours must be 1 to 168",
                                                                    "_view": "hackathon"})
                    kw["until"] = time.strftime("%Y-%m-%d %H:%M", time.localtime(time.time() + h * 3600))
                else:  # <input type=datetime-local> sends 2026-11-15T18:00
                    kw["until"] = form.get("until", "").strip().replace("T", " ")[:16]
                kw["users"] = " ".join(n for n in sorted(sb.friend_users()) if form.get(f"hu_{n}") == "1")
            elif op != "off":
                return self.after_post(ip, who, name, rec, {"ok": False, "error": "unknown action", "_view": "hackathon"})
            res = portal_call(ip, who, "hackathon", **kw)
            if res.get("ok"):
                res = dict(res, message="Hackathon mode is on." if res.get("active") else "Hackathon mode is off.")
            return self.after_post(ip, who, name, rec, dict(res, _view="hackathon"))
        if action == "boost":  # everyone: root raises this account's memory limit for a few hours if there's room
            res = portal_call(ip, who, "boost", user=name)
            return self.after_post(ip, who, name, rec, dict(res, _view="boost"))
        if who.get("owner") and action == "self-update":
            res = portal_call(ip, who, "self-update")
            return self.after_post(ip, who, name, rec, dict(res, _view="request-update"))
        if who.get("owner") and action.startswith("request-"):
            if not REQUEST_ID_RE.fullmatch(key):
                return self.after_post(ip, who, name, rec, {"ok": False, "error": "no such request"})
            res = portal_call(ip, who, action, key=key)
            return self.after_post(ip, who, name, rec, dict(res, _view=action))
        if action == "running-stop":  # the Running card's Stop (root and `box _portal` check the key again)
            if not sbrunning.KEY_RE.match(key):
                return self.after_post(ip, who, name, rec, {"ok": False, "error": "That isn't running any more."})
            res = portal_call(ip, who, "running-stop", key=key)
            return self.after_post(ip, who, name, rec, dict(res, _view="running-ctl", key=key))
        if action in ("serve-ctl", "serve-logs", "shared-ctl", "shared-logs"):
            op = form.get("op", "")
            if not SERVER_RE.fullmatch(key) or (action.startswith("serve-") and key == "t3") \
                    or (action.endswith("-ctl") and op not in SERVER_OPS):
                return self.after_post(ip, who, name, rec, {"ok": False, "error": "unknown server"})
            res = portal_call(ip, who, action, key=key, **({"op": op} if action.endswith("-ctl") else {}))
            return self.after_post(ip, who, name, rec, dict(res, _view=action, key=key))
        if action == "msg":  # the inbox: done, reply, clear, send
            op = form.get("op", "")
            if op not in ("done", "reply", "archive", "send"):
                return self.after_post(ip, who, name, rec, {"ok": False, "error": "unknown action", "_view": "msg"})
            kw = {k: form[k][:4000] for k in ("id", "text", "to", "title", "context", "level", "due") if form.get(k)}
            res = portal_call(ip, who, "msg", op=op, **kw)
            if res.get("ok") and op == "send":
                res["message"] = "Sent." + (" " + res["message"].split(". ", 1)[1] if ". " in res.get("message", "") else "")
            return self.after_post(ip, who, name, rec, dict(res, _view="msg"))
        if action == "where":  # your own status, and whether others see your activity
            op = form.get("op", "")
            if op == "set":
                kw = {"clear": True} if form.get("clear") else {"status": form.get("status", "")[:200],
                                                                  "until": form.get("until", "")[:60]}
            elif op == "private":
                kw = {"private": bool(form.get("private"))}
            else:
                return self.after_post(ip, who, name, rec, {"ok": False, "error": "unknown action", "_view": "where"})
            res = portal_call(ip, who, "where", op=op, **kw)
            return self.after_post(ip, who, name, rec, dict(res, _view="where"))
        if action == "telegram":  # phone alerts: link (a one-time t.me link), test, notify level, unlink; status (poll)
            op = form.get("op", "")
            if op not in ("link", "unlink", "notify", "test", "status"):
                return self.after_post(ip, who, name, rec, {"ok": False, "error": "unknown action", "_view": "telegram"})
            res = portal_call(ip, who, "telegram", op=op, **({"level": form.get("level", "")} if op == "notify" else {}))
            if op == "status":
                return self.send(200, json.dumps({"ok": bool(res.get("ok")), "linked": bool(res.get("linked"))}),
                                 "application/json")
            return self.after_post(ip, who, name, rec, dict(res, _view="telegram"))
        if who.get("owner") and action == "telegram-setup":
            res = portal_call(ip, who, "telegram-setup", **({"op": "off"} if form.get("op") == "off" else
                                                           {"token": form.get("tgtoken", "").strip()[:200]}))
            return self.after_post(ip, who, name, rec, dict(res, _view="telegram-setup"))
        if action == "projects":  # "Projects on all your boxes": keep one repo in ~ on every box, or stop
            op = form.get("op", "")
            if not PROJECT_RE.fullmatch(key) or op not in ("on", "off"):
                return self.after_post(ip, who, name, rec, {"ok": False, "error": "no such project", "_view": "projects"})
            res = portal_call(ip, who, "projects", key=key, op=op)
            return self.after_post(ip, who, name, rec, dict(res, _view="projects", _busy=op == "on"))
        if action in ("peer-login", "peer-check"):  # the T3 app / ChatGPT on this person's other boxes
            if key not in PEER_LABEL:
                return self.after_post(ip, who, name, rec, {"ok": False, "error": "unknown login", "_view": action})
            res = portal_call(ip, who, action, key=key)
            if as_json:
                rows = [r for r in res.get("boxes") or [] if isinstance(r, dict)]
                return self.send(200, json.dumps({"ok": bool(res.get("ok")),
                                                  "all_done": bool(rows) and all(r.get("done") for r in rows)}),
                                 "application/json")
            return self.after_post(ip, who, name, rec, dict(res, _view="peer-login", key=key))
        if action == "team":  # teammates' agents in your T3: allow (with an access level) or stop
            op = form.get("op", "")
            if op not in ("grant", "revoke"):
                return self.after_post(ip, who, name, rec, {"ok": False, "error": "unknown action", "_view": "team"})
            kw = {"to": form.get("to", "")[:40]}
            if op == "grant":
                kw["access"] = form.get("access", "")[:40]
            res = portal_call(ip, who, "team", op=op, **kw)
            return self.after_post(ip, who, name, rec, dict(res, _view="team"))
        if action == "restore":  # an archived project back in ~ (`box restore NAME`, as this user)
            if not ARCHIVE_RE.fullmatch(key) or ".." in key:
                return self.after_post(ip, who, name, rec, {"ok": False, "error": "no such project", "_view": "restore"})
            res = portal_call(ip, who, "restore", key=key)
            return self.after_post(ip, who, name, rec, dict(res, _view="restore"))
        actions = ("t3", "t3app", "t3prompt", "login", "code", "check", "add-key")
        keys = ("", "claude", "codex", "gh", "t3connect")
        if action not in actions or key not in keys:
            return self.after_post(ip, who, name, rec, {"ok": False, "error": "unknown action"})
        if action == "add-key":
            key_txt = form.get("sshkey", "")
            res = portal_call(ip, who, "add-key", sshkey=key_txt[:8192])
            res = dict(res, key_added=bool(res.get("ok")), _view="add-key")
            return self.after_post(ip, who, name, rec, res)
        kw = {"key": key}
        if action == "login" and form.get("console"):
            kw["console"] = True
        if action == "code":
            kw["code"] = form.get("code", "")[:1000]
        if action in ("t3prompt", "t3app"):  # the T3 app's setup prompt: keep the tailnet address (the app can't
            # go through Cloudflare); "t3app" is the older button's name, still on pages open in someone's browser
            res = app_prompt_result(portal_call(ip, who, "t3app"), rec)
            return self.after_post(ip, who, name, rec, dict(res, _tok=token_for(ip, who["id"])))
        res = portal_call(ip, who, action, **kw)
        if (who.get("cf_jwt")) and res.get("pair_url"):
            res = public_pair(res)
        if as_json:
            return self.send(200, json.dumps({"ok": bool(res.get("ok")), "done": bool(res.get("done"))}),
                             "application/json")
        res = dict(res, key=key, _tok=token_for(ip, who["id"]), _view=action)
        return self.after_post(ip, who, name, rec, res)


# ---------- public front door pages (only reachable through sharedbox-gate's unix socket) ----------


def cf_who(email, jwt):
    """Portal identity in cloudflare mode: the friend whose registry email the gate-verified token carries."""
    name, frec = sb.user_by_email(email or "")
    if not name or not jwt:
        return None
    return {"id": "cf:" + sb.token_hash(email)[:32], "display": name, "login": email, "node": "",
            "cf_jwt": jwt, "name": name, "rec": frec}


def cf_owner_who(email, jwt):
    """The owner (CF_OWNER_EMAILS, with no friend account on that email) as the owner's own account
    (OWNER_T3_USER, default the first ADMIN_USERS). Root re-checks the token and the email for every action."""
    email = (email or "").strip().lower()
    if not email or not jwt or email not in sb.owner_emails(CFG) or sb.email_taken(email):
        return None
    pw = sb.owner_account(CFG)
    if not pw:
        return None
    return {"id": "cf:" + sb.token_hash(email)[:32], "display": pw.pw_name, "login": email, "node": "",
            "cf_jwt": jwt, "name": pw.pw_name, "owner": True,
            "rec": {"uid": pw.pw_uid, "status": "active", "owner": True, "home": pw.pw_dir}}


def landing(email=None):
