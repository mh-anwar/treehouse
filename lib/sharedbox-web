def public_pair(res):
    """T3's pairing link points at its Tailscale address; send gateway users through PUBLIC_URL instead.
    T3 reads the one-time token from the fragment: <origin>/pair#token=..."""
    u = urllib.parse.urlsplit(res.get("pair_url") or "")
    tok = (urllib.parse.parse_qs(u.fragment).get("token") or urllib.parse.parse_qs(u.query).get("token") or [""])[0]
    return dict(res, pair_url=f"{PUBLIC}/pair#" + urllib.parse.urlencode({"token": tok}) if tok else "",
                url=PUBLIC + "/")


