            + facts(s) + f'<div class="sub">{link(s.get("port"), public=own_public)}</div>{acts("serve", s, more=switches(s))}'
            '</div>'
            for s in mine if isinstance(s, dict) and SERVER_RE.fullmatch(str(s.get("name", "")))) + "</div>")
        out.append("<p class='sub' style='margin:12px 0 0'>" + ("Only you can open these links, after signing in like on "
                   "this page." if PUBLIC and own_public else "These links work on your devices that have Tailscale "
                   "(the private network these machines use).") + "</p>")
    end = "</section></div>"
