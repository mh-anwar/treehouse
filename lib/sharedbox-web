def limits_text():
    """What everyone gets, from the config (never hard-coded)."""
    lim = sb.user_limits(CFG)
    return (f"{lim.get('MEMORY_LOW') or 'an equal share of'} of memory guaranteed each, up to "
            f"{sb.human(sb.parse_size(lim['MEMORY_MAX']))} when the box is quiet, an equal share of the CPU, "
            f"and {CFG['DISK_BUDGET_GB']}G of disk.")


def archive_text():
