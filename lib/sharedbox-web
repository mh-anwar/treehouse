_metrics_cache = {}  # seconds -> ((mtime_ns, size), rows)


def metrics_tail(seconds):
    """Samples from the last `seconds`, oldest first. Reads the file backwards, so only the tail is parsed."""
    try:
        st = os.stat(METRICS)
    except OSError:
        return []
    sig = (st.st_mtime_ns, st.st_size)
    hit = _metrics_cache.get(seconds)
    if hit and hit[0] == sig:
        return hit[1]
    cutoff = time.time() - seconds
    buf, pos = b"", st.st_size
    try:
        with open(METRICS, "rb") as f:
            while pos > 0 and st.st_size - pos < 16 << 20:
                step = min(1 << 16, pos)
                pos -= step
                f.seek(pos)
                buf = f.read(step) + buf
                lines = buf.split(b"\n")
                first = lines[0] if pos == 0 else (lines[1] if len(lines) > 2 else b"")
                try:
                    if first and json.loads(first)["ts"] < cutoff:
                        break
                except (ValueError, KeyError, TypeError):
                    pass
    except OSError:
        return []
    rows = []
    for line in buf.split(b"\n")[0 if pos == 0 else 1:]:
        try:
            r = json.loads(line)
            if isinstance(r, dict) and float(r["ts"]) >= cutoff:
                rows.append(r)
        except (ValueError, KeyError, TypeError):
            continue
    rows.sort(key=lambda r: r["ts"])
    _metrics_cache[seconds] = (sig, rows)
    return rows


def sample_step(rows):
    gaps = sorted(b["ts"] - a["ts"] for a, b in zip(rows, rows[1:]) if b["ts"] > a["ts"])
    return gaps[len(gaps) // 2] if gaps else 300


def user_series(rows, name, step):
    """[(ts, cores)], [(ts, mem bytes)] for one user; None where there's no data."""
    cpu, mem, prev = [], [], None
    for r in rows:
        u = (r.get("users") or {}).get(name)
        ts = r["ts"]
        if not (isinstance(u, list) and len(u) >= 2):
            cpu.append((ts, None))
            mem.append((ts, None))
            prev = None
            continue
        mem.append((ts, u[1]))
        if prev and 0 < ts - prev[0] <= 3 * step and u[0] >= prev[1]:
            cpu.append((ts, (u[0] - prev[1]) / 1e6 / (ts - prev[0])))
        else:
            cpu.append((ts, None))
        prev = (ts, u[0])
    return cpu, mem


def bucket(pts, t0, t1, n=240, how=max):
    """At most n points: one per time bucket (how=max or avg); None for empty buckets."""
    if len(pts) <= n:
        return pts
    width = (t1 - t0) / n or 1
    groups = {}
    for ts, v in pts:
        if v is not None:
            groups.setdefault(min(n - 1, int((ts - t0) / width)), []).append(v)
    return [(t0 + (i + .5) * width, how(groups[i]) if i in groups else None) for i in range(n)]


def avg(xs):
    return sum(xs) / len(xs)


def last_val(pts):
    return next((v for _, v in reversed(pts) if v is not None), None)


def peak(pts):
    return max((v for _, v in pts if v is not None), default=0)


def svg_paths(pts, t0, t1, ymax, gap, cls, W=1000, H=200):
    segs, cur, last = [], [], None
    for ts, v in pts:
        if v is None or (last is not None and ts - last > gap):
            if cur:
                segs.append(cur)
            cur = []
        if v is None:
            continue
        x = (ts - t0) / ((t1 - t0) or 1) * W
        y = H - min(max(v, 0), ymax) / (ymax or 1) * H
        cur.append((x, y))
        last = ts
    if cur:
        segs.append(cur)
    out = []
    for s in segs:
        if len(s) == 1:
            s = [(s[0][0] - 2, s[0][1]), (s[0][0] + 2, s[0][1])]
        line = " L".join(f"{x:.1f},{y:.1f}" for x, y in s)
        out.append(f'<path class="ar {cls}" d="M{s[0][0]:.1f},{H} L{line} L{s[-1][0]:.1f},{H} Z"/>'
                   f'<path class="ln {cls}" d="M{line}"/>')
    return "".join(out)


def svg_chart(series, t0, t1, ymax, gap, fmt, limits=(), rng="24h", head=""):
    """A line chart: series = [(points, "a"|"b")], limits = [(value, label)] drawn dashed.
    Text lives in HTML around the SVG, so it stays readable when the SVG stretches to a phone's width."""
    e = html.escape
    H = 200
    grid = "".join(f'<line class="gl" x1="0" x2="1000" y1="{H * f}" y2="{H * f}"/>' for f in (0, .25, .5, .75))
    lims, labels = "", []
    for v, label in limits:
        if v and v <= ymax:
            y = H - v / ymax * H
            lims += f'<line class="lim" x1="0" x2="1000" y1="{y:.1f}" y2="{y:.1f}"/>'
            labels.append(f'<span class="yl lim" style="top:{y / H * 100:.1f}%">{e(label)}</span>')
    if not any(abs(v / ymax - 1) < .12 for v, _ in limits if v):
        labels.append(f'<span class="yl" style="top:9%">{e(fmt(ymax))}</span>')
    body = "".join(svg_paths(p, t0, t1, ymax, gap, c) for p, c in series)
    ago = {"24h": ("24h ago", "12h ago"), "7d": ("7 days ago", "3½ days ago")}[rng]
    return f"""<div class="chart">{head}<div class="plot">
<svg viewBox="0 0 1000 {H}" preserveAspectRatio="none" aria-hidden="true">{grid}{body}{lims}
<line class="gl" x1="0" x2="1000" y1="{H}" y2="{H}"/></svg>{"".join(labels)}</div>
<div class="xl"><span>{ago[0]}</span><span>{ago[1]}</span><span>now</span></div></div>"""


def spark(pts, t0, t1, gap):
    m = max(peak(pts), 0.05)
    return (f'<svg viewBox="0 0 1000 200" preserveAspectRatio="none" aria-hidden="true">'
            f'{svg_paths(pts, t0, t1, m * 1.1, gap, "a")}</svg>')


def fmt_cores(v):
    return f"{v:.2f} cores" if v < 10 else f"{v:.0f} cores"


def nice_max(peak_v, limit, floor):
    """Chart top: show the limit line when it's in sight, else zoom in on the actual usage."""
    top = max(peak_v * 1.25, floor)
    if limit and limit <= 4 * top:
        top = max(top, limit * 1.08)
    return top


def friend_limits(rec):
    """Live cgroup limits, falling back to the config. Everyone (owner included) has the same limits and no CPU cap."""
    c = sb.read_cgroup(sb.slice_path(rec["uid"])) if rec and rec.get("uid") is not None else None
    lim = sb.user_limits(CFG, rec)
    cfg_mem = sb.parse_size(lim["MEMORY_HIGH"]) if lim.get("MEMORY_HIGH") else None
    return {"cpu": (c or {}).get("cpu_quota_cores"),
            "mem_high": (c or {}).get("mem_high") or cfg_mem,
            "mem_max": (c or {}).get("mem_max") or sb.parse_size(lim["MEMORY_MAX"]),
            "mem_low": sb.memory_guaranteed(lim), "lim": lim}


SAFE_EVENTS = ("user_created", "tools_updated", "skill_shared")


def box_feed(n=6, me=None):
    """Recent box-wide happenings, worded for friends. Never shows emails or logins. Skips `me`'s own events
    (they're under "Your activity" already)."""
    out = []
    for ev in reversed(sb.recent_events(80)):
        k, user = ev.get("kind"), str(ev.get("user") or "")
        if k not in SAFE_EVENTS or (me and user == me):
            continue
        if k == "user_created":
            txt = f"<b>{html.escape(user)}</b> joined the box"
        elif k == "tools_updated":
            txt = "Coding agents were updated to their newest versions"
        elif k == "skill_shared":
            txt = (f"<b>{html.escape(user)}</b> shared the skill <code>{html.escape(str(ev.get('skill', '')))}</code>"
                   " (<code>box skills</code>)")
        else:
            continue
        out.append(f"<li><span class='mut'>{html.escape(ago_text(ev.get('ts', 0)))}</span> · {txt}</li>")
        if len(out) >= n:
            break
    return out


def ago_text(ts):
    try:
        d = max(0, time.time() - float(ts))
    except (TypeError, ValueError):
        return "?"
    for unit, s in (("d", 86400), ("h", 3600), ("m", 60)):
        if d >= s:
            return f"{int(d // s)}{unit} ago"
    return "just now"


def reboot_text():
    """"next reboot Wed 04:00" for the box line, or "" when no reboot is planned."""
    rb = sb.reboot_info(CFG)
    if not rb["at"]:
        return ""
    if rb["postponed"]:
        return f"reboot waiting for agents (by {time.strftime('%H:%M', time.localtime(rb['latest']))})"
    return "next reboot " + time.strftime("%a %H:%M", time.localtime(rb["at"]))


def mem_limit(lim):
    """The memory limit to show: the live hard cap, else MEMORY_MAX from the config, else the soft limit."""
    return lim.get("mem_max") or sb.parse_size(sb.user_limits(CFG)["MEMORY_MAX"]) or lim.get("mem_high")


def you_strip(name, rec, st, btn, rng="24h", base=""):
    """The Usage card's insides: your memory/CPU/disk now, one small memory chart, one line about the box."""
    e = html.escape
    rng = rng if rng in RANGES else "24h"
    now = time.time()
    rows = metrics_tail(RANGES[rng])
    t0, t1 = now - RANGES[rng], now
    step = sample_step(rows)
    gap = max(3 * step, 2.5 * RANGES[rng] / 240)
    owner = bool((rec or {}).get("owner"))
    lim = friend_limits(rec)
    cpu, mem = user_series(rows, name, step)
    cpu_now, mem_now = last_val(cpu), last_val(mem)
    ml = mem_limit(lim)
    ncpu = os.cpu_count() or 1
    u = ((sb.read_json(sb.USAGE, {}) or {}).get("users") or {}).get(name) or {}
    budget = u.get("budget") or (None if owner else sb.cfg_int(CFG, "DISK_BUDGET_GB") << 30)
    disk = u.get("disk")

    def bar(used, cap):
        pct = min(100, 100 * (used or 0) / cap) if cap else 0
        color = "var(--bad)" if pct > 90 else "var(--warn)" if pct > 70 else "var(--acc)"
        return f'<div class="bar"><i style="width:{pct:.1f}%;background:{color}"></i></div>'

    def stat(label, v, sub):
        return f'<div class="stat"><h4>{e(label)}</h4><div class="v">{v}</div>{sub}</div>'
    guar = lim.get("mem_low")
    stats = [stat("Memory", f"{e(sb.human(mem_now or 0))}" + (f"<small> of {e(sb.human(ml))}</small>" if ml else ""),
                  (bar(mem_now, ml) if ml else '<div class="sub">no limit</div>')
                  + (f'<div class="sub">{e(sb.human(guar))} guaranteed, the rest while the box is quiet</div>'
                     if guar and ml and guar < ml else "")),
             stat("CPU", e(fmt_cores(cpu_now or 0)), f'<div class="sub">equal share of {ncpu} cores</div>')]
    if disk is not None or budget:
        stats.append(stat("Disk", (e(sb.human(disk)) if disk is not None else "<small>not measured yet</small>")
                          + (f"<small> of {e(sb.human(budget))}</small>" if budget and disk is not None else ""),
                          bar(disk, budget) if budget and disk is not None else
                          (f'<div class="sub">{e(sb.human(budget))} to use</div>' if budget else "")))
    stats.append(stat("Projects", str(int(u.get("projects") or 0)), '<div class="sub">in your home folder</div>'))
    out = [f'<div class="you">{"".join(stats)}</div>']
    # one small chart: memory against the limit
    if any(v is not None for _, v in mem):
        mem_b = bucket(mem, t0, t1)
        top = nice_max(peak(mem_b), ml, 256 << 20)
        head = (f'<div class="chart-h"><b>Your memory</b><span class="sub">peak {e(sb.human(peak(mem)))}</span>'
                f'<span style="margin-left:auto" class="seg">'
                + "".join(f'<a href="{base}/me?tab=account&amp;range={r}#dash" class="{"on" if r == rng else ""}">{r}</a>'
                          for r in RANGES)
                + "</span></div>")
        marks = ([(ml, f"most {sb.human(ml)}")] if ml else []) + (
            [(guar, f"guaranteed {sb.human(guar)}")] if guar and ml and guar < ml else [])
        out.append(svg_chart([(mem_b, "b")], t0, t1, top, gap, sb.human, marks, rng, head))
    # the box in one line
    last = rows[-1] if rows else {}
    level = {"calm": ("ok", "quiet"), "moderate": ("warn", "moderate"), "busy": ("bad", "busy")}.get(
        sb.box_load().get("level"), ("ok", "quiet"))
    bits = [f'<span class="dot {level[0]}"></span>Box: {level[1]}']
    if last.get("mem") is not None:
        bits.append(f"{float(last['mem']):.0f}% memory used")
    if last.get("disk_free") is not None:
        bits.append(f"{float(last['disk_free']):.0f}% disk free")
    rb = reboot_text()
    if rb:
        bits.append(e(rb))
    out.append(f'<div class="youx"><span class="boxline">{" · ".join(bits)}</span></div>')
    return "".join(out)


def activity_section(name, owner=False, rng="24h"):
    """Collapsed: who's around, your own activity, what happened on the box."""
    e = html.escape
    now = time.time()
    rows = metrics_tail(RANGES["24h"])
    t0, t1 = now - RANGES["24h"], now
    step = sample_step(rows)
    gap = max(3 * step, 2.5 * RANGES["24h"] / 240)
    last = rows[-1] if rows else {}
    people = []
    users = sorted(set((last.get("users") or {}).keys()) | set(sb.friend_users()) | set(sb.admin_users(CFG)))
    for n in users:
        c, _ = user_series(rows, n, step)
        cb = bucket(c, t0, t1, n=120, how=avg)
        cn = last_val(c[-3:]) or 0
        seen = next((t for t, v in reversed(c) if v is not None and v >= 0.05), None)
        people.append((cn, n, cb, seen))
    people.sort(key=lambda p: (-p[0], -(p[3] or 0), p[1]))
    working = sum(1 for p in people if p[0] >= 0.05)

    def doing(cn, seen):
        if cn >= 0.05:
            return "working now"
        return f"active {ago_text(seen)}" if seen else "away"
    out = []
    if people:
        out.append("<h3>People on the box</h3><ul class='people'>" + "".join(
            f'<li><span class="dot {"ok" if cn >= 0.05 else ""}"></span><span class="n">'
            f'<b>{e(n)}</b>{" <span class=mut>(you)</span>" if n == name else ""}</span>{spark(cb, t0, t1, 2 * gap)}'
            f'<span class="c">{doing(cn, seen)}</span></li>' for cn, n, cb, seen in people) + "</ul>")
    mine = [] if owner else own_events(name, n=5)
    feed = [] if owner else box_feed(n=5, me=name)
    if mine:
        out.append("<h3>Your activity</h3><ul class='ev'>" + "".join(mine) + "</ul>")
    if feed:
        out.append("<h3>Recently on the box</h3><ul class='ev'>" + "".join(feed) + "</ul>")
    if not out:
        return ""
    return (f"<details class='sec' id='activity'><summary>Activity<span class='sub'>"
            f"{working} working now</span></summary>"
            + "".join(out) + "</details>")


RUN_SHOWN = 8           # rows before "N more"
RUN_OLD = 86400         # up this long with RUN_OLD_MEM or more: flagged, it may be forgotten
RUN_OLD_MEM = 200 << 20
RUN_STOP_TEXT = {
    "containers": "Stop {name}? It stays off, reboots included, until someone starts it again.",
    "server": "Stop {name}? It stays off, reboots included, until you start it again under Your servers.",
    "unit": "Stop {name}? Anything running inside it ends now.",
}


def oom_notes(name, days=2):
    """What the box stopped for this account when memory ran out (root's oom.jsonl, from the janitor tick)."""
    out = []
    try:
        with open(os.path.join(sb.STATE_DIR, "oom.jsonl")) as f:
            for line in f.readlines()[-300:]:
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if isinstance(r, dict) and r.get("user") == name and float(r.get("ts") or 0) > time.time() - days * 86400:
                    out.append(r)
    except OSError:
        pass
    return out[-3:]


def run_rows(items, btn=None):
    """<li> rows for the Running card (btn=None: read-only, the owner's view of everyone)."""
    e = html.escape
    rows = []
    for it in items:
        if not isinstance(it, dict):
            continue
        kind = str(it.get("kind") or "")
        age = it.get("age") if isinstance(it.get("age"), (int, float)) else None
        mem = int(it.get("mem") or 0)
        label = sbrunning.KIND_LABEL.get(kind, kind.title())
        old = age is not None and age >= RUN_OLD and mem >= RUN_OLD_MEM and kind in ("database", "container", "terminal", "app")
        pill = (f'<span class="pill warn">up {e(sbrunning.ago(age))}</span>' if old else
                f'<span class="pill">{e(label)}</span>')
        detail = sb.printable(str(it.get("detail") or ""))[:120]
        sub_txt = (f"{e(label)} · " if old else "") + e(detail)
        cpu = sbrunning.cpu_avg({"age": age, "cpu_usec": it.get("cpu_usec") or 0}) if age else 0
        act = ""
        if btn and it.get("stop") in RUN_STOP_TEXT and sbrunning.KEY_RE.match(str(it.get("key") or "")):
            msg = RUN_STOP_TEXT[it["stop"]].format(name=sb.printable(str(it.get("name")))[:60])
            act = btn("running-stop", "Stop", str(it["key"]), primary=False, small=True,
                      attrs=f" onsubmit=\"return confirm({e(json.dumps(msg))})\"")
        rows.append(f'<li class="{"bg" if kind == "background" else ""}"><div class="nm"><b>'
                    f'{e(sb.printable(str(it.get("name") or "?"))[:80])}</b>{pill if kind != "background" else ""}'
                    f'<div class="sub">{sub_txt}</div></div>'
                    f'<div class="num">{e(sb.human(mem))}<span class="sub">'
                    + (f"up {e(sbrunning.ago(age))}" + (f" · {cpu:g}% CPU" if cpu >= 0.1 else "") if age else "&nbsp;")
                    + "</span></div>" + (f'<div class="act">{act}</div>' if btn else "") + "</li>")
    return rows


def running_section(name, rec, st, btn, slot=None):
    """Everything running for this account (containers, databases, servers, agents, terminals), biggest first,
    with Stop buttons; from `box _portal status` (it runs as the account, so container names are there).
    What a Stop did shows at the top of this card (slot)."""
    e = html.escape
    items = st.get("running")
    out = ["<div class='blk' id='running' data-card='running'><h2>Running for you</h2><section class='sec'>",
           (slot or NO_SLOT)("running")]
    lim = friend_limits(rec) if rec and rec.get("uid") is not None else {"mem_low": None, "mem_max": None}
    for k in oom_notes(name):
        when = time.strftime("%a %H:%M", time.localtime(float(k.get("ts") or 0)))
        out.append(f"<p class='warnline' style='margin:0 0 12px'>{e(when)}: the box ran out of memory and stopped "
                   f"{e(sb.printable(str(k.get('what') or 'something'))[:100])} so everything else kept running. "
                   "Start it again if you still need it.</p>")
    if items is None:
        out.append("<p class='mut' style='margin:0'>Couldn't load this just now. Refresh in a minute.</p></section></div>")
        return "".join(out)
    if not items:
        out.append("<p class='mut' style='margin:0'>Nothing running right now.</p></section></div>")
        return "".join(out)
    total = sum(int(i.get("mem") or 0) for i in items if isinstance(i, dict))
    mx, low = mem_limit(lim) if lim.get("mem_max") else None, lim.get("mem_low")
    out.append(f"<p class='sub' style='margin:0 0 14px'>{e(sb.human(total))} in use"
               + (f" · {e(sb.human(low))} guaranteed, up to {e(sb.human(mx))} while the box is quiet" if low and mx else "")
               + ". Databases and containers keep running until someone stops them, so stop what you don't use."
               "</p>")
    main = [i for i in items if isinstance(i, dict) and i.get("kind") != "background"]
    bg = [i for i in items if isinstance(i, dict) and i.get("kind") == "background"]
    shown, rest = main[:RUN_SHOWN], main[RUN_SHOWN:] + bg
    out.append("<ul class='run'>" + "".join(run_rows(shown, btn)) + "</ul>")
    if rest:
        out.append(f"<details class='run-more'><summary>{len(rest)} more</summary><ul class='run'>"
                   + "".join(run_rows(rest, btn)) + "</ul></details>")
    out.append("<p class='sub' style='margin:14px 0 0'>Agent sessions and T3 Code end on their own. Your agent "
               "can also list this: <code>box running</code>.</p></section></div>")
    return "".join(out)


def running_all_section(ip, who):
    """The owner's Running tab: what every account on the box runs (root collects it, with container names)."""
    e = html.escape
    res = portal_call(ip, who, "running-all")
    if not res.get("ok"):
        return f"<p class='err'>Couldn't load what's running: {e(str(res.get('error') or 'no answer'))}</p>"
    accts = [a for a in res.get("accounts") or [] if isinstance(a, dict)]
    total = sum(int(a.get("mem") or 0) for a in accts)
    out = ["<section class='sec runall'>",
           f"<p class='sub' style='margin:0 0 16px'>{e(sb.human(total))} in use across {len(accts)} accounts. "
           "Only each account's owner can stop their things (on their own page); ask them about anything that "
           "looks forgotten.</p>"]
    for a in accts:
        items = [i for i in a.get("items") or [] if isinstance(i, dict) and i.get("kind") != "background"]
        out.append(f"<h3>{e(sb.printable(str(a.get('user')))[:40])}<span class='sub'>{e(sb.human(int(a.get('mem') or 0)))}"
                   "</span></h3>")
        if not items:
            out.append("<p class='mut' style='margin:0'>Nothing running.</p>")
            continue
        out.append("<ul class='run'>" + "".join(run_rows(items[:RUN_SHOWN])) + "</ul>")
        if len(items) > RUN_SHOWN:
            out.append(f"<details class='run-more'><summary>{len(items) - RUN_SHOWN} more</summary><ul class='run'>"
                       + "".join(run_rows(items[RUN_SHOWN:])) + "</ul></details>")
    out.append("</section>")
    return "".join(out)


def servers_section(st, shared, btn, base="", own_public=True, slot=None):
    """Your own `box serve` servers and the group's shared ones (two cards), with start/stop/restart and logs.
    own_public=False (the owner): the gate only opens friends' port blocks at /p/PORT, so no public links.
    A button's result (a notice, or the logs) shows at the top of the card it was pressed in (slot)."""
    e = html.escape
    slot = slot or NO_SLOT

    def acts(kind, s, group=False):
        n, running = s["name"], s.get("state") == "running"
        conf = (f' onsubmit="return confirm({e(json.dumps("Stop " + n + " for everyone?"))})"' if group else "")
        b = []
        for op, label in (("restart", "Restart"), ("stop", "Stop")) if running else (("start", "Start"),):
            b.append(btn(f"{kind}-ctl", label, n, f'<input type="hidden" name="op" value="{op}">',
                         primary=op == "start", small=True, attrs=conf if op == "stop" else ""))
        b.append(btn(f"{kind}-logs", "Logs", n, primary=False, small=True))
        return '<div class="acts">' + "".join(b) + "</div>"

    def state(s):
        stt = str(s.get("state") or "?")
        cls = "ok" if stt == "running" else "bad" if stt == "failed" else "warn" if stt in (
