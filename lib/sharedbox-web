def event_text(ev, show_email=True):
    """One events.jsonl line as a plain sentence (owner's log, and each friend's own activity)."""
    e = html.escape
    kind = str(ev.get("kind") or "?")
    if kind == "balance":
        return ("The machine got busy for a while" if ev.get("cpu_busy") or ev.get("mem_tight")
                else "The machine is quiet again")
    tpl = EVENT_TEXT.get(kind)
    fields = {k: (" ".join(map(str, v)) if isinstance(v, list) else str(v)) for k, v in ev.items()
              if k not in ("ts", "kind") and v not in (None, "", [], {})}
    if not show_email:
        fields.pop("email", None)
        fields.pop("login", None)
    fields["user"] = str(ev.get("user") or "the machine")
    if tpl:
        def sub(m):
            k = m.group(1)
            v = sb.printable(fields.get(k, "?"))[:120]
            return f"<b>{e(v)}</b>" if k == "user" else f"<code>{e(v)}</code>" if k in ("cmd", "file", "path") \
                else e(v)
        tpl_txt = tpl.replace("`", "")
        txt = re.sub(r"\{(\w+)\}", sub, e(tpl_txt))
        return txt[:1].upper() + txt[1:] if not tpl_txt.startswith("{") else txt
    bits = [f"{e(k)} {e(sb.printable(v)[:80])}" for k, v in fields.items() if k != "user"]
    return f"<b>{e(fields['user'])}</b> · {e(kind.replace('_', ' '))}" + (" · " + ", ".join(bits) if bits else "")


