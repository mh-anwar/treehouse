def ai_accounts_section(st, logins, btn, tok, base, slot=None):
    """The Account tab's "AI accounts on each machine": machines down the side, Claude / ChatGPT / Google across,
    the account signed in on each (each machine may have a different one), and Sign in / Sign out in each cell.
    This machine's cells use the normal logins; the others go through `box _portal peer-*` over SSH."""
    e = html.escape
    keys = [k for k in ACCOUNT_LABEL if k in logins]
    if not keys:
        return ""
    here = str(st.get("box") or HOST)
    acc_here = st.get("accounts") or {}
    peers = {b: v for b, v in (st.get("boxes") or {}).items() if isinstance(v, dict)}
    multi = bool(peers)

    def confirm(k, b):
        return (f" onsubmit=\"return confirm('Sign out of {ACCOUNT_LABEL[k]} on {e(b)}? Agents there stop using that "
                f"account until you sign in again.')\"")

    def cell(k, b, is_here, ok, who, own):
        m = re.fullmatch(r"<td( class='mut')?>(.*)</td>", _cell(k, b, is_here, ok, who, own), re.S)
        return f"<td data-label='{e(ACCOUNT_LABEL[k])}'{m.group(1) or ''}><div>{m.group(2)}</div></td>"

    def _cell(k, b, is_here, ok, who, own):
        label = ACCOUNT_LABEL[k]
        if ok is None:
            return "<td class='mut'>Not known yet</td>"
        box_f = "" if is_here else f'<input type="hidden" name="box" value="{e(b)}">'
        if ok:
            name = e(who) if who else "Signed in"
            note = ""
            if k == "claude" and multi:
                note = ("<div class='sub'>This machine's own account</div>" if own else
                        "<div class='sub'>Shared across your machines</div>")
            out_btn = btn("logout" if is_here else "peer-logout", "Sign out", k, extra=box_f, link=True,
                          attrs=confirm(k, b))
            return f"<td><span class='dot ok'></span>{name}{note}<div class='sub'>{out_btn}</div></td>"
        verb = btn("login" if is_here else "peer-login", "Sign in", k, extra=box_f, primary=False, small=True,
                   attrs=f" aria-label='Sign in to {label} on {e(b)}'")
        return f"<td><span class='dot'></span><span class='mut'>Not signed in</span><div style='margin-top:6px'>{verb}</div></td>"

    trs = []
    trs.append(f"<tr><th scope='row'>{e(here)}<div class='sub'>this machine</div></th>" + "".join(
        cell(k, here, True, bool((logins.get(k) or {}).get("ok")), acc_here.get(k, ""), bool(st.get("claude_own")))
        for k in keys) + "</tr>")
    for b, v in sorted(peers.items()):
        if not v.get("ssh"):
            trs.append(f"<tr><th scope='row'>{e(b)}</th><td colspan='{len(keys)}' class='mut'>Not connected yet. Your "
                       "machines connect to each other by themselves within a few minutes.</td></tr>")
            continue
        got, acc = v.get("logins") or {}, v.get("accounts") or {}
        trs.append(f"<tr><th scope='row'>{e(b)}</th>" + "".join(
            cell(k, b, False, got.get(k) if k in got else None, acc.get(k, ""), bool(v.get("claude_own")))
            for k in keys) + "</tr>")
    checked = st.get("boxes_checked") or 0
    foot = ["Each machine keeps its own sign-ins, so you can use a different account on each one."]
    if multi and "claude" in keys:
        foot.append("A Claude sign-in is copied to your machines that don't have their own; signing in or out of "
                    "Claude on one machine here makes that machine keep its own account.")
    if "antigravity" in keys:
        foot.append("To use Google (Antigravity) inside T3, turn it on in T3's Settings, Providers, and sign in there "
                    "once more: T3 keeps its own sign-in.")
    if multi and checked:
        foot.append(f"Other machines last checked {ago_text(checked)}.")
    head = "".join(f"<th>{e(ACCOUNT_LABEL[k])}</th>" for k in keys)
    return ("<div class='blk' id='accounts' data-card='accounts'><h2>AI accounts on each machine</h2>"
            "<section class='sec'>" + (slot or NO_SLOT)("accounts")
            + f"<div class='tw'><table class='acct'><thead><tr><th>Machine</th>{head}</tr></thead><tbody>"
            + "".join(trs) + "</tbody></table></div>"
            + f"<p class='sub' style='margin-bottom:0'>{' '.join(foot)}</p></section></div>")


