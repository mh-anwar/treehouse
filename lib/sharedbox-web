                        + (f" with {e(sb.printable(str(s['agent']))[:30])}" if s.get("agent") else "")
                        + (f", {e(sb.printable(str(s['created']))[:16])}" if s.get("created") else ""))
        return out + f'<div class="sub">{" · ".join(bits)}</div>'


    def state(s):
        stt = str(s.get("state") or "?")
