<textarea id="connect-prompt" readonly style="height:150px">{e(text)}</textarea>
<p><button type="button" class="sm" id="connect-copy">Copy instructions</button>
<span class="sub">Same text: <a href="/_box/connect.md">{e(PUBLIC)}/_box/connect.md</a></span></p>
<script>document.getElementById("connect-copy").addEventListener("click",async function(){{
const t=document.getElementById("connect-prompt");try{{await navigator.clipboard.writeText(t.value)}}
catch(x){{t.select();document.execCommand("copy")}}this.textContent="Copied ✓"}});</script>"""


AGENT_GET = ("/_box/api/whoami", "/_box/connect.md")
AGENT_KEY_PATH = "/_box/api/ssh-key"


def agent_identity(handler):
    """(who, None) for a friend, else (None, (status, error)) for the JSON API (cloudflare mode only)."""
    if not CF:
        return None, (404, "this needs the box's Cloudflare login (PUBLIC_MODE=cloudflare)")
    who = handler.who()
    if who and who.get("name") and who.get("cf_jwt"):
        return who, None
    email = handler.cf_email() or ""
    if email in sb.owner_emails(CFG):
        return None, (403, f"{email} is the owner's login and has no friend account here. SSH in as yourself "
                           "the usual way, or link an account: sudo sharedbox-admin access add EMAIL --user NAME")
    return None, (403, f"no account on this box for {email or 'this login'}; ask your friend for an invite")


def agent_origin_ok(headers, strict=True):
    """No cross-site use of the visitor's cookie: an Origin, if sent, must be this site exactly; for writes
    (strict) a browser's Sec-Fetch-Site must say same-origin too. CLI clients send neither."""
    origin = headers.get("Origin")
    site = (headers.get("Sec-Fetch-Site") or "").strip().lower()
    return (origin is None or origin == PUBLIC) and (not strict or site in ("", "none", "same-origin"))


def agent_whoami(who):
    try:
        lo, hi = sb.port_range(CFG, pwd.getpwnam(who["name"]).pw_uid)
        ports = f"{lo}-{hi}"
    except (KeyError, ValueError):
        ports = ""
    ssh_host = live_ssh_host()
    return {"ok": True, "user": who["name"], "email": who.get("login", ""), "ssh_host": ssh_host,
            "ssh_enabled": bool(ssh_host), "ports": ports, "dashboard": PUBLIC + "/_box/me", "site": PUBLIC}


def agent_add_key(who, body):
    """Register one SSH public key for `who` (root re-verifies the Access token and the key). (status, json)."""
    if "PRIVATE KEY" in body:
        return 400, {"ok": False, "error": "that's a PRIVATE key: never send it anywhere. Send the .pub file."}
    text = body.strip()
    if text.startswith("{"):
        try:
            text = str(json.loads(text).get("key") or "")
        except (ValueError, AttributeError):
            text = ""
    key, err = sb.validate_pubkey(text)
    if err:
        return 400, {"ok": False, "error": err}
    res = portal_call("gate", who, "add-key", sshkey=key)
    if not res.get("ok"):
        return (403 if res.get("relogin") else 400), {"ok": False, "error": res.get("error") or "couldn't add the key"}
    ssh_host = live_ssh_host()
    out = {"ok": True, "user": who["name"], "ssh_host": ssh_host,
           "ssh_config": sbconnect.ssh_config_block(who["name"], ssh_host) if ssh_host else ""}
    if not ssh_host:
        out["note"] = ("key added, but SSH through Cloudflare isn't on yet: ask the owner to run "
                       "sudo sharedbox-admin cloudflare ssh")
    return 200, out


class GateHandler(Handler):
    """Requests relayed by sharedbox-gate over the unix socket. The gate has already stripped every
    client-supplied X-Sharedbox-* header and only passes a session token it found in the cookie."""

    def send(self, code, body, ctype="text/html; charset=utf-8", headers=()):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Referrer-Policy", "no-referrer")  # the URL may hold a one-time token
        self.send_header("Content-Security-Policy",
                         "default-src 'self'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; "
                         "img-src 'self' data:; form-action 'self'; frame-ancestors 'none'")
        for k, v in headers:
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def redirect(self, where, headers=()):
        self.send(303, "", "text/plain", [("Location", where), *headers])

    def client_ip(self):
        return self.headers.get("X-Sharedbox-Client-IP") or "?"

    def cf_email(self):
        return (self.headers.get("X-Sharedbox-Cf-Email") or "").lower() if CF else None

    def who(self, owner=True):
        if CF:  # the gate verified the token and strips any client-sent X-Sharedbox-* header
            jwt = self.headers.get("X-Sharedbox-Cf-Jwt")
            return cf_who(self.cf_email(), jwt) or (cf_owner_who(self.cf_email(), jwt) if owner else None)
        return session_who(self.headers.get("X-Sharedbox-Session"))

    def route(self):
        path = urllib.parse.urlsplit(self.path).path
        for prefix, kind in (("/i/", "invite"), ("/login/", "login")):
            if path.startswith(prefix) and sb.TOKEN_RE.fullmatch(path[len(prefix):]):
                return kind, path[len(prefix):]
        if path == "/_box/features":
            return "features", None
        if path in ("/_box", "/_box/", "/_box/me"):
            return "me", None
        if path in ("/_box/logout", "/_box/healthz", "/_box/open", "/_box/app"):
            return path[6:], None
        return "landing", path

    def do_GET(self):
        if urllib.parse.urlsplit(self.path).path in AGENT_GET:
            return self.agent_get(urllib.parse.urlsplit(self.path).path)
        kind, arg = self.route()
        q = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
        if kind == "healthz":
            return self.send(200, "ok", "text/plain")
        if CF and kind in ("invite", "login") and self.who(owner=False):
            return self.redirect("/_box/me")  # already has an account: nothing to sign up or log in to
        if kind == "invite":
            return self.send(200, invite_page(arg, email=self.cf_email()))
        if kind == "login":
            return self.redirect("/") if CF else self.send(200, login_page(arg))
        if kind == "app":  # "Open my T3 Code": "/" goes to T3 (pairing first if needed). A one-minute marker cookie
            # tells the gate this is the button, not a bookmark (browsers' Sec-Fetch-Site may not survive Cloudflare)
            return self.redirect("/", [("Set-Cookie", "tb_open=1; Path=/; Max-Age=60; Secure; HttpOnly; SameSite=Lax")])
        who = self.who()
        if kind == "open" and (not who or who.get("owner")) and CF and self.cf_email() in sb.owner_emails(CFG):
            # the owner's own T3: root checks the Access token itself and mints the pairing token
            if self.limited("open:owner", 10):
                return self.send(429, landing(self.cf_email()))
            res = spool_call({"action": "owner-pair", "cf_jwt": self.headers.get("X-Sharedbox-Cf-Jwt") or ""}, wait=60)
            if res.get("ok") and res.get("pair_url"):
                return self.redirect(public_pair(res)["pair_url"])
            return self.send(502, page("Couldn't open your T3", f"<p>{html.escape(res.get('error') or 'try again')}</p>"))
        if kind == "open" and who:
            # the gate sends a browser here when it has no T3 session yet: pair it and go straight in,
            # instead of leaving them on T3's "paste a pairing token" screen
            if self.limited("open:" + who["id"], 10):
                return self.redirect("/_box/me")
            res = public_pair(portal_call("gate", who, "t3"))
            if res.get("ok") and res.get("pair_url"):
                return self.redirect(res["pair_url"])
            return self.send(200, portal_page("gate", who, who["name"], who["rec"], res))
        if kind == "features":
            return self.send(200, features_page())
        if kind == "me" and who:
            return self.send(200, portal_page("gate", who, who["name"], who["rec"], welcome="welcome" in q,
                                              rng=(q.get("range") or ["24h"])[0]))
        if kind == "landing" and who and who.get("owner"):
            return self.redirect("/_box/me")  # the owner always has a page: their dashboard
        if kind == "landing" and arg not in ("/", "/_box/me", "/_box/", "/_box"):
            return self.send(404, landing(self.cf_email()))
        return self.send(200, landing(self.cf_email()))

    def send_json(self, code, obj):
        return self.send(code, json.dumps(obj) + "\n", "application/json")

    def agent_get(self, path):
        """GET /_box/api/whoami (JSON) and /_box/connect.md (the prompt as plain text) for CLI agents.
        Top-level navigations arrive cross-site after the Cloudflare login, so only a foreign Origin is refused;
        other sites can't read the answers anyway (no CORS)."""
        if not agent_origin_ok(self.headers, strict=False):
            return self.send_json(403, {"ok": False, "error": "cross-site request refused"})
        who, err = agent_identity(self)
        if path == "/_box/connect.md":
            if err:
                return self.send(err[0], err[1] + "\n", "text/plain; charset=utf-8")
            return self.send(200, sbconnect.connect_text(who["name"], PUBLIC, live_ssh_host()),
                             "text/plain; charset=utf-8")
        if err:
            return self.send_json(err[0], {"ok": False, "error": err[1]})
        return self.send_json(200, agent_whoami(who))

    def agent_post(self):
        """POST /_box/api/ssh-key: the body is one public key line. Needs X-Treehouse-Agent: 1 (a header no
        HTML form or simple cross-site request can send) and no foreign Origin, so a page elsewhere can't add a
        key with the visitor's Cloudflare cookie."""
        if (self.headers.get("X-Treehouse-Agent") or "").strip() != "1":
            return self.send_json(403, {"ok": False, "error": "send the header X-Treehouse-Agent: 1"})
        if not agent_origin_ok(self.headers):
            return self.send_json(403, {"ok": False, "error": "cross-site request refused"})
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            n = -1
        if not 0 < n <= 16384:
            return self.send_json(413 if n > 0 else 400, {"ok": False, "error": "send one public key line as the body"})
        body = self.rfile.read(n).decode(errors="replace")
        who, err = agent_identity(self)
        if err:
            return self.send_json(err[0], {"ok": False, "error": err[1]})
        if self.limited("agent-key:" + who["id"], 10):
            return self.send_json(429, {"ok": False, "error": "too many tries; wait a few minutes"})
        code, res = agent_add_key(who, body)
        return self.send_json(code, res)

    def limited(self, bucket, n=10, window=600):
        q = rate.setdefault(bucket, deque(maxlen=n + 1))
        now = time.time()
        if len([t for t in q if now - t < window]) >= n:
            return True
        q.append(now)
        return False

    def do_POST(self):
        if urllib.parse.urlsplit(self.path).path == AGENT_KEY_PATH:
            return self.agent_post()
        kind, arg = self.route()
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            n = -1
        if not 0 <= n <= 16384:
            return self.send(413, "too large", "text/plain")
        form = {k: v[0] for k, v in urllib.parse.parse_qs(self.rfile.read(n).decode(errors="replace")).items()}
        origin = self.headers.get("Origin")
        if origin is not None and origin != PUBLIC:
            return self.send(403, "bad origin", "text/plain")
        ua = (self.headers.get("User-Agent") or "")[:200]
        if kind == "invite":
            cfm = self.cf_email()
            if CF and self.who(owner=False):
                return self.redirect("/_box/me")
            if not hmac.compare_digest(form.get("token", ""), token_for("gate", "invite:" + sb.token_hash(arg))):
                return self.send(400, invite_page(arg, "form expired, please submit again", form, cfm))
            if self.limited("gate-join:" + self.client_ip(), 5):
                return self.send(429, invite_page(arg, "too many attempts, wait 10 minutes", form, cfm))
            username = form.get("username", "").strip().lower()
            email, eerr = (cfm, None) if CF else sb.validate_email(form.get("email", ""))
            err = sb.validate_username(username, CFG) or eerr
            if err:
                return self.send(400, invite_page(arg, err, form, cfm))
            req = {"action": "join", "invite": arg, "username": username, "email": email, "ua": ua}
            if CF:  # root verifies the token itself and takes the email from it, not from us
                req["cf_jwt"] = self.headers.get("X-Sharedbox-Cf-Jwt") or ""
            res = spool_call(req, wait=60)
            if CF and res.get("ok"):
                return self.redirect("/_box/me?welcome=1")
            if not res.get("ok") or not res.get("session"):
                return self.send(400, invite_page(arg, res.get("error") or "something went wrong", form, cfm))
            return self.redirect("/_box/me?welcome=1", [("X-Sharedbox-Set-Session", res["session"])])
        if CF and kind in ("login", "logout"):
            return self.redirect("/")
        if kind == "login":
            if not hmac.compare_digest(form.get("token", ""), token_for("gate", "login:" + sb.token_hash(arg))):
                return self.send(400, login_page(arg, "form expired, please try again"))
            if self.limited("gate-login:" + self.client_ip(), 10):
                return self.send(429, login_page(arg, "too many attempts, wait 10 minutes"))
            res = spool_call({"action": "redeem", "login": arg, "ua": ua})
            if not res.get("ok") or not res.get("session"):
                return self.send(400, login_page(arg, res.get("error")))
            return self.redirect("/_box/me", [("X-Sharedbox-Set-Session", res["session"])])
        who = self.who()
        if not who:
            return self.redirect("/")
        if not hmac.compare_digest(form.get("token", ""), token_for("gate", who["id"])):
            return self.send(400, portal_page("gate", who, who["name"], who["rec"],
                                              {"ok": False, "error": "form expired, please try again"}))
        if kind == "logout":
            spool_call({"action": "logout", "session": who["session"]})
            return self.redirect("/", [("X-Sharedbox-Clear-Session", "1")])
        if kind == "me":
            return self.portal_post("gate", who, form)
        return self.send(404, "not found", "text/plain")


class GateServer(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True


def serve_gate():
    """The private socket sharedbox-gate relays public requests to. Only the sharedbox user can reach it."""
    d = os.path.dirname(GATE_SOCK)
    os.makedirs(d, mode=0o700, exist_ok=True)
    try:
        os.unlink(GATE_SOCK)
    except FileNotFoundError:
        pass
    old = os.umask(0o077)
    try:
        srv = GateServer(GATE_SOCK, GateHandler)
    finally:
        os.umask(old)
    print(f"sharedbox-web: public pages for sharedbox-gate on {GATE_SOCK} ({PUBLIC})", flush=True)
    srv.serve_forever()


def main():
    global SELF_IP
    port = sb.cfg_int(CFG, "WEB_PORT")
    bind = CFG["WEB_BIND"]
    SELF_IP = sb.tailscale_ip4()
    if bind == "tailscale":
        bind = SELF_IP
        if not bind:
            sys.exit("tailscale IP not available yet")  # systemd restarts us
    ALLOWED_HOSTS.update(allowed_hosts(bind))
    threading.Thread(target=sampler, daemon=True).start()
    if PUBLIC:
        threading.Thread(target=serve_gate, daemon=True).start()
    fam = socket.AF_INET6 if ":" in bind else socket.AF_INET
    ThreadingHTTPServer.address_family = fam
    srv = ThreadingHTTPServer((bind, port), Handler)
    srv.daemon_threads = True
    print(f"sharedbox-web on http://{bind}:{port}", flush=True)
    srv.serve_forever()


if __name__ == "__main__":
    main()
