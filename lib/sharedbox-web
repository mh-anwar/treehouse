# ---------- the owner's other boxes (BOXES) ----------
# Each box answers GET /api/box on its tailnet port with a few box-level numbers, only to the boxes in BOXES.
# A background thread asks the others every PEER_EVERY seconds (short timeout), so a dead box never slows a page.

PEER_EVERY = 30
PEER_TIMEOUT = 3
PEER_MAX_BYTES = 16384
PEERS = {}       # box name -> {"ip", "data", "seen", "err", "busy"}
BOX_LIST = []    # [(name, ip)] from BOXES, in its order (this box included)
PEER_IPS = set()  # who may read /api/box
peers_lock = threading.Lock()
_box_cache = []  # [time, summary]
_OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))  # straight to the tailnet, never a proxy
SUMMARY_PCT = ("mem", "disk_free")


def box_summary():
    """This box's numbers for the others: no per-user data. Cached 15 s; no subprocess."""
    now = time.time()
    if _box_cache and now - _box_cache[0] < 15:
        return _box_cache[1]
    b = sb.box_load()
    rows = metrics_tail(900)  # the health job runs as root, so its disk numbers are right (this service can't see /home)
    last = rows[-1] if rows else {}
    mem = last.get("mem")
    if mem is None and b["mem_total"]:
        mem = round(100 * (1 - b["mem_avail"] / b["mem_total"]), 1)
    ip = box_ip()
    t3 = (CFG.get("OWNER_T3_PORT") or "").strip()
    name = next((n for n, i in BOX_LIST if i == ip), HOST)
    upd = sb.read_json(os.path.join(sb.STATE_DIR, "update.json"), {}) or {}
    disk = real_disk()
    d = {"v": 1, "name": name, "version": str(upd.get("commit") or "")[:12], "ncpu": b["ncpu"],
         "load1": round(b["loadavg"][0], 2), "level": b["level"], "mem": mem, "disk_free": last.get("disk_free"),
         # added later (older boxes leave them out; clean_summary keeps them optional): CPU busy %, memory and disk
         # in bytes, and who is active now (people who hid their activity with `box where --private` never are)
         "cpu": last.get("cpu"), "mem_used_b": max(0, b["mem_total"] - b["mem_avail"]), "mem_total_b": b["mem_total"],
         "disk_free_b": disk[1] if disk else None, "disk_total_b": disk[0] if disk else None,
         "people": active_people(rows),
         "dashboard": PUBLIC + "/_box/me" if PUBLIC else f"http://{ip}:{CFG['WEB_PORT']}/",
         "t3": "" if not t3.isdigit() else PUBLIC + "/_box/app" if PUBLIC else f"http://{ip}:{t3}"}
    # every account's T3 Code version and state (the janitor tick's t3.json): the owner's Machines card shows drift
    t3s = sb.read_json(sb.T3_STATE, {}) or {}
    d["t3_target"] = str(t3s.get("target") or sb.t3_box_version())
    d["t3_accounts"] = {n: {"v": str(r.get("version") or ""), "s": str(r.get("state") or "")}
                        for n, r in (t3s.get("accounts") or {}).items() if isinstance(r, dict)}
    _box_cache[:] = [now, d]
    return d


def active_people(rows, window=600):
    """Accounts that used the CPU in the last `window` seconds (from the health sampler), minus anyone who hid their
    activity (`box where --private`). Sorted, at most 30."""
    if not rows:
        return []
    step = sample_step(rows)
    now = time.time()
    try:
        hidden = {u for u, r in (sbwhere.load() or {}).items() if isinstance(r, dict) and r.get("private")}
    except Exception:  # noqa: BLE001 - no presence file yet: nobody hid anything
        hidden = set()
    names = set((rows[-1].get("users") or {}).keys())
    out = []
    for n in sorted(names - hidden):
        seen = last_active(rows, n, step)
        if seen and now - seen < window and re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", n):
            out.append(n)
    return out[:30]


def clean_summary(d):
    """A peer's /api/box answer, keeping only known fields with sane values; None if it isn't one."""
    if not isinstance(d, dict) or d.get("v") != 1:
        return None

    def num(v, lo, hi):
        return float(v) if isinstance(v, (int, float)) and not isinstance(v, bool) and lo <= v <= hi else None
    out = {k: num(d.get(k), 0, 100) for k in SUMMARY_PCT}
    out["load1"] = num(d.get("load1"), 0, 1e5)
    out["cpu"] = num(d.get("cpu"), 0, 100)
    for k in ("mem_used_b", "mem_total_b", "disk_free_b", "disk_total_b"):
        out[k] = num(d.get(k), 0, 1 << 60)
    ppl = d.get("people")
    out["people"] = [p for p in ppl if isinstance(p, str) and re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", p)][:30] \
        if isinstance(ppl, list) else None
    ncpu = num(d.get("ncpu"), 1, 4096)
    out["ncpu"] = int(ncpu) if ncpu else None
    out["level"] = d.get("level") if d.get("level") in ("calm", "moderate", "busy") else ""
    v = d.get("version")
    out["version"] = v if isinstance(v, str) and re.fullmatch(r"[A-Za-z0-9._-]{0,40}", v) else ""
    for k in ("dashboard", "t3"):
        u = d.get(k)
        out[k] = safe_url(u) if isinstance(u, str) and len(u) <= 300 else ""
    tv = d.get("t3_target")
    out["t3_target"] = tv if isinstance(tv, str) and sb.T3_VERSION_RE.fullmatch(tv) else ""
    acc = d.get("t3_accounts")
    out["t3_accounts"] = {n: {"v": r.get("v") if sb.T3_VERSION_RE.fullmatch(str(r.get("v") or "")) else "",
                              "s": r.get("s") if r.get("s") in ("running", "asleep", "off", "legacy") else ""}
                          for n, r in list(acc.items())[:60]
                          if isinstance(n, str) and re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", n) and isinstance(r, dict)} \
        if isinstance(acc, dict) else {}
    return out


def peer_url(ip):
    return f"http://{ip}:{CFG['WEB_PORT']}/api/box"


def fetch_peer(name, ip):
    data, err = None, ""
    try:
        with _OPENER.open(peer_url(ip), timeout=PEER_TIMEOUT) as r:
            body = r.read(PEER_MAX_BYTES + 1)
        data = clean_summary(json.loads(body)) if len(body) <= PEER_MAX_BYTES else None
        err = "" if data else "gave an answer this box doesn't understand"
    except urllib.error.HTTPError as ex:
        ex.close()
        err = {404: "needs a treehouse update", 403: "doesn't list this box in BOXES yet"}.get(ex.code, f"error {ex.code}")
    except Exception:  # noqa: BLE001 - refused, timed out, bad JSON: all just "not reachable"
        err = "not reachable"
    with peers_lock:
        p = PEERS.get(name)
        if not p or p["ip"] != ip:
            return
        p.update(busy=False, err=err)
        if data:
            p.update(data=data, seen=time.time())


def peers_tick():
    """Re-read BOXES (no restart needed after `box friends boxes`) and ask every other box once."""
    cur = sb.boxes(sb.load_config())
    todo = []
    with peers_lock:
        BOX_LIST[:] = list(cur.items())
        PEER_IPS.clear()
        PEER_IPS.update(cur.values())
        for n in list(PEERS):
            if PEERS[n]["ip"] != cur.get(n):
                del PEERS[n]
        for n, ip in cur.items():
            if ip == SELF_IP:
                continue
            p = PEERS.setdefault(n, {"ip": ip, "data": None, "seen": 0, "err": "", "busy": False})
            if not p["busy"]:
                p["busy"] = True
                todo.append((n, ip))
    for n, ip in todo:
        threading.Thread(target=fetch_peer, args=(n, ip), daemon=True).start()


def peers_loop():
    while True:
        try:
            peers_tick()
        except Exception as ex:  # noqa: BLE001
            print(f"peers: {ex!r}", file=sys.stderr, flush=True)
        time.sleep(PEER_EVERY)


def peer_allowed(ip):
    ip = ip[7:] if ip.startswith("::ffff:") else ip
    with peers_lock:
        return ip in ("127.0.0.1", "::1") or ip == SELF_IP or ip in PEER_IPS


def machine_rows(allowed=None):
    """[(name, ip, here, summary or {}, state)] for the Machines tab: this machine first-hand, the others from the
    poller. allowed: names this viewer has an account on (None = all of BOXES). state: online | checking | offline,
    with why/seen for offline."""
    with peers_lock:
        lst = list(BOX_LIST)
        peers = {n: dict(p) for n, p in PEERS.items()}
    here_d = box_summary()
    if not any(ip == SELF_IP for _, ip in lst):  # no BOXES (or this machine isn't in it): just this one
        lst = [(here_d.get("name") or HOST, SELF_IP or "")] + [x for x in lst if x[1] != SELF_IP]
    now = time.time()
    out = []
    for name, ip in lst:
        here = ip == SELF_IP or (not ip and name == (here_d.get("name") or HOST))
        if allowed is not None and not here and name not in allowed:
            continue
        p = peers.get(name) or {}
        d = here_d if here else p.get("data")
        fresh = here or bool(d and now - p.get("seen", 0) < 3 * PEER_EVERY)
        if fresh:
            st = {"state": "online"}
        elif p.get("busy") and not p.get("err") and not d:
            st = {"state": "checking"}
        else:
            st = {"state": "offline", "why": p.get("err") or "not reachable", "seen": p.get("seen") or 0}
        out.append((name, ip, here, (d or {}) if fresh else {}, st))
    out.sort(key=lambda r: not r[2])
    return out


