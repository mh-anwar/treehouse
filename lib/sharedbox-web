def page(title, body, gate=False, member=True):
    # "treehouse · mybox": the product first, this machine second
    here = "/_box/features" if title == "How it works" else "/_box/me" if title.endswith("dashboard") else ""

    def cur(h):
        return ' aria-current="page"' if h == here else ""
    mark = f'<img src="{FAVICON}" width="18" height="18" alt="" class="logo">{html.escape(BRAND)} <span class="host">· {html.escape(HOST)}</span>'
    nav = (f'<a href="/_box/me" class="brand">{mark}</a>' + (
           '<nav>' + "".join(f'<a href="{h}"{cur(h)}>{t}</a>' for h, t in (
               ("/_box/me", "Dashboard"), ("/_box/features", "How it works"), ("/_box/app", "Open T3"))) + '</nav>'
           if member else "")
           if gate else
           f'<a href="/" class="brand">{mark}</a>\n<nav><a href="/">dashboard</a><a href="/join">join</a></nav>')
    full = f"{title} · {BRAND} · {HOST}" if title and title != HOST else f"{BRAND} · {HOST}"
    return f"""<!doctype html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="icon" href="{FAVICON}">
<title>{html.escape(full)}</title><style>{CSS}</style></head>
<body><header>{nav}</header>
<main><!--email_off-->{body}<!--/email_off--></main></body></html>"""


