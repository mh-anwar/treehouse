                         f"{e(sb.human(free))} free")
        else:
            disk = meter("Disk", None if d.get("disk_free") is None else 100 - d["disk_free"],
                         f"{d.get('disk_free') or 0:.0f}% free")
        if d.get("load1") is not None and ncpu:
            busy = d["load1"] / ncpu
