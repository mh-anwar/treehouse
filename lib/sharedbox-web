def portal_page(ip, who, name, rec, result=None, welcome=False, rng="24h", tab="", card=""):
    """The friend's home page, in tabs: Home (the start card: log in to an AI, then open T3; what needs you;
    who's here), Messages, Servers (yours, the group's, what's running) and Account (logins, phone alerts,
    teammates, projects, usage, more options). Brand-new people see only the start card. No terminal anywhere.
    `card`: the card a button's result shows in (see result_place)."""
    if who.get("owner"):
        return owner_page(ip, who, name, rec, result, rng, tab, card)
    e = html.escape
    tok = token_for(ip, who["id"])
    gate = bool(who.get("cf_jwt"))
    base = "/_box" if gate else ""
    st, more_data = portal_bundle(ip, who)
    shared, msg, where, tg, team = (more_data[k] for k in ("shared", "msg", "where", "tg", "team"))
    logins, t3 = st.get("logins") or {}, st.get("t3")
    btn = portal_btn(tok, base)
    view = str((result or {}).get("_view") or "")
    if result and not card:
        ptab, card = place_of(result)
        tab = tab or ptab
    in_start = bool(result) and card == "start"

    ai = [k for k in ("claude", "codex") if k in logins]
    ai_ok = any(logins[k]["ok"] for k in ai)
    # Whether they can reach the box over Tailscale isn't known here (friends invited by email have no Tailscale
    # id on record even once the owner shares the box), so everyone gets the setup prompt: its first step checks.
    on_tailnet = bool((rec or {}).get("ts_id")) or not gate or not CF  # known to reach the Tailscale IP (ssh line)
    app_set = bool(t3 and t3.get("app"))  # the T3 app on a laptop really connected (a session labelled for it)

    # ---- the start card: the page's one main button ----
    if not t3:
        state = "S0"
    elif not ai_ok:
        state = "S1"
    elif app_set:
        state = "S3"
    else:
        state = "S2"
    # behind the public gate, T3 is a plain link: the gate pairs the browser by itself if it has to
    if CF and gate:
        def open_t3(label, small=False):
            return f"<a href='/_box/app'>{e(label)}</a>" if small else f"<a class='btn' href='/_box/app'>{e(label)}</a>"
    else:
        def open_t3(label, small=False):
            return btn("t3", label, link=small)
    busy = ("<div id='start-busy' hidden>" + notice("Waking up T3. This can take a minute.", "busy") + "</div>")
    sc = []
    if in_start and result.get("ok") and result.get("app_prompt"):
        sc.append(prompt_body(result))
    elif in_start and result.get("ok") and not result.get("done") and not result.get("pair_url") \
            and (result.get("url") or result.get("code") or result.get("paste")):
        sc.append(portal_result(result, btn, base))  # a login in progress: its steps are the card
    else:
        if in_start:
            sc.append(f"<div class='out' data-out>{portal_result(result, btn, base)}</div>")
        if state == "S0":
            sc.append("<h2>T3 isn't set up on this box yet</h2>"
                      "<p>Tell the owner. Everything else on this page still works.</p>")
        elif state == "S1":
            sc.append(f"<h2>{'Welcome, ' + e(name) if welcome else 'Log in to your AI'}</h2>")
            if not ai:
                sc.append("<p>No coding agents are installed on the box yet. Tell the owner.</p>")
            else:
                sc.append("<p>Your agents on the box use your Claude or ChatGPT plan. You only do this once.</p>")
                first = "claude" if "claude" in logins else "codex"
                sc.append("<div class='line'>" + btn("login", "Log in with Claude" if first == "claude" else
                                                     "Log in with ChatGPT", first) + "</div>")
                if first == "claude" and "codex" in logins:
                    sc.append("<div class='line sub'>Or use your ChatGPT plan: "
                              + btn("login", "Log in with ChatGPT", "codex", link=True) + ".</div>")
        else:  # S2, S3: T3 in this browser, or the T3 app on their laptop or phone (T3 Connect: no VPN)
            t3c = logins.get("t3connect")
            if t3c and t3c.get("ok"):
                need = any(v.get("ssh") and (v.get("logins") or {}).get("t3connect") is not True
                           for v in (st.get("boxes") or {}).values() if isinstance(v, dict))
                more = btn("peer-login", "Set it up there too", "t3connect", primary=False, small=True) if need else ""
                app = (f"<details class='appd' id='app'><summary class='btn secondary'>Open T3 app</summary>"
                       f"{app_help(more)}</details>")
            elif t3c:  # the first press signs them in to T3 Connect; after that the app finds the box by itself
                app = btn("login", "Open T3 app", "t3connect", primary=False)
            else:
                app = ""
            sc.append(f"<h2>{'Welcome, ' + e(name) if welcome else 'Open T3'}</h2><p>T3 is where you talk to your "
