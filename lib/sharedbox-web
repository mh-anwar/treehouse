PROJECT_RE = re.compile(r"[A-Za-z0-9_][A-Za-z0-9._-]{0,99}")  # same rule as lib/sbprojects.py and sharedbox-admin
PROJECT_STATE = {"cloned": ("ok", "copied"), "updated": ("ok", "updated"), "current": ("ok", "up to date"),
                 "skipped": ("warn", "left alone"), "error": ("bad", "failed")}


def projects_section(st, tok, base, slot=None):
    """"Projects on all your boxes" (lib/sbprojects.py): git repos in ~ with a remote, each with an on/off button;
    per other box what the last sync did. Only shown when the person has more than one box."""
    e = html.escape
    pj = st.get("projects")
    if not isinstance(pj, dict):
        return ""
    slot = slot or NO_SLOT
    head = "<div class='blk' id='projects' data-card='projects'><h2>Projects on all your machines</h2><section class='sec'>"
    if not pj.get("ok"):
        return head + slot("projects") + "<p class='mut' style='margin:0'>Couldn't list your projects just now.</p></section></div>"
    boxes = {str(b): v for b, v in (pj.get("boxes") or {}).items() if isinstance(v, dict)}
    rows = [r for r in pj.get("projects") or [] if isinstance(r, dict) and PROJECT_RE.fullmatch(str(r.get("name") or ""))]
    avail = sorted((r for r in rows if r.get("available")), key=lambda r: (not r.get("everywhere"), r["name"].lower()))
    other = [r for r in rows if not r.get("available")]
    names = sorted(boxes)
    where = (", ".join(names[:-1]) + " and " + names[-1]) if len(names) > 1 else (names[0] if names else "your other machines")

    def box_line(b, v):
        state = str(v.get("state") or "waiting")
        err = str((boxes.get(b) or {}).get("error") or "")
        if state == "waiting":
            if err:  # why is said once, under the list, with the next step
                return f"<span class='pb'><span class='dot warn'></span>{e(b)}: waiting for that machine</span>"
            return f"<span class='pb'><span class='spin' aria-hidden='true'></span>{e(b)}: copying soon</span>"
        cls, label = PROJECT_STATE.get(state, ("", state))
        note = str(v.get("note") or "")
        t3 = "" if state == "error" or v.get("t3") else ". Not in T3 there yet"
        return (f"<span class='pb'><span class='dot {cls}'></span>{e(b)}: {e(label)}"
                + (f" <span class='sub'>{e(note[:200])}</span>" if note else "") + (f"<span class='sub'>{t3}</span>" if t3 else "")
                + "</span>")

    items = []
    for r in avail:
        n = r["name"]
        if r.get("everywhere"):
            d = "".join(box_line(b, v) for b, v in sorted((r.get("boxes") or {}).items()) if isinstance(v, dict)) \
                or "<span class='sub'>On. Copies start within 10 minutes.</span>"
            act = f"<form method='post' action='{base}/me'>{hidden(tok, action='projects', key=n, op='off')}" \
                  "<button class='secondary sm'>Stop copying (copies stay)</button></form>"
        else:
            d = "<span class='sub'>Only on this machine</span>"
            act = f"<form method='post' action='{base}/me'>{hidden(tok, action='projects', key=n, op='on')}" \
                  "<button class='secondary sm'>Copy to all my machines</button></form>"
        items.append(f"<li><span class='k mono'>{e(n)}</span><span class='d'>{d}</span><span class='a'>{act}</span></li>")
    out = [head, slot("projects"),
           f"<p class='sub' style='margin-top:0'>Copy a project to {e(where)} so you can work on it there too. Each copy "
           "shows up in T3 on that machine and keeps up with what you push to GitHub. A copy with unsaved changes of its "
           "own is never overwritten. Stopping keeps the copies.</p>"]
    if items:
        out.append("<ul class='rows prj'>" + "".join(items) + "</ul>")
    elif not other:
        out.append("<p class='mut'>No git projects in your home folder yet.</p>")
    if other:
        out.append("<details class='p' style='margin-top:12px'><summary class='sub' style='cursor:pointer'>"
                   + e(plural(len(other), "project")) + " not on GitHub yet, so they can't be copied</summary><ul class='rows prj'>" + "".join(
                       f"<li><span class='k mono'>{e(r['name'])}</span><span class='d sub'>{e(str(r.get('why') or ''))}</span></li>"
                       for r in other) + "</ul></details>")
    bad = [(b, str(v.get("error"))) for b, v in sorted(boxes.items()) if v.get("error")]
    if bad and any(r.get("everywhere") for r in avail):
        out.append("<p class='sub'>" + " ".join(f"<span class='dot warn'></span><b>{e(b)}</b>: {e(err[:200])}"
                                               for b, err in bad)
                   + f" <a href='{base}/me?tab=messages'>Tell the owner</a></p>")
    if any(r.get("everywhere") for r in avail):
        out.append("<p class='sub'>Last copied: " + " · ".join(
            f"{e(b)} {e(ago_text(v['last_sync']) if v.get('last_sync') else 'not yet')}" for b, v in sorted(boxes.items()))
            + ". Copies update every 30 minutes, and within 10 minutes of a change.</p>")
    return "".join(out) + "</section></div>"


