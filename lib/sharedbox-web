def running_section(name, rec, st, btn, slot=None):
    """Everything running for this account (containers, databases, servers, agents, terminals), biggest first,
    with Stop buttons; from `box _portal status` (it runs as the account, so container names are there).
    What a Stop did shows at the top of this card (slot)."""
    e = html.escape
    items = st.get("running")
    out = ["<div class='blk' id='running' data-card='running'><h2>Running for you</h2><section class='sec'>",
           (slot or NO_SLOT)("running")]
    lim = friend_limits(rec) if rec and rec.get("uid") is not None else {"mem_low": None, "mem_max": None}
    for k in oom_notes(name):
        when = time.strftime("%a %H:%M", time.localtime(float(k.get("ts") or 0)))
        out.append(f"<p class='warnline' style='margin:0 0 12px'>{e(when)}: this machine ran out of memory and stopped "
                   f"{e(sb.printable(str(k.get('what') or 'something'))[:100])} so everything else kept running. "
                   "Start it again if you still need it.</p>")
    if items is None:
        out.append("<p class='mut' style='margin:0'>Couldn't load this just now. Refresh in a minute.</p></section></div>")
        return "".join(out)
    if not items:
        out.append("<p class='mut' style='margin:0'>Nothing running right now.</p></section></div>")
        return "".join(out)
    total = sum(int(i.get("mem") or 0) for i in items if isinstance(i, dict))
    mx, low = mem_limit(lim) if lim.get("mem_max") else None, lim.get("mem_low")
    out.append(f"<p class='sub' style='margin:0 0 14px'>{e(sb.human(total))} of memory in use"
               + (f". You always get {e(sb.human(low))}, and up to {e(sb.human(mx))} when the machine has room" if low and mx else "")
               + ". Databases and containers keep running until someone stops them, so stop what you don't use."
               "</p>")
    main = [i for i in items if isinstance(i, dict) and i.get("kind") != "background"]
    bg = [i for i in items if isinstance(i, dict) and i.get("kind") == "background"]
    shown, rest = main[:RUN_SHOWN], main[RUN_SHOWN:] + bg
    out.append("<ul class='run'>" + "".join(run_rows(shown, btn)) + "</ul>")
    if rest:
        out.append(f"<details class='run-more'><summary>Show {len(rest)} more</summary><ul class='run'>"
                   + "".join(run_rows(rest, btn)) + "</ul></details>")
    out.append("<p class='sub' style='margin:14px 0 0'>Agent sessions end when their chat ends; T3 Code stops on its "
               "own. Your agent can list and stop these for you too.</p></section></div>")
    return "".join(out)


def running_all_section(ip, who, btn=None, viewer=None, slot=None):
    """The owner's All running tab: what every account on the machine runs (root collects it, with container names),
    with Stop buttons. Stopping someone else's thing, or any T3 Code, first says whose it is and what happens; a
    keep-running server asks a second time. The result shows at the top of this card."""
    e = html.escape
    res = portal_call(ip, who, "running-all")
    head = ("<div class='blk' id='running-all' data-card='running-all'><h2>Running on this machine</h2>"
            "<section class='sec runall'>" + (slot or NO_SLOT)("running-all"))
    if not res.get("ok"):
        return head + f"<p class='err'>Couldn't load what's running: {e(str(res.get('error') or 'no answer'))}</p></section></div>"
    accts = [a for a in res.get("accounts") or [] if isinstance(a, dict)]
    total = sum(int(a.get("mem") or 0) for a in accts)
    out = [head, f"<p class='sub' style='margin:0 0 16px'>{e(sb.human(total))} of memory in use by {len(accts)} {'person' if len(accts) == 1 else 'people'}. "
           "Before you stop something of someone else's, the page says whose it is and what will happen. Things marked "
           "keep running ask twice.</p>"]
    for a in accts:
        user = sb.printable(str(a.get("user")))[:40]
        items = [i for i in a.get("items") or [] if isinstance(i, dict) and i.get("kind") != "background"]
        mem = int(a.get("mem") or 0)
        out.append(f"<h3>{e(user)}{' (you)' if user == viewer else ''}"
                   + (f"<span class='sub'>{e(sb.human(mem))}</span>" if mem else "") + "</h3>")
        if not items:
            out.append("<p class='mut' style='margin:0'>Nothing running.</p>")
