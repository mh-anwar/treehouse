def status_and_shared(ip, who):
    """Root's `status` and `shared-ls` answers. The group's servers are a second (slower) call: fetch both at once."""
    shared = {}
    th = threading.Thread(target=lambda: shared.update(portal_call(ip, who, "shared-ls")), daemon=True)
    th.start()
    st = portal_call(ip, who, "status")
    th.join(35)
    return st, dict(shared) or {"ok": False, "error": "no answer in time"}


