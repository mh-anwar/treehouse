def t3_versions_line(d, names):
    """The owner's Machines card: which T3 Code version each account on that machine runs, against the box's own."""
    e = html.escape
    target, acc = d.get("t3_target") or "", d.get("t3_accounts") or {}
    if not target and not acc:
        return ""
    asleep = sum(1 for r in acc.values() if r.get("s") == "asleep")
    behind = sorted((n, r) for n, r in acc.items() if r.get("v") and r.get("v") != target)
    head = f"T3 <code>{e(target or '?')}</code>"
    if not acc:
        tail = "."
    elif not behind:
        tail = " on every account."
    else:
        tail = (", except " + ", ".join(f"{e(names.get(n) or n)} <code>{e(r['v'])}</code>"
                                        + (" (T3's own service)" if r.get("s") == "legacy" else "")
                                        for n, r in behind[:8])
                + (f" and {len(behind) - 8} more" if len(behind) > 8 else "")
                + ". Each moves over the next time nothing runs in it for a while.")
    sleep = (f" {asleep} of {len(acc)} asleep (they wake when opened)." if asleep > 1 else
             f" 1 of {len(acc)} asleep (it wakes when opened)." if asleep else "")
    return f"<div class='mf sub'>{head}{tail}{sleep}</div>"


