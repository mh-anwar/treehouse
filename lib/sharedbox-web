def allowed_hosts(bind):
    """Names this box is legitimately reached by: hostname, MagicDNS name, its IPs, WEB_HOSTS."""
    names = {HOST, "localhost", "127.0.0.1", "::1", bind, SELF_IP}
    try:
        st = json.loads(subprocess.run(["tailscale", "status", "--json", "--peers=false"],
                                       capture_output=True, text=True, timeout=5).stdout)
        me = st.get("Self") or {}
        dns = (me.get("DNSName") or "").rstrip(".")
        names |= {dns, dns.split(".")[0], me.get("HostName") or ""}
        names |= set(me.get("TailscaleIPs") or [])
    except (OSError, ValueError, AttributeError, subprocess.TimeoutExpired):
        pass
    names |= {h.strip() for h in CFG.get("WEB_HOSTS", "").split(",")}
    return {n.lower() for n in names if n}


def host_ok(value):
    """Host header (port stripped) checked against ALLOWED_HOSTS."""
    try:
        host = urllib.parse.urlsplit("//" + (value or "")).hostname
    except ValueError:
        return False
    return bool(host) and host.lower() in ALLOWED_HOSTS


class Handler(BaseHTTPRequestHandler):
    server_version = "sharedbox"
    timeout = 30  # slow clients must not pin handler threads forever

    def log_message(self, fmt, *args):
        pass

    def send(self, code, body, ctype="text/html; charset=utf-8"):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Security-Policy",
                         "default-src 'self'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; "
                         "img-src 'self' data:; form-action 'self'; frame-ancestors 'none'")
        self.end_headers()
        self.wfile.write(data)

    def ident(self):
        ip = self.client_address[0]
        if ip.startswith("::ffff:"):
            ip = ip[7:]
        if ip in ("127.0.0.1", "::1") or ip == SELF_IP:
            return ip, None  # local users must not be able to sign up as the owner
        return ip, sb.tailscale_whois(ip)

    def do_GET(self):
        path = urllib.parse.urlsplit(self.path).path
        if path != "/healthz" and not host_ok(self.headers.get("Host")):
            return self.send(421, "unknown host; use this machine's Tailscale name", "text/plain")
        if path == "/":
            self.send(200, dashboard())
        elif path == "/api/state":
            self.send(200, json.dumps(api_state()), "application/json")
        elif path in ("/join", "/me"):
            ip, who = self.ident()
            self.send(200, join_page(ip, who))
        elif path == "/healthz":
            self.send(200, "ok", "text/plain")
        else:
            self.send(404, page("not found", "<p>not found</p>"))

    def do_POST(self):
        path = urllib.parse.urlsplit(self.path).path
        if path not in ("/join", "/me"):
            return self.send(404, "not found", "text/plain")
        host = self.headers.get("Host")
        if not host_ok(host):
            return self.send(421, "unknown host; use this machine's Tailscale name", "text/plain")
        origin = self.headers.get("Origin")
        if origin is not None and urllib.parse.urlsplit(origin).netloc != host:
            return self.send(403, "bad origin", "text/plain")
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            n = -1
        if not 0 <= n <= 16384:
            return self.send(413, "too large", "text/plain")
        body = self.rfile.read(n).decode(errors="replace")
        form = {k: v[0] for k, v in urllib.parse.parse_qs(body).items()}
        ip, who = self.ident()
        if not who:
            return self.send(403, join_page(ip, None))
        if not hmac.compare_digest(form.get("token", ""), token_for(ip, who["id"])):
            return self.send(400, join_page(ip, who, err="form expired, please submit again", form=form))
        if path == "/me":
            return self.portal_post(ip, who, form)
        q = rate.setdefault(ip, deque(maxlen=10))
        now = time.time()
        if len([t for t in q if now - t < 600]) >= 5:
            return self.send(429, join_page(ip, who, err="too many attempts, wait 10 minutes", form=form))
        q.append(now)
        username = form.get("username", "").strip().lower()
        err = sb.validate_username(username, CFG)
        key, kerr = "", None  # the SSH key is optional
        if form.get("key", "").strip():
            key, kerr = sb.validate_pubkey(form.get("key", ""))
        if err or kerr:
            return self.send(400, join_page(ip, who, err=err or kerr, form=form))
        res = submit_join(ip, who, username, key)
        if not res.get("ok"):
            return self.send(400, join_page(ip, who, err=res.get("error"), form=form))
        if res.get("pending"):
            return self.send(200, join_page(ip, who, msg="<h2>Request sent</h2><p>The owner will "
                                                         "approve it soon. Check back on this page.</p>"))
        name, rec = existing_account(who["id"])
        if not name:
            return self.send(200, join_page(ip, who, msg="<h2>Account created</h2><p>Reload this page.</p>"))
        return self.send(200, portal_page(ip, who, name, rec, welcome=True))

    def portal_post(self, ip, who, form):
        name, rec = (who["name"], who["rec"]) if who.get("session") or who.get("cf_jwt") else existing_account(who["id"])
        if not name:
            return self.send(200, join_page(ip, who))
        action, key = form.get("action", ""), form.get("key", "")
        as_json = form.get("format") == "json"
        now = time.time()
        if as_json and action == "check":  # the page polls this while someone types a code
            last = portal_poll.get(who["id"], 0)
            if now - last < 2:
                return self.send(429, json.dumps({"ok": False}), "application/json")
            portal_poll[who["id"]] = now
        else:
            q = portal_rate.setdefault(who["id"], deque(maxlen=40))
            if len([t for t in q if now - t < 600]) >= 30:
                return self.send(429, portal_page(ip, who, name, rec,
                                                  {"ok": False, "error": "too many tries; wait a few minutes"}))
            q.append(now)
        actions = ("t3", "login", "code", "check", "add-key") + (("device-link",) if PUBLIC and not CF else ())
        if action not in actions or key not in ("", "claude", "codex", "gh"):
            return self.send(400, portal_page(ip, who, name, rec, {"ok": False, "error": "unknown action"}))
        if action == "add-key":
            key_txt = form.get("sshkey", "")
            res = portal_call(ip, who, "add-key", sshkey=key_txt[:8192])
            res = dict(res, key_added=bool(res.get("ok")))
            return self.send(200, portal_page(ip, who, name, rec, res))
        kw = {"key": key}
        if action == "login" and form.get("console"):
            kw["console"] = True
        if action == "code":
            kw["code"] = form.get("code", "")[:1000]
        res = portal_call(ip, who, action, **kw)
        if (who.get("session") or who.get("cf_jwt")) and res.get("pair_url"):
            res = public_pair(res)
        if as_json:
            return self.send(200, json.dumps({"ok": bool(res.get("ok")), "done": bool(res.get("done"))}),
                             "application/json")
        res = dict(res, key=key, _tok=token_for(ip, who["id"]))
        self.send(200, portal_page(ip, who, name, rec, res))


