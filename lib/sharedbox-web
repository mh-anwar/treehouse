FRIEND_TABS = (("home", "Home"), ("messages", "Messages"), ("servers", "Servers"), ("account", "Account"))
ADMIN_TABS = (("people", "Friends"), ("running", "All running"), ("requests", "Requests"), ("boxes", "Boxes"),
              ("settings", "Settings"), ("events", "Events"))
# old links and bookmarks to /_box/me#something: which tab that card lives on now (the page's script moves there)
HASH_TAB = {"start": "home", "app": "home", "people": "home", "activity": "home", "needs": "home",
            "messages": "messages", "servers": "servers", "shared": "servers", "running": "servers", "logs": "servers",
            "account": "account", "dash": "account", "team": "account", "telegram": "account", "peers": "account",
            "archive": "account", "more": "account", "projects": "account",
            "admin": "admin", "friends": "people", "invite": "people", "requests": "requests", "boxes": "boxes",
            "settings": "settings", "hackathon": "settings", "telegram-setup": "settings", "update": "settings",
            "events": "events"}
# where each button's result goes (tab, card) when the page can't say (no JavaScript): by what was pressed
VIEW_PLACE = {"running-ctl": ("servers", "running"), "serve-ctl": ("servers", "servers"),
              "serve-logs": ("servers", "servers"), "shared-ctl": ("servers", "shared"),
              "shared-logs": ("servers", "shared"), "msg": ("messages", "messages"), "where": ("home", "people"),
              "telegram": ("account", "account"), "peer-login": ("account", "account"), "team": ("account", "team"),
