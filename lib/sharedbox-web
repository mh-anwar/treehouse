def join_page(ip, who, msg=None, err=None, form=None, rng="24h", tab="", result=None, card=""):
    e = html.escape
    if not who:
        return page("join", f"""<div class="box"><h2>Can't identify you</h2>
<p>This page only works over Tailscale. Ask the owner to share this machine with you, accept the
invite, then open <b>http://{html.escape(box_ip())}:{html.escape(str(CFG['WEB_PORT']))}/join</b>.</p></div>""")
    name, rec = existing_account(who["id"])
    if name:
        return portal_page(ip, who, name, rec, result, rng=rng, tab=tab, card=card)
    if CFG["JOIN_MODE"] != "open":
        return page("join", "<div class='box'><h2>Signups are closed</h2><p>Ask the owner.</p></div>")
    if msg:
        return page("join", f"<div class='box'>{msg}</div>")
    form = form or {}
