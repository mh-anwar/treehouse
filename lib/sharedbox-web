def peer_card(res, tok, base):
    """After "Sign in" on another machine (or "Set up the T3 app on your other machines"): one link per machine,
    the code box for sign-ins that show a code to paste back, and a poll that notices when a link is done."""
    e = html.escape
    key = str(res.get("key") or "")
    box = str(res.get("box") or "")
