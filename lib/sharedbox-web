def portal_bundle(ip, who):
    """Root's answers for one page view, fetched at once: status (the slow one), shared servers, inbox,
    who's here and Telegram. A missing answer becomes {"ok": False}; the page still renders."""
    calls = {"shared": ("shared-ls", {}), "msg": ("msg", {"op": "inbox"}), "where": ("where", {"op": "list"}),
             "tg": ("telegram", {"op": "status"}), "team": ("team", {"op": "list"})}
    got = {}

    def one(k, action, kw):
        got[k] = portal_call(ip, who, action, **kw)
    ths = [threading.Thread(target=one, args=(k, a, kw), daemon=True) for k, (a, kw) in calls.items()]
    for t in ths:
        t.start()
    st = portal_call(ip, who, "status")
    deadline = time.time() + 35
    for t in ths:
        t.join(max(0, deadline - time.time()))
    return st, {k: dict(got.get(k) or {"ok": False, "error": "no answer in time"}) for k in calls}


