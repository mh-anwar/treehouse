def page(title, body, gate=False):
    # "treehouse · sietchtabr": the product first, this machine second
    mark = f'▣ {html.escape(BRAND)} <span class="host">· {html.escape(HOST)}</span>'
    nav = (f'<a href="/_box/me" class="brand">{mark}</a><nav><a href="/_box/me">Dashboard</a>'
           '<a href="/_box/features">Features</a><a href="/_box/app">T3 Code</a></nav>'
           if gate else
           f'<a href="/" class="brand">{mark}</a>\n<nav><a href="/">dashboard</a><a href="/join">join</a></nav>')
    full = f"{title} · {BRAND} · {HOST}" if title and title != HOST else f"{BRAND} · {HOST}"
    return f"""<!doctype html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{html.escape(full)}</title><style>{CSS}</style></head>
<body><header>{nav}</header>
<main><!--email_off-->{body}<!--/email_off--></main></body></html>"""


