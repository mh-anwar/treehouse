                        "target='_blank' rel='noopener'>Open the sign-in page</a><br>2. Sign in. The page then shows a "
                        "code. Paste it here:"
                        f"<form method='post' action='{base}/me' class='inv' style='margin-top:8px'>"
                        f"{hidden(tok, action='peer-code', key=key, box=str(r.get('box') or ''))}"
                        "<input name='code' autocomplete='off' required placeholder='the code from the sign-in page' "
                        "aria-label='Code from the sign-in page'><button class='sm'>Finish signing in</button></form>"
                        "</span></li>")
        elif r.get("url"):
            polls = True
            url = safe_url(r.get("url"), ("https://",))
            code = (f" and check the code <b class='mono' style='white-space:nowrap'>{e(str(r['code']))}</b>" if r.get("code") else "")
            rows.append(f"<li data-box='{b}'><span class='k'>{b}</span><span class='d'>Open the link, sign in{code}, "
                        f"then approve.</span><span class='a'><a class='btn sm' href='{e(url)}' target='_blank' "
                        f"rel='noopener'>Open the sign-in page for {b}</a></span></li>")
        else:
            rows.append(f"<li><span class='k'>{b}</span><span class='d'><span class='dot warn'></span>"
                        f"{e(str(r.get('error') or 'no answer'))}</span></li>")
    poll = ""
    if polls:
        poll = (f"<script>(function(){{const body=new URLSearchParams({{token:{json.dumps(tok)},action:'peer-check',"
                f"key:{json.dumps(key)},box:{json.dumps(box)},format:'json'}});const t0=Date.now();async function poll(){{"
                "if(Date.now()-t0>15*60*1000)return;try{const r=await fetch('" + base + "/me',{method:'POST',body});"
                "const j=await r.json();if(j.all_done){location.href='" + base + "/me?tab=account#accounts';return}}catch(e){}"
                "setTimeout(poll,4000)}setTimeout(poll,4000)})();</script>")
    what = ACCOUNT_LABEL.get(key) or PEER_LABEL.get(key, key)
    title = f"Sign in to {what} on {e(box)}" if box else f"Set up {e(what)} on your other machines"
    tail = ("This page notices by itself once each machine is done. " if polls else "") + "The links work for 10 minutes."
    return (f"<div class='card' id='peers'><h3>{title}</h3><ul class='rows'>" + "".join(rows)
            + f"</ul><p class='sub'>{tail}</p></div>" + poll)


