# ---------- sampling ----------

def rows():
    """(key, label, kind, cgroup path) for every row on the dashboard."""
    out = []
    for name in sb.admin_users(CFG):
        try:
            uid = pwd.getpwnam(name).pw_uid
        except KeyError:
            continue
        out.append((name, name, "admin", sb.slice_path(uid)))
    for name, rec in sorted(sb.friend_users().items()):
        out.append((name, name, "friend", sb.slice_path(rec["uid"])))
    out.append(("system", "system services", "system", os.path.join(sb.CGROUP_ROOT, "system.slice")))
    return out


def sampler():
    prev, last_hist = {}, 0
    while True:
        now = time.time()
        snap = {}
        for key, label, kind, path in rows():
            c = sb.read_cgroup(path)
            row = {"label": label, "kind": kind, "online": c is not None}
            if c:
                p = prev.get(key)
                if p:
                    dt = c["t"] - p["t"]
                    row["cpu_pct"] = round((c["cpu_usec"] - p["cpu_usec"]) / 1e6 / dt * 100, 1)
                    row["throttled"] = c["throttled_usec"] > p["throttled_usec"]
                row.update({k: c[k] for k in ("mem", "mem_high", "mem_max", "swap", "pids",
                                              "pids_max", "cpu_quota_cores")})
                prev[key] = c
            snap[key] = row
        hist_tick = now - last_hist >= HISTORY_EVERY
        with state_lock:
            live.clear()
            live.update(snap)
            if hist_tick:
                for key, row in snap.items():
                    h = history.setdefault(key, deque(maxlen=24 * 60))
                    h.append((int(now), row.get("cpu_pct", 0), row.get("mem", 0)))
        if hist_tick:
            last_hist = now
        time.sleep(SAMPLE_EVERY)


def api_state():
    usage = sb.read_json(sb.USAGE, {}) or {}
    reg = sb.friend_users()
    out_rows = []
    with state_lock:
        for key, row in live.items():
            r = dict(row)
            u = usage.get("users", {}).get(key)
            if u:
                r["disk"], r["budget"], r["over"] = u.get("disk"), u.get("budget"), u.get("over")
                r["services"] = u.get("services", [])
                r["pending_deletions"] = u.get("pending_deletions", [])
            if key in reg:
                lo, hi = sb.port_range(CFG, reg[key]["uid"])
                r["ports"] = f"{lo}-{hi}"
                r["status"] = reg[key].get("status", "active")
            r["history"] = list(history.get(key, []))[-180:]
            out_rows.append(r)
    pending = requests = 0
    try:
        pending = len(os.listdir(sb.PENDING))
    except OSError:
        pass
    try:
        requests = len([f for f in os.listdir(sb.REQUESTS) if f.endswith(".txt")])
    except OSError:
        pass
    tv = (sb.read_json(sb.TOOLS_JSON, {}) or {}).get("tools", {})
    events = [e for e in sb.recent_events(40) if e.get("kind") != "janitor_error"]
    return {"host": HOST, "time": int(time.time()), "box": sb.box_load(), "rows": out_rows,
            "janitor_ran": usage.get("generated"), "join_mode": CFG["JOIN_MODE"],
            "pending_signups": pending, "open_requests": requests,
            "agents": [f"{tv[k]['label']} {tv[k]['version']}" for k in ("claude", "codex", "gemini", "opencode") if k in tv],
            "events": events[::-1]}


# ---------- join ----------

def token_for(ip, ts_id):
    return hmac.new(SECRET, f"{ip}|{ts_id}".encode(), hashlib.sha256).hexdigest()


def existing_account(ts_id):
    for name, rec in sb.friend_users().items():
        if rec.get("ts_id") == ts_id:
            return name, rec
    return None, None


def spool_call(req, wait=30):
    """Hand a request to the root provisioner and wait for its answer."""
    rid = secrets.token_hex(12)
    sb.write_json(os.path.join(sb.SPOOL, f"req-{rid}.json"), dict(req, ts=int(time.time())), mode=0o600)
    res_path = os.path.join(sb.SPOOL, f"res-{rid}.json")
    deadline = time.time() + wait
    while time.time() < deadline:
        time.sleep(0.25)
        res = sb.read_json(res_path)
        if res is not None:
            try:
                os.unlink(res_path)
            except OSError:
                pass
            return res
    return {"ok": False, "error": "the box is busy; try again in a minute"}


def submit_join(ip, who, username, key):
    return spool_call({"action": "join", "ip": ip, "ts_id": who["id"], "login": who["login"],
                       "username": username, "key": key})


def portal_call(ip, who, action, **kw):
    # logins wait ~25 s for a code; T3's very first start downloads it
    wait = {"status": 30, "t3": 240}.get(action, 90)
    if who.get("cf_jwt"):  # cloudflare mode: root re-verifies the Access token itself
        return spool_call(dict({"action": action, "cf_jwt": who["cf_jwt"]}, **kw), wait=wait)
    if who.get("session"):  # public gateway: root checks the session token itself
        return spool_call(dict({"action": action, "session": who["session"]}, **kw), wait=wait)
    return spool_call(dict({"action": action, "ip": ip, "ts_id": who["id"]}, **kw), wait=wait)


