METRICS = os.path.join(sb.STATE_DIR, "health", "metrics.jsonl")
RANGES = {"24h": 86400, "7d": 7 * 86400}
SERVER_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]{0,39}")  # same rule as `box _portal` and sharedbox-admin
SERVER_OPS = ("start", "stop", "restart")
_metrics_cache = {}  # seconds -> ((mtime_ns, size), rows)


def metrics_tail(seconds):
    """Samples from the last `seconds`, oldest first. Reads the file backwards, so only the tail is parsed."""
    try:
        st = os.stat(METRICS)
    except OSError:
        return []
    sig = (st.st_mtime_ns, st.st_size)
    hit = _metrics_cache.get(seconds)
    if hit and hit[0] == sig:
        return hit[1]
    cutoff = time.time() - seconds
    buf, pos = b"", st.st_size
    try:
        with open(METRICS, "rb") as f:
            while pos > 0 and st.st_size - pos < 32 << 20:
                step = min(1 << 16, pos)
                pos -= step
                f.seek(pos)
                buf = f.read(step) + buf
                lines = buf.split(b"\n")
                first = lines[0] if pos == 0 else (lines[1] if len(lines) > 2 else b"")
                try:
                    if first and json.loads(first)["ts"] < cutoff:
                        break
                except (ValueError, KeyError, TypeError):
                    pass
    except OSError:
        return []
    rows = []
    for line in buf.split(b"\n")[0 if pos == 0 else 1:]:
        try:
            r = json.loads(line)
            if isinstance(r, dict) and float(r["ts"]) >= cutoff:
                rows.append(r)
        except (ValueError, KeyError, TypeError):
            continue
    rows.sort(key=lambda r: r["ts"])
    _metrics_cache[seconds] = (sig, rows)
    return rows


def real_disk():
    """(total, free) bytes of the disk people's files are on. This service can't see /home (ProtectHome gives it an
    empty private mount, so sb.disk_free("/home") said "1.4M / 3.0G"): use the root-run health sampler's numbers,
    else "/" (on the boxes /home is part of the root filesystem). None if neither is known."""
    rows = metrics_tail(900)
    last = rows[-1] if rows else {}
    free, total, pct = last.get("disk_free_b"), last.get("disk_total_b"), last.get("disk_free")
    if isinstance(free, (int, float)) and isinstance(total, (int, float)) and total > 0:
        return int(total), int(free)
    if isinstance(free, (int, float)) and isinstance(pct, (int, float)) and pct > 0:
        return int(free * 100 / pct), int(free)
    try:
        return sb.disk_free("/")
    except OSError:
        return None


def sample_step(rows):
    gaps = sorted(b["ts"] - a["ts"] for a, b in zip(rows, rows[1:]) if b["ts"] > a["ts"])
    return gaps[len(gaps) // 2] if gaps else 300


def user_series(rows, name, step):
    """[(ts, cores)], [(ts, mem bytes)] for one user; None where there's no data."""
    cpu, mem, prev = [], [], None
    for r in rows:
        u = (r.get("users") or {}).get(name)
        ts = r["ts"]
        if not (isinstance(u, list) and len(u) >= 2):
            cpu.append((ts, None))
            mem.append((ts, None))
            prev = None
            continue
        mem.append((ts, u[1]))
        if prev and 0 < ts - prev[0] <= 3 * step and u[0] >= prev[1]:
            cpu.append((ts, (u[0] - prev[1]) / 1e6 / (ts - prev[0])))
        else:
            cpu.append((ts, None))
        prev = (ts, u[0])
    return cpu, mem


def bucket(pts, t0, t1, n=240, how=max):
    """At most n points: one per time bucket (how=max or avg); None for empty buckets."""
    if len(pts) <= n:
        return pts
    width = (t1 - t0) / n or 1
    groups = {}
    for ts, v in pts:
        if v is not None:
            groups.setdefault(min(n - 1, int((ts - t0) / width)), []).append(v)
    return [(t0 + (i + .5) * width, how(groups[i]) if i in groups else None) for i in range(n)]


def avg(xs):
    return sum(xs) / len(xs)


def last_val(pts):
    return next((v for _, v in reversed(pts) if v is not None), None)


def peak(pts):
    return max((v for _, v in pts if v is not None), default=0)


def svg_paths(pts, t0, t1, ymax, gap, cls, W=1000, H=200):
    segs, cur, last = [], [], None
    for ts, v in pts:
        if v is None or (last is not None and ts - last > gap):
            if cur:
                segs.append(cur)
            cur = []
        if v is None:
            continue
        x = (ts - t0) / ((t1 - t0) or 1) * W
        y = H - min(max(v, 0), ymax) / (ymax or 1) * H
        cur.append((x, y))
        last = ts
    if cur:
        segs.append(cur)
    out = []
    for s in segs:
        if len(s) == 1:
            s = [(s[0][0] - 2, s[0][1]), (s[0][0] + 2, s[0][1])]
        line = " L".join(f"{x:.1f},{y:.1f}" for x, y in s)
        out.append(f'<path class="ar {cls}" d="M{s[0][0]:.1f},{H} L{line} L{s[-1][0]:.1f},{H} Z"/>'
                   f'<path class="ln {cls}" d="M{line}"/>')
    return "".join(out)


def svg_chart(series, t0, t1, ymax, gap, fmt, limits=(), rng="24h", head=""):
    """A line chart: series = [(points, "a"|"b")], limits = [(value, label)] drawn dashed.
    Text lives in HTML around the SVG, so it stays readable when the SVG stretches to a phone's width."""
    e = html.escape
    H = 200
    grid = "".join(f'<line class="gl" x1="0" x2="1000" y1="{H * f}" y2="{H * f}"/>' for f in (0, .25, .5, .75))
    lims, labels = "", []
    for v, label in limits:
        if v and v <= ymax:
            y = H - v / ymax * H
            lims += f'<line class="lim" x1="0" x2="1000" y1="{y:.1f}" y2="{y:.1f}"/>'
            labels.append(f'<span class="yl lim" style="top:{y / H * 100:.1f}%">{e(label)}</span>')
    if not any(abs(v / ymax - 1) < .12 for v, _ in limits if v):
        labels.append(f'<span class="yl" style="top:9%">{e(fmt(ymax))}</span>')
    body = "".join(svg_paths(p, t0, t1, ymax, gap, c) for p, c in series)
    ago = {"24h": ("24h ago", "12h ago"), "7d": ("7 days ago", "3½ days ago")}[rng]
    return f"""<div class="chart">{head}<div class="plot">
<svg viewBox="0 0 1000 {H}" preserveAspectRatio="none" aria-hidden="true">{grid}{body}{lims}
<line class="gl" x1="0" x2="1000" y1="{H}" y2="{H}"/></svg>{"".join(labels)}</div>
<div class="xl"><span>{ago[0]}</span><span>{ago[1]}</span><span>now</span></div></div>"""


def spark(pts, t0, t1, gap):
    m = max(peak(pts), 0.05)
    return (f'<svg viewBox="0 0 1000 200" preserveAspectRatio="none" aria-hidden="true">'
            f'{svg_paths(pts, t0, t1, m * 1.1, gap, "a")}</svg>')


def fmt_cores(v):
    return f"{v:.2f} cores" if v < 10 else f"{v:.0f} cores"


def nice_max(peak_v, limit, floor):
    """Chart top: show the limit line when it's in sight, else zoom in on the actual usage."""
    top = max(peak_v * 1.25, floor)
    if limit and limit <= 4 * top:
        top = max(top, limit * 1.08)
    return top


def friend_limits(rec):
    """Live cgroup limits, falling back to the config. Everyone (owner included) has the same limits and no CPU cap."""
    c = sb.read_cgroup(sb.slice_path(rec["uid"])) if rec and rec.get("uid") is not None else None
    lim = sb.user_limits(CFG, rec)
    cfg_mem = sb.parse_size(lim["MEMORY_HIGH"]) if lim.get("MEMORY_HIGH") else None
    return {"cpu": (c or {}).get("cpu_quota_cores"),
            "mem_high": (c or {}).get("mem_high") or cfg_mem,
            "mem_max": (c or {}).get("mem_max") or sb.parse_size(lim["MEMORY_MAX"]),
            "mem_low": sb.memory_guaranteed(lim), "lim": lim}


