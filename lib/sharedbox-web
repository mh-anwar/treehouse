# ---------- tabs and in-place results ----------
# /_box/me is split into tabs, each its own URL (?tab=...). Everyone gets the first four; the owner also gets the
# admin tabs, in the same bar after a divider. A button's result shows at the top of the card holding the button:
# with JavaScript the page posts with fetch and swaps that card in place (no reload, no jump to the top); without
# it, post/redirect/get comes back to the same tab with #card in the URL.

FRIEND_TABS = (("home", "Home"), ("messages", "Messages"), ("servers", "Servers"), ("machines", "Machines"),
               ("account", "Account"))
ADMIN_TABS = (("people", "Friends"), ("running", "All running"), ("requests", "Requests"), ("settings", "Settings"),
              ("events", "Activity"))
TAB_ALIAS = {"boxes": "machines"}  # old ?tab= links (the owner-only Boxes tab became everyone's Machines tab)
# old links and bookmarks to /_box/me#something: which tab that card lives on now (the page's script moves there)
HASH_TAB = {"start": "home", "app": "home", "people": "home", "activity": "home", "needs": "home",
            "messages": "messages", "servers": "servers", "shared": "servers", "running": "servers", "logs": "servers", "running-all": "running",
            "account": "account", "dash": "account", "team": "account", "telegram": "account", "peers": "account",
            "archive": "account", "more": "account", "projects": "account",
            "admin": "admin", "friends": "people", "invite": "people", "requests": "requests", "boxes": "machines",
            "machines": "machines",
            "settings": "settings", "hackathon": "settings", "telegram-setup": "settings", "update": "settings",
            "events": "events"}
# where each button's result goes (tab, card) when the page can't say (no JavaScript): by what was pressed
VIEW_PLACE = {"running-ctl": ("servers", "running"), "serve-ctl": ("servers", "servers"),
              "running-any": ("running", "running-all"), "serve-set": ("servers", "servers"),
              "serve-logs": ("servers", "servers"), "shared-ctl": ("servers", "shared"),
              "shared-logs": ("servers", "shared"), "msg": ("messages", "messages"), "where": ("home", "people"),
              "telegram": ("account", "account"), "peer-login": ("account", "accounts"),
              "ai-account": ("account", "accounts"), "team": ("account", "team"),
              "restore": ("account", "archive"), "projects": ("account", "projects"), "boost": ("account", "dash"), "add-key": ("account", "more"),
              "invite": ("people", "invite"), "hackathon": ("settings", "hackathon"),
              "telegram-setup": ("settings", "telegram-setup"), "request-update": ("settings", "update")}
CARD_RE = re.compile(r"[a-z][a-z-]{0,30}")


def page_tabs(owner=False):
    """[(key, label)] in the tab bar: everyone's tabs, then the owner's admin tabs."""
    return FRIEND_TABS + (ADMIN_TABS if owner else ())


def resolve_tab(tab, owner=False, nreq=0):
    """The tab to show for ?tab=: unknown or someone else's tab -> Home. "admin" (old links to the owner's admin
    area) -> Requests when some are open, else Friends. "boxes" -> Machines."""
    if owner and tab == "admin":
        return "requests" if nreq else "people"
    tab = TAB_ALIAS.get(tab, tab)
    return tab if tab in dict(page_tabs(owner)) else "home"


def place_of(res, owner=False):
    """(tab, card) for a button's result, from what was pressed. Logins land in the start card, except GitHub
    (an Account row) and the owner's (their logins are Account rows)."""
    view, key = str((res or {}).get("_view") or ""), str((res or {}).get("key") or "")
    if view in VIEW_PLACE:
        return VIEW_PLACE[view]
    if view.startswith("request-"):
        return "requests", "requests"
    if view in ("login", "code", "check") and (key == "gh" or owner):
        return "account", "account"
    return "home", "start"


def result_place(res, form=None, owner=False):
    """(tab, card): the card the button was pressed in when the page said so (_tab/_card, sent by its script),
    else where that kind of result goes."""
    form = form or {}
    t, c = str(form.get("_tab") or ""), str(form.get("_card") or "")
    if CARD_RE.fullmatch(c) and t in dict(page_tabs(owner)):
        return t, c
    return place_of(res, owner)


def redirect_url(base, fid, tab, card):
    """Post/redirect/get without JavaScript: back to the same tab, scrolled to the card that shows the result."""
    return f"{base}/me?r={fid}&tab={tab}" + (f"#{card}" if card and CARD_RE.fullmatch(card) else "")


def flash_put(who_id, result, card):
    now = time.time()
    for k in [k for k, v in FLASH.items() if now - v[0] > 900]:
        FLASH.pop(k, None)
    fid = secrets.token_urlsafe(9)
    FLASH[fid] = (now, who_id, result, card)
    return fid


def flash_get(fid, who_id):
    """(result, card) stored by flash_put for this person, else (None, "")."""
    fl = FLASH.get(fid or "")
    return (fl[2], fl[3]) if fl and fl[1] == who_id else (None, "")


class Slot:
    """The result area at the top of each card: empty, except in the card the button was pressed in."""

    def __init__(self, card="", body=""):
        self.card, self.body, self.used = card, body, False

    def __call__(self, cid):
        if cid == self.card and self.body and not self.used:
            self.used = True
            return f"<div class='out' data-out>{self.body}</div>"
        return "<div class='out' data-out></div>"


NO_SLOT = Slot()


def result_html(res, btn, tok, base):
    """What a button's result looks like inside its card."""
    if not res:
        return ""
    view = str(res.get("_view") or "")
    if view == "telegram" and res.get("ok") and res.get("url"):
        return telegram_link_card(res, tok, base)
    if view == "peer-login" and res.get("ok"):
        return peer_card(res, tok, base)
    return portal_result(res, btn, base)


def tab_bar(base, tabs, cur, counts=None, owner=False):
    """Links styled as tabs (keyboard and back button work as usual); aria-current on the one showing."""
    e = html.escape
    counts = counts or {}
    keys = dict(tabs)
    hmap = {h: t for h, t in HASH_TAB.items() if t in keys or (owner and t == "admin")}
    out = []
    for k, label in tabs:
        if owner and k == ADMIN_TABS[0][0]:
            out.append("<span class='tsep' aria-hidden='true'></span>")
        n, cls = counts.get(k, (0, ""))
        out.append(f"<a href='{base}/me?tab={k}' data-tab='{k}'"
                   + (" class='on' aria-current='page'" if k == cur else "") + f">{e(label)}"
                   + (f"<span class='pill {cls}'>{int(n)}</span>" if n else "") + "</a>")
    return (f"<nav class='tabs' aria-label='Dashboard' data-cur='{e(cur)}' data-hash='{e(json.dumps(hmap))}'>"
            + "".join(out) + "</nav>")


def needs_items(base, msg, st, name, nreq=0):
    """Home's "Needs you": new messages, open requests (owner), servers that crashed, what the box stopped when
    memory ran out, big things left running for days, projects about to be archived. Each links to its tab."""
    e = html.escape
    out = []
    new = [m for m in (msg.get("messages") or []) if isinstance(m, dict) and m.get("id") and not m.get("read")] \
        if msg.get("ok") else []
    if new:
        out.append((f"<b>{plural(len(new), 'new message')}</b><div class='sub'>{e(str(new[0].get('title') or ''))[:120]}</div>",
                    f"{base}/me?tab=messages", "Read"))
    if nreq:
        out.append((f"<b>{plural(nreq, 'request')}</b> from friends waiting for you", f"{base}/me?tab=requests",
                    "Open requests"))
    failed = [str(s.get("name")) for s in st.get("servers") or [] if isinstance(s, dict) and s.get("state") == "failed"
              and SERVER_RE.fullmatch(str(s.get("name", "")))]
    if failed:
        out.append((f"<b>{e(', '.join(failed[:5]))}</b> stopped because of an error", f"{base}/me?tab=servers#servers",
                    "Open Servers"))
    for k in oom_notes(name)[-2:]:
        out.append((f"This machine ran out of memory and stopped <b>{e(sb.printable(str(k.get('what') or 'something'))[:80])}</b>",
                    f"{base}/me?tab=servers#running", "See what's running"))
    for it in [i for i in st.get("running") or [] if isinstance(i, dict)][:RUN_SHOWN]:
        age = it.get("age") if isinstance(it.get("age"), (int, float)) else None
        if age is not None and age >= RUN_OLD and int(it.get("mem") or 0) >= RUN_OLD_MEM \
                and it.get("kind") in ("database", "container", "terminal", "app"):
            out.append((f"<b>{e(sb.printable(str(it.get('name') or '?'))[:60])}</b> has been running for "
                        f"{e(sbrunning.ago(age))} and uses {e(sb.human(int(it.get('mem') or 0)))} of memory. Still need it?",
                        f"{base}/me?tab=servers#running", "See what's running"))
            if len(out) >= 6:
                break
    pend = [str(p) for p in ((((sb.read_json(sb.USAGE, {}) or {}).get("users") or {}).get(name) or {})
                             .get("pending_deletions") or [])][:5]
    if pend:
        out.append((f"Unused for a while, soon moved to the archive: <b>{e(', '.join(pend))}</b>",
                    f"{base}/me?tab=account#archive", "See why"))
    return out


