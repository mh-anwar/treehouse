# ---------- portal: everything a new friend needs, in the browser ----------

def cores(pct):
    try:
        return f"{float(str(pct).rstrip('%')) / 100:g}"
    except ValueError:
        return str(pct)


def safe_url(u, schemes=("https://", "http://")):
    u = str(u or "")
    return u if u.startswith(schemes) and len(u) < 4096 else ""


