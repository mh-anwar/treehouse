def ago_text(ts):
    try:
        d = max(0, time.time() - float(ts))
    except (TypeError, ValueError):
        return "?"
    for unit, s in (("d", 86400), ("h", 3600), ("m", 60)):
        if d >= s:
            return f"{int(d // s)}{unit} ago"
    return "just now"


def reboot_tile():
    """("Next reboot", value html, subtitle) for the box tiles, or None when no reboot is planned."""
    rb = sb.reboot_info(CFG)
    if not rb["at"]:
        return None
    if rb["postponed"]:
        return ("Reboot", "Waiting", f"for agents to finish their turn, by "
                f"{time.strftime('%H:%M', time.localtime(rb['latest']))} at the latest")
    when = time.strftime("%a %H:%M", time.localtime(rb["at"]))
    if rb["why"] == "updates":
        return ("Next reboot", html.escape(when), "for security updates")
    sched = rb["schedule"] or "scheduled"
    return ("Next reboot", html.escape(when), sched[:1].upper() + sched[1:] + ". Servers and T3 come back by themselves.")


