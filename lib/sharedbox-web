def you_strip(name, rec, st, btn, rng="24h", base=""):
    """The Usage card's insides: your memory/CPU/disk now, one small memory chart, one line about the box."""
    e = html.escape
    rng = rng if rng in RANGES else "24h"
    now = time.time()
    rows = metrics_tail(RANGES[rng])
