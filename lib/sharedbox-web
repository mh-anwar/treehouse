DASH_JS = r"""
const H=n=>{if(n==null)return'–';const u=['B','K','M','G','T'];let i=0;while(n>=1024&&i<4){n/=1024;i++}return(i?n.toFixed(1):n)+u[i]};
const pct=(a,b)=>b?Math.min(100,100*a/b):0;
const cls=p=>p>90?'var(--bad)':p>70?'var(--warn)':'var(--acc)';
const bar=(p)=>`<div class="bar"><i style="width:${p}%;background:${cls(p)}"></i></div>`;
function spark(h){if(!h||h.length<2)return'';const w=110,ht=26,m=Math.max(100,...h.map(x=>x[1]));
const pts=h.map((x,i)=>`${(i/(h.length-1)*w).toFixed(1)},${(ht-x[1]/m*ht).toFixed(1)}`).join(' ');
return `<svg class="spark" width="${w}" height="${ht}"><polyline fill="none" stroke="var(--acc)" stroke-width="1.5" points="${pts}"/></svg>`}
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
async function tick(){
 let s;try{s=await (await fetch('/api/state')).json()}catch(e){return}
 const b=s.box, memUsed=b.mem_total-b.mem_avail, diskUsed=b.disk_total-b.disk_free;
 const lvl={calm:'ok',moderate:'warn',busy:'bad'}[b.level];
 document.getElementById('cards').innerHTML=`
 <div class="card"><h3>Status</h3><div class="big"><span class="pill ${lvl}" style="font-size:16px">${b.level}</span></div>
  <div class="sub">pressure — cpu ${b.psi_cpu.toFixed(0)}% · mem ${b.psi_mem.toFixed(0)}% · io ${b.psi_io.toFixed(0)}%</div></div>
 <div class="card"><h3>CPU load</h3><div class="big">${b.loadavg[0].toFixed(2)} <span class="sub">/ ${b.ncpu} cores</span></div>${bar(pct(b.loadavg[0],b.ncpu))}</div>
 <div class="card"><h3>Memory</h3><div class="big">${H(memUsed)} <span class="sub">/ ${H(b.mem_total)}</span></div>${bar(pct(memUsed,b.mem_total))}</div>
 <div class="card"><h3>Disk</h3><div class="big">${H(diskUsed)} <span class="sub">/ ${H(b.disk_total)}</span></div>${bar(pct(diskUsed,b.disk_total))}</div>
 <div class="card"><h3>People</h3><div class="big">${s.rows.filter(r=>r.kind=='friend').length}</div>
  <div class="sub">join mode: ${esc(s.join_mode)}${s.open_requests?` · <b style="color:var(--warn)">${s.open_requests} request${s.open_requests>1?'s':''}</b>`:''}</div></div>
 <div class="card"><h3>Agents installed</h3><div class="sub" style="font-size:13px;color:var(--fg)">${s.agents.map(esc).join('<br>')||'–'}</div></div>`;
 const order={admin:0,friend:1,system:2};
 const rows=s.rows.sort((a,b)=>order[a.kind]-order[b.kind]||(b.cpu_pct||0)-(a.cpu_pct||0));
 document.getElementById('rows').innerHTML=rows.map(r=>{
  const cpuCap=r.cpu_quota_cores?r.cpu_quota_cores*100:b.ncpu*100;
  const memCap=r.mem_max||b.mem_total;
  const flags=[];
  if(r.kind!='friend')flags.push(`<span class="pill">${r.kind}</span>`);
  if(r.status&&r.status!='active')flags.push(`<span class="pill bad">${esc(r.status)}</span>`);
  if(r.throttled)flags.push('<span class="pill warn">cpu capped</span>');
  if(r.mem_high&&r.mem>0.9*r.mem_high)flags.push('<span class="pill warn">mem near limit</span>');
  if(r.over)flags.push('<span class="pill bad">over disk budget</span>');
  if((r.pending_deletions||[]).length)flags.push(`<span class="pill warn">${r.pending_deletions.length} project${r.pending_deletions.length>1?'s':''} expiring</span>`);
  if(r.kind=='friend'&&!r.online)flags.push('<span class="pill">offline</span>');
  const svcs=(r.services||[]).map(x=>`<span class="pill ${x.state=='running'?'ok':x.state=='failed'?'bad':''}">${esc(x.name)}</span>`).join(' ');
  return `<tr><td><b>${esc(r.label)}</b> ${flags.join(' ')}</td>
  <td class="num mini">${(r.cpu_pct??0).toFixed(0)}% <span class="mut">/ ${cpuCap.toFixed(0)}%</span>${bar(pct(r.cpu_pct||0,cpuCap))}</td>
  <td>${spark(r.history)}</td>
  <td class="num mini">${H(r.mem)} <span class="mut">/ ${r.mem_max?H(r.mem_max):'–'}</span>${bar(pct(r.mem||0,memCap))}</td>
  <td class="num">${r.pids??'–'}</td>
  <td class="num mini">${r.disk!=null?H(r.disk):'–'} <span class="mut">/ ${r.budget?H(r.budget):'–'}</span>${r.budget?bar(pct(r.disk,r.budget)):''}</td>
  <td class="num mut">${esc(r.ports||'')}</td><td>${svcs}</td></tr>`}).join('');
 const t=x=>new Date(x*1000).toLocaleString([], {month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});
 document.getElementById('events').innerHTML=s.events.map(e=>{
  let d=esc(e.kind).replace(/_/g,' ');if(e.path)d+=` <code>${esc(e.path)}</code> (${esc(H(e.bytes))}, ${esc(e.reason)})`;
  if(e.login)d+=` <span class="mut">${esc(e.login)}</span>`;if(e.free_pct!=null)d+=` — ${esc(e.free_pct)}% free`;
  return `<li><span class="mut">${t(e.ts)}</span> · <b>${esc(e.user||'box')}</b> · ${d}</li>`}).join('')||'<li class="mut">nothing yet</li>';
 document.getElementById('foot').textContent=`janitor last ran ${s.janitor_ran?t(s.janitor_ran):'never'} · refreshed ${new Date().toLocaleTimeString()}`;
}
tick();setInterval(tick,5000);
