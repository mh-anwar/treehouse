SUMMARY_PCT = ("mem", "disk_free")


def box_summary():
    """This box's numbers for the others: no per-user data. Cached 15 s; no subprocess."""
    now = time.time()
    if _box_cache and now - _box_cache[0] < 15:
        return _box_cache[1]
    b = sb.box_load()
    rows = metrics_tail(900)  # the health job runs as root, so its disk numbers are right (this service can't see /home)
    last = rows[-1] if rows else {}
    mem = last.get("mem")
    if mem is None and b["mem_total"]:
        mem = round(100 * (1 - b["mem_avail"] / b["mem_total"]), 1)
    ip = box_ip()
    t3 = (CFG.get("OWNER_T3_PORT") or "").strip()
    name = next((n for n, i in BOX_LIST if i == ip), HOST)
    upd = sb.read_json(os.path.join(sb.STATE_DIR, "update.json"), {}) or {}
    d = {"v": 1, "name": name, "version": str(upd.get("commit") or "")[:12], "ncpu": b["ncpu"],
         "load1": round(b["loadavg"][0], 2), "level": b["level"], "mem": mem, "disk_free": last.get("disk_free"),
         "dashboard": PUBLIC + "/_box/me" if PUBLIC else f"http://{ip}:{CFG['WEB_PORT']}/",
         "t3": "" if not t3.isdigit() else PUBLIC + "/_box/app" if PUBLIC else f"http://{ip}:{t3}"}
    _box_cache[:] = [now, d]
    return d


def clean_summary(d):
    """A peer's /api/box answer, keeping only known fields with sane values; None if it isn't one."""
    if not isinstance(d, dict) or d.get("v") != 1:
        return None

    def num(v, lo, hi):
        return float(v) if isinstance(v, (int, float)) and not isinstance(v, bool) and lo <= v <= hi else None
    out = {k: num(d.get(k), 0, 100) for k in SUMMARY_PCT}
    out["load1"] = num(d.get("load1"), 0, 1e5)
    ncpu = num(d.get("ncpu"), 1, 4096)
    out["ncpu"] = int(ncpu) if ncpu else None
    out["level"] = d.get("level") if d.get("level") in ("calm", "moderate", "busy") else ""
    v = d.get("version")
    out["version"] = v if isinstance(v, str) and re.fullmatch(r"[A-Za-z0-9._-]{0,40}", v) else ""
    for k in ("dashboard", "t3"):
        u = d.get(k)
        out[k] = safe_url(u) if isinstance(u, str) and len(u) <= 300 else ""
    return out


def peer_url(ip):
    return f"http://{ip}:{CFG['WEB_PORT']}/api/box"


def fetch_peer(name, ip):
    data, err = None, ""
    try:
        with _OPENER.open(peer_url(ip), timeout=PEER_TIMEOUT) as r:
            body = r.read(PEER_MAX_BYTES + 1)
        data = clean_summary(json.loads(body)) if len(body) <= PEER_MAX_BYTES else None
        err = "" if data else "gave an answer this box doesn't understand"
    except urllib.error.HTTPError as ex:
        ex.close()
        err = {404: "needs a treehouse update", 403: "doesn't list this box in BOXES yet"}.get(ex.code, f"error {ex.code}")
    except Exception:  # noqa: BLE001 - refused, timed out, bad JSON: all just "not reachable"
        err = "not reachable"
    with peers_lock:
        p = PEERS.get(name)
        if not p or p["ip"] != ip:
            return
        p.update(busy=False, err=err)
        if data:
            p.update(data=data, seen=time.time())


def peers_tick():
    """Re-read BOXES (no restart needed after `box friends boxes`) and ask every other box once."""
    cur = sb.boxes(sb.load_config())
    todo = []
    with peers_lock:
        BOX_LIST[:] = list(cur.items())
        PEER_IPS.clear()
        PEER_IPS.update(cur.values())
        for n in list(PEERS):
            if PEERS[n]["ip"] != cur.get(n):
                del PEERS[n]
        for n, ip in cur.items():
            if ip == SELF_IP:
                continue
            p = PEERS.setdefault(n, {"ip": ip, "data": None, "seen": 0, "err": "", "busy": False})
            if not p["busy"]:
                p["busy"] = True
                todo.append((n, ip))
    for n, ip in todo:
        threading.Thread(target=fetch_peer, args=(n, ip), daemon=True).start()


def peers_loop():
    while True:
        try:
            peers_tick()
        except Exception as ex:  # noqa: BLE001
            print(f"peers: {ex!r}", file=sys.stderr, flush=True)
        time.sleep(PEER_EVERY)


def peer_allowed(ip):
    ip = ip[7:] if ip.startswith("::ffff:") else ip
    with peers_lock:
        return ip in ("127.0.0.1", "::1") or ip == SELF_IP or ip in PEER_IPS


