        style = "" if primary else ' style="background:#252b35;color:var(--fg)"'
        return f"""<form method="post" action="/me" style="display:inline">
<input type="hidden" name="token" value="{tok}"><input type="hidden" name="action" value="{action}">
<input type="hidden" name="key" value="{e(key)}">{extra}<button{style}>{e(label)}</button></form>"""

