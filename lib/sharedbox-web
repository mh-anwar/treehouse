            load = (f'<div class="m"><h4>Load</h4><div class="mv">{d["load1"]:.1f} <small>for {ncpu} cores</small></div>'
                    f'<div class="sub">{word[:1].upper() + word[1:]}. Under {ncpu}, no program waits for the CPU.</div></div>')
        else:
            load = '<div class="m"><h4>Load</h4><div class="mv mut">–</div></div>'
