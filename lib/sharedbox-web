              "invite": ("people", "invite"), "hackathon": ("settings", "hackathon"),
              "telegram-setup": ("settings", "telegram-setup"), "request-update": ("settings", "update")}
CARD_RE = re.compile(r"[a-z][a-z-]{0,30}")


def page_tabs(owner=False, boxes=True):
    """[(key, label)] in the tab bar. boxes=False: the owner has no other boxes, so no Boxes tab."""
    return FRIEND_TABS + (tuple((k, v) for k, v in ADMIN_TABS if k != "boxes" or boxes) if owner else ())


def resolve_tab(tab, owner=False, nreq=0, boxes=True):
    """The tab to show for ?tab=: unknown or someone else's tab -> Home. "admin" (old links to the owner's admin
    area) -> Requests when some are open, else Friends."""
    if owner and tab == "admin":
        return "requests" if nreq else "people"
    return tab if tab in dict(page_tabs(owner, boxes)) else "home"


def place_of(res, owner=False):
    """(tab, card) for a button's result, from what was pressed. Logins land in the start card, except GitHub
    (an Account row)."""
    view, key = str((res or {}).get("_view") or ""), str((res or {}).get("key") or "")
    if view in VIEW_PLACE:
        return VIEW_PLACE[view]
    if view.startswith("request-"):
        return "requests", "requests"
    if view in ("login", "code", "check") and key == "gh":
        return "account", "account"
    return "home", "start"


def result_place(res, form=None, owner=False):
    """(tab, card): the card the button was pressed in when the page said so (_tab/_card, sent by its script),
    else where that kind of result goes."""
    form = form or {}
    t, c = str(form.get("_tab") or ""), str(form.get("_card") or "")
    if CARD_RE.fullmatch(c) and t in dict(page_tabs(owner)):
        return t, c
    return place_of(res, owner)


def redirect_url(base, fid, tab, card):
    """Post/redirect/get without JavaScript: back to the same tab, scrolled to the card that shows the result."""
    return f"{base}/me?r={fid}&tab={tab}" + (f"#{card}" if card and CARD_RE.fullmatch(card) else "")


def flash_put(who_id, result, card):
    now = time.time()
    for k in [k for k, v in FLASH.items() if now - v[0] > 900]:
        FLASH.pop(k, None)
    fid = secrets.token_urlsafe(9)
    FLASH[fid] = (now, who_id, result, card)
    return fid


def flash_get(fid, who_id):
    """(result, card) stored by flash_put for this person, else (None, "")."""
    fl = FLASH.get(fid or "")
    return (fl[2], fl[3]) if fl and fl[1] == who_id else (None, "")


class Slot:
    """The result area at the top of each card: empty, except in the card the button was pressed in."""

    def __init__(self, card="", body=""):
        self.card, self.body, self.used = card, body, False

    def __call__(self, cid):
        if cid == self.card and self.body and not self.used:
            self.used = True
            return f"<div class='out' data-out>{self.body}</div>"
        return "<div class='out' data-out></div>"


NO_SLOT = Slot()


