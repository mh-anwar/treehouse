def box_section(n_events=30, btn=None):
    """Friends, invites, Cloudflare seats, everything that happened. Only ever rendered for the owner;
    read from world-readable state files (and the gate's invite records, which this process may read)."""
    e = html.escape
    now = time.time()
    out = ['<div class="dash-h" id="box"><h2>The box</h2><span class="sub">only you see this</span></div>']
    users = sb.registry().get("users") or {}
    usage = (sb.read_json(sb.USAGE, {}) or {}).get("users") or {}
    rows = metrics_tail(RANGES["7d"])
    step = sample_step(rows)
    # -- tiles: people, invites, Cloudflare seats
    inv_dir = os.path.join(sb.GATE_DIR, "invites")
    can_read = os.access(inv_dir, os.R_OK | os.X_OK)
    open_inv = sum(1 for _, r in sb.gate_records("invites") if float(r.get("expires", 0) or 0) > now)
    active = sum(1 for r in users.values() if isinstance(r, dict) and r.get("status", "active") == "active")
    tiles = [("Friends", f"{len(users)}", f"{active} active" if active != len(users) else "all active"),
             ("Open invites", f"{open_inv}" if can_read else "?", "unused, not expired" if can_read else
              "can't read the invite records")]
    if CF:
        limit = sb.cfg_int(CFG, "CF_SEAT_LIMIT")
        n = len(allowed_emails())
        pct = min(100, 100 * n / limit) if limit else 0
        color = "var(--bad)" if pct > 90 else "var(--warn)" if pct > 70 else "var(--acc)"
        tiles.append(("Cloudflare allow list", f"{n}<small> of {limit}</small>",
                      f'<div class="bar"><i style="width:{pct:.1f}%;background:{color}"></i></div>'
                      '<div class="sub" style="margin-top:6px">counted from accounts and invites; for the exact list, '
                      'ask your agent: <b>show the Cloudflare allow list</b> (<code>box friends access</code>)</div>'))
    out.append('<div class="tiles">' + "".join(
        f'<div class="tile"><h3>{e(h)}</h3><div class="v">{v}</div>'
        + (sub if sub.startswith("<") else f'<div class="sub">{e(sub)}</div>') + "</div>"
        for h, v, sub in tiles) + "</div>")
    # -- friends
    if users:
        trs = []
        for name in sorted(users):
            r = users[name] if isinstance(users[name], dict) else {}
            u = usage.get(name) or {}
            stt = str(r.get("status") or "active")
            seen = last_active(rows, name, step)
            if seen and now - seen < 3 * max(step, 60):
                on = '<span class="dot ok"></span>active now'
            elif seen:
                on = f'<span class="dot"></span>{e(ago_text(seen))}'
            else:
                on = '<span class="dot"></span><span class="mut">not this week</span>'
            svcs = [x for x in u.get("services") or [] if isinstance(x, dict)]
            running = sum(1 for x in svcs if x.get("state") == "running")
            disk = (e(sb.human(u["disk"])) + (f' <span class="mut">/ {e(sb.human(u["budget"]))}</span>'
                                               if u.get("budget") else "")) if u.get("disk") is not None else "–"
            try:
                joined = time.strftime("%b %d, %Y", time.localtime(float(r.get("created"))))
            except (TypeError, ValueError):
                joined = "?"
            over = ' <span class="pill bad">over disk budget</span>' if u.get("over") else ""
            trs.append(f'<tr><td><b>{e(name)}</b>{over}'
                       f'</td><td class="mut">{e(str(r.get("email") or "–"))}</td><td class="num">{e(joined)}</td>'
                       f'<td><span class="pill {"ok" if stt == "active" else "bad"}">{e(stt)}</span></td>'
                       f'<td class="num">{disk}</td><td class="num">{len(svcs)}'
                       f'{f" <span class=mut>({running} running)</span>" if svcs else ""}</td>'
                       f'<td class="num">{on}</td></tr>')
        out.append('<div style="overflow-x:auto"><table><thead><tr><th>username</th><th>email</th><th>joined</th>'
                   '<th>status</th><th>disk</th><th>services</th><th>online</th></tr></thead><tbody>'
                   + "".join(trs) + "</tbody></table></div>")
    else:
        out.append("<p class='mut'>Nobody has joined yet.</p>")
    out.append('<p class="sub">To invite someone, ask your agent: <b>invite sam@example.com</b> (it runs '
               '<code>box invite --email sam@example.com</code> and gives you a message to send them). '
               'To remove, suspend or link an email, ask it too (<code>box friends</code>).</p>')
    try:
        out.append(requests_section(btn))
    except Exception as ex:  # noqa: BLE001
        print(f"requests section: {ex!r}", file=sys.stderr, flush=True)
    # -- every event, newest first; runs of the same kind+user fold into one line
    evs, folded = list(reversed(sb.recent_events(200))), []
    for ev in evs:
        if not isinstance(ev, dict):
            continue
        key = (ev.get("kind"), ev.get("user"))
        if folded and folded[-1][0] == key and ev.get("kind") in ("balance", "janitor_error"):
            folded[-1][2] += 1
            continue
        folded.append([key, ev, 1])
        if len(folded) >= n_events:
            break
    out.append("<h2>Box events</h2><ul class='ev'>" + ("".join(
        f"<li><span class='mut'>{e(ago_text(ev.get('ts', 0)))}</span> · {event_text(ev)}"
        + (f" <span class='pill'>×{cnt}</span>" if cnt > 1 else "") + "</li>" for _, ev, cnt in folded)
        or "<li class='mut'>nothing yet</li>") + "</ul>")
    return "".join(out)


