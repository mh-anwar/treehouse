#!/usr/bin/python3 -I
"""sharedbox-tune: make the box itself efficient (kernel, memory, disk, network), and say what's left.

  sharedbox-tune check [--json]   read-only report; any user (agents run it as `box tune`)
  sharedbox-tune apply [--install] root: the runtime settings a sysctl file can't hold (swap, zswap, the
                                  hardware watchdog, earlyoom's config). Run by install.sh (with --install: may
                                  also install the earlyoom package) and at every boot (sharedbox-tune.service)

Two kinds of findings:
  "treehouse"  every box should have it: the repo ships it (etc/sysctl-*.conf, `apply` below) and an update
               applies it. If one shows up as not applied, the install is old or something overrode it.
  "owner"      depends on this machine (a desktop service the owner may use, swap size, CPU power mode): a
               suggestion for the owner to decide. Agents never switch these on their own.

Adding a check: measure first, then add it to CHECKS. If it helps every box, ship the setting too (a line in
etc/sysctl-*.conf or a step in `apply`), so `check` and the install agree.
"""

import argparse
import glob
import json
import re
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
SYSCTL_INSTALLED = "/etc/sysctl.d/60-sharedbox-*.conf"
SYSCTL_REPO = os.path.join(os.path.dirname(HERE), "etc", "sysctl-*.conf")  # running from a checkout


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def sysctl_path(key):
    return "/proc/sys/" + key.replace(".", "/")


def shipped_sysctls():
    """{key: (value, file, why)} from treehouse's sysctl files: the installed ones, plus a checkout's own when run
    from one (so a setting added to the repo shows up as missing before it's deployed)."""
    files = sorted(glob.glob(SYSCTL_INSTALLED)) + sorted(glob.glob(SYSCTL_REPO))
    out = {}
    for fn in files:
        why = []
        for line in read(fn).splitlines():
            line = line.strip()
            if line.startswith("#"):
                why.append(line.lstrip("# "))
                continue
            if not line:
                why = []
                continue
            if "=" in line:
                k, v = (x.strip() for x in line.split("=", 1))
                out[k] = (" ".join(v.split()), os.path.basename(fn), " ".join(why))
    return out, files


def systemd_active(unit):
    try:
        return subprocess.run(["systemctl", "is-active", "--quiet", unit], timeout=10).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def systemd_enabled(unit):
    try:
        return subprocess.run(["systemctl", "is-enabled", "--quiet", unit], timeout=10).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def finding(name, ok, now, want, why, kind):
    return {"name": name, "ok": bool(ok), "now": str(now), "want": str(want), "why": why, "kind": kind}


# ---------- checks ----------

def check_sysctls():
    want, files = shipped_sysctls()
    if not files:
        return [finding("treehouse kernel settings", False, "not installed", "/etc/sysctl.d/60-sharedbox-*.conf",
                        "the box predates them: update treehouse", "treehouse")]
    out = []
    for k, (v, fn, why) in sorted(want.items()):
        now = " ".join(read(sysctl_path(k), "?").split())
        out.append(finding(k, now == v, now, v, why or fn, "treehouse"))
    return out


ZSWAP = "/sys/module/zswap/parameters"


def check_memory():
    out = []
    swaps = [ln.split()[0] for ln in read("/proc/swaps").splitlines()[1:] if ln.split()]
    mem_kb = next((int(ln.split()[1]) for ln in read("/proc/meminfo").splitlines() if ln.startswith("MemTotal:")), 0)
    out.append(finding("swap", bool(swaps), ", ".join(swaps) or "none", f"a swap file (~{min(8, max(2, mem_kb // 2 // 2**20))} GB)",
                       "without swap, a memory spike kills programs instead of slowing them; with zswap on, "
                       "swap is mostly compressed RAM and rarely touches the disk. Treehouse makes one when there's "
                       "none and the disk has room (TUNE_SWAP=0 turns that off)", "treehouse"))
    if os.path.isdir(ZSWAP):
        en = read(f"{ZSWAP}/enabled")
        comp = read(f"{ZSWAP}/compressor")
        out.append(finding("zswap (compressed memory before swap)", en == "Y" or not swaps,
                           f"{en} ({comp})", "Y (zstd or lz4)",
                           "idle memory is compressed (~3x) instead of written to disk: a full box slows down "
                           "gently instead of freezing", "treehouse"))
    thp = read("/sys/kernel/mm/transparent_hugepage/enabled")
    cur = thp.split("[")[1].split("]")[0] if "[" in thp else thp
    out.append(finding("transparent hugepages", cur != "always", cur, "madvise",
                       "'always' wastes memory and causes stalls with many small processes (agents, node)", "owner"))
    return out


def check_disk():
    out = []
    ssd = any(read(f"{d}/queue/rotational") == "0" for d in glob.glob("/sys/block/*")
              if not os.path.basename(d).startswith(("loop", "sr", "zram", "ram")))
    if ssd:
        out.append(finding("fstrim.timer (SSD trim, weekly)", systemd_enabled("fstrim.timer"),
                           "enabled" if systemd_enabled("fstrim.timer") else "off", "enabled",
                           "an untrimmed SSD gets slower as it fills", "owner"))
    return out


# services a server rarely needs; each is the owner's call (a desktop box may use them)
DESKTOP_LEFTOVERS = {
    "gdm.service": "a login screen; holds a desktop session's memory on a box nobody sits at",
    "sddm.service": "a login screen (see gdm)",
    "lightdm.service": "a login screen (see gdm)",
    "cups.service": "printing",
    "cups-browsed.service": "finds network printers",
    "avahi-daemon.service": "announces the box on the local network",
    "bluetooth.service": "Bluetooth",
    "ModemManager.service": "mobile modems",
    "packagekit.service": "a GUI software center's backend",
    "whoopsie.service": "crash reports to Canonical",
    "kerneloops.service": "kernel crash reports",
    "colord.service": "screen color profiles",
    "upower.service": "battery and power info for laptops",
    "rsyslog.service": "writes every log line a second time (journald already keeps them); keep it if something "
                       "reads /var/log/syslog",
}


# what `box tune disable|enable` (owner only) may switch; nothing else
SWITCHABLE = set(DESKTOP_LEFTOVERS) | {"wpa_supplicant.service"}


def wireless_in_use():
    for d in glob.glob("/sys/class/net/*"):
        if os.path.isdir(os.path.join(d, "wireless")) and read(os.path.join(d, "operstate")) == "up":
            return True
    return False


def check_services():
    out = []
    running = [u for u in DESKTOP_LEFTOVERS if systemd_active(u)]
    if systemd_active("wpa_supplicant.service") and not wireless_in_use():
        running.append("wpa_supplicant.service")
    why = "; ".join(f"{u.removesuffix('.service')}: {DESKTOP_LEFTOVERS.get(u, 'Wi-Fi, but no Wi-Fi link is up')}"
                    for u in running)
    out.append(finding("services a server rarely needs", not running, ", ".join(running) or "none", "none",
                       (why + ". Turn off only what the owner confirms nobody uses: `box tune disable NAME` "
                        "(owner's account, no sudo; `box tune enable NAME` undoes it)") if running else "", "owner"))
    return out


def check_cpu():
    gov = read("/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor")
    epp = read("/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference")
    if not gov:
        return []
    slow = gov == "powersave" and epp in ("power", "balance_power")
    return [finding("CPU power mode", not slow, gov + (f" / {epp}" if epp else ""),
                    "schedutil, or powersave with balance_performance",
                    "a battery-saving mode makes every build and agent turn slower", "owner")]


def check_network():
    out = []
    try:
        st = json.loads(subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True,
                                       timeout=10).stdout or "{}")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        st = {}
    relayed = [p.get("HostName", "?") for p in (st.get("Peer") or {}).values()
               if p.get("Online") and p.get("Active") and not p.get("CurAddr") and p.get("Relay")]
    if st:
        out.append(finding("Tailscale direct connections", not relayed, ", ".join(relayed) + " relayed" if relayed
                           else "all direct", "all direct",
                           "relayed devices go through a Tailscale server (slower, capped): usually a strict router "
                           "or firewall on that side; UDP 41641 open on this box's router helps", "owner"))
    return out


def wired_ports():
    """Physical wired ports (en*, backed by a device)."""
    try:
        return sorted(n for n in os.listdir("/sys/class/net") if n.startswith("en")
                      and os.path.exists(f"/sys/class/net/{n}/device"))
    except OSError:
        return []


def wired_config(port):
    """(has a DHCP or static config, what manages it) for one wired port: systemd-networkd's .network file for it,
    else NetworkManager's view."""
    try:
        r = subprocess.run(["networkctl", "status", "--no-pager", port], capture_output=True, text=True, timeout=10)
        m = re.search(r"Network File:\s*(\S+)", r.stdout)
        if m and m.group(1) not in ("n/a", "-"):
            text = read(m.group(1))
            if not text:  # 0640 root:systemd-network: as a user, go by what networkd reports for the port
                return ("(configured)" in r.stdout or "DHCPv4" in r.stdout or "DHCPv6" in r.stdout), m.group(1)
            ok = bool(re.search(r"^\s*(DHCP=(yes|ipv4|ipv6|true)|Address=)", text, re.M | re.I))
            return ok, m.group(1)
    except (OSError, subprocess.TimeoutExpired):
        pass
    try:
        r = subprocess.run(["nmcli", "-t", "-g", "GENERAL.STATE", "device", "show", port], capture_output=True,
                           text=True, timeout=10)
        if r.returncode == 0 and r.stdout.strip() and "unmanaged" not in r.stdout:
            return True, "NetworkManager"
    except (OSError, subprocess.TimeoutExpired):
        pass
    return False, "no config"


def check_wired():
    out = []
    for port in wired_ports():
        ok, how = wired_config(port)
        out.append(finding(f"wired port {port} gets an address by itself", ok, how if ok else "no DHCP config",
                           "DHCP (/etc/netplan/90-treehouse-wired.yaml)",
                           "plugging a cable in should just work on any port; a config pinned to another machine's "
                           "MAC address leaves the port dead. Updating treehouse installs the wired-port config",
                           "treehouse"))
    return out


# ---------- network self-recovery (sharedbox-netguard) ----------

NETGUARD_RECENT_S = 7 * 86400


def netguard():
    """sharedbox-netguard loaded as a module (installed next to this file, or the checkout's lib/)."""
    import importlib.machinery
    import importlib.util
    path = os.path.join(HERE, "sharedbox-netguard")
    loader = importlib.machinery.SourceFileLoader("sbnetguard", path)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("sbnetguard", loader))
    loader.exec_module(mod)
    return mod


def netguard_status():
    try:
        return netguard().status()
    except Exception:  # noqa: BLE001 - an old install without it: the check says so
        return None


def check_netguard(status=None, now=None):
    import time
    s = status if status is not None else netguard_status()
    now = now or time.time()
    if s is None:
        return [finding("net-guard (brings the network back by itself)", False, "not installed", "running",
                        "the install predates it: update treehouse", "treehouse")]
    out = [finding("net-guard (brings the network back by itself)", s["timer"] or not s["on"],
                   "running" if s["timer"] else ("off (NET_GUARD=0)" if not s["on"] else "not running"),
                   "running (sharedbox-netguard.timer)",
                   "a pulled cable or dongle, a wedged Wi-Fi driver or a router outage should heal without anyone "
                   "at the keyboard: it re-applies the network, restarts networkd/Tailscale, re-plugs the dongle, and "
                   "reboots only after 20 min with no working link", "treehouse")]
    st = s.get("state") or {}
    if s["wifi"] == "netplan":
        ws = st.get("wifi_setup") or {}
        why = ("a different or replaced USB dongle gets no Wi-Fi, because the config names one dongle's MAC "
               "address. Updating treehouse moves it to the any-dongle config")
        if ws.get("ok") is False:
            why = f"moving it failed ({ws.get('why')}); {why}. `sudo sharedbox-netguard wifi-setup --retry`"
        out.append(finding("Wi-Fi works with any USB dongle", False, "pinned to " + ", ".join(s["pinned"]),
                           "any dongle (/etc/systemd/network/80-sharedbox-wifi.network)", why, "treehouse"))
    elif s["wifi"] == "treehouse":
        out.append(finding("Wi-Fi works with any USB dongle", True, "any dongle", "any dongle", "", "treehouse"))
    metrics = {k: [ln["metric"] for ln in s["links"].values() if ln["kind"] == k and ln["metric"] is not None]
               for k in ("wired", "wifi")}
    if metrics["wired"] and metrics["wifi"]:
        ok = min(metrics["wired"]) < min(metrics["wifi"])
        out.append(finding("cable preferred over Wi-Fi", ok, f"route metric wired {min(metrics['wired'])}, Wi-Fi "
                           f"{min(metrics['wifi'])}", "wired lower (100 vs 600)",
                           "with both in, traffic should take the cable, and the Wi-Fi take over when it's pulled",
                           "treehouse"))
    if st.get("down_since"):
        out.append(finding("network", False, f"down for {int((now - st['down_since']) // 60)} min: {st.get('links')}",
                           "up", "net-guard is working on it (`sharedbox-netguard status`)", "owner"))
    rb = st.get("last_reboot") or {}
    if rb.get("ts") and now - rb["ts"] < NETGUARD_RECENT_S:
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(rb["ts"]))
        out.append(finding("net-guard rebooted the box", False, f"{when}: {rb.get('reason', '?')}", "no reboots",
                           "the network was down with no working link for a long time and nothing else brought it "
                           "back. Once is fine; if it repeats, check the dongle (or use a cable), the router and "
                           "`box telemetry`", "owner"))
    return out


def network_lines(s):
    """`box tune`'s Network block: links, Wi-Fi setup, net-guard's state and last action."""
    import time
    if not s:
        return []
    lines = []
    for n, ln in s["links"].items():
        lines.append(f"  {n} ({'Wi-Fi' if ln['kind'] == 'wifi' else 'wired'}): "
                     + ("connected" if ln["carrier"] else "no link")
                     + (f", {', '.join(ln['ipv4'])}" if ln["ipv4"] else "")
                     + (f", route metric {ln['metric']}" if ln["metric"] is not None else ""))
    w = {"treehouse": "any USB dongle", "": "not configured"}.get(s["wifi"]) \
        or "pinned to " + ", ".join(s["pinned"]) + " (MAC-named; another dongle gets no Wi-Fi)"
    lines.append(f"  Wi-Fi config: {w}")
    st = s.get("state") or {}
    g = "on" if s["timer"] else ("off (NET_GUARD=0)" if not s["on"] else "not running")
    la = st.get("last_action")
    if la:
        g += f"; last action {time.strftime('%Y-%m-%d %H:%M', time.localtime(la['ts']))}: {la['action']}" \
             f" ({la['detail']})"
    else:
        g += "; no action needed so far"
    lines.append(f"  net-guard: {g}")
    return lines


def check_account():
    """This account's own setup (the agent may fix these itself; they're the user's files, kept with a backup)."""
    if os.geteuid() == 0:
        return []
    import time
    times = []
    for _ in range(3):
        t = time.monotonic()
        subprocess.run(["bash", "-lc", "true"], capture_output=True, timeout=30)
        times.append((time.monotonic() - t) * 1000)
    ms = sorted(times)[1]
    return [finding("your shell start (every agent command pays it)", ms < 60, f"{ms:.0f} ms", "under 30 ms",
                    "`box tune shell` fixes slow nvm loading; for anything else see `box help lean`", "account")]


# ---------- no-freeze: a frozen box restarts by itself (owners often can't reach the power button) ----------

WATCHDOG_SYS = "/sys/class/watchdog/watchdog0"
LAST_BOOT = "/var/lib/sharedbox/health/last-boot.json"   # written by sharedbox-health (root: reads the journal)
UNCLEAN_BOOTS = {"watchdog": "the hardware watchdog restarted it (the box had frozen)",
                 "panic": "the kernel crashed (panic) and restarted it",
                 "unclean": "it stopped without shutting down: a freeze the watchdog caught, a power cut or the "
                            "reset button"}


def virt():
    """'' on real hardware, else what systemd-detect-virt names (kvm, lxc, docker, ...)."""
    try:
        r = subprocess.run(["systemd-detect-virt"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    out = r.stdout.strip()
    return "" if r.returncode or out == "none" else out


def systemd_runtime_watchdog():
    """Seconds PID 1 pings the hardware watchdog at (0 = off)."""
    try:
        out = subprocess.run(["systemctl", "show", "-p", "RuntimeWatchdogUSec", "--value"], capture_output=True,
                             text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return 0
    return usec_seconds(out)


def usec_seconds(v):
    """systemd prints RuntimeWatchdogUSec as '0', '1min', '30s', '1min 30s' or 'infinity'."""
    v = (v or "").strip()
    if not v or v == "0":
        return 0
    if v == "infinity":
        return 1
    total, units = 0, {"us": 1e-6, "ms": 1e-3, "s": 1, "min": 60, "h": 3600}
    for part in v.split():
        num = part.rstrip("abcdefghijklmnopqrstuvwxyz")
        try:
            total += float(num) * units.get(part[len(num):] or "s", 1)
        except ValueError:
            return 0
    return int(total)


WATCHDOG_DAEMONS = ("watchdog.service", "wd_keepalive.service")


def check_nofreeze():
    out = []
    ident = read(f"{WATCHDOG_SYS}/identity")
    daemon = next((u for u in WATCHDOG_DAEMONS if systemd_active(u)), "")
    secs = systemd_runtime_watchdog()
    v = virt()
    if daemon:
        out.append(finding("hardware watchdog (restarts a frozen box)", True, f"{ident or '?'}, run by {daemon}",
                           "armed", "", "treehouse"))
    elif not ident:
        out.append(finding("hardware watchdog (restarts a frozen box)", bool(v), f"none ({v})" if v else "none",
                           "armed", "" if v else
                           "no watchdog device: this board has none treehouse knows (Intel boards: iTCO_wdt), or "
                           "the install predates it: update treehouse", "treehouse"))
    else:
        out.append(finding("hardware watchdog (restarts a frozen box)", secs > 0,
                           f"{ident}, " + (f"pinged by systemd every {secs}s" if secs else "not armed"),
                           "armed by systemd (RuntimeWatchdogSec=60s)",
                           "if the whole system hangs, even the kernel, the board itself resets it after a minute",
                           "treehouse"))
    eo = tune_setting("TUNE_EARLYOOM", "auto")
    off = eo in ("0", "no", "off")
    on = systemd_active("earlyoom.service")
    out.append(finding("earlyoom (stops the biggest job before memory runs out)", on or off,
                       "running" if on else ("off (TUNE_EARLYOOM=0)" if off else "not running"), "running",
                       "when RAM runs out the kernel can thrash for many minutes before its own OOM killer acts; "
                       "earlyoom stops a heavy build first, never agents, ssh or T3 (/etc/default/earlyoom)",
                       "treehouse"))
    lb = read_json_file(LAST_BOOT)
    if lb.get("reason") in UNCLEAN_BOOTS:
        out.append(finding("last restart", False, f"{lb.get('when', '?')}: {lb['reason']}", "a clean shutdown",
                           UNCLEAN_BOOTS[lb["reason"]] + ". Once is fine; if it repeats, look at temperatures, the "
                           "disk (SMART) and the RAM; the weekly health email has the last log lines", "owner"))
    return out


def read_json_file(path):
    try:
        with open(path) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


CHECKS = [check_sysctls, check_memory, check_nofreeze, check_disk, check_cpu, check_services, check_network, check_wired,
          check_netguard, check_account]


def run_checks():
    out = []
    for c in CHECKS:
        try:
            out += c()
        except Exception as e:  # one broken check must not hide the others
            out.append(finding(c.__name__, False, f"check failed: {e}", "", "", "treehouse"))
    return out


def cmd_check(a):
    res = run_checks()
    if a.json:
        print(json.dumps(res, indent=2))
        return
    todo_t = [r for r in res if not r["ok"] and r["kind"] == "treehouse"]
    todo_o = [r for r in res if not r["ok"] and r["kind"] == "owner"]
    todo_a = [r for r in res if not r["ok"] and r["kind"] == "account"]
    print(f"Box tuning: {sum(r['ok'] for r in res)}/{len(res)} as recommended.")
    if todo_t:
        print("\nShould already be set by treehouse (update treehouse; if it stays, something overrides it):")
        for r in todo_t:
            print(f"  - {r['name']}: {r['now']} (want {r['want']}). {r['why']}")
    if todo_o:
        print("\nFor the owner to decide (suggest; never change these yourself):")
        for r in todo_o:
            print(f"  - {r['name']}: {r['now']} (suggested {r['want']}). {r['why']}")
    if todo_a:
        print("\nThis account (fix it, then tell the user in a line):")
        for r in todo_a:
            print(f"  - {r['name']}: {r['now']} (want {r['want']}). {r['why']}")
    if not todo_t and not todo_o and not todo_a:
        print("Nothing to do. Look further: `box help tune`.")
    net = network_lines(netguard_status())
    if net:
        print("\nNetwork (`box help network`):")
        print("\n".join(net))


# ---------- apply (root) ----------

def apply_zswap():
    if not os.path.isdir(ZSWAP) or not read("/proc/swaps").splitlines()[1:]:
        return "zswap: no swap, skipped"
    for comp in ("zstd", "lz4", "lzo-rle", "lzo"):
        try:
            with open(f"{ZSWAP}/compressor", "w") as f:
                f.write(comp)
            break
        except OSError:
            continue
    with open(f"{ZSWAP}/enabled", "w") as f:
        f.write("Y")
    return f"zswap: on ({read(f'{ZSWAP}/compressor')})"


SWAPFILE = "/swap.treehouse"


def tune_setting(key, default="auto"):
    try:
        sys.path.insert(0, os.environ.get("SHAREDBOX_LIB", HERE))
        import sbcommon as sb
        return str(sb.load_config().get(key, default)).strip().lower()
    except Exception:
        return default


def tune_swap_setting():
    return tune_setting("TUNE_SWAP")


def apply_swap():
    """No swap at all: make one (zswap needs it, and without any a memory spike kills programs). Sized
    min(8 GB, max(2 GB, RAM/2)); only with plenty of free disk; TUNE_SWAP=0 in sharedbox.conf turns it off.
    Our own file is switched on again at every boot (no /etc/fstab edit)."""
    setting = tune_swap_setting()
    active = [ln.split()[0] for ln in read("/proc/swaps").splitlines()[1:] if ln.split()]
    if os.path.exists(SWAPFILE) and SWAPFILE not in active and setting != "0":
        subprocess.run(["swapon", SWAPFILE], check=False)
        return f"swap: {SWAPFILE} on"
    if active or setting in ("0", "no", "off"):
        return "swap: " + (", ".join(active) if active else "off (TUNE_SWAP=0)")
    mem = next((int(ln.split()[1]) * 1024 for ln in read("/proc/meminfo").splitlines()
                if ln.startswith("MemTotal:")), 0)
    size = min(8 << 30, max(2 << 30, mem // 2))
    st = os.statvfs("/")
    free, total = st.f_bavail * st.f_frsize, st.f_blocks * st.f_frsize
    if free < 4 * size or free - size < 0.2 * total:
        return f"swap: none, and not enough free disk to add {size >> 30} GB safely"
    fs = subprocess.run(["stat", "-fc", "%T", "/"], capture_output=True, text=True).stdout.strip()
    if fs == "btrfs":
        r = subprocess.run(["btrfs", "filesystem", "mkswapfile", "--size", f"{size >> 20}m", SWAPFILE],
                           capture_output=True, text=True)
    elif fs in ("ext2/ext3", "ext4", "xfs"):
        r = subprocess.run(["fallocate", "-l", str(size), SWAPFILE], capture_output=True, text=True)
        if r.returncode == 0:
            os.chmod(SWAPFILE, 0o600)
            r = subprocess.run(["mkswap", SWAPFILE], capture_output=True, text=True)
    else:
        return f"swap: none; {fs} isn't a filesystem treehouse makes swap files on"
    if r.returncode != 0:
        try:
            os.unlink(SWAPFILE)
        except OSError:
            pass
        return f"swap: couldn't make {SWAPFILE}: {(r.stderr or '').strip()[-200:]}"
    subprocess.run(["swapon", SWAPFILE], check=False)
    return f"swap: made {SWAPFILE} ({size >> 30} GB)"


# The hardware watchdog. Intel boards (iTCO_wdt: every Haswell-era OptiPlex/EliteDesk/ProDesk) have one, but
# Ubuntu blacklists the driver, and systemd-modules-load honours that blacklist, hence the `install` override.
# systemd (PID 1) then pings it; if even PID 1 or the kernel hangs, the board resets the machine.
WD_MODULE = "iTCO_wdt"
WD_MODULES_LOAD = "/etc/modules-load.d/sharedbox-watchdog.conf"
WD_MODPROBE = "/etc/modprobe.d/zz-sharedbox-watchdog.conf"
WD_SYSTEMD = "/etc/systemd/system.conf.d/60-sharedbox-watchdog.conf"
WD_RUNTIME, WD_REBOOT = 60, 300   # seconds: a hang resets after 1 min; a stuck shutdown after 5
MANAGED = "# managed by treehouse (sharedbox-tune apply)"
WD_FILES = {
    WD_MODULES_LOAD: f"{MANAGED}: load the hardware watchdog at boot\n{WD_MODULE}\n",
    WD_MODPROBE: f"{MANAGED}: Ubuntu blacklists the watchdog driver; systemd-modules-load honours blacklists\n"
                 f"install {WD_MODULE} /sbin/modprobe --ignore-install {WD_MODULE}\n",
    WD_SYSTEMD: f"{MANAGED}: systemd pings the hardware watchdog; a frozen box resets itself\n"
                f"[Manager]\nRuntimeWatchdogSec={WD_RUNTIME}s\nRebootWatchdogSec={WD_REBOOT // 60}min\n",
}
# The same settings, put in by hand on some boxes before treehouse shipped them: removed once ours are in place,
# and only when they hold exactly these lines (comments aside), so nothing an owner wrote is lost.
HAND_MADE = {
    "/etc/modules-load.d/watchdog.conf": ["iTCO_wdt"],
    "/etc/modprobe.d/zz-watchdog-allow.conf": ["install iTCO_wdt /sbin/modprobe --ignore-install iTCO_wdt"],
    "/etc/systemd/system.conf.d/watchdog.conf": ["[Manager]", "RuntimeWatchdogSec=60s", "RebootWatchdogSec=5min"],
    "/etc/sysctl.d/90-no-freeze.conf": ["kernel.panic = 10", "kernel.panic_on_oops = 1", "kernel.softlockup_panic = 1",
                                        "kernel.hardlockup_panic = 1"],
}


def content_lines(text):
    """Non-comment lines, `a=b` spacing normalised to `a = b` for sysctl files."""
    out = []
    for ln in text.splitlines():
        ln = ln.strip()
        if not ln or ln.startswith(("#", ";")):
            continue
        if "=" in ln and not ln.startswith("install "):
            k, v = ln.split("=", 1)
            ln = f"{k.strip()} = {v.strip()}" if "." in k else f"{k.strip()}={v.strip()}"
        out.append(ln)
    return out


def write_if_changed(path, body, mode=0o644):
    if read(path, None) == body.strip():
        return False
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".sbtmp"
    with open(tmp, "w") as f:
        f.write(body)
    os.chmod(tmp, mode)
    os.replace(tmp, path)
    return True


def remove_hand_made(paths=None):
    gone = []
    for path, want in (paths or HAND_MADE).items():
        text = read(path, None)
        if text is not None and content_lines(text) == content_lines("\n".join(want)):
            try:
                os.unlink(path)
                gone.append(path)
            except OSError:
                pass
    return gone


def watchdog_users():
    """PIDs other than systemd (PID 1) holding a watchdog device open: another daemon owns it."""
    pids = []
    for fd_dir in glob.glob("/proc/[0-9]*/fd"):
        pid = int(fd_dir.split("/")[2])
        if pid == 1:
            continue
        try:
            fds = os.listdir(fd_dir)
        except OSError:
            continue
        for fd in fds:
            try:
                if os.readlink(f"{fd_dir}/{fd}").startswith("/dev/watchdog"):
                    pids.append(pid)
                    break
            except OSError:
                continue
    return pids


def wait_for(path, secs=5.0):
    import time
    end = time.monotonic() + secs
    while not os.path.exists(path):
        if time.monotonic() > end:
            return False
        time.sleep(0.2)
    return True


def set_systemd_watchdog():
    """Arm it live (no reboot). systemd 249+ takes the setting over D-Bus; older ones re-read system.conf.d on
    daemon-reexec, which keeps every service running."""
    ok = True
    for prop, secs in (("RuntimeWatchdogUSec", WD_RUNTIME), ("RebootWatchdogUSec", WD_REBOOT)):
        r = subprocess.run(["busctl", "set-property", "org.freedesktop.systemd1", "/org/freedesktop/systemd1",
                            "org.freedesktop.systemd1.Manager", prop, "t", str(secs * 10**6)],
                           capture_output=True, text=True)
        ok = ok and r.returncode == 0
    if not ok:
        subprocess.run(["systemctl", "daemon-reexec"], check=False)
    return systemd_runtime_watchdog()


def apply_watchdog():
    if tune_setting("TUNE_WATCHDOG") in ("0", "no", "off"):
        return "watchdog: off (TUNE_WATCHDOG=0)"
    v = virt()
    if v and subprocess.run(["systemd-detect-virt", "--container", "-q"]).returncode == 0:
        return f"watchdog: inside a container ({v}), skipped"
    daemon = next((u for u in WATCHDOG_DAEMONS if systemd_active(u)), "") or \
        ("another program" if watchdog_users() else "")
    if daemon:
        return f"watchdog: {daemon} already runs it; left alone"
    loaded = ""
    if not os.path.exists(WATCHDOG_SYS):
        r = subprocess.run(["modprobe", "--ignore-install", WD_MODULE], capture_output=True, text=True)
        if r.returncode != 0 or not wait_for(WATCHDOG_SYS):
            for f in (WD_MODULES_LOAD, WD_MODPROBE):   # no such hardware: don't fail a module load every boot
                if os.path.exists(f):
                    os.unlink(f)
            return "watchdog: none on this machine" + (f" ({v})" if v else "") + ", skipped"
        loaded = f" (loaded {WD_MODULE})"
    ident = read(f"{WATCHDOG_SYS}/identity")
    changed = []
    files = dict(WD_FILES)
    if "iTCO" not in ident:   # some other driver is already loaded at boot: only the systemd part is ours
        files = {WD_SYSTEMD: WD_FILES[WD_SYSTEMD]}
    for path, body in files.items():
        if write_if_changed(path, body):
            changed.append(path)
    gone = remove_hand_made()
    secs = systemd_runtime_watchdog()
    if secs != WD_RUNTIME:
        secs = set_systemd_watchdog()
    return (f"watchdog: {ident or '?'}{loaded}, " + (f"armed (systemd pings it every {secs}s)" if secs else
                                                     "NOT armed: systemd didn't take RuntimeWatchdogSec")
            + (f"; wrote {', '.join(changed)}" if changed else "")
            + (f"; replaced hand-made {', '.join(gone)}" if gone else ""))


# earlyoom: stops the biggest heavy job (builds, tests, python) a few seconds before RAM runs out, never agents,
# ssh, T3 or system services. The kernel's own OOM killer acts only after minutes of thrashing, and systemd-oomd
# goes by memory pressure over 30 s; earlyoom is the fast last line. Same settings on every box.
EARLYOOM_CONF = "/etc/default/earlyoom"
EARLYOOM_ARGS = ("-m 8,4 -s 100,100 -r 600 -n "
                 "--prefer ^(python|python3|pytest|cargo|rustc|cc1plus|ld|dolt|java|node-worker)$ "
                 "--avoid ^(sshd|sshd-session|systemd|systemd-.*|tailscaled|t3|node|node-MainThread|claude|dockerd|"
                 "containerd|containerd-shim.*|earlyoom|bash|tmux.*|gc|deid|codex|claude.exe|opencode)$")
EARLYOOM_BODY = (f"{MANAGED}. Change TUNE_EARLYOOM in /etc/sharedbox/sharedbox.conf, or remove this line to keep\n"
                 "# your own settings here (treehouse then leaves the file alone).\n"
                 "# -m 8,4: stop a job at 8% RAM left (kill at 4%); -s 100,100: go by RAM only (swap here is mostly "
                 "zswap);\n# --prefer: heavy jobs go first; --avoid: never agents, ssh, T3, docker or systemd.\n"
                 f'EARLYOOM_ARGS="{EARLYOOM_ARGS}"\n')
EARLYOOM_PACKAGE_DEFAULTS = ("", "-r 3600", "-r 60")


def earlyoom_args(text):
    val = None
    for ln in (text or "").splitlines():
        ln = ln.strip()
        if ln.startswith("EARLYOOM_ARGS="):
            val = ln.split("=", 1)[1].strip().strip('"').strip("'")
    return val


def earlyoom_conf_ours(text):
    """May treehouse (re)write this file? Missing, the package's default, ours, or the same settings by hand."""
    if text is None or text.startswith(MANAGED):
        return True
    args = earlyoom_args(text)
    return args is None or args in EARLYOOM_PACKAGE_DEFAULTS or args == EARLYOOM_ARGS


def apply_earlyoom(install=False):
    import shutil
    if tune_setting("TUNE_EARLYOOM") in ("0", "no", "off"):
        return "earlyoom: off (TUNE_EARLYOOM=0)"
    if not shutil.which("earlyoom"):
        if not install:
            return "earlyoom: not installed (the next treehouse update installs it)"
        try:
            sys.path.insert(0, os.environ.get("SHAREDBOX_LIB", HERE))
            import sbdistro
            sbdistro.install(["earlyoom"])
        except Exception as e:  # noqa: BLE001 - unknown distro, no network: say so, the rest still applies
            return f"earlyoom: couldn't install it: {e}"
        if not shutil.which("earlyoom"):
            return "earlyoom: couldn't install it (see the package manager's output above)"
    text = read(EARLYOOM_CONF, None)
    changed = False
    if earlyoom_conf_ours(text):
        changed = write_if_changed(EARLYOOM_CONF, EARLYOOM_BODY)
        note = "treehouse settings"
    else:
        note = f"the owner's own settings in {EARLYOOM_CONF} (kept)"
    subprocess.run(["systemctl", "enable", "--now", "earlyoom.service"], capture_output=True)
    if changed:
        subprocess.run(["systemctl", "restart", "earlyoom.service"], capture_output=True)
    return f"earlyoom: {'running' if systemd_active('earlyoom.service') else 'NOT running'}, {note}" \
        + (" (updated)" if changed else "")


def cmd_apply(a):
    if os.geteuid() != 0:
        sys.exit("sharedbox-tune apply: needs root (install.sh and sharedbox-tune.service run it)")
    steps = (apply_swap, apply_zswap, apply_watchdog,   # swap first: zswap only does anything with swap
             lambda: apply_earlyoom(install=a.install))
    for step in steps:
        try:
            print(step())
        except (OSError, subprocess.SubprocessError) as e:
            print(f"{getattr(step, '__name__', 'step')}: {e}", file=sys.stderr)


def main():
    p = argparse.ArgumentParser(prog="sharedbox-tune", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    s = p.add_subparsers(dest="cmd", required=True)
    x = s.add_parser("check")
    x.add_argument("--json", action="store_true")
    x.set_defaults(fn=cmd_check)
    x = s.add_parser("apply")
    x.add_argument("--install", action="store_true", help="may install packages (earlyoom); install.sh passes it")
    x.set_defaults(fn=cmd_apply)
    a = p.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
