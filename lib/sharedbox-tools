#!/usr/bin/python3 -I
"""sharedbox-tools: system-wide toolchain for friends and their agents (root).

  sharedbox-tools install [--dry-run]    install everything enabled in sharedbox.conf
  sharedbox-tools update                 update the coding agents (+ uv); system packages are left to
                                         unattended-upgrades (Debian/Ubuntu) or the owner's pacman -Syu (Arch)
  sharedbox-tools add pkg|npm NAME...    install extra packages and remember them (e.g. for `box request`s)
  sharedbox-tools remove pkg|npm NAME... uninstall packages (also remove them from TOOLS_* in sharedbox.conf)
                                         `pkg` = the system package manager (apt or pacman); `apt` still works
  sharedbox-tools status                 installed versions (also written to /var/lib/sharedbox/tools.json)

Only installs packages. It never upgrades the whole system, restarts services, or touches the network config.

Coding agents (TOOLS_NPM) are kept per version in /opt/sharedbox/agents/<pkg>/<version>, installed with pnpm
(one hard-linked store, ~40% less disk than npm; npm is the fallback if pnpm can't be installed), and /usr/local/bin
has a small launcher per command that always follows <pkg>/current. A new version is installed next to the old
one and switched to atomically, so running sessions don't break mid-update.

Agents that aren't on npm (TOOLS_MANIFEST, e.g. Google's Antigravity CLI) use the same store: their vendor's update
manifest names the newest version, a tarball and its sha512; the tarball is checked, unpacked into its own version
directory and switched to the same way. Their own self-updaters are turned off in the launcher.
"""

import argparse
import hashlib
import hmac
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import traceback
import urllib.request
import zipfile

sys.path.insert(0, os.environ.get("SHAREDBOX_LIB", "/usr/lib/sharedbox"))
import sbcommon as sb  # noqa: E402
import sbdistro as distro  # noqa: E402

TOOLS_JSON = os.path.join(sb.STATE_DIR, "tools.json")
EXTRA = "/etc/sharedbox/tools.local"   # lines: "apt NAME" (Debian) / "pkg NAME" (Arch) / "npm NAME@VERSION" (pinned at `add`)
ANDROID_REPO = "https://dl.google.com/android/repository/"
NPM_PREFIX = "/usr/local"
# registry packages only (no git/url/file specs), optional version
NPM_SPEC = re.compile(r"(@[a-zA-Z0-9][\w.-]*/)?[a-zA-Z0-9][\w.-]*(@[\w.-]+)?")
SHIM_DIR = "/usr/local/bin"
SHIM_MARK = "# sharedbox agent shim"
VERSION_RE = re.compile(r"\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?")
KEEP_PREVIOUS = 1          # old versions kept after a switch, for sessions started just before it
# TOOLS_MANIFEST agents: name=https://...{arch}...json#binary[,alias...]; the first binary is the tarball's only member
MANIFEST = {}              # name -> {"url": manifest url, "bins": [...], "latest": {version, url, sha512}}
MANIFEST_ENTRY = re.compile(r"([a-z0-9][\w.-]*(?:/[a-z0-9][\w.-]*)?)=(https://[^\s#]+)"
                            r"#([A-Za-z0-9][\w.-]*(?:,[A-Za-z0-9][\w.-]*)*)")
MANIFEST_ARCH = {"x86_64": "amd64", "amd64": "amd64", "aarch64": "arm64", "arm64": "arm64"}
MANIFEST_MAX = 1 << 30     # the download is refused past 1 GiB (Antigravity 1.5 is ~100 MB packed, 270 MB unpacked)

# binary -> how to show it to users
KNOWN = [
    ("claude", "Claude Code"), ("codex", "OpenAI Codex"), ("gemini", "Gemini CLI"),
    ("opencode", "opencode"), ("node", "Node.js"), ("npm", "npm"), ("python3", "Python"),
    ("uv", "uv"), ("pipx", "pipx"), ("git", "git"), ("gh", "GitHub CLI"), ("tmux", "tmux"),
    ("rg", "ripgrep"), ("fdfind", "fd"), ("jq", "jq"), ("sqlite3", "sqlite3"), ("gcc", "gcc"),
    ("make", "make"), ("java", "Java"), ("go", "Go"), ("rustup", "rustup"),
    ("sdkmanager", "Android SDK"), ("xvfb-run", "Xvfb"), ("antigravity", "Antigravity CLI"),
]


def log(msg):
    print(f"==> {msg}", flush=True)


def run(cmd, dry, env=None, check=True):
    if dry:
        print("    would run: " + " ".join(cmd))
        return 0
    return subprocess.run(cmd, check=check, env=env).returncode


def words(cfg, key):
    return cfg.get(key, "").split()


def extras(kind):
    try:
        with open(EXTRA) as f:
            return [l.split()[1] for l in f if l.startswith(kind + " ") and len(l.split()) == 2]
    except FileNotFoundError:
        return []


# ---------- system packages (apt / pacman, see sbdistro) ----------

PKG_KINDS = ("pkg", "apt")   # "apt" is the old name, still accepted everywhere


def pkg_kind():
    """What `add pkg` records in tools.local: "apt" on Debian/Ubuntu (unchanged format), else "pkg"."""
    return "apt" if distro.current() == "debian" else "pkg"


def pkg_extras():
    """Extra system packages, native names. Old "apt NAME" lines are translated on Arch."""
    return distro.native_names(extras("apt") + extras("pkg"))


def system_packages(cfg):
    """TOOLS_APT (+ browser libs, + JDK) as native names. On Arch, TOOLS_PACMAN / TOOLS_PACMAN_BROWSER
    replace the translated Debian lists when set."""
    arch = distro.current() == "arch"
    base = words(cfg, "TOOLS_PACMAN") if arch and words(cfg, "TOOLS_PACMAN") else words(cfg, "TOOLS_APT")
    pkgs = list(base)
    if cfg.get("TOOLS_BROWSER_DEPS", "1") == "1":
        pkgs += (words(cfg, "TOOLS_PACMAN_BROWSER") if arch and words(cfg, "TOOLS_PACMAN_BROWSER")
                 else words(cfg, "TOOLS_APT_BROWSER"))
    if cfg.get("TOOLS_ANDROID", "0") == "1":
        pkgs += ["openjdk-21-jdk-headless"]
    return distro.native_names(pkgs) + pkg_extras()


def pkg_install(pkgs, dry):
    try:
        distro.install(pkgs, dry)
        return True
    except distro.Unsupported as e:
        print(f"    error: {e}\n    skipped: {' '.join(pkgs)}", file=sys.stderr)
        return False


# ---------- npm agents ----------

def npm_install(pkgs, dry, latest=False, scripts=True):
    """scripts=False for extras: requested by friends, so no install scripts run as root."""
    if not pkgs:
        return
    if not shutil.which("npm") and not dry:
        print("    npm missing; skipping npm packages", file=sys.stderr)
        return
    spec = [p + "@latest" if latest and "@" not in p[1:] else p for p in pkgs]
    run(["npm", "install", "-g", "--prefix", NPM_PREFIX, "--no-fund", "--no-audit"]
        + ([] if scripts else ["--ignore-scripts"]) + spec, dry, check=False)


def npm_name(spec):
    """'@scope/pkg@1.2' -> '@scope/pkg'"""
    i = spec.find("@", 1)
    return spec if i < 0 else spec[:i]


def npm_installed(name):
    pj = os.path.join(NPM_PREFIX, "lib", "node_modules", name, "package.json")
    v = (sb.read_json(pj, {}) or {}).get("version")
    return v if isinstance(v, str) and re.fullmatch(r"[\w.+-]+", v) else None


def npm_extras_pinned():
    """Extras as name@version. Unpinned legacy lines are pinned to what is installed now;
    if it isn't installed they are skipped, never pulled at @latest."""
    out = []
    for spec in extras("npm"):
        if "@" in spec[1:]:
            out.append(spec)
        elif npm_installed(spec):
            out.append(f"{spec}@{npm_installed(spec)}")
        else:
            print(f"    skipping npm extra {spec}: no pinned version; re-add it with "
                  "`sharedbox-tools add npm NAME`", file=sys.stderr)
    return out


# ---------- coding agents: versioned store ----------

def manifest_specs(cfg):
    """TOOLS_MANIFEST entries as {name: {"url", "bins"}}; malformed entries are skipped with a note."""
    out = {}
    for spec in words(cfg, "TOOLS_MANIFEST"):
        m = MANIFEST_ENTRY.fullmatch(spec)
        if not m:
            print(f"    skipping TOOLS_MANIFEST entry {spec!r}: expected name=https://...json#binary[,alias]",
                  file=sys.stderr)
            continue
        out[m.group(1)] = {"url": m.group(2), "bins": m.group(3).split(",")}
    return out


def agent_specs(cfg):
    """TOOLS_NPM + TOOLS_MANIFEST as [(name, wanted)], renamed npm packages mapped to their new name ("latest" unless
    pinned). Fills MANIFEST, which tells the other steps which agents aren't npm packages."""
    MANIFEST.clear()
    MANIFEST.update(manifest_specs(cfg))
    out = []
    for spec in words(cfg, "TOOLS_NPM"):
        name, _, wanted = spec[1:].partition("@") if spec.startswith("@") else spec.partition("@")
        name = ("@" + name) if spec.startswith("@") else name
        if name in sb.AGENT_RENAMED:
            log(f"{name} is now {sb.AGENT_RENAMED[name]} (renamed on npm); using that. "
                f"Update TOOLS_NPM in {sb.CONF_PATH} to drop this note.")
            name, wanted = sb.AGENT_RENAMED[name], ""
        if name == "t3" and not wanted:  # T3_CHANNEL: stable = npm's `latest`, nightly = its `nightly` tag
            wanted = "nightly" if sb.t3_channel(cfg) == "nightly" else "latest"
        if NPM_SPEC.fullmatch(name) and name not in MANIFEST:
            out.append((name, wanted or "latest"))
    return out + [(name, "latest") for name in MANIFEST]


def vkey(v):
    """Sortable key for a semver string; prereleases sort before the release."""
    m = re.match(r"(\d+)\.(\d+)\.(\d+)(-.*)?", v or "")
    return (tuple(int(x) for x in m.groups()[:3]), m.group(4) is None) if m else ((0, 0, 0), False)


def agent_root(name):
    return os.path.join(sb.AGENTS_DIR, sb.agent_slug(name))


def version_dir(name, ver):
    return os.path.join(agent_root(name), ver)


def installed_ok(name, ver):
    return os.path.exists(os.path.join(version_dir(name, ver), ".sharedbox-complete"))


def current_version(name):
    try:
        v = os.path.basename(os.readlink(os.path.join(agent_root(name), "current")))
    except OSError:
        return None
    return v if VERSION_RE.fullmatch(v) and installed_ok(name, v) else None


def manifest_arch():
    arch = MANIFEST_ARCH.get(platform.machine().lower())
    if not arch:
        raise RuntimeError(f"no build for this CPU ({platform.machine()})")
    return arch


def http_get(url, timeout=60):
    return urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "sharedbox-tools"}),
                                  timeout=timeout)


def manifest_latest(name):
    """The vendor manifest's newest {version, url, sha512}, checked: a plain version, an https tarball, a sha512."""
    url = MANIFEST[name]["url"].replace("{arch}", manifest_arch())
    with http_get(url) as r:
        data = json.loads(r.read(1 << 16) or b"null")
    if not isinstance(data, dict):
        raise RuntimeError(f"{url}: not a manifest")
    ver, tar, sha = (str(data.get(k) or "") for k in ("version", "url", "sha512"))
    sha = sha.lower()
    if not VERSION_RE.fullmatch(ver) or not tar.startswith("https://") or not re.fullmatch(r"[0-9a-f]{128}", sha):
        raise RuntimeError(f"{url}: unexpected manifest {json.dumps(data)[:200]}")
    MANIFEST[name]["latest"] = {"version": ver, "url": tar, "sha512": sha}
    return ver


def resolve_version(name, wanted):
    if name in MANIFEST:
        return manifest_latest(name)
    r = subprocess.run(["npm", "view", "--json", f"{name}@{wanted}", "version"],
                       capture_output=True, text=True, timeout=120)
    try:
        v = json.loads(r.stdout or "null")
    except ValueError:
        v = None
    if isinstance(v, list):  # a range matched several
        v = max(v, key=vkey) if v else None
    if not isinstance(v, str) or not VERSION_RE.fullmatch(v):
        raise RuntimeError(f"npm view {name}@{wanted} failed: {(r.stderr or r.stdout).strip()[-300:]}")
    return v


PNPM_STORE = os.path.join(sb.AGENTS_DIR, ".pnpm-store")
_pnpm = []


def pnpm():
    """pnpm for root (installed into /usr/local once), or None to fall back to npm. pnpm hard-links every
    file from one store, so versions that share files share disk (~40% less than npm for the agents)."""
    if not _pnpm:
        path = shutil.which("pnpm", path=f"{NPM_PREFIX}/bin:/usr/bin:/bin")
        if not path and shutil.which("npm"):
            log("installing pnpm (agents are stored with it to save disk)")
            subprocess.run(["npm", "install", "-g", "--prefix", NPM_PREFIX, "--no-fund", "--no-audit",
                            "pnpm@10"], check=False)
            path = shutil.which("pnpm", path=f"{NPM_PREFIX}/bin")
        if not path:
            print("    warning: pnpm unavailable; installing agents with npm (uses more disk)", file=sys.stderr)
        _pnpm.append(path)
    return _pnpm[0]


def ensure_manifest(name, ver, dry):
    """Download the manifest's tarball to a temporary directory next to the store, check its sha512 while it
    streams, unpack its one binary, run `--version` once with a throwaway HOME, then rename the directory into
    place. Any failure leaves only the temporary directory (removed here) and the current version untouched."""
    info = MANIFEST[name].get("latest") or {}
    if info.get("version") != ver:
        raise RuntimeError(f"{name}: no manifest entry for {ver}")
    final = version_dir(name, ver)
    member = MANIFEST[name]["bins"][0]
    if dry:
        print(f"    would download {info['url']} (sha512 checked) into {final}")
        return
    os.makedirs(agent_root(name), mode=0o755, exist_ok=True)
    tmp = f"{final}.tmp-{os.getpid()}"
    shutil.rmtree(tmp, ignore_errors=True)
    os.makedirs(tmp, mode=0o755)
    try:
        tgz = os.path.join(tmp, ".download.tar.gz")
        h, size = hashlib.sha512(), 0
        with http_get(info["url"], timeout=600) as r, open(tgz, "wb") as f:
            for chunk in iter(lambda: r.read(1 << 20), b""):
                size += len(chunk)
                if size > MANIFEST_MAX:
                    raise RuntimeError(f"{name} {ver}: download is larger than {MANIFEST_MAX >> 20} MB")
                h.update(chunk)
                f.write(chunk)
        if not hmac.compare_digest(h.hexdigest(), info["sha512"]):
            raise RuntimeError(f"{name} {ver}: checksum mismatch, download refused")
        with tarfile.open(tgz, "r:gz") as tf:
            members = tf.getmembers()
            if len(members) != 1 or not members[0].isreg() or os.path.normpath(members[0].name) != member \
                    or members[0].size > MANIFEST_MAX:
                raise RuntimeError(f"{name} {ver}: expected one file named {member} in the archive, got "
                                   + ", ".join(m.name for m in members[:5]))
            src = tf.extractfile(members[0])
            dest = os.path.join(tmp, member)
            fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o755)
            with src, os.fdopen(fd, "wb") as out:
                shutil.copyfileobj(src, out, 1 << 20)
        os.unlink(tgz)
        with tempfile.TemporaryDirectory(prefix="sharedbox-smoke-") as home:
            r = subprocess.run([dest, "--version"], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                               timeout=120, env={"HOME": home, "PATH": "/usr/local/bin:/usr/bin:/bin",
                                                 "AGY_CLI_DISABLE_AUTO_UPDATE": "true", "NO_COLOR": "1"})
        if r.returncode != 0:
            raise RuntimeError(f"{name} {ver}: `{member} --version` failed (exit {r.returncode}): "
                               + (r.stderr or r.stdout).strip()[-200:])
        if ver not in (r.stdout + r.stderr):
            print(f"    note: {member} --version says {(r.stdout or r.stderr).strip()[:80]!r}, manifest says {ver}",
                  file=sys.stderr)
        open(os.path.join(tmp, ".sharedbox-complete"), "w").close()
        subprocess.run(["chmod", "-R", "a+rX,go-w", tmp], check=False)
        shutil.rmtree(final, ignore_errors=True)   # an incomplete earlier attempt
        os.rename(tmp, final)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def ensure_version(name, ver, dry):
    """Install name@ver into its own directory. It's only used once .sharedbox-complete exists, so a
    half-finished install is never run (installed in place: pnpm's .bin wrappers hold absolute paths)."""
    if installed_ok(name, ver):
        return
    if name in MANIFEST:
        return ensure_manifest(name, ver, dry)
    final = version_dir(name, ver)
    if dry:
        print(f"    would install {name}@{ver} into {final}")
        return
    os.makedirs(agent_root(name), mode=0o755, exist_ok=True)
    shutil.rmtree(final, ignore_errors=True)   # an incomplete earlier attempt
    os.makedirs(final, mode=0o755)
    pn = pnpm()
    if pn:
        with open(os.path.join(final, "package.json"), "w") as f:
            f.write("{}\n")
        # build scripts allowed: these are owner-configured agents, and they need theirs (native binaries)
        cmd = [pn, "add", "--store-dir", PNPM_STORE, "--config.dangerously-allow-all-builds=true",
               "--config.update-notifier=false", "--prod", f"{name}@{ver}"]
        r = subprocess.run(cmd, cwd=final, check=False)
    else:
        r = subprocess.run(["npm", "install", "--prefix", final, "--no-fund", "--no-audit", "--omit=dev",
                            f"{name}@{ver}"], check=False)
    if r.returncode != 0 or not agent_bins(name, final):
        shutil.rmtree(final, ignore_errors=True)
        raise RuntimeError(f"{'pnpm' if pn else 'npm'} install {name}@{ver} failed (exit {r.returncode})")
    subprocess.run(["chmod", "-R", "a+rX,go-w", final], check=False)
    open(os.path.join(final, ".sharedbox-complete"), "w").close()


def agent_bins(name, d):
    if name in MANIFEST:
        return list(MANIFEST[name]["bins"]) if os.path.isfile(os.path.join(d, MANIFEST[name]["bins"][0])) else []
    pj = sb.read_json(os.path.join(d, "node_modules", name, "package.json"), {}) or {}
    b = pj.get("bin")
    if isinstance(b, str):
        b = {name.rsplit("/", 1)[-1]: b}
    if not isinstance(b, dict):
        return []
    return sorted(k for k in b if re.fullmatch(r"[A-Za-z0-9][\w.-]*", k)
                  and os.path.exists(os.path.join(d, "node_modules", ".bin", k)))


def set_current(name, ver):
    link = os.path.join(agent_root(name), "current")
    tmp = f"{link}.tmp-{os.getpid()}"
    try:
        os.unlink(tmp)
    except FileNotFoundError:
        pass
    os.symlink(ver, tmp)
    os.replace(tmp, link)


def shim_text(cfg, name, binary):
    pre = ""
    if binary == "claude":
        # the one-year token from the dashboard's Claude login (`claude setup-token`; the same file on every box,
        # copied by federation). An API key or a token already in the environment wins.
        pre = ('t=$HOME/.config/treehouse/claude-token\n'
               'if [ -z "$CLAUDE_CODE_OAUTH_TOKEN$ANTHROPIC_API_KEY" ] && [ -r "$t" ]; then\n'
               '    read -r CLAUDE_CODE_OAUTH_TOKEN < "$t" && export CLAUDE_CODE_OAUTH_TOKEN\n'
               'fi\n')
    target = f"node_modules/.bin/{binary}"
    off = "DISABLE_AUTOUPDATER=1 OPENCODE_DISABLE_AUTOUPDATE=1"
    if name in MANIFEST:  # one binary under every name; its self-updater can't write /opt, so it must not try
        target = MANIFEST[name]["bins"][0]
        off += " AGY_CLI_DISABLE_AUTO_UPDATE=true"   # Antigravity only honours "true" (not 1 or yes)
    return f'''#!/bin/sh
{SHIM_MARK} for {name}: written by sharedbox-tools, don't edit (rewritten on every update).
{pre}export {off}
exec "{sb.AGENTS_DIR}/{sb.agent_slug(name)}/current/{target}" "$@"
'''


def is_shim(path):
    try:
        with open(path, "rb") as f:
            return SHIM_MARK.encode() in f.read(400)
    except OSError:
        return False


def write_shim(cfg, name, binary):
    path = os.path.join(SHIM_DIR, binary)
    if os.path.lexists(path) and not is_shim(path):
        # ours to replace: an old global npm install, or a link into this agent's store (also when it dangles:
        # a hand-made link to a version that was cleaned up)
        tgt = os.path.realpath(path)
        if not tgt.startswith((os.path.join(NPM_PREFIX, "lib", "node_modules") + "/", agent_root(name) + "/")):
            print(f"    warning: {path} exists and isn't ours; not replacing it with the {name} shim",
                  file=sys.stderr)
            return
    text = shim_text(cfg, name, binary)
    try:
        with open(path) as f:
            if f.read() == text:
                return
    except OSError:
        pass
    tmp = f"{path}.tmp-{os.getpid()}"
    with open(tmp, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o755)
    os.replace(tmp, path)


def drop_legacy_global(names, dry):
    """Old layout: agents installed with `npm install -g` into /usr/local/lib/node_modules."""
    old = [n for n in names if os.path.isdir(os.path.join(NPM_PREFIX, "lib", "node_modules", n))]
    if old:
        log(f"removing the old global npm copies of {' '.join(old)} (now in {sb.AGENTS_DIR})")
        run(["npm", "uninstall", "-g", "--prefix", NPM_PREFIX] + old, dry, check=False)


def in_use(paths):
    """Which of these directories a running process was started from (argv or executable)."""
    busy = set()
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                text = f.read(8192).decode(errors="replace")
        except OSError:
            continue
        try:
            text += "\0" + os.readlink(f"/proc/{pid}/exe")
        except OSError:
            pass
        for p in paths:
            if p + "/" in text:
                busy.add(p)
    return busy


def gc_versions(names):
    keep = set()
    candidates = []
    for name in names:
        root, cur = agent_root(name), current_version(name)
        if not os.path.isdir(root):
            continue
        vers = sorted((v for v in os.listdir(root) if VERSION_RE.fullmatch(v)), key=vkey)
        older = [v for v in vers if cur and vkey(v) < vkey(cur)]
        keep.update(version_dir(name, v) for v in older[-KEEP_PREVIOUS:])
        if cur:
            keep.add(version_dir(name, cur))
        for v in os.listdir(root):
            p = os.path.join(root, v)
            if ".tmp-" in v and time.time() - os.lstat(p).st_mtime > 6 * 3600:
                candidates.append(p)  # a crashed install (old layout)
            elif VERSION_RE.fullmatch(v) and p not in keep:
                candidates.append(p)  # includes installs that never completed
    slugs = {sb.agent_slug(n) for n in names}
    for d in os.listdir(sb.AGENTS_DIR) if os.path.isdir(sb.AGENTS_DIR) else []:
        if not d.startswith(".") and d not in slugs and os.path.isdir(os.path.join(sb.AGENTS_DIR, d)):
            candidates.append(os.path.join(sb.AGENTS_DIR, d))  # no longer in TOOLS_NPM
    busy = in_use(candidates)
    removed = False
    for p in candidates:
        if p in busy:
            continue
        log(f"removing unused {p}")
        shutil.rmtree(p, ignore_errors=True)
        removed = True
    if removed and os.path.isdir(PNPM_STORE) and pnpm():
        subprocess.run([pnpm(), "store", "prune", "--store-dir", PNPM_STORE], check=False)


def remove_stale_shims(names):
    slugs = {sb.agent_slug(n) for n in names}
    for fn in os.listdir(SHIM_DIR):
        path = os.path.join(SHIM_DIR, fn)
        if os.path.islink(path) and not os.path.exists(path):
            # a dangling link into the store (a hand-made link to a version that's gone) only gives
            # "command not found" with extra confusion; one for a live agent was replaced by its shim already
            if os.readlink(path).startswith(sb.AGENTS_DIR + "/"):
                log(f"removing {path} (a broken link into {sb.AGENTS_DIR})")
                os.unlink(path)
            continue
        if os.path.isfile(path) and is_shim(path):
            with open(path) as f:
                # old pin-aware shims: `a=AGENTS_DIR/slug`; launchers: `exec "AGENTS_DIR/slug/current/..."`
                m = re.search(r"^(?:a=|exec \")" + re.escape(sb.AGENTS_DIR) + r"/([^/\s\"]+)", f.read(), re.M)
            if m and m.group(1) not in slugs:
                log(f"removing {path} (its package is no longer in TOOLS_NPM)")
                os.unlink(path)


def agents_lock():
    """One agent sync at a time (the nightly timer vs. an owner's `install`)."""
    import fcntl
    os.makedirs(sb.AGENTS_DIR, mode=0o755, exist_ok=True)
    f = open(os.path.join(sb.AGENTS_DIR, ".lock"), "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        log("another agent update is running; waiting for it")
        fcntl.flock(f, fcntl.LOCK_EX)
    return f


def sync_agents(cfg, dry, errors):
    """Install the wanted version of each agent, switch to it, write shims, clean up."""
    if not dry:
        lock = agents_lock()  # noqa: F841 (held until this function returns)
        sb.migrate_user_state()  # retire the old per-user pin store, keeping request records
    specs = agent_specs(cfg)
    names = [n for n, _ in specs]
    if not specs:
        return
    if not shutil.which("npm") and not dry and any(n not in MANIFEST for n in names):
        errors.append("npm missing; npm coding agents not installed")
        specs = [s for s in specs if s[0] in MANIFEST]   # the manifest agents don't need npm
    # Lookups and downloads are network/disk bound: do them side by side (measured on a fresh store, 4 agents:
    # lookups 2.0 s -> 0.6 s, installs 38 s -> 22 s). Switching versions stays one at a time, in order.
    from concurrent.futures import ThreadPoolExecutor

    def resolve(spec):
        try:
            return resolve_version(spec[0], spec[1]), None
        except Exception as e:
            return None, e

    with ThreadPoolExecutor(max_workers=4) as pool:
        resolved = dict(zip([n for n, _ in specs], pool.map(resolve, specs)))
    todo = []
    for name, _ in specs:
        ver, err = resolved[name]
        if err:
            print(f"    {name}: {err}", file=sys.stderr)
            errors.append(f"{name}: {err}")
        elif current_version(name) == ver:
            print(f"    {name} {ver} (up to date)")
        else:
            log(f"{name} {current_version(name) or '(new)'} -> {ver}")
            todo.append((name, ver))

    def install(item):
        try:
            ensure_version(item[0], item[1], dry)
            return None
        except Exception as e:  # one agent failing must not stop the others
            traceback.print_exc()
            return e

    if any(n not in MANIFEST for n, _ in todo) and not dry:
        pnpm()  # set up once, before the parallel installs share it
    with ThreadPoolExecutor(max_workers=4) as pool:
        failed = dict(zip([n for n, _ in todo], pool.map(install, todo)))
    for name, ver in todo:
        if failed[name]:
            errors.append(f"{name}: {failed[name]}")
        elif not dry:
            set_current(name, ver)
    if dry:
        return
    # only once the replacement is installed, so a failed install never leaves people without the agent
    ready = [n for n in names if current_version(n) and n not in MANIFEST]
    drop_legacy_global(ready + [o for o, n in sb.AGENT_RENAMED.items() if n in ready], dry)
    for name in names:
        cur = current_version(name)
        for b in agent_bins(name, version_dir(name, cur)) if cur else []:
            try:
                write_shim(cfg, name, b)
            except OSError as e:
                errors.append(f"shim {b}: {e}")
    for step, fn in (("cleanup", lambda: gc_versions(names)),
                     ("stale shims", lambda: remove_stale_shims(names))):
        try:
            fn()
        except Exception as e:
            traceback.print_exc()
            errors.append(f"{step}: {e}")


def agent_status():
    out = {}
    for name in [n for n, _ in agent_specs(sb.load_config())] if os.path.isdir(sb.AGENTS_DIR) else []:
        cur = current_version(name)
        out[name] = {"current": cur,
                     "bins": agent_bins(name, version_dir(name, cur)) if cur else []}
    return out


# ---------- uv ----------

def uv_install(dry):
    if dry:
        print("    would install uv + uvx into /usr/local/bin (astral.sh installer)")
        return
    with tempfile.TemporaryDirectory() as d:
        script = os.path.join(d, "install.sh")
        # astral.sh's release host 403s Python's default "Python-urllib" User-Agent.
        req = urllib.request.Request("https://astral.sh/uv/install.sh",
                                     headers={"User-Agent": "sharedbox-tools"})
        try:
            with urllib.request.urlopen(req, timeout=60) as resp, open(script, "wb") as f:
                shutil.copyfileobj(resp, f)
        except OSError as e:
            print(f"    warning: could not download the uv installer ({e}). Users can still use "
                  "pipx; retry with `sudo sharedbox-tools install`", file=sys.stderr)
            return
        env = dict(os.environ, UV_UNMANAGED_INSTALL="/usr/local/bin", INSTALLER_NO_MODIFY_PATH="1")
        r = subprocess.run(["sh", script], env=env, check=False)
    if r.returncode != 0 or not os.path.exists("/usr/local/bin/uv"):
        print("    warning: uv install failed. Users can still use pipx; retry with "
              "`sudo sharedbox-tools install`", file=sys.stderr)


# ---------- android ----------

def android_install(cfg, dry):
    root = cfg.get("ANDROID_SDK_ROOT", "/opt/android-sdk")
    log(f"Android SDK in {root} (accepting the Android SDK license on the owner's behalf)")
    if dry:
        print("    would download cmdline-tools, then sdkmanager platform-tools, platforms, build-tools")
        return
    ua = {"User-Agent": "sharedbox-tools"}  # some hosts refuse Python's default User-Agent
    xml = urllib.request.urlopen(urllib.request.Request(ANDROID_REPO + "repository2-3.xml", headers=ua),
                                 timeout=60).read().decode()
    blk = re.search(r'<remotePackage path="cmdline-tools;latest">(.*?)</remotePackage>', xml, re.S)
    if not blk:
        sys.exit("could not find cmdline-tools in the Android repository index")
    arch = None
    for a in re.findall(r"<archive>(.*?)</archive>", blk.group(1), re.S):
        if "<host-os>linux</host-os>" in a:
            arch = a
    if not arch:
        sys.exit("no linux cmdline-tools archive found")
    url = re.search(r"<url>([^<]+)</url>", arch).group(1)
    sha1 = re.search(r'<checksum type="sha1">([0-9a-f]+)</checksum>', arch).group(1)

    sdkm = os.path.join(root, "cmdline-tools", "latest", "bin", "sdkmanager")
    if not os.path.exists(sdkm):
        with tempfile.TemporaryDirectory() as d:
            z = os.path.join(d, "tools.zip")
            with urllib.request.urlopen(urllib.request.Request(ANDROID_REPO + url, headers=ua), timeout=600) as r, \
                    open(z, "wb") as out:
                shutil.copyfileobj(r, out)
            h = hashlib.sha1()
            with open(z, "rb") as f:
                for chunk in iter(lambda: f.read(1 << 20), b""):
                    h.update(chunk)
            if h.hexdigest() != sha1:
                sys.exit("cmdline-tools checksum mismatch; aborting")
            with zipfile.ZipFile(z) as zf:
                zf.extractall(d)
            os.makedirs(os.path.join(root, "cmdline-tools"), exist_ok=True)
            shutil.move(os.path.join(d, "cmdline-tools"), os.path.join(root, "cmdline-tools", "latest"))
        for dp, _, fs in os.walk(os.path.join(root, "cmdline-tools", "latest", "bin")):
            for fn in fs:
                os.chmod(os.path.join(dp, fn), 0o755)

    platforms = sorted({int(x) for x in re.findall(r'path="platforms;android-(\d+)"', xml)})
    btools = sorted(set(re.findall(r'path="build-tools;(\d+\.\d+\.\d+)"', xml)),
                    key=lambda v: tuple(map(int, v.split("."))))
    n_plat = sb.cfg_int(cfg, "ANDROID_PLATFORMS") if "ANDROID_PLATFORMS" in cfg else 3
    want = (["platform-tools"] + [f"platforms;android-{p}" for p in platforms[-n_plat:]]
            + [f"build-tools;{b}" for b in btools[-2:]])
    env = dict(os.environ, ANDROID_HOME=root, ANDROID_SDK_ROOT=root)
    subprocess.run([sdkm, f"--sdk_root={root}", "--licenses"], input="y\n" * 50, text=True,
                   env=env, stdout=subprocess.DEVNULL, check=False)
    subprocess.run([sdkm, f"--sdk_root={root}", "--install"] + want, env=env, check=False)
    subprocess.run(["chmod", "-R", "a+rX", root], check=False)


# ---------- status ----------

def versions():
    # a throwaway HOME: as root, `opencode --version` & co. create cache/config dirs in whatever HOME is
    with tempfile.TemporaryDirectory(prefix="sharedbox-versions-") as home:
        return _versions(home)


def _versions(home):
    out = {}
    for binary, label in KNOWN:
        path = shutil.which(binary, path="/usr/local/bin:/usr/bin:/bin:"
                            "/opt/android-sdk/cmdline-tools/latest/bin")
        if not path and binary == "fdfind" and distro.current() == "arch":
            path = shutil.which("fd", path="/usr/local/bin:/usr/bin:/bin")   # Arch names it fd
        if not path:
            continue
        flag = {"java": "-version", "go": "version", "tmux": "-V"}.get(binary, "--version")
        try:
            r = subprocess.run([path, flag], capture_output=True, text=True, timeout=20,
                               env={"PATH": "/usr/local/bin:/usr/bin:/bin", "HOME": home,
                                    "DISABLE_AUTOUPDATER": "1", "AGY_CLI_DISABLE_AUTO_UPDATE": "true",
                                    "NO_COLOR": "1"})
            text = (r.stdout or r.stderr).strip()
        except (OSError, subprocess.TimeoutExpired):
            text = ""
        m = re.search(r"\d+\.\d+(\.\d+)?", text)
        out[binary] = {"label": label, "version": m.group(0) if m else "installed", "path": path}
    return out


def write_status(last_update=None):
    """tools.json (world-readable): versions, agents, and how the last update went."""
    v = versions()
    prev = sb.read_json(TOOLS_JSON, {}) or {}
    try:
        agents = agent_status()
    except OSError:
        agents = {}
    sb.write_json(TOOLS_JSON, {"updated": int(time.time()), "tools": v, "agents": agents,
                               "last_update": last_update or prev.get("last_update")}, mode=0o644)
    return v


def t3_policy(cfg, dry):
    """/etc/t3code/policy.json: every T3 on the box stays on T3_CHANNEL (see sbcommon.t3_policy)."""
    if dry:
        log(f"would write {sb.T3_POLICY} (T3 channel: {sb.t3_channel(cfg)})")
        return
    try:
        done = sb.write_t3_policy(cfg)
    except OSError as e:
        done = f"couldn't write {sb.T3_POLICY}: {e}"
    if done:
        log(done)


# ---------- commands ----------

def cmd_install(cfg, a):
    dry = a.dry_run
    pkgs = system_packages(cfg)
    log(f"{'apt' if distro.current() == 'debian' else 'system'} packages"
        + ("" if distro.current() == "debian" else f" ({distro.package_manager() or 'unsupported distro'})"))
    pkgs_ok = pkg_install(sorted(set(pkgs)), dry)
    log(f"coding agents (npm + vendor manifests, versioned under {sb.AGENTS_DIR})")
    errors = []
    sync_agents(cfg, dry, errors)
    t3_policy(cfg, dry)
    npm_install(npm_extras_pinned(), dry, scripts=False)
    if cfg.get("TOOLS_UV", "1") == "1" and (dry or not shutil.which("uv")):
        log("uv")
        uv_install(dry)
    if cfg.get("TOOLS_ANDROID", "0") == "1":
        android_install(cfg, dry)
    if not dry:
        for k, v in sorted(write_status().items()):
            print(f"    {v['label']:<14} {v['version']}")
    for e in errors:
        print(f"    error: {e}", file=sys.stderr)
    if not pkgs_ok or errors:
        sys.exit(1)


def cmd_update(cfg, a):
    """Every step runs even if an earlier one fails; failures go to tools.json + events and the exit code."""
    errors = []
    started = int(time.time())
    log("coding agents")
    sync_agents(cfg, False, errors)
    t3_policy(cfg, False)
    steps = [("npm extras", lambda: npm_install(npm_extras_pinned(), False, scripts=False))]  # stay pinned
    if shutil.which("uv") and os.path.dirname(shutil.which("uv")) == "/usr/local/bin":
        steps.append(("uv", lambda: uv_install(False)))
    for label, fn in steps:
        log(label)
        try:
            fn()
        except Exception as e:
            traceback.print_exc()
            errors.append(f"{label}: {e}")
    write_status({"ts": started, "ok": not errors, "errors": errors[:20]})
    sb.log_event("tools_updated" if not errors else "tools_update_failed", None, errors=errors[:20])
    if errors:
        print("update finished with errors:\n" + "\n".join(f"  - {e}" for e in errors), file=sys.stderr)
        sys.exit(1)


def pkg_installed(name):
    """Arch only: is the package (or group) installed now?"""
    for q in (["pacman", "-Q", "--", name], ["pacman", "-Qg", "--", name]):
        if subprocess.run(q, capture_output=True).returncode == 0:
            return True
    return False


def cmd_add(cfg, a):
    for n in a.names:
        if not re.fullmatch(r"[@a-zA-Z0-9._/+-]+", n) or (a.kind == "npm" and not NPM_SPEC.fullmatch(n)):
            sys.exit(f"bad package name: {n}")
    names = a.names
    if a.kind in PKG_KINDS:
        a.kind = pkg_kind()
        names = distro.native_names(names)
        if not pkg_install(names, False):
            sys.exit(1)
        if a.kind != "apt":   # pacman problems are warnings; record only what actually installed
            names = [n for n in names if pkg_installed(n)]
    else:
        npm_install(names, False, scripts=False)
        # pin what was approved; `update` reinstalls exactly this version
        names = []
        for n in a.names:
            v = npm_installed(npm_name(n))
            if v:
                names.append(f"{npm_name(n)}@{v}")
            else:
                print(f"    {n} did not install; not recorded", file=sys.stderr)
    try:
        with open(EXTRA) as f:
            lines = f.readlines()
    except FileNotFoundError:
        lines = []
    key = npm_name if a.kind == "npm" else (lambda n: n)
    kinds, tr = (("npm",), str) if a.kind == "npm" else (PKG_KINDS, distro.native_name)
    new = {key(n) for n in names}
    keep = [l for l in lines if not (len(l.split()) == 2 and l.split()[0] in kinds
                                     and key(tr(l.split()[1])) in new)]
    with open(EXTRA, "w") as f:
        f.writelines(keep + [f"{a.kind} {n}\n" for n in names])
    write_status()
    sb.log_event("tools_added", None, packages=" ".join(a.names))


def cmd_remove(cfg, a):
    for n in a.names:
        if not re.fullmatch(r"[@a-zA-Z0-9._/+-]+", n):
            sys.exit(f"bad package name: {n}")
    key = npm_name if a.kind == "npm" else (lambda n: n)
    names = a.names
    if a.kind == "npm":
        run(["npm", "uninstall", "-g", "--prefix", NPM_PREFIX] + [key(n) for n in a.names],
            False, check=False)
    else:
        names = distro.native_names(a.names)
        try:
            distro.remove(names)
        except distro.Unsupported as e:
            sys.exit(f"error: {e}")
    kinds, tr = (("npm",), str) if a.kind == "npm" else (PKG_KINDS, distro.native_name)
    gone = {key(n) for n in names}
    try:
        with open(EXTRA) as f:
            keep = [l for l in f if not (len(l.split()) == 2 and l.split()[0] in kinds
                                         and key(tr(l.split()[1])) in gone)]
        with open(EXTRA, "w") as f:
            f.writelines(keep)
    except FileNotFoundError:
        pass
    if a.kind == "npm":
        conf = words(cfg, "TOOLS_NPM")
    elif distro.current() == "debian":
        conf = words(cfg, "TOOLS_APT")
    else:
        conf = distro.native_names(words(cfg, "TOOLS_APT") + words(cfg, "TOOLS_APT_BROWSER")
                                   + words(cfg, "TOOLS_PACMAN") + words(cfg, "TOOLS_PACMAN_BROWSER"))
    listed = [n for n in names if n in conf]
    if listed:
        print(f"note: {' '.join(listed)} is still listed in {sb.CONF_PATH}; remove it there "
              "or the next install/update will bring it back", file=sys.stderr)
    write_status()
    sb.log_event("tools_removed", None, packages=" ".join(a.names))


def cmd_status(cfg, a):
    for k, v in sorted(write_status().items()):
        print(f"{v['label']:<14} {v['version']:<12} {v['path']}")
    st = sb.read_json(TOOLS_JSON, {}) or {}
    for name, ag in sorted((st.get("agents") or {}).items()):
        print(f"agent {name}: current {ag['current']}")
    lu = st.get("last_update") or {}
    if lu:
        print(f"last update {time.strftime('%Y-%m-%d %H:%M', time.localtime(lu['ts']))}: "
              + ("ok" if lu.get("ok") else "FAILED: " + "; ".join(lu.get("errors") or [])))


def main():
    if os.geteuid() != 0:
        sys.exit("sharedbox-tools: must run as root")
    cfg = sb.load_config()
    p = argparse.ArgumentParser(prog="sharedbox-tools", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    s = p.add_subparsers(dest="cmd", required=True)
    x = s.add_parser("install"); x.add_argument("--dry-run", action="store_true")
    x.set_defaults(fn=cmd_install)
    s.add_parser("update").set_defaults(fn=cmd_update)
    x = s.add_parser("add"); x.add_argument("kind", choices=["pkg", "apt", "npm"])
    x.add_argument("names", nargs="+"); x.set_defaults(fn=cmd_add)
    x = s.add_parser("remove"); x.add_argument("kind", choices=["pkg", "apt", "npm"])
    x.add_argument("names", nargs="+"); x.set_defaults(fn=cmd_remove)
    s.add_parser("status").set_defaults(fn=cmd_status)
    a = p.parse_args()
    a.fn(cfg, a)


if __name__ == "__main__":
    main()
