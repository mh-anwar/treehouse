def _sha(data):
    return hashlib.sha256(data).hexdigest()


def _create(path, data):
    """Write `data` to `path` only if it does not exist. Returns True if written."""
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
    except FileExistsError:
        return False
    with os.fdopen(fd, "wb") as f:
        f.write(data)
        os.fchmod(f.fileno(), 0o644)
    return True


def _replace(path, data):
    tmp = f"{path}.tmp-{os.getpid()}"
    try:
        os.unlink(tmp)
    except FileNotFoundError:
        pass
    _create(tmp, data)
    os.replace(tmp, path)


def plant(cfg, quiet=False):
    d = cfg.get("CANARY_DIR", "/srv/backups/prod")
    os.umask(0o022)
    os.makedirs(d, mode=0o755, exist_ok=True)
    st = os.lstat(d)
    if not os.path.isdir(d) or os.path.islink(d) or st.st_uid != os.geteuid() or st.st_mode & 0o022:
        sys.exit(f"refusing to plant: {d} must be a real directory owned by us and not group/world-writable")
    planted = sb.read_json(PLANTED, {}) or {}
    made = []

    def put(name, data):
        path = os.path.join(d, name)
        if _create(path, data):
            planted[name] = _sha(data)
            made.append(name)

    put(".env", fake_env().encode())
    put("db_dump_users.sql", fake_sql().encode())
    put("README.txt", README.encode())

    aws = os.path.join(d, "aws-credentials")
    token = _readb(os.path.join(TOKEN_DIR, "aws-credentials"), 1 << 16)
    if token:
        cur = _readb(aws, 1 << 16)
        if cur is None:
            put("aws-credentials", token)
        elif cur != token and planted.get("aws-credentials") == _sha(cur):
            _replace(aws, token)          # upgrade our own fake to the admin's canarytoken
            planted["aws-credentials"] = _sha(token)
            made.append("aws-credentials (canarytokens.org key)")
    else:
        put("aws-credentials", fake_aws().encode())

    key = os.path.join(d, "id_ed25519_deploy")
    if not os.path.lexists(key) and not os.path.lexists(key + ".pub"):
        try:
            r = subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "deploy@prod-web-01",
                                "-f", key], stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30)
            if r.returncode == 0:
                for p in (key, key + ".pub"):
                    os.chmod(p, 0o644)
                made += ["id_ed25519_deploy", "id_ed25519_deploy.pub"]
            else:
                print(f"ssh-keygen failed: {r.stderr.strip()}", file=sys.stderr)
        except (OSError, subprocess.TimeoutExpired) as e:
            print(f"ssh-keygen failed: {e}", file=sys.stderr)

    if made:
        try:
            sb.write_json(PLANTED, planted, mode=0o600)
        except OSError as e:
            print(f"could not record planted decoys: {e}", file=sys.stderr)
    if not quiet:
        print(f"decoys in {d}: " + (f"planted {', '.join(made)}" if made else "all present, nothing changed"))
    return made


def tripwires(cfg):
    d = cfg.get("CANARY_DIR", "/srv/backups/prod")
    return [os.path.join(d, n) for n, watch in DECOYS.items() if watch]


# ---------- actions ----------

def is_friend(cfg, uid, user):
    try:
        lo, hi = int(cfg["FRIEND_UID_MIN"]), int(cfg["FRIEND_UID_MAX"])
    except (KeyError, ValueError):
        return False
    return uid != 0 and lo <= uid <= hi and user not in sb.admin_users(cfg)


def username(uid):
    try:
        return pwd.getpwuid(uid).pw_name
    except (KeyError, OverflowError):
        return str(uid)


def systemctl(verb, uid):
    try:
        r = subprocess.run(["systemctl", verb, f"user-{uid}.slice"], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, str(e)
    return r.returncode == 0, (r.stderr or r.stdout).strip()


def append_hit(rec):
    try:
        fd = os.open(HITS, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_CLOEXEC, 0o600)
        with os.fdopen(fd, "a") as f:
            f.write(json.dumps(rec) + "\n")
    except OSError as e:
        print(f"cannot write {HITS}: {e}", file=sys.stderr)


def mail_text(cfg, info, rec, note):
    chain = " <- ".join(f"{c['comm']}[{c['pid']}] uid={c['uid']}" for c in info.get("parents", [])) or "-"
    lu = info.get("loginuid")
    lines = [
        f"{rec['user']} (uid {rec['uid']}) opened a decoy secret file on this box.",
        "",
        f"file:      {rec['file']}",
        f"when:      {time.strftime('%Y-%m-%d %H:%M:%S %Z', time.localtime(rec['ts']))}",
        f"command:   {rec['cmd'][:500]}",
        f"exe:       {rec['exe']}",
        f"cwd:       {info.get('cwd')}",
        f"pid:       {rec['pid']} ({info.get('comm')}), euid {info.get('euid')}"
        + (f", login uid {lu} ({username(lu)})" if lu is not None else ""),
        f"parents:   {chain}",
        f"ssh from:  {rec['ip'] or 'unknown'} (from SSH_CONNECTION in its environment; can be faked)",
        "",
        f"action:    {note}",
    ]
    if rec.get("suppressed_before"):
        lines.append(f"           (+{rec['suppressed_before']} more hits by this user in the previous 10 minutes)")
    lines += [
        "",
        "Nothing legitimate reads these files, so this is someone (or someone's agent) hunting for secrets.",
        f"Their processes are {'FROZEN in place (paused, nothing lost) so you can look at them' if rec['frozen'] else 'still running'}.",
        "",
        f"  to inspect:   systemd-cgls /user.slice/user-{rec['uid']}.slice ; sudo ls -l /proc/{rec['pid']}/",
        f"  to unfreeze:  sudo sharedbox-canary thaw {rec['user']}",
        f"  to lock out:  sudo sharedbox-admin suspend {rec['user']}",
        "",
        "All hits: sudo sharedbox-canary status",
    ]
    return "\n".join(lines) + "\n"


def send_mail(cfg, subject, text):
    try:
        sbmail.send(cfg, subject, text)
    except Exception as e:  # noqa: BLE001 - never let mail kill the daemon
        print(f"alert email failed: {e}", file=sys.stderr)


def mail_ok(cfg):
    try:
        return sbmail.configured(cfg)
    except Exception:  # noqa: BLE001
        return False


class Responder:
    """Runs off the event loop: decide, freeze, record, email."""

    def __init__(self, cfg):
        self.cfg = cfg
        action = cfg.get("CANARY_ACTION", "alert").strip().lower()
        if action not in ("alert", "freeze"):
            print(f"unknown CANARY_ACTION={action!r}; alerting only", file=sys.stderr)
            action = "alert"
        self.action = action
        self.last = {}   # uid -> {"ts", "lines", "suppressed"}

    def handle(self, info):
        now = int(time.time())
        uid = info["uid"]
        user = username(uid)
        rec = {"ts": now, "user": user, "uid": uid, "pid": info["pid"], "cmd": info["cmd"],
               "exe": info["exe"], "file": info["file"], "ip": info["ip"], "frozen": False}
        st = self.last.get(uid)
        if st and now - st["ts"] < RATE_WINDOW:
            st["suppressed"] += 1
            if st["lines"] < MAX_REPEAT_LINES:
                st["lines"] += 1
                append_hit(dict(rec, repeat=True))
            return
        suppressed = st["suppressed"] if st else 0
        self.last = {u: s for u, s in self.last.items() if now - s["ts"] < RATE_WINDOW}
        self.last[uid] = {"ts": now, "lines": 0, "suppressed": 0}
        if suppressed:
            rec["suppressed_before"] = suppressed

        friend = is_friend(self.cfg, uid, user)
        if not friend:
            note = "alert only (root/admin/system account: never frozen)"
        elif self.action != "freeze":
            note = "alert only (CANARY_ACTION=alert)"
        else:
            ok, err = systemctl("freeze", uid)
            rec["frozen"] = ok
            note = f"froze user-{uid}.slice" if ok else f"FREEZE FAILED: {err}"
        append_hit(rec)
        sb.log_event("canary", user, file=rec["file"], pid=rec["pid"], cmd=rec["cmd"][:200], frozen=rec["frozen"])
        print(f"TRIPWIRE: {user} (uid {uid}) pid {rec['pid']} `{rec['cmd'][:200]}` opened {rec['file']} "
              f"from {rec['ip'] or '?'}; {note}", file=sys.stderr, flush=True)
        if mail_ok(self.cfg):
            threading.Thread(target=send_mail, daemon=True,
                             args=(self.cfg, f"🚨 TRIPWIRE: {user} opened decoy secrets",
                                   mail_text(self.cfg, info, rec, note))).start()

    def run(self, q):
        while True:
            info = q.get()
            try:
                self.handle(info)
            except Exception as e:  # noqa: BLE001
                print(f"responder error: {e!r}", file=sys.stderr, flush=True)


# ---------- daemon ----------

def open_watch(lib, paths):
    """fanotify fd with every existing tripwire marked. Prefers permission events (opener blocked
    while we look at it); falls back to plain notifications if the kernel lacks them."""
    for cls, mask, perm in ((FAN_CLASS_CONTENT, FAN_OPEN_PERM, True), (FAN_CLASS_NOTIF, FAN_OPEN, False)):
        try:
            fan = fan_init(lib, cls)
        except FanError as e:
            if e.errno == errno.EINVAL and perm:
                continue
            raise
        try:
            n = mark_all(lib, fan, mask, paths)
        except FanError as e:
            os.close(fan)
            if e.errno == errno.EINVAL and perm:
                continue
            raise
        return fan, mask, perm, n
    raise FanError(errno.EINVAL, "fanotify unusable")


def mark_all(lib, fan, mask, paths):
    n = 0
    for p in paths:
        try:
            fan_mark(lib, fan, mask, p)
            n += 1
        except FanError as e:
            if e.errno != errno.ENOENT:
                raise
    return n


def respond(fan, fd):
    try:
        os.write(fan, RESPONSE.pack(fd, FAN_ALLOW))
    except OSError as e:
        print(f"fanotify response failed for fd {fd}: {e}", file=sys.stderr, flush=True)


def on_event(fan, perm, ev, q):
    mask, fd, pid = ev
    if fd == FAN_NOFD or mask & FAN_Q_OVERFLOW:
        print("fanotify queue overflow: some opens were not recorded", file=sys.stderr, flush=True)
        return
    info = None
    try:
        if pid != MYPID:
            info = collect(pid, fd)
    except Exception as e:  # noqa: BLE001
        info = {"pid": pid, "uid": -1, "euid": -1, "loginuid": None, "comm": "?", "cmd": f"? ({e!r})",
                "exe": None, "cwd": None, "file": _link(f"/proc/self/fd/{fd}"), "ppid": 0, "parents": [], "ip": None}
    finally:
        try:
            if perm and mask & FAN_ALL_PERM:
                respond(fan, fd)      # always allow: we want them to take the bait
        finally:
            os.close(fd)
    if info:
        try:
            q.put_nowait(info)
        except queue.Full:
            print(f"responder backlog full, dropped hit by pid {pid}", file=sys.stderr, flush=True)


def cmd_watch(cfg, a):
    need_root()
    lib = _libc()
    paths = tripwires(cfg)
    fan, mask, perm, n = open_watch(lib, paths)
    print(f"watching {n}/{len(paths)} decoys in {cfg.get('CANARY_DIR', '/srv/backups/prod')} "
          f"({'open permission events' if perm else 'open notifications only: kernel lacks permission events'}); "
          f"action={cfg.get('CANARY_ACTION', 'alert')}", file=sys.stderr, flush=True)
    q = queue.Queue(maxsize=1000)
    threading.Thread(target=Responder(cfg).run, args=(q,), daemon=True).start()
    poller = select.poll()
    poller.register(fan, select.POLLIN)
    remark = time.monotonic() + REMARK_EVERY
    try:
        while True:
            if time.monotonic() >= remark:
                n2 = mark_all(lib, fan, mask, paths)
                if n2 != n:
                    print(f"now watching {n2}/{len(paths)} decoys", file=sys.stderr, flush=True)
                    n = n2
                remark = time.monotonic() + REMARK_EVERY
            if not poller.poll(REMARK_EVERY * 1000):
                continue
            buf = os.read(fan, 64 * 1024)
            for ev in parse_events(buf):
                on_event(fan, perm, ev, q)
    finally:
        os.close(fan)      # the kernel allows any still-pending permission events


# ---------- admin commands ----------

def need_root():
    if os.geteuid() != 0:
        sys.exit("run with sudo")


def cmd_plant(cfg, a):
    need_root()
    plant(cfg)


def cmd_thaw(cfg, a):
    need_root()
    try:
        pw = pwd.getpwnam(a.user) if not a.user.isdigit() else pwd.getpwuid(int(a.user))
    except KeyError:
        sys.exit(f"no such user: {a.user}")
    ok, err = systemctl("thaw", pw.pw_uid)
    if not ok:
        sys.exit(f"thaw failed: {err}")
    sb.log_event("canary-thaw", pw.pw_name)
    print(f"{pw.pw_name}: user-{pw.pw_uid}.slice thawed (their processes run again)")


def recent_hits(n=20):
    lines = (_readb(HITS, 1 << 30) or b"").decode(errors="replace").splitlines()
    out = []
    for line in lines[-n:]:
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            pass
    return out


def cmd_status(cfg, a):
    need_root()
    d = cfg.get("CANARY_DIR", "/srv/backups/prod")
    r = subprocess.run(["systemctl", "is-active", "sharedbox-canary.service"], capture_output=True, text=True)
    print(f"daemon: {r.stdout.strip() or 'unknown'}   action: {cfg.get('CANARY_ACTION', 'alert')}   dir: {d}")
    for name, watch in DECOYS.items():
        p = os.path.join(d, name)
        try:
            st = os.lstat(p)
            desc = f"{oct(st.st_mode & 0o777)} uid={st.st_uid} {st.st_size}B"
        except FileNotFoundError:
            desc = "MISSING (sudo sharedbox-canary plant)"
        print(f"  {'tripwire' if watch else 'bait    '}  {name:24} {desc}")
    hits = recent_hits(a.n)
    print(f"\nrecent hits ({len(hits)}):" if hits else "\nno hits yet")
    frozen = {}
    for h in hits:
        t = time.strftime("%Y-%m-%d %H:%M", time.localtime(h.get("ts", 0)))
        flag = " FROZEN" if h.get("frozen") else (" (repeat)" if h.get("repeat") else "")
        print(f"  {t}  {h.get('user')}  {os.path.basename(h.get('file') or '?')}  "
              f"`{(h.get('cmd') or '')[:60]}`  {h.get('ip') or ''}{flag}")
        if h.get("frozen"):
            frozen[h["user"]] = h["uid"]
    for user, uid in frozen.items():
        r = subprocess.run(["systemctl", "show", "-P", "FreezerState", f"user-{uid}.slice"],
                           capture_output=True, text=True)
        print(f"  {user}: user-{uid}.slice is {r.stdout.strip() or 'unknown'}")


def cmd_test(cfg, a):
    d = cfg.get("CANARY_DIR", "/srv/backups/prod")
    action = cfg.get("CANARY_ACTION", "alert")
    print(f"""To check the tripwire end to end:

  1. sudo systemctl status sharedbox-canary      (should be active, "watching N/N decoys")
  2. As a NON-admin test account, read a decoy:
       cat {os.path.join(d, '.env')}
     (As root or an admin it is only recorded + emailed, never frozen.)
  3. sudo sharedbox-canary status                 (the hit should be listed)
     journalctl -u sharedbox-canary -n 20
  4. With CANARY_ACTION={action}, a friend-range test account is """
          + ("frozen: its shell stops responding.\n     Undo: sudo sharedbox-canary thaw TESTUSER"
             if action == "freeze" else "only alerted on.") + """

Don't test with a real friend's account under freeze mode. Nothing is frozen by this command.""")


def main():
    p = argparse.ArgumentParser(prog="sharedbox-canary", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    s = p.add_subparsers(dest="cmd", required=True)
    s.add_parser("plant").set_defaults(fn=cmd_plant)
    s.add_parser("watch").set_defaults(fn=cmd_watch)
    x = s.add_parser("thaw"); x.add_argument("user"); x.set_defaults(fn=cmd_thaw)
    x = s.add_parser("status"); x.add_argument("-n", type=int, default=20); x.set_defaults(fn=cmd_status)
    s.add_parser("test").set_defaults(fn=cmd_test)
    a = p.parse_args()
    a.fn(sb.load_config(), a)


if __name__ == "__main__":
    main()
