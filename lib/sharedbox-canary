# ---------- fanotify (linux/fanotify.h) ----------
FAN_CLOEXEC = 0x1
FAN_CLASS_NOTIF = 0x0
FAN_CLASS_CONTENT = 0x4
FAN_MARK_ADD = 0x1
FAN_OPEN = 0x20
FAN_OPEN_PERM = 0x10000
FAN_ALL_PERM = 0x10000 | 0x20000 | 0x40000        # OPEN_PERM | ACCESS_PERM | OPEN_EXEC_PERM
FAN_Q_OVERFLOW = 0x4000
FAN_ALLOW = 0x01
FAN_NOFD = -1
FANOTIFY_METADATA_VERSION = 3
AT_FDCWD = -100
META = struct.Struct("=IBBHQii")   # event_len, vers, reserved, metadata_len, mask, fd, pid (24 bytes)
RESPONSE = struct.Struct("=iI")    # fd, response
MYPID = os.getpid()


class FanError(OSError):
    pass


def _libc():
    lib = ctypes.CDLL(ctypes.util.find_library("c") or "libc.so.6", use_errno=True)
    lib.fanotify_init.argtypes = [ctypes.c_uint, ctypes.c_uint]
    lib.fanotify_init.restype = ctypes.c_int
    lib.fanotify_mark.argtypes = [ctypes.c_int, ctypes.c_uint, ctypes.c_uint64, ctypes.c_int, ctypes.c_char_p]
    lib.fanotify_mark.restype = ctypes.c_int
    return lib


def fan_init(lib, flags):
    fd = lib.fanotify_init(flags | FAN_CLOEXEC, os.O_RDONLY | getattr(os, "O_LARGEFILE", 0))
    if fd < 0:
        e = ctypes.get_errno()
        raise FanError(e, f"fanotify_init: {os.strerror(e)}")
    return fd


def fan_mark(lib, fan, mask, path):
    if lib.fanotify_mark(fan, FAN_MARK_ADD, mask, AT_FDCWD, os.fsencode(path)) < 0:
        e = ctypes.get_errno()
        raise FanError(e, f"fanotify_mark {path}: {os.strerror(e)}")


def parse_events(buf):
    """[(mask, fd, pid)] from one read() of the fanotify fd."""
    out, off = [], 0
    while off + META.size <= len(buf):
        ev_len, vers, _res, _mlen, mask, fd, pid = META.unpack_from(buf, off)
        if vers != FANOTIFY_METADATA_VERSION:
            raise FanError(errno.EPROTO, f"fanotify metadata version {vers}, expected {FANOTIFY_METADATA_VERSION}")
        if ev_len < META.size or off + ev_len > len(buf):
            break
        out.append((mask, fd, pid))
        off += ev_len
    return out


# ---------- /proc ----------

def _readb(path, limit=1 << 16):
    try:
        with open(path, "rb") as f:
            return f.read(limit)
    except OSError:
        return None


def _link(path):
    try:
        return os.readlink(path)
    except OSError:
        return None


def proc_status(pid):
    st = {}
    for line in (_readb(f"/proc/{pid}/status") or b"").decode(errors="replace").splitlines():
        k, _, v = line.partition(":")
        st[k] = v.strip()
    return st


def proc_environ(pid):
    raw = _readb(f"/proc/{pid}/environ", 256 << 10) or b""
    env = {}
    for item in raw.split(b"\0"):
        k, sep, v = item.partition(b"=")
        if sep:
            env[k.decode(errors="replace")] = v.decode(errors="replace")
    return env


def ssh_ip(pids):
    """Client IP from SSH_CONNECTION/SSH_CLIENT of the process or its ancestors (user-controlled env!)."""
    for p in pids:
        env = proc_environ(p)
        for k in ("SSH_CONNECTION", "SSH_CLIENT"):
            if env.get(k):
                return env[k].split()[0]
    return None


def collect(pid, fd=None):
    """Everything we can learn about `pid` (while it is still blocked in open())."""
    st = proc_status(pid)
    uids = (st.get("Uid") or "-1 -1").split()
    cmd = (_readb(f"/proc/{pid}/cmdline", 4096) or b"").rstrip(b"\0").replace(b"\0", b" ")
    loginuid = (_readb(f"/proc/{pid}/loginuid") or b"").strip()
    info = {
        "pid": pid,
        "uid": int(uids[0]),
        "euid": int(uids[1]) if len(uids) > 1 else int(uids[0]),
        "loginuid": int(loginuid) if loginuid.isdigit() and int(loginuid) != 4294967295 else None,
        "comm": st.get("Name", "?"),
        "cmd": cmd.decode(errors="replace") or f"[{st.get('Name', '?')}]",
        "exe": _link(f"/proc/{pid}/exe"),
        "cwd": _link(f"/proc/{pid}/cwd"),
        "file": _link(f"/proc/self/fd/{fd}") if fd is not None and fd >= 0 else None,
        "ppid": int(st.get("PPid") or 0),
    }
    chain, p = [], info["ppid"]
    while p > 1 and len(chain) < 5:
        pst = proc_status(p)
        if not pst:
            break
        chain.append({"pid": p, "comm": pst.get("Name", "?"), "uid": int((pst.get("Uid") or "-1").split()[0])})
        p = int(pst.get("PPid") or 0)
    info["parents"] = chain
    info["ip"] = ssh_ip([pid] + [c["pid"] for c in chain])
    return info


