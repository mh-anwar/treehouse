def cmd_invite(a):
    """Ask root for a one-time invite link. Only accounts in ADMIN_USERS get an answer."""
    if ME.pw_name not in sb.admin_users(CFG):
        sys.exit("only the owner's accounts can invite people. "
                 "Ask the owner, or `box request \"invite <name>\"`.")
    rid = f"{os.getpid()}{int(time.time() * 1000)}{os.urandom(4).hex()}"
    req = {"action": "invite", "note": (a.note or "")[:120], "days": a.days, "tailscale": a.tailscale,
           "create": not a.no_create}
    if a.username:
        if a.no_create:
            sys.exit("--username needs the account to be created now; drop --no-create")
        req["username"] = a.username.strip()[:32]
    if a.email:
        req["email"] = a.email.strip()[:254]
    elif sb.public_mode(CFG) == "cloudflare" and not a.tailscale:
        sys.exit("this machine uses Cloudflare Access: give the friend's email, e.g. "
                 "box invite --email sam@example.com --note \"Sam\" (they log in with it)")
    path = os.path.join(sb.ADMIN_DROP, f"{rid}.json")
    tmp = os.path.join(sb.ADMIN_DROP, f".{rid}.tmp")
    try:
        with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as f:
            json.dump(req, f)
        os.rename(tmp, path)  # the path unit only reacts to *.json, so it never sees a half-written file
    except OSError as e:
        sys.exit(provisioner_trouble(f"the machine couldn't take this request ({e.strerror or e})"))
    reply = os.path.join(sb.ADMIN_REPLIES, f"{rid}.json")
    # creating the account (and, in cloudflare mode, updating the Access allow list) takes a while
    wait = 30 if a.no_create and not a.email else 120
    deadline = time.time() + wait
    while time.time() < deadline:
        try:
            with open(reply) as f:
                res = json.load(f)
            break
        except (FileNotFoundError, ValueError):
            time.sleep(0.25)
    else:
        sys.exit(provisioner_trouble(f"the machine didn't answer within {wait} seconds"))
    if a.json:
        print(json.dumps(res))
        return
    if not res.get("ok"):
        sys.exit(res.get("error", "invite failed"))
    print(res["message"])
    if res.get("username"):
        what = (f"login link {res['id']} works once until "
                f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(res['expires']))}; " if res.get("id") else "")
        print(f"\n(account {res['username']} created; {what}undo: box friends remove {res['username']})",
              file=sys.stderr)
    elif res.get("id"):
        exp = time.strftime("%Y-%m-%d %H:%M", time.localtime(res["expires"]))
        print(f"\n(invite {res['id']}, single use, expires {exp})", file=sys.stderr)
    elif res.get("note"):
        print(f"\n({res['note']})", file=sys.stderr)


