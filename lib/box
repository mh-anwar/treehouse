def projects_peers():
    """{box: ssh destination} for every other machine in BOXES (federation's `Host <box>` block, the owner's alias, or
    user@ip: sbmulti.ssh_dest). {} when this is the only box."""
    import sbfed
    import sbmulti
    boxes = sb.boxes(CFG)
    me = sbfed.self_name(boxes, sb.tailscale_ip4(), socket.gethostname())
    return {n: sbmulti.ssh_dest(n, ip, ME.pw_name, HOME) for n, ip in boxes.items() if n != me}


def projects_remote(dest, req):
    """Run `box _projects-here` on another machine as this person, at low priority. Its answer, or an error."""
    import sbprojects
    try:
        r = fed_ssh(dest, shlex.join([*sbprojects.NICE, "box", "_projects-here"]), json.dumps(req),
                    timeout=sbprojects.PEER_TIMEOUT)
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": "That machine took too long to answer; trying again at the next sync."}
    except OSError as ex:
        return {"ok": False, "error": str(ex)[:200]}
    if "invalid choice" in r.stderr and "_projects-here" in r.stderr:
        return {"ok": False, "error": "That machine needs a treehouse update first."}
    if r.returncode == 255:
        return {"ok": False, "error": ("Not connected yet. Your machines connect to each other by themselves within a few minutes; "
                                      "if this stays for a day, the owner can fix it.")}
    try:
        return json.loads((r.stdout.strip().splitlines() or ["{}"])[-1])
    except ValueError:
        return {"ok": False, "error": "No answer: " + (r.stderr.strip().splitlines() or ["?"])[-1][:150]}


def projects_t3_add(path, name):
    """Add a copy to this person's T3 here (`t3 project add`): (ok, why not). An existing project counts as done."""
    if not shutil.which("t3", path=user_env()["PATH"]):
        return False, "T3 isn't installed on this machine."
    try:
        r = subprocess.run(["t3", "project", "add", "--title", name, path], env=user_env(), capture_output=True,
                           text=True, errors="replace", timeout=120, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as ex:
        return False, type(ex).__name__
    if r.returncode == 0 or "already exists" in (r.stdout + r.stderr):
        return True, ""
    import sbprojects
    return False, sbprojects.last_line(r.stderr or r.stdout, 120)


def projects_ago(ts):
    if not ts:
        return "never"
    m = int((time.time() - ts) // 60)
    return "just now" if m < 1 else f"{m} min ago" if m < 60 else f"{m // 60} h ago" if m < 2880 else f"{m // 1440} days ago"


