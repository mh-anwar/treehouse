        keys = [k for k in (sbfed.clean_key(x) for x in req.get("keys") or []) if k]
        ssh = [ln for ln in req.get("ssh") or [] if isinstance(ln, str) and "\n" not in ln]
        kh = [ln for ln in req.get("known_hosts") or [] if isinstance(ln, str) and "\n" not in ln]
        for path, lines in ((os.path.join(d, "authorized_keys"), keys), (os.path.join(d, "config"), ssh)):
            cur = fed_read(path)
            new = sbfed.managed_block(cur, lines)
            if new != cur:
                sbfed.write_private(path, new)
        sbfed.write_private(os.path.join(d, "treehouse_known_hosts"), "".join(ln + "\n" for ln in kh))
        print(json.dumps({"ok": True}))
    elif a.action == "link":
        notes, peers = [], {}
        for peer, ip in (req.get("peers") or {}).items():
            if sb.BOX_NAME_RE.fullmatch(str(peer)) and sb.BOX_IP_RE.fullmatch(str(ip)):
                peers[peer] = fed_link_peer(peer, ip, bool(req.get("home")), notes)
        sb.write_json(FED_STATE, {"ts": int(time.time()), "self": req.get("self"), "peers": peers}, mode=0o600)
        print(json.dumps({"ok": True, "notes": notes}))
    else:
        print(json.dumps({"ok": False, "error": "unknown action"}))


