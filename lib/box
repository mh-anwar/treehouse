def portal_project_keep(name):
    """Mark a project as used today, so the archive clock starts again (the janitor looks at the newest file in it)."""
    name = str(name or "").strip().strip("/")
    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9._-]{0,99}", name):
        return {"ok": False, "error": "no such project"}
    path = os.path.join(HOME, name)
    if not os.path.isdir(path) or os.path.islink(path):
        return {"ok": False, "error": f"~/{name} isn't there any more. Refresh the page."}
    mark = os.path.join(path, ".git" if os.path.isdir(os.path.join(path, ".git")) else "", ".treehouse-kept")
    with open(mark, "w") as f:
        f.write(time.strftime("%Y-%m-%d %H:%M\n"))
    os.utime(path)
    return {"ok": True, "message": f"Kept {name}. It stays in your home folder for at least another "
                                   f"{CFG['PROJECT_TTL_DAYS']} days."}


def serve_op(op, u):
    """stop = stays off across reboots too; start/restart = on, and back after a reboot (like group servers)."""
    if op == "restart":
        r = sctl("enable", u, capture=True)
        return r if r.returncode else sctl("restart", u, capture=True)
    return sctl(*{"start": ("enable", "--now"), "stop": ("disable", "--now")}[op], u, capture=True)


def portal_serve_ctl(name, op):
    name = portal_own_server(name)
    if not name or op not in PORTAL_SERVER_OPS:
        return {"ok": False, "error": "no such server"}
    r = serve_op(op, f"sb-{name}.service")
    if r.returncode != 0:
        return {"ok": False, "error": f"{op} {name} failed: " + (r.stderr or r.stdout or "").strip()[-300:]}
    state = next((s["state"] for s in list_services() if s["name"] == name), "stopped")
    return {"ok": True, "name": name, "op": op, "state": state,
            "message": f"{name}: {'stopped' if op == 'stop' else op + 'ed'}"}


def portal_serve_logs(name):
