    host = sb.tailscale_ip4()
    if not r or not host:
        sys.exit("box t3: needs a friend account and Tailscale running on the box")
    return host, r[0], {"T3CODE_HOST": host, "T3CODE_PORT": str(r[0]),
                        "T3CODE_PROJECT_ROOT": os.path.join(HOME, "projects"), "T3CODE_NO_BROWSER": "1"}


def t3_pair(host, port, env, ttl="30m"):
    r = subprocess.run(["t3", "pair", "--ttl", ttl, "--label", f"{ME.pw_name} (box t3)"],
                       env=dict(os.environ, **env), capture_output=True, text=True, timeout=60)
    url = next((l.split(":", 1)[1].strip() for l in r.stdout.splitlines()
                if l.startswith("Pairing URL:")), None)
    if not url:
        sys.exit("box t3: pairing failed:\n" + (r.stdout + r.stderr)[-1500:])
    return url


def listening(host, port):
    try:
        socket.create_connection((host, port), timeout=1).close()
        return True
    except OSError:
        return False


def t3_ensure(host, port, env, quiet=False):
    """Write the T3 user unit and make sure it's enabled and started. Doesn't wait for it."""
    os.makedirs(os.path.join(HOME, "projects"), exist_ok=True)
    os.makedirs(UNIT_DIR, exist_ok=True)
    unit = ["[Unit]", "Description=T3 Code (box t3)", "StartLimitIntervalSec=600", "StartLimitBurst=10", "",
            "[Service]", "WorkingDirectory=%h/projects",
            "Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"]
    unit += [f"Environment={k}={sd_escape(v)}" for k, v in env.items()]
    unit += ["ExecStart=/usr/local/bin/t3 serve", "Restart=on-failure", "RestartSec=5", "",
             "[Install]", "WantedBy=default.target", ""]
    path = os.path.join(UNIT_DIR, T3_UNIT)
    body = "\n".join(unit)
    try:
        changed = open(path).read() != body
    except FileNotFoundError:
        changed = True
    if changed:
        with open(path, "w") as f:
            f.write(body)
        sctl("daemon-reload", capture=quiet)
    if changed and listening(host, port):
        sctl("restart", T3_UNIT, capture=quiet)
    else:
        sctl("enable", "--now", T3_UNIT, capture=quiet)


def cmd_t3(a):
    if not shutil.which("t3"):
        sys.exit('T3 Code is not installed on this box. Ask the owner: box request "install t3 (npm)"')
    host, port, env = t3_env()
    if a.action == "stop":
        sys.exit(sctl("disable", "--now", T3_UNIT).returncode)
    if a.action == "logs":
        os.execvp("journalctl", ["journalctl", "--user", "-u", T3_UNIT, "-n", "200", "--no-pager"])
    if a.action == "status":
        up = listening(host, port)
        print(f"T3 Code: {'running' if up else 'not running'} at http://{host}:{port}/")
        return
    # start (if needed) + pair
    t3_ensure(host, port, env)
    if not listening(host, port):
        print("starting T3 Code (the first start downloads it, about 1 minute)…", file=sys.stderr)
    deadline = time.time() + 300
    while not listening(host, port):
        if time.time() > deadline:
            sys.exit("box t3: server did not come up; see `box t3 logs`")
        time.sleep(2)
    time.sleep(2)
    url = t3_pair(host, port, env)
    print(f"""
T3 Code is running at http://{host}:{port}/ (only you can use it, after pairing)

Open this link in your browser within 30 minutes to pair it:

  {url}

Need another device later? Run `box t3 pair` for a fresh link.
First time? Log in to your agent at {portal_url()} (or `box setup` in a terminal); T3 uses that login.
T3_PAIR_URL={url}""")


