def gather(sample=0.5):
    """sample: seconds to measure CPU over. Session start (every agent session waits for it) uses a short one;
    throttling there also comes from the kernel's own 10-second pressure average, so nothing is missed."""
    st = sb.read_json(STATUS_FILE, {}) or {}
    cg = sb.read_cgroup(sb.slice_path(ME.pw_uid))
    if cg:  # sample CPU over a short window
        time.sleep(sample)
        cg2 = sb.read_cgroup(sb.slice_path(ME.pw_uid))
        dt = cg2["t"] - cg["t"]
        cg2["cpu_pct"] = round((cg2["cpu_usec"] - cg["cpu_usec"]) / 1e6 / dt * 100) if dt else 0
        cg2["throttled"] = cg2["throttled_usec"] > cg["throttled_usec"] or cpu_pressure() > 10
        cg = cg2
    try:
        run = sbrunning.worth_mentioning(sbrunning.running(ME.pw_uid, HOME))
    except Exception:  # noqa: BLE001 - session start must never fail over this
        run = []
    return {"user": ME.pw_name, "friend": is_friend(), "ports": ports(),
            "limits": my_limits(), "live": cg,
            "box": sb.box_load(), "janitor": st, "running": run}


def undescribed_servers():
    """This account's `box serve` servers whose unit file has no X-Treehouse-About line (made before descriptions
    were asked for). Reads a few small files; never fails session start."""
    try:
        files = sorted(os.listdir(os.path.join(HOME, ".config", "systemd", "user")))
    except OSError:
        return []
    out = []
    for fn in files:
        m = re.fullmatch(r"sb-([A-Za-z0-9][A-Za-z0-9_-]{0,39})\.service", fn)
        if m and m.group(1) not in ("t3", "t3-proxy") and not sbrunning.server_meta(HOME, m.group(1)).get("about"):
            out.append(m.group(1))
    return out


def size_text(v):
    """'28160M' -> '27.5 GB' (limits as people read them); '' for nothing."""
    try:
        n = sb.parse_size(v) if v not in (None, "") else None
    except ValueError:
        return str(v)
    return sb.size_text(n) if n else ""


def running_line(it):
    """One item for agents' session-start text: names are the account's own text, so cleaned and quoted."""
    return (f"`{sbrunning.clean(it['name'], 60)}` ({sbrunning.KIND_LABEL.get(it['kind'], it['kind']).lower()}"
            + (f", {sbrunning.clean(it['detail'], 60)}" if it.get("detail") and it["kind"] in ("database", "container")
               else "")
            + f", {sb.size_text(it['mem'])}, up {sbrunning.ago(it.get('age'))})")


def recent_oom_kills(days=2):
    """What the machine stopped for this account when memory ran out (root writes oom/USER.jsonl, 0640 root:USER,
    from the janitor tick)."""
    out = []
    try:
        with open(os.path.join(sb.STATE_DIR, "oom", f"{ME.pw_name}.jsonl")) as f:
            for line in f.readlines()[-200:]:
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if isinstance(r, dict) and r.get("user") == ME.pw_name and r.get("ts", 0) > time.time() - days * 86400:
                    r["what"] = sb.printable(str(r.get("what") or "a process group"))[:120]
                    out.append(r)
    except OSError:
        pass
    return out[-3:]


def cpu_pressure():
    """% of the last 10 s some of this account's processes waited for CPU (throttled at the quota, or a busy box)."""
    try:
        with open(os.path.join(sb.slice_path(ME.pw_uid), "cpu.pressure")) as f:
            return float(f.readline().split("avg10=")[1].split()[0])
    except (OSError, IndexError, ValueError):
        return 0.0


