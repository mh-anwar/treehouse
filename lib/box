def drop_build_throttle():
    """Older versions capped build parallelism in new homes (MAKEFLAGS=-j2, Gradle workers): take out exactly
    those lines from the files we wrote, so builds use the machine. Idempotent; anything else is left alone."""
    files = {os.path.join(HOME, ".config", "environment.d", "60-sharedbox.conf"):
             re.compile(r"^(MAKEFLAGS=-j\d+|CMAKE_BUILD_PARALLEL_LEVEL=\d+|CARGO_BUILD_JOBS=\d+)$"),
             os.path.join(HOME, ".gradle", "gradle.properties"):
             re.compile(r"^(org\.gradle\.workers\.max=\d+|org\.gradle\.parallel=false)$")}
    for path, pat in files.items():
        try:
            with open(path) as f:
                cur = f.read()
        except OSError:
            continue
        if not cur or "sharedbox" not in cur.splitlines()[0]:
            continue  # not our file
        new = "".join(ln for ln in cur.splitlines(keepends=True) if not pat.match(ln.strip()))
        new = new.replace("this machine is shared. Keep builds polite.", "")
        if new != cur:
            with open(path, "w") as f:
                f.write(new)


