       box friends issues [--days N]             what everyone's agents logged with `box issue`
       box friends boxes ["NAME=IP NAME=IP"]     your treehouse boxes for the dashboard's Boxes card (same line
                                                 on every machine; Tailscale IPs; "" clears it)"""


def friends_ago(ts):
    if not ts:
        return "-"
    d = max(0, time.time() - float(ts))
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if d >= n:
            return f"{int(d // n)}{unit} ago"
    return "just now"


