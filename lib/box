PKG_RE = re.compile(r"[a-z0-9][a-z0-9@._+-]{0,99}")  # = sbdistro.PKG_NAME_RE (root checks again)
REQ_SENT = os.path.join(HOME, ".sharedbox", "requests-sent.json")
REQ_FINAL = ("installed", "done", "declined")


def my_requests():
    """My requests as root last recorded them, plus ones root hasn't picked up yet (state "sent")."""
    try:
        theirs = (sb.read_json(os.path.join(sb.USER_STATE, ME.pw_name, "requests.json"), {}) or {}).get("requests") or []
    except OSError:
        theirs = []
    known = {r.get("id") for r in theirs}
    sent = [dict(r, state="sent") for r in (sb.read_json(REQ_SENT, []) or [])
            if isinstance(r, dict) and r.get("id") not in known and time.time() - r.get("ts", 0) < 86400]
    return [r for r in theirs if isinstance(r, dict)] + sent


def request_line(r):
    what = ("install " + " ".join(r.get("packages") or []) if r.get("kind") == "install" else r.get("text") or "")
    state = {"sent": "sent, not picked up yet", "new": "received", "queued": "queued", "installing": "installing",
             "approved": "approved by the owner, installing", "waiting": "waiting for the owner",
             "installed": "installed", "done": "done", "declined": "declined"}.get(r.get("state"), r.get("state"))
    return (f"{fmt_ts(r['ts']) if r.get('ts') else '?'}  [{state}] {sb.printable(what)}"
            + (f"  ({sb.printable(r['reason'])})" if r.get("reason") else ""))


def cmd_request(a):
    words = list(a.text or [])
    if words == ["status"]:
        mine = my_requests()
        if a.json:
            print(json.dumps({"ok": True, "requests": mine}))
            return
        if not mine:
            print("no requests in the last 30 days")
        for r in mine:
            print(request_line(r))
        return
    pkgs = None
    if len(words) >= 2 and words[0] == "install":
        pkgs = [w.strip().lower() for w in words[1:]]
        if not all(PKG_RE.fullmatch(p) for p in pkgs) or len(pkgs) > 20:
            pkgs = None  # "install ffmpeg (system package) for ..." as separate words: free text
    text = " ".join(words).strip()
    if not text:
        sys.exit('usage: box request install PKG [PKG...] [--why "what it is for"]\n'
                 '       box request "anything else, in plain words"\n       box request status')
    if len(text) > 1000 or len(a.why or "") > 300:
        sys.exit("keep it under 1000 characters (--why: 300)")
    rid = f"{ME.pw_name}-{int(time.time())}-{os.getpid()}"
    body = json.dumps({"install": pkgs, "why": a.why or ""}) if pkgs else \
        (text + (f" (why: {a.why})" if a.why else "")) + "\n"
    path = os.path.join(sb.REQUESTS, rid + (".json" if pkgs else ".txt"))
    tmp = os.path.join(sb.REQUESTS, f".{rid}.tmp")
    try:
        # 0600: other friends can't list the directory but could guess names; written to a dotfile first,
        # so root never picks up half a request
        with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as f:
            f.write(body)
        os.rename(tmp, path)
    except OSError as e:
        sys.exit(provisioner_trouble(f"couldn't file the request ({e.strerror or e})"))
    sent = [r for r in (sb.read_json(REQ_SENT, []) or []) if isinstance(r, dict)
            and time.time() - r.get("ts", 0) < 86400][-50:]
    sent.append({"id": rid, "ts": int(time.time()), "kind": "install" if pkgs else "text",
                 **({"packages": pkgs} if pkgs else {"text": text})})
    os.makedirs(os.path.dirname(REQ_SENT), exist_ok=True)
    sb.write_json(REQ_SENT, sent, mode=0o600)
    rec = None
    if pkgs:  # most package requests are installed within a minute: wait for the outcome
        deadline = time.time() + (a.wait if a.wait is not None else 240)
        while time.time() < deadline:
            rec = next((r for r in my_requests() if r.get("id") == rid), None)
            if rec and rec.get("state") in REQ_FINAL + ("waiting",):
                break
            time.sleep(2)
    rec = rec or {"id": rid, "state": "sent"}
    if a.json:
        print(json.dumps({"ok": True, "id": rid, "request": rec}))
        return
    st = rec.get("state")
    if st == "installed":
