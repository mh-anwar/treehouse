def fmt_ts(ts):
    return time.strftime("%a %b %d %H:%M", time.localtime(ts))


# ---------- status ----------

def gather():
    st = sb.read_json(STATUS_FILE, {}) or {}
    cg = sb.read_cgroup(sb.slice_path(ME.pw_uid))
    if cg:  # sample CPU over a short window
        time.sleep(0.5)
        cg2 = sb.read_cgroup(sb.slice_path(ME.pw_uid))
        dt = cg2["t"] - cg["t"]
        cg2["cpu_pct"] = round((cg2["cpu_usec"] - cg["cpu_usec"]) / 1e6 / dt * 100) if dt else 0
        cg2["throttled"] = cg2["throttled_usec"] > cg["throttled_usec"]
        cg = cg2
    return {"user": ME.pw_name, "friend": is_friend(), "ports": ports(),
            "limits": my_limits() if is_friend() else None, "live": cg,
            "box": sb.box_load(), "janitor": st}


def scheduled_reboot():
    """Epoch seconds of a pending `shutdown -r`, or None."""
    try:
        with open("/run/systemd/shutdown/scheduled") as f:
            kv = dict(l.strip().split("=", 1) for l in f if "=" in l)
        if kv.get("MODE", "reboot") == "reboot" and kv.get("USEC"):
            return int(kv["USEC"]) / 1e6
    except (OSError, ValueError):
        pass
    return None


DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]


def reboot_days():
    return [d.strip()[:3].title() for d in CFG.get("SCHEDULED_REBOOT_DAYS", "").split(",")
            if d.strip()[:3].title() in DAYS]


def next_weekly_reboot(now=None):
    """Epoch seconds of the next SCHEDULED_REBOOT_DAYS reboot, or None."""
    days = reboot_days()
    try:
        hh, mm = (int(x) for x in CFG.get("REBOOT_TIME", "04:00").split(":")[:2])
    except ValueError:
        return None
    now = now or time.time()
    for i in range(8):
        t = time.localtime(now + i * 86400)
        if DAYS[t.tm_wday] not in days:
            continue
        ts = time.mktime((t.tm_year, t.tm_mon, t.tm_mday, hh, mm, 0, 0, 0, -1))
        if ts > now:
            return ts
    return None


def advice(g):
    out = []
    al = sb.security_alert(ME.pw_name)
    if al:
        out.append(f"SECURITY: on {fmt_ts(al['ts'])} a program running as this user "
                   f"(`{al.get('cmd') or al.get('exe') or '?'}`) opened the box's decoy secrets "
                   f"({al['file']}). Tell the user at the start of your next reply, in plain words: nothing "
                   "real leaked, but something on their account looked for passwords/keys, usually a "
                   "malicious package or script. Offer to check recently installed npm/pip packages, "
                   "autostarts (~/.config/autostart, systemd --user units, shell rc files) and running "
                   "processes. Never open files under the decoy directory yourself.")
    for n in agent_notices():
        out.append(f"Agent UPDATED for security on {fmt_ts(n['ts'])}: {n['name']} {n['from']} -> {n['to']} "
                   f"({n['why']}). Mention it to the user if they ask why a tool changed.")
    rb = scheduled_reboot()
    wk = next_weekly_reboot()
    if wk and wk - time.time() < 12 * 3600 and not (rb and abs(rb - wk) < 3600):
        out.append(f"The box will REBOOT on {fmt_ts(wk)} (scheduled weekly reboot). Only `box serve` "
                   "services and `box t3` come back by themselves. Save work and finish long jobs before then.")
    if rb:
        out.append(f"The box will REBOOT on {fmt_ts(rb)} for security updates. Only `box serve` "
                   "services and `box t3` come back by themselves. Save work and finish long jobs before then.")
    b = g["box"]
    if b["level"] == "busy":
        out.append("The box is BUSY right now. Postpone heavy builds/tests if possible; "
                   "if not, use `box heavy --` and reduce parallelism.")
    elif b["level"] == "moderate":
        out.append("The box is moderately loaded. Use `box heavy --` for builds.")
    live = g["live"] or {}
    if live.get("mem_high") and live["mem"] > 0.85 * live["mem_high"]:
        out.append("You are close to your RAM limit. Stop unused servers, daemons, or watchers "
                   "(e.g. `./gradlew --stop`) before starting anything else.")
    if live.get("throttled"):
        out.append("Your CPU is being throttled at your quota. Lower parallelism.")
    j = g["janitor"]
    if j.get("over_budget"):
        out.append(f"You are OVER your disk budget. Caches and build outputs were wiped. "
                   f"Delete things you don't need, or the oldest idle projects will be removed "
                   f"after {fmt_ts(j['over_budget_deadline'])}." if j.get("over_budget_deadline")
                   else "You are OVER your disk budget. Free space now.")
    for p in j.get("projects", []):
        if p.get("delete_on"):
            out.append(f"Project ~/projects/{p['name']} will be DELETED on {fmt_ts(p['delete_on'])} "
                       f"(idle {p['idle_days']}d). Touch/commit to keep it, or push it to git.")
    if b["disk_free"] < b["disk_total"] * 0.1:
        out.append("The machine's disk is almost full. Avoid large downloads.")
    return out


