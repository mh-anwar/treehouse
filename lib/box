def t3_legacy(host):
    """An older T3 (from before the socket) still running on the public port itself, without the socket?"""
    return (sctl("is-active", T3_SOCKET, capture=True).stdout.strip() != "active"
            and listening(host, ports()[0]))


def t3_up(host, env):
    """Is T3 itself running (not just the socket that wakes it)?"""
    return listening(host, int(env["T3CODE_PORT"])) or t3_legacy(host)


def t3_live_env(host, env):
