UNIT_DIR = os.path.join(HOME, ".config", "systemd", "user")


def sctl(*args, capture=False):
    env = dict(os.environ, XDG_RUNTIME_DIR=f"/run/user/{ME.pw_uid}")
    return subprocess.run(["systemctl", "--user", *args], env=env, text=True,
                          capture_output=capture)


def unit(name):
    if not name.replace("-", "").replace("_", "").isalnum() or len(name) > 40:
        sys.exit("service name: letters, digits, - and _ only")
    if name in ("t3", "t3-proxy"):
        sys.exit(f"service name: {name} is taken by T3; pick another")
    return f"sb-{name}.service"


def sd_escape(s):
    return s.replace("%", "%%").replace("$", "$$")


def list_services():
    r = sctl("list-units", "--all", "--plain", "--no-legend", "--type=service", "sb-*", capture=True)
    out = []
    for line in r.stdout.splitlines():
        parts = line.split(None, 4)
        if len(parts) >= 4 and parts[0].startswith("sb-") and parts[0] != T3_PROXY:  # part of T3, not theirs
            out.append({"name": parts[0][3:-8], "state": parts[3] if parts[2] == "active" else parts[2]})
    seen = {s["name"] for s in out}
    try:  # stopped with `box serve stop` (disabled): systemd unloads it, but its unit file is still ours
        files = sorted(os.listdir(UNIT_DIR))
    except OSError:
        files = []
    for fn in files:
        n = fn[3:-8] if fn.startswith("sb-") and fn.endswith(".service") else ""
        if n and n not in seen and fn != T3_PROXY and n not in ("t3", "t3-proxy"):
            out.append({"name": n, "state": "stopped"})
    return out


SERVE_USAGE = ('box serve add NAME --about "what it does, in one plain sentence" (--important | --safe-to-stop) '
               '[--keep-running] [--hackathon-pause] [--project P] [--port P] [--url URL] -- COMMAND...')


def serve_opts(argv, need_cmd=False):
    """`box serve` options can come anywhere after NAME (argparse's REMAINDER would swallow them as the command):
    everything before the first "--" is options, everything after it the command."""
    if "--" in argv:
        i = argv.index("--")
        opts, cmd = argv[:i], argv[i + 1:]
    elif need_cmd:
        k = 0  # no "--": options first, the command from its first word that isn't an option or an option's value
        vals = ("--about", "--project", "--port", "--url")
        while k < len(argv) and argv[k].startswith("--"):
            k += 2 if argv[k] in vals else 1
        opts, cmd = argv[:k], argv[k:]
    else:
        opts, cmd = argv, []
    ap = argparse.ArgumentParser(prog="box serve", add_help=False)
    ap.add_argument("--about"); ap.add_argument("--project"); ap.add_argument("--url")
    ap.add_argument("--port", type=int)
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--important", action="store_true"); g.add_argument("--safe-to-stop", action="store_true")
    k = ap.add_mutually_exclusive_group()
    k.add_argument("--keep-running", action="store_true"); k.add_argument("--no-keep-running", action="store_true")
    h = ap.add_mutually_exclusive_group()
    h.add_argument("--hackathon-pause", action="store_true"); h.add_argument("--no-hackathon-pause", action="store_true")
    o, extra = ap.parse_known_args(opts)
    if extra:
        sys.exit(f"box serve: unknown option {extra[0]}. Usage: {SERVE_USAGE}")
    return o, cmd


def serve_creator():
    """Who made it: this account, plus the agent and T3 thread when the environment says (no secrets)."""
    agent = os.environ.get("AI_AGENT", "")
    agent = ("Claude Code" if agent.startswith("claude") or os.environ.get("CLAUDECODE") else
             "Codex" if agent.startswith("codex") or os.environ.get("CODEX_SANDBOX") or os.environ.get("CODEX_HOME")
             else "opencode" if agent.startswith("opencode") else
             "Antigravity" if agent.startswith(("antigravity", "gemini")) else agent.split("_")[0][:40])
    thread = os.environ.get("T3CODE_THREAD_ID", "")
    return {"by": ME.pw_name, "agent": agent, "thread": thread if re.fullmatch(r"[A-Za-z0-9:_.-]{1,80}", thread) else ""}


def default_project(wd):
    """The project a server belongs to: the first folder under ~ it runs from, else ""."""
    if wd.startswith(HOME + "/"):
        return wd[len(HOME) + 1:].split("/")[0][:80]
    return ""


def meta_lines(meta):
    """The X-Treehouse-* lines for a unit's [Unit] section (see sbrunning.META_KEYS)."""
    out = []
    for k, key in sbrunning.META_KEYS.items():
        v = meta.get(key)
        if key == "keep":
            v = "yes" if v else ""
        if v:
            out.append(f"X-Treehouse-{k}={sd_escape(sbrunning.meta_value(v, 300))}")
    return out


def keep_lines(keep):
    """[Service] lines that depend on keep-running: always restart it (even after an out-of-memory stop), and ask
    systemd-oomd to pick something else when memory runs out (it honours that for the account's own services)."""
    return ["Restart=always", "RestartSec=5", "ManagedOOMPreference=omit"] if keep else ["Restart=on-failure", "RestartSec=5"]


def serve_unit_text(name, wd, port, cmd, meta):
    body = ["[Unit]", f"Description={sd_escape(sbrunning.meta_value(meta.get('about') or 'box serve ' + name, 200))}",
            *meta_lines(meta), "StartLimitIntervalSec=600", "StartLimitBurst=10", "",
            "[Service]", f"WorkingDirectory={sd_escape(wd)}",
            f"Environment=PATH={sd_escape(os.environ.get('PATH', '/usr/bin:/bin'))}"]
    if port is not None:
        body.append(f"Environment=PORT={port}")
    body += [f"ExecStart={sd_escape(shlex.join(cmd))}", *keep_lines(meta.get("keep")),
             "", "[Install]", "WantedBy=default.target", ""]
    return "\n".join(body)


def rewrite_meta(name, meta):
    """Change a server's description / settings in place: its unit file keeps everything else."""
    path = os.path.join(UNIT_DIR, f"sb-{name}.service")
    with open(path) as f:
        lines = f.read().splitlines()
    drop = ("X-Treehouse-", "Restart=", "RestartSec=", "ManagedOOMPreference=")
    out = []
    for ln in lines:
        if ln.startswith(drop):
            continue
        if ln.startswith("Description="):
            ln = f"Description={sd_escape(sbrunning.meta_value(meta.get('about') or 'box serve ' + name, 200))}"
            out.append(ln)
            out += meta_lines(meta)
            continue
        out.append(ln)
        if ln.startswith("ExecStart="):
            out += keep_lines(meta.get("keep"))
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(out) + "\n")
    os.replace(tmp, path)
    sctl("daemon-reload")


def serve_meta(name):
    return sbrunning.server_meta(HOME, name)


def server_line(s, meta, ip=""):
    """One server for `box serve ls`: name, state, what it's for, settings."""
    bits = [f"{s['name']:<20} {s['state']:<10}" + (f" port {meta['port']}" if meta.get("port") else "")]
    bits.append("    " + (meta.get("about") or "No description yet. Started with: " + (meta.get("exec") or "?")[:120]
                          + f"\n    Add one: box serve describe {s['name']} --about \"what it does\" --important|--safe-to-stop"))
    flags = [x for x in ("keep running" if meta.get("keep") else "",
                         "may pause during hackathons" if meta.get("hackathon") == "pause" else "",
                         {"important": "important", "safe-to-stop": "safe to stop"}.get(meta.get("importance"), ""),
                         f"project {meta['project']}" if meta.get("project") else "",
                         f"made by {meta.get('by')}" + (f" ({meta['agent']})" if meta.get("agent") else "")
                         if meta.get("by") else "") if x]
    if flags:
        bits.append("    " + " · ".join(flags))
    url = meta.get("url") or (f"http://{ip}:{meta['port']}/" if ip and meta.get("port") else "")
    if url:
        bits.append("    " + url)
    return "\n".join(bits)



def temporary_dir(d):
    """A folder that gets deleted on its own: a T3 worktree (removed with its thread), /tmp and the like. A service
    started there fails forever once it's gone (systemd: 200/CHDIR), silently."""
    d = os.path.realpath(d)
    under = lambda r: d == r or d.startswith(r + "/")  # noqa: E731
    if under(os.path.realpath(os.path.join(HOME, ".t3", "worktrees"))):
        return True
    if under(os.path.realpath(HOME)):
        return False
    return any(under(r) for r in ("/tmp", "/var/tmp", "/dev/shm", "/run/user"))


def serve_workdir(cwd, cmd):
    """(WorkingDirectory, note) for `box serve add`; (None, error) when the service would break later.
    From a temporary folder: the command's own folder if that lasts, else ~. Refused when the command or a file it
    names lives in the temporary folder: it would stop working as soon as the folder is deleted."""
    if not temporary_dir(cwd):
        return cwd, ""
    fix = ("Run `box serve add` from the project's own folder in ~ (or put the code in ~/services/NAME) "
           "and use full paths.")
    if temporary_dir(cmd[0]):
        return None, (f"box serve: {cmd[0]} is in a temporary folder (a T3 worktree or /tmp); the service would stop "
                      f"for good once that folder is deleted. {fix}")
    for arg in cmd[1:]:
        if arg.startswith("-") or os.path.isabs(arg) or "/" not in arg and "." not in arg:
            continue
        if os.path.exists(os.path.join(cwd, arg)):
            return None, (f"box serve: {arg} is in {cwd}, a temporary folder (a T3 worktree or /tmp); the service "
                          f"would stop for good once that folder is deleted. {fix}")
    exe_dir = os.path.dirname(cmd[0])
    wd = exe_dir if exe_dir.startswith(HOME + "/") and not temporary_dir(exe_dir) else HOME
    return wd, (f"note: {cwd} is a temporary folder, so the service runs in {wd} instead "
                "(it would stop for good once the folder is deleted).")


def broken_services():
    """This account's `box serve` units whose folder is gone (they fail with 200/CHDIR at every start)."""
    out = []
    try:
        files = sorted(os.listdir(UNIT_DIR))
    except OSError:
        return out
    for fn in files:
        if not (fn.startswith("sb-") and fn.endswith(".service")) or fn in ("sb-t3.service", T3_PROXY):
            continue
        try:
            with open(os.path.join(UNIT_DIR, fn)) as f:
                wd = next((ln.split("=", 1)[1].strip() for ln in f if ln.startswith("WorkingDirectory=")), "")
        except OSError:
            continue
        wd = wd.replace("%%", "%").replace("$$", "$")
        if wd and not wd.startswith(("~", "-")) and not os.path.isdir(wd):
            out.append({"name": fn[3:-8], "dir": wd})
    return out


def cmd_serve(a):
    act = a.action
    if act == "ls":
        svcs = list_services()
        if not svcs:
            print(f"No servers yet. Start one with: {SERVE_USAGE}")
        ip = sb.tailscale_ip4() or ""
        if getattr(a, "json", False) or "--json" in (a.cmd or []):
            print(json.dumps({"ok": True, "servers": [dict(s, **serve_meta(s["name"])) for s in svcs]}))
            return
        for s in svcs:
            print(server_line(s, serve_meta(s["name"]), ip))
        return
    if not a.name:
        sys.exit(f"usage: box serve {act} NAME")
    u = unit(a.name)
    if act == "add":
        o, cmd = serve_opts(a.cmd or [], need_cmd=True)
        if a.port is not None and o.port is None:
            o.port = a.port
        if not cmd:
            sys.exit(f"usage: {SERVE_USAGE}")
        missing = []
        if not (o.about or "").strip():
            missing.append('--about "one plain sentence: what it does and who uses it"')
        if not (o.important or o.safe_to_stop or o.keep_running):
            missing.append("--important (people rely on it) or --safe-to-stop (fine to stop when memory is short)")
        if missing:
            sys.exit("box serve add needs to know what this server is, so people looking at the machine can tell. "
                     "Add " + " and ".join(missing) + f".\nExample: box serve add {a.name} --about \"Telegram bot for "
                     f"the study group\" --important --keep-running -- {shlex.join(cmd)[:80]}\nFull form: {SERVE_USAGE}")
        exe = shutil.which(cmd[0])
        if not exe:
            sys.exit(f"command not found: {cmd[0]}")
        cmd[0] = os.path.abspath(exe)
        wd, why = serve_workdir(os.getcwd(), cmd)
        if wd is None:
            sys.exit(why)
        if why:
            print(why, file=sys.stderr)
        r = ports()
        port = o.port
        if r and port is None:
            port = next((p for p in range(r[0] + 1, r[1]) if not port_in_use(p)), None)  # first+last: T3
        if r and port in r:
            sys.exit(f"port {port} is reserved for your T3 server; pick one from {r[0] + 1}-{r[1] - 1}")
        if r and port is not None and not (r[0] <= port <= r[1]):
            print(f"warning: port {port} is outside your range {r[0]}-{r[1]}", file=sys.stderr)
        if wd.startswith(HOME + "/") and wd != HOME:
            print(f"note: the project this runs from won't be archived while this server exists (even if stopped). "
                  f"`box serve rm {a.name}` releases it.", file=sys.stderr)
        meta = dict(serve_creator(), about=o.about.strip(), project=(o.project or default_project(wd)),
                    created=time.strftime("%Y-%m-%d %H:%M"), url=o.url or "", keep=bool(o.keep_running),
                    importance="important" if o.important or o.keep_running else "safe-to-stop",
                    hackathon="pause" if o.hackathon_pause and not o.keep_running else "")
        os.makedirs(UNIT_DIR, exist_ok=True)
        with open(os.path.join(UNIT_DIR, u), "w") as f:
            f.write(serve_unit_text(a.name, wd, port, cmd, meta))
        sctl("daemon-reload")
        r2 = sctl("enable", "--now", u)
        if r2.returncode == 0:
            print(f"started {a.name}" + (f" on port {port} (also in $PORT)" if port else "")
                  + (". It's marked keep running: nothing stops it automatically" if meta["keep"] else "")
                  + f". logs: box serve logs {a.name}")
        else:
            print(f"Couldn't start {a.name}. See why: box serve logs {a.name}", file=sys.stderr)
        sys.exit(r2.returncode)
    if act in ("describe", "keep", "hackathon"):
        if not os.path.isfile(os.path.join(UNIT_DIR, u)):
            sys.exit(f"No server called {a.name}. See yours: box serve ls")
        meta = serve_meta(a.name)
        if act == "keep":
            v = (a.cmd or [""])[0]
            if v not in ("on", "off"):
                sys.exit(f"usage: box serve keep {a.name} on|off   (on: nothing stops it automatically)")
            meta["keep"] = v == "on"
            if meta["keep"]:
                meta["importance"], meta["hackathon"] = "important", ""
        elif act == "hackathon":
            v = (a.cmd or [""])[0]
            if v not in ("pause", "keep"):
                sys.exit(f"usage: box serve hackathon {a.name} pause|keep   (pause: stopped while hackathon mode is on, "
                         "started again when it ends)")
            if v == "pause" and meta.get("keep"):
                sys.exit(f"{a.name} is marked keep running, so hackathon mode never pauses it. Turn that off first: "
                         f"box serve keep {a.name} off")
            meta["hackathon"] = "pause" if v == "pause" else ""
        else:
            o, _ = serve_opts(a.cmd or [])
            if o.about is not None:
                meta["about"] = o.about.strip()
            if o.project is not None:
                meta["project"] = o.project.strip()
            if o.url is not None:
                meta["url"] = o.url.strip()
            if o.important or o.safe_to_stop:
                meta["importance"] = "important" if o.important else "safe-to-stop"
            if o.keep_running or o.no_keep_running:
                meta["keep"] = bool(o.keep_running)
            if o.hackathon_pause or o.no_hackathon_pause:
                meta["hackathon"] = "pause" if o.hackathon_pause and not meta.get("keep") else ""
            if not meta.get("about"):
                sys.exit(f'box serve describe {a.name} --about "what it does, in one plain sentence" '
                         "[--important|--safe-to-stop] [--keep-running|--no-keep-running] [--hackathon-pause|"
                         "--no-hackathon-pause] [--project P] [--url URL]")
            if not meta.get("by"):
                meta.update({k: v for k, v in serve_creator().items() if k != "by" or not meta.get("by")})
        rewrite_meta(a.name, meta)
        print(server_line({"name": a.name, "state": next((s["state"] for s in list_services() if s["name"] == a.name),
                                                         "stopped")}, serve_meta(a.name), sb.tailscale_ip4() or ""))
        return
    if act == "logs":
        os.execvp("journalctl", ["journalctl", "--user", "-u", u, "-n", "200", "--no-pager"]
                  + (["-f"] if a.follow else []))
    if act == "rm":
        sctl("disable", "--now", u)
        try:
            os.unlink(os.path.join(UNIT_DIR, u))
        except FileNotFoundError:
            pass
        sctl("daemon-reload")
        print(f"removed {a.name}")
        return
    if act in PORTAL_SERVER_OPS:  # stop keeps it off across reboots; start/restart turn it back on for good
        if act == "stop" and serve_meta(a.name).get("keep") and "--force" not in (a.cmd or []):
            sys.exit(f"{a.name} is marked keep running. Stop it only if its owner asked: box serve stop {a.name} --force")
        r = serve_op(act, u)
        if r.returncode:
            sys.exit(f"box serve {act} {a.name}: " + (r.stderr or r.stdout or "failed").strip()[-300:])
        print(f"{a.name}: " + {"stop": "stopped (stays off across reboots until `box serve start`)",
                                 "start": "started", "restart": "restarted"}[act])
        return
    sys.exit(sctl(act, u).returncode)


