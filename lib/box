AGENT_COMMS = {"claude": "claude", "codex": "codex", "gemini": "gemini", "opencode": "opencode",
               "aider": "aider", "cursor-agent": "cursor", "goose": "goose", "amp": "amp"}


def which_agent():
    """Best guess at the coding agent this runs under (env first, then the process tree)."""
    if os.environ.get("CLAUDECODE"):
        return "claude"
    if os.environ.get("AI_AGENT"):
        return os.environ["AI_AGENT"].split("_")[0][:40]
    for k, name in (("CODEX_SANDBOX", "codex"), ("CODEX_THREAD_ID", "codex"),
                    ("GEMINI_CLI", "gemini"), ("OPENCODE", "opencode")):
        if os.environ.get(k):
            return name
    pid = os.getppid()
    for _ in range(12):
        try:
            with open(f"/proc/{pid}/stat") as f:
                st = f.read()
            comm = st[st.index("(") + 1:st.rindex(")")]
            pid = int(st[st.rindex(")") + 2:].split()[1])
        except (OSError, ValueError, IndexError):
            break
        for k, name in AGENT_COMMS.items():
            if comm.startswith(k):
                return name
        if pid <= 1:
            break
    return "human" if sys.stdin.isatty() else "unknown"


ISSUES_PER_DAY = 25


def log_issue(text, kind="other", auto=False, dedupe_s=600):
    """Append one issue; skip exact repeats from the last `dedupe_s` seconds. True if written."""
    text = " ".join(text.split())[:2000]
    if not text:
        return False
    now = time.time()
    mine = read_my_issues()
    norm = re.sub(r"[^a-z0-9]+", " ", text.lower()).strip()
    recent = [r for r in mine if now - r.get("ts", 0) < dedupe_s]
    if any(re.sub(r"[^a-z0-9]+", " ", str(r.get("text", "")).lower()).strip() == norm for r in recent):
        return False
    if sum(1 for r in mine if now - r.get("ts", 0) < 86400) >= ISSUES_PER_DAY:  # an agent stuck in a loop
        return False
    cwd = os.getcwd() if os.path.exists(".") else ""
    rec = {"ts": round(now), "kind": kind if kind in sb.ISSUE_KINDS else "other", "text": text,
           "agent": which_agent(), "cwd": cwd, "auto": auto,
           "session": os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("CODEX_THREAD_ID")
           or os.environ.get("T3CODE_THREAD_ID") or ""}
    os.makedirs(os.path.dirname(ISSUES_FILE), mode=0o700, exist_ok=True)
    fd = os.open(ISSUES_FILE, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write(json.dumps(rec) + "\n")
        size = f.tell()
    if size > ISSUES_MAX_BYTES:  # keep the newest half
        with open(ISSUES_FILE, "rb") as f:
            f.seek(size - ISSUES_MAX_BYTES // 2)
            f.readline()
            tail = f.read()
        tmp = ISSUES_FILE + ".tmp"
        with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600), "wb") as f:
            f.write(tail)
        os.replace(tmp, ISSUES_FILE)
    return True


def read_my_issues(since=0):
    out = []
    try:
        with open(ISSUES_FILE, errors="replace") as f:
            for line in f:
                try:
                    r = json.loads(line)
                    if r.get("ts", 0) >= since:
                        out.append(r)
                except ValueError:
                    pass
    except OSError:
        pass
    return out


def auto_issues():
    """Log slowdowns the agent can't see itself: RAM soft-limit throttling, CPU throttling, OOM kills.

    Called at session start (`box status --agent`); at most one entry per signal per day.
    """
    path = sb.slice_path(ME.pw_uid)
    cur = {}
    try:
        with open(os.path.join(path, "memory.events")) as f:
            ev = dict(l.split() for l in f if l.strip())
        cur["mem_high"], cur["oom_kill"] = int(ev.get("high", 0)), int(ev.get("oom_kill", 0))
        with open(os.path.join(path, "cpu.stat")) as f:
            cs = dict(l.split() for l in f if l.strip())
        cur["throttled_usec"] = int(cs.get("throttled_usec", 0))
    except (OSError, ValueError):
        return
    st = sb.read_json(AUTO_STATE, {}) or {}
    prev, last = st.get("counters"), st.get("logged", {})
    now = time.time()
    if prev:
        cg = sb.read_cgroup(path) or {}
        d_high = cur["mem_high"] - prev.get("mem_high", 0)
        d_oom = cur["oom_kill"] - prev.get("oom_kill", 0)
        d_thr = (cur["throttled_usec"] - prev.get("throttled_usec", 0)) / 1e6
        found = []
        if d_oom > 0:
            found.append(("oom", "limit", f"{d_oom} process(es) of {ME.pw_name} were OOM-killed "
                          f"(hard RAM limit {sb.human(cg.get('mem_max')) if cg.get('mem_max') else 'max'})"))
        if d_high > 100:
            found.append(("mem_high", "slow", f"RAM soft limit hit {d_high} times since last session "
                          f"(memory.high {sb.human(cg.get('mem_high')) if cg.get('mem_high') else 'max'}, "
                          f"now using {sb.human(cg.get('mem', 0))}); processes were throttled"))
        if d_thr > 60:
            found.append(("cpu", "slow", f"CPU quota throttled processes for {d_thr / 60:.0f} min since "
                          "last session"))
        for key, kind, text in found:
            if now - last.get(key, 0) > 86400:
                if log_issue(text, kind, auto=True):
                    last[key] = now
    os.makedirs(os.path.dirname(AUTO_STATE), mode=0o700, exist_ok=True)
    sb.write_json(AUTO_STATE, {"counters": cur, "logged": last}, mode=0o600)


def cmd_issue(a):
    text = " ".join(a.text).strip()
    if not text:
        sys.exit('usage: box issue [--kind slow|broken|missing|limit|confusing|other] "what happened, '
                 'what you tried, what it cost"')
    if log_issue(text, a.kind, dedupe_s=600):
        print(f"logged to {ISSUES_FILE}. The box owner reviews these. Keep working around it.")
    else:
        print("already logged in the last 10 minutes; not repeated.")


def cmd_issues(a):
    rows = read_my_issues(time.time() - a.days * 86400)
    if a.json:
        print(json.dumps(rows, indent=2))
        return
    if not rows:
        print(f"no issues logged in the last {a.days} days ({ISSUES_FILE})")
    for r in rows:
        print(f"{fmt_ts(r.get('ts', 0))}  [{r.get('kind', '?')}]{' (auto)' if r.get('auto') else ''} "
              f"{r.get('agent', '?')}: {sb.printable(r.get('text', ''))}")


# ---------- internal (called by root tools via setpriv, as this user) ----------

# ---------- web portal helpers (box _portal; called as the user by sharedbox-admin) ----------
# Lets someone with only a browser start T3 and log in to their agents/GitHub from the join page.
# Every action prints exactly one JSON line on stdout.

PORTAL_LOGINS = {
    # key: (label, command, the user pastes a code back?)
    # a one-year token (`claude setup-token`): it doesn't rotate, so the same one works on every box (copied by
    # federation, read by the claude shim). `claude auth login` tokens rotate and break when copied.
    "claude": ("Claude", ["claude", "setup-token"], True),
    "codex": ("Codex (ChatGPT)", ["codex", "login", "--device-auth"], False),
    "gh": ("GitHub", ["gh", "auth", "login", "--hostname", "github.com", "--git-protocol", "https", "--web"],
           False),
    # links this account's T3 Code to the friend's own T3 account: the T3 app on their laptop then sees this box
    # from anywhere (T3's own relay), no Tailscale or Cloudflare login needed
    "t3connect": ("T3 Connect", ["t3", "connect", "link", "--headless"], False),
    # Google's Antigravity CLI: prints a Google sign-in link (indented, ~700 characters), reads the code the page then
    # shows, saves the token and exits. Never copied to the other boxes (one sign-in per box, like ChatGPT).
    "antigravity": ("Google (Antigravity)", ["antigravity", "acp", "--login"], True),
}
LOGIN_SOCK = "sblogin"
URL_RE = re.compile(r"https://[^\s\"'<>]+")
DEVICE_CODE_RE = re.compile(r"(?:[Cc]ode:?\s*|^\s*)([A-Z0-9]{4}-[A-Z0-9]{4,6})\s*$", re.M)  # alone, or after
# "code:" / "Code:" (T3 Connect prints "Code: ABCD-EFGH")
PASTE_RE = re.compile(r"[A-Za-z0-9#_.~+/=-]{4,600}")


def t3_connect_on():
    """Is this account's T3 Code linked to a T3 account (T3 Connect)? T3 keeps the link in its data folder
    (`t3 status` reports the T3 desktop service instead, which friends' accounts don't use)."""
    return os.path.exists(os.path.join(HOME, ".t3", "userdata", "secrets", "cloud-linked-user-id.bin"))


AGY_TOKEN = os.path.join(HOME, ".gemini", "antigravity-cli", "antigravity-oauth-token")
AGY_CHECK = os.path.join(HOME, ".sharedbox", "antigravity-check.json")
AGY_OK_TTL = 600  # a "signed in" answer is re-checked after this many seconds: Google can revoke or expire the grant
#                   without the CLI ever rewriting the token file


def antigravity_ok(fresh=False):
    """Signed in to Antigravity: its token file has something in it, and `antigravity models` doesn't ask to sign in
    (~1 s; when it can't tell, e.g. offline, the file decides). A "signed out" answer is kept for that version of the
    token file (a new sign-in rewrites it); a "signed in" one only for AGY_OK_TTL. fresh=True skips the cache."""
    try:
        st = os.stat(AGY_TOKEN)
    except OSError:
        return False
    if not st.st_size:
        return False
    seen = sb.read_json(AGY_CHECK, {}) or {}
    if not fresh and isinstance(seen, dict) and seen.get("key") == f"{st.st_mtime_ns}:{st.st_size}":
        if not seen.get("ok"):
            return False
        at = seen.get("at")
        if isinstance(at, (int, float)) and 0 <= time.time() - at < AGY_OK_TTL:
            return True
    ok = True
    try:
        r = subprocess.run(["antigravity", "models"], env=dict(user_env(), AGY_CLI_DISABLE_AUTO_UPDATE="true"),
                           stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=20)
        ok = r.returncode == 0 or "sign in" not in (r.stdout + r.stderr).lower()
    except (OSError, subprocess.TimeoutExpired):
        pass
    try:  # the check may have refreshed the token: remember the file as it is now
        st = os.stat(AGY_TOKEN)
        os.makedirs(os.path.dirname(AGY_CHECK), exist_ok=True)
        sb.write_json(AGY_CHECK, {"key": f"{st.st_mtime_ns}:{st.st_size}", "ok": ok, "at": time.time()},
                      mode=0o600)
    except OSError:
        pass
    return ok


def portal_logged_in(key, fresh=False):
    if key == "gh":
        return gh_ok()
    if key == "t3connect":
        return t3_connect_on()
    if key == "antigravity":
        return antigravity_ok(fresh)
    for name, _, _, files, envs, _ in AGENTS:
        if name == key:
            return logged_in(files, envs)
    return False


def user_env():
    return dict(os.environ, PATH=f"{HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin",
                XDG_RUNTIME_DIR=f"/run/user/{ME.pw_uid}")


def tmux(*args):
    return subprocess.run(["tmux", "-L", LOGIN_SOCK, *args], env=user_env(),
                          capture_output=True, text=True, timeout=20)


def login_screen(key):
    return tmux("capture-pane", "-p", "-J", "-S", "-300", "-t", key).stdout


def gh_finish():
    """After a GitHub login: git credential helper + a git identity if none is set."""
    env = user_env()
    subprocess.run(["gh", "auth", "setup-git"], env=env, capture_output=True, timeout=30)
    name, email = git_ident()
    if name and email:
        return
    r = subprocess.run(["gh", "api", "user", "--jq", '[.id, .login, .name // ""] | @tsv'],
                       env=env, capture_output=True, text=True, timeout=30)
    try:
        uid, login, full = r.stdout.rstrip("\n").split("\t")
    except ValueError:
        return
    if not name:
        subprocess.run(["git", "config", "--global", "user.name", full or login])
    if not email:
        subprocess.run(["git", "config", "--global", "user.email", f"{uid}+{login}@users.noreply.github.com"])


def portal_status():
    out = {"logins": {}, "t3": None}
    for key, (label, cmd, _) in PORTAL_LOGINS.items():
        if shutil.which(cmd[0]):
            out["logins"][key] = {"label": label, "ok": portal_logged_in(key)}
            if out["logins"][key]["ok"]:
                mark_setup_done(key)  # also covers friends who logged in before setup-done was written here
    if out["logins"].get("gh", {}).get("ok") and not all(git_ident()):
        gh_finish()
    r, host = ports(), sb.tailscale_ip4()
    if r and host and shutil.which("t3"):
        _, _, env = t3_env()
        out["t3"] = {"url": f"http://{host}:{r[0]}/", "running": t3_up(host, env)}
        out["t3"]["app"] = t3_app_paired()  # the start card leads with "Open T3" once the app has connected
    name, email = git_ident()
    out["git"] = {"name": name, "email": email}
    out["ssh"] = bool(ssh_keys())
    # this person's other boxes and which logins are done there (from the last federation pass / approvals)
    st = sb.read_json(FED_STATE, {}) or {}
    out["boxes"] = {p: {"ssh": bool(v.get("ssh")), "logins": dict(v.get("logins") or {})}
                    for p, v in (st.get("peers") or {}).items() if isinstance(v, dict)}
    out["box"] = st.get("self") or socket.gethostname().split(".")[0]
    if len(sb.boxes(CFG)) > 1:  # the Account tab's "Projects on all your boxes" (lib/sbprojects.py)
        try:
            import sbprojects
            out["projects"] = sbprojects.summary(HOME, projects_peers())
        except Exception as ex:  # noqa: BLE001 - the rest of the dashboard must still load
            out["projects"] = {"ok": False, "error": str(ex)[:200]}
    return out


def portal_t3(pair, app=False, label=None, ttl="30m"):
    if not shutil.which("t3"):
        return {"ok": False, "error": "T3 Code isn't installed on this box yet. Ask the owner."}
    r, host = ports(), sb.tailscale_ip4()
    if not r or not host:
        return {"ok": False, "error": "Tailscale isn't running on the box. Ask the owner."}
    host, port, env = t3_env()
    t3_ensure(host, port, env, quiet=True)
    if not pair:
        return {"ok": True}
    deadline = time.time() + 150  # the very first start downloads T3
    while not t3_up(host, env):
        if time.time() > deadline:
            return {"ok": False, "starting": True,
                    "error": "T3 Code is still starting (the first start downloads it). Try again in a minute."}
        time.sleep(2)
    time.sleep(2)
    env = t3_live_env(host, env)
    t3_starter(env)
    label = label or (f"{ME.pw_name} T3 app" if app else f"{ME.pw_name} (join page)")  # the label spots the app later
    r = subprocess.run(["t3", "pair", "--ttl", ttl, "--label", label],
                       env=dict(user_env(), **env), capture_output=True, text=True, timeout=60)
    url = next((l.split(":", 1)[1].strip() for l in r.stdout.splitlines() if l.startswith("Pairing URL:")), None)
    if not url:
        return {"ok": False, "error": "pairing failed; try again, or ask the owner to check `box t3 logs`"}
    url = public_t3_url(url, host, port)
    out = {"ok": True, "pair_url": url, "app_link": sbconnect.t3_app_link(url), "url": f"http://{host}:{port}/"}
    if app:  # for the setup prompt: the apps already connected (the laptop agent can't read the app's settings)
        out["apps"] = t3_app_sessions()
    return out


def app_setup_prompt(url):
    """The setup prompt for the agent on the friend's laptop, with what the box knows (their Tailscale account,
    T3 apps already connected): the same text as the dashboard's "Make a setup prompt"."""
    rec = (sb.registry().get("users") or {}).get(ME.pw_name) or {}
    ts = sbconnect.ts_facts(sb.tailscale_status(), rec)
    return sbconnect.app_prompt(url, portal_url(), socket.gethostname(), ts_login=ts["login"], ts_mode=ts["mode"],
                                apps=t3_app_sessions(), expires=sbconnect.pair_expires(time.time()))


def t3_json(args, env=None, timeout=60):
    """Run `t3 ARGS --json` against this account's T3 and parse the output; None on any trouble."""
    host, port, tenv = t3_env()
    r = subprocess.run(["t3", *args, "--json"], env=dict(user_env(), **t3_live_env(host, tenv), **(env or {})),
                       capture_output=True, text=True, errors="replace", timeout=timeout)
    try:
        return json.loads(r.stdout) if r.returncode == 0 else None
    except ValueError:
        return None


def portal_team(req):
    """Teammates' agents in a T3 (the dashboard's "Let a teammate's agents work in your T3"). Root calls this as
    each side: op "grant" as the T3's owner (a one-time pairing link labelled for the teammate), "accept" as the
    teammate (link it, at the access level the owner chose), "list" and "revoke" as the owner, "forget" as the
    teammate. See sbconnect.team_*."""
    op = req.get("op")
    if not shutil.which("t3"):
        return {"ok": False, "error": "T3 Code isn't installed on this box yet. Ask the owner."}
    if op == "list":
        sessions = t3_json(["auth", "session", "list"])
        return {"ok": True, "grants": sbconnect.team_grants(sessions or [])}
    if op == "grant":
        to = str(req.get("to") or "")
        if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", to) or to == ME.pw_name:
            return {"ok": False, "error": "pick a teammate"}
        res = portal_t3(True, label=sbconnect.team_label(to), ttl="10m")
        return {"ok": True, "pair_url": res["pair_url"]} if res.get("ok") else res
    if op == "accept":
        origin, code = sbconnect.split_pair_url(str(req.get("pair_url") or ""))
        access = req.get("access")
        if not origin or access not in sbconnect.TEAM_ACCESS:
            return {"ok": False, "error": "bad request"}
        up = portal_t3(False)  # make sure this account's T3 runs: the link is saved by the running T3
        if not up.get("ok"):
            return up
        host, port, env = t3_env()
        deadline = time.time() + 150
        while not t3_up(host, env):
            if time.time() > deadline:
                return {"ok": False, "error": "their T3 is still starting; try again in a minute"}
            time.sleep(2)
        for old in sbconnect.team_links_to(t3_json(["environment", "list"]) or [], origin):  # a renewal replaces
            subprocess.run(["t3", "environment", "unlink", old], env=dict(user_env(), **t3_live_env(host, env)),
                           capture_output=True, timeout=60)
        r = subprocess.run(["t3", "environment", "link", origin, "--pairing-code", code, "--access", access],
                           env=dict(user_env(), **t3_live_env(host, env)), capture_output=True, text=True,
                           errors="replace", timeout=90)
        if r.returncode != 0:
            return {"ok": False, "error": "linking failed: " + ((r.stderr or r.stdout).strip().splitlines() or ["?"])[-1][:200]}
        return {"ok": True}
    if op == "revoke":
        sessions = t3_json(["auth", "session", "list"]) or []
        to = str(req.get("to") or "")
        ids = [g["session"] for g in sbconnect.team_grants(sessions) if g["to"] == to]
        host, port, env = t3_env()
        for sid in ids:
            subprocess.run(["t3", "auth", "session", "revoke", sid], env=dict(user_env(), **t3_live_env(host, env)),
                           capture_output=True, timeout=60)
        return {"ok": True, "revoked": len(ids), "origin": f"http://{host}:{port}"}
    if op == "forget":
        origin = str(req.get("origin") or "")
        host, port, env = t3_env()
        for old in sbconnect.team_links_to(t3_json(["environment", "list"]) or [], origin):
            subprocess.run(["t3", "environment", "unlink", old], env=dict(user_env(), **t3_live_env(host, env)),
                           capture_output=True, timeout=60)
        return {"ok": True}
    return {"ok": False, "error": "unknown action"}


def t3_starter(env):
    """First time only: a ready-made project, so T3 opens straight into something to chat in."""
    marker = os.path.join(HOME, ".sharedbox", "t3-starter")
    if os.path.exists(marker):
        return
    d = os.path.join(HOME, "my-first-app")
    os.makedirs(d, exist_ok=True)
    if not os.path.exists(os.path.join(d, ".git")):
        subprocess.run(["git", "init", "-q", "-b", "main", d], capture_output=True)
        with open(os.path.join(d, "README.md"), "w") as f:
            f.write("# My first app\n\nAsk your agent to build something here, e.g. "
                    "\"make me a simple website about my favourite movies and give me the link\".\n")
    r = subprocess.run(["t3", "project", "add", d, "--title", "My first app"],
                       env=dict(user_env(), **env), capture_output=True, text=True, timeout=60)
    if r.returncode == 0:
        os.makedirs(os.path.dirname(marker), exist_ok=True)
        open(marker, "w").close()


def ssh_keys():
    try:
        with open(os.path.join(HOME, ".ssh", "authorized_keys")) as f:
            return [l.strip() for l in f if l.strip() and not l.startswith("#")]
    except OSError:
        return []


def portal_add_key(key):
    key, err = sb.validate_pubkey(key)
    if err:
        return {"ok": False, "error": err}
    keys = ssh_keys()
    if key.split()[:2] not in [k.split()[:2] for k in keys]:
        os.makedirs(os.path.join(HOME, ".ssh"), mode=0o700, exist_ok=True)
        path = os.path.join(HOME, ".ssh", "authorized_keys")
        with open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600), "w") as f:
            f.write(key + "\n")
    return {"ok": True, "key_added": True}


def mark_setup_done(key):
    """A browser login to an AI worked: the friend is set up, so SSH logins show `box status`, not the welcome."""
    if key == "gh":
        return
    try:
        os.makedirs(os.path.join(HOME, ".sharedbox"), exist_ok=True)
        open(os.path.join(HOME, ".sharedbox", "setup-done"), "a").close()
    except OSError:
        pass


def portal_login_start(key, console=False):
    label, cmd, paste = PORTAL_LOGINS[key]
    if not shutil.which(cmd[0]):
        return {"ok": False, "error": f"{label} isn't installed on this box. Ask the owner."}
    if portal_logged_in(key, fresh=True):  # never let a cached "signed in" block signing in again
        if key == "gh":
            gh_finish()
        mark_setup_done(key)
        return {"ok": True, "done": True}
    if key == "claude" and console:  # an Anthropic Console (API billing) account: the normal login
        cmd = ["claude", "auth", "login", "--console"]
    tmux("kill-session", "-t", key)
    # keep the pane around after the login exits so its last words can be read
    # gh asks extra y/n questions when it has a terminal; with no terminal it just prints the code
    run = '"$@" </dev/null 2>&1 | cat' if key == "gh" else '"$@"'
    wrapped = ["sh", "-c", run + '; echo "[login exited $?]"; sleep 300', "sh", *cmd]
    tm = ["tmux", "-L", LOGIN_SOCK, "new-session", "-d", "-s", key, "-x", "250", "-y", "60", "--", *wrapped]
    # a scope under the user's own systemd keeps it alive after the (root-run) caller exits
    r = subprocess.run(["systemd-run", "--user", "--scope", "--quiet", "--collect", "--", *tm],
                       env=user_env(), capture_output=True, text=True, timeout=30)
    if r.returncode != 0:
        subprocess.run(tm, env=user_env(), capture_output=True, timeout=30)
    deadline = time.time() + 25
    while time.time() < deadline:
        time.sleep(1)
        screen = login_screen(key)
        urls = sbconnect.screen_urls(screen)  # Claude hard-wraps its long sign-in link
        codes = [] if paste else DEVICE_CODE_RE.findall(screen)
        if urls and (paste or codes):
            return {"ok": True, "url": urls[0], "code": codes[0] if codes else None, "paste": paste}
        if "[login exited" in screen:
            if portal_logged_in(key):
                mark_setup_done(key)
                return {"ok": True, "done": True}
            break
    err = f"{label} login didn't start: " + tail(login_screen(key))
    tmux("kill-session", "-t", key)  # don't leave a half-started login running
    return {"ok": False, "error": err}


def portal_login_code(key, code):
    code = (code or "").strip()
    if not PASTE_RE.fullmatch(code):
        return {"ok": False, "error": "that code doesn't look right; copy it again from the browser"}
    if tmux("has-session", "-t", key).returncode != 0:
        return {"ok": False, "error": "that login expired; start it again"}
    tmux("send-keys", "-t", key, "-l", "--", code)
    tmux("send-keys", "-t", key, "Enter")
    return portal_login_wait(key, 30)


CLAUDE_TOKEN = os.path.join(HOME, ".config", "treehouse", "claude-token")
CLAUDE_TOKEN_RE = re.compile(r"sk-ant-oat01-[A-Za-z0-9_-]{20,300}")
FED_NUDGE = os.path.join(HOME, ".sharedbox", "fed-nudge")  # root's fed-sync copies logins to the other boxes soon


def fed_nudge():
    try:
        os.makedirs(os.path.dirname(FED_NUDGE), exist_ok=True)
        with open(FED_NUDGE, "w") as f:
            f.write(str(int(time.time())))
    except OSError:
        pass


def save_claude_token(token, mtime=None):
    """Keep a `claude setup-token` token where the claude shim reads it (0600). True if it changed."""
    if not CLAUDE_TOKEN_RE.fullmatch(token or ""):
        return False
    if fed_read(CLAUDE_TOKEN).strip() == token:
        return False
    os.makedirs(os.path.dirname(CLAUDE_TOKEN), mode=0o700, exist_ok=True)
    tmp = CLAUDE_TOKEN + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(token + "\n")
    if mtime:
        os.utime(tmp, (mtime, mtime))
    os.replace(tmp, CLAUDE_TOKEN)
    return True


def claude_token_from_screen(key="claude"):
    """setup-token prints the token once, after the pasted code: take it off the login screen (it fits on one
    250-column line; joining lines could glue the next word onto it)."""
    m = CLAUDE_TOKEN_RE.search(login_screen(key))
    if m and save_claude_token(m.group(0)):
        fed_nudge()


def portal_login_wait(key, seconds):
    label = PORTAL_LOGINS[key][0]
    deadline = time.time() + seconds
    while time.time() < deadline:
        if key == "claude":
            claude_token_from_screen()
        if portal_logged_in(key):
            if key == "gh":
                gh_finish()
            if key == "t3connect":
                # T3 links "on next start": restart this account's T3 Code so its relay comes up
                sctl("restart", "--no-block", T3_UNIT, capture=True)
            if key in ("gh", "t3connect"):
                fed_nudge()  # the other boxes: copy GitHub, offer the T3 app there too
            tmux("kill-session", "-t", key)
            mark_setup_done(key)
            return {"ok": True, "done": True}
        if "[login exited" in login_screen(key):
            break
        time.sleep(1)
    if portal_logged_in(key):
        mark_setup_done(key)
        return {"ok": True, "done": True}
    screen = login_screen(key)
    if "[login exited" in screen:  # it's over (failed or cancelled): clean it up; a pending one keeps waiting
        tmux("kill-session", "-t", key)
    return {"ok": False, "error": f"{label} login hasn't finished: " + tail(screen)}


def tail(screen, n=4):
    screen = CLAUDE_TOKEN_RE.sub("sk-ant-…", screen)  # an error line never shows a token
    lines = [l.strip() for l in screen.splitlines()
             if l.strip() and "[login exited" not in l and "https://" not in l]
    return " / ".join(lines[-n:])[-400:] or "no output"


def portal_url():
    """The user's dashboard: the public site when there is one (works anywhere), else the tailnet page."""
    pub = sb.public_url(CFG)
    # the Tailscale IP, not the name: friends who joined the owner's tailnet as shared-in users can't resolve it
    return f"{pub}/_box/me" if pub else f"http://{sb.tailscale_ip4() or socket.gethostname()}:{CFG['WEB_PORT']}/me"


# servers from the web page: the friend's own `box serve` units, and the group's `box shared` ones
PORTAL_SERVER_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]{0,39}")  # never starts with "-": no option injection
PORTAL_SERVER_OPS = ("start", "stop", "restart")
PORTAL_LOG_LINES = 100
PORTAL_LOG_BYTES = 48 * 1024


def portal_server_name(name):
    """A NAME the web page may act on, or None. Same rules as unit(), minus non-ASCII and leading -/_."""
    name = name or ""
    return name if PORTAL_SERVER_RE.fullmatch(name) and name.isascii() else None


def portal_unit_port(name):
    try:
        with open(os.path.join(UNIT_DIR, f"sb-{name}.service")) as f:
            for l in f:
                if l.startswith("Environment=PORT="):
                    return l.strip().split("=", 2)[2]
    except OSError:
        pass
    return ""


def portal_own_server(name):
    """NAME if it's one of this user's own `box serve` units (a unit file we wrote), else None. Never sb-t3."""
    name = portal_server_name(name)
    if not name or name in ("t3", "t3-proxy") or not os.path.isfile(os.path.join(UNIT_DIR, f"sb-{name}.service")):
        return None
    return name


def portal_cap_lines(lines):
    """The last PORTAL_LOG_LINES lines, at most PORTAL_LOG_BYTES in total, as printable text."""
    out, size = [], 0
    for l in reversed([str(x) for x in lines][-PORTAL_LOG_LINES:]):
        l = l[:2000]
        size += len(l) + 1
        if size > PORTAL_LOG_BYTES:
            break
        out.append(l)
    return out[::-1]


def portal_serve_ls():
    seen, servers = set(), []
    for s in list_services():
        if s["name"] != "t3" and portal_server_name(s["name"]):
            seen.add(s["name"])
            servers.append({"name": s["name"], "state": s["state"], "port": portal_unit_port(s["name"])})
    try:  # a stopped, unloaded unit still has its file
        files = sorted(os.listdir(UNIT_DIR))
    except OSError:
        files = []
    for fn in files:
        n = fn[3:-8] if fn.startswith("sb-") and fn.endswith(".service") else ""
        if n and n != "t3" and n not in seen and portal_server_name(n):
            servers.append({"name": n, "state": "stopped", "port": portal_unit_port(n)})
    return {"ok": True, "servers": sorted(servers, key=lambda s: s["name"])}


def serve_op(op, u):
    """stop = stays off across reboots too; start/restart = on, and back after a reboot (like group servers)."""
    if op == "restart":
        r = sctl("enable", u, capture=True)
        return r if r.returncode else sctl("restart", u, capture=True)
    return sctl(*{"start": ("enable", "--now"), "stop": ("disable", "--now")}[op], u, capture=True)


def portal_serve_ctl(name, op):
    name = portal_own_server(name)
    if not name or op not in PORTAL_SERVER_OPS:
        return {"ok": False, "error": "no such server"}
    r = serve_op(op, f"sb-{name}.service")
    if r.returncode != 0:
        return {"ok": False, "error": f"{op} {name} failed: " + (r.stderr or r.stdout or "").strip()[-300:]}
    state = next((s["state"] for s in list_services() if s["name"] == name), "stopped")
    return {"ok": True, "name": name, "op": op, "state": state,
            "message": f"{name}: {'stopped' if op == 'stop' else op + 'ed'}"}


def portal_serve_logs(name):
    name = portal_own_server(name)
    if not name:
        return {"ok": False, "error": "no such server"}
    r = subprocess.run(["journalctl", "--user", "-u", f"sb-{name}.service", "-n", str(PORTAL_LOG_LINES),
                        "--no-pager", "-o", "short-iso"], env=user_env(), capture_output=True,
                       text=True, errors="replace", timeout=30)
    return {"ok": True, "name": name, "lines": portal_cap_lines(r.stdout.splitlines())}


def portal_running():
    """The dashboard's Running card: what runs for this account, no container ids."""
    keep = ("key", "kind", "name", "detail", "mem", "age", "pids", "stop", "cpu_usec")
    return [{k: it.get(k) for k in keep} for it in sbrunning.running(ME.pw_uid, HOME)]


def portal_running_stop(key):
    """Stop one item of the Running card. The key is matched against the live list again, so only this account's
    own containers and units can be named. Containers: `docker stop` (they stay stopped across reboots until started
    again); `box serve` servers: disabled + stopped; other units (terminals, browsers, user services): stopped."""
    it = sbrunning.find(sbrunning.running(ME.pw_uid, HOME), key)
    if not it:
        return {"ok": False, "error": "That isn't running any more (or it can't be stopped from here). Refresh the page."}
    env = dict(os.environ, XDG_RUNTIME_DIR=f"/run/user/{ME.pw_uid}",
               DOCKER_HOST=os.environ.get("DOCKER_HOST") or f"unix:///run/user/{ME.pw_uid}/docker.sock")
    if it["stop"] == "containers":
        ids = [i for i in it.get("ids") or [] if re.fullmatch(r"[0-9a-f]{64}", i)]
        if not ids or not shutil.which("docker"):
            return {"ok": False, "error": "Docker isn't reachable for this account right now."}
        # restart: always would bring it back at the next reboot (docker starts it again): unless-stopped behaves
        # the same in every other way but respects this stop
        pol = subprocess.run(["docker", "inspect", "-f", "{{.Id}} {{.HostConfig.RestartPolicy.Name}}", *ids], env=env,
                             capture_output=True, text=True, timeout=60)
        always = [ln.split()[0] for ln in pol.stdout.splitlines() if ln.split()[1:] == ["always"]]
        if always:
            subprocess.run(["docker", "update", "--restart", "unless-stopped", *always], env=env, capture_output=True,
                           text=True, timeout=60)
        r = subprocess.run(["docker", "stop", "--time", "20", *ids], env=env, capture_output=True, text=True,
                           timeout=180)
        if r.returncode != 0:
            return {"ok": False, "error": f"Couldn't stop {it['name']}: " + (r.stderr or r.stdout or "").strip()[-300:]}
        n = len(ids)
        return {"ok": True, "message": f"Stopped {it['name']}" + (f" ({n} containers)" if n > 1 else "")
                + ". It stays off, reboots included, until someone starts it again."}
    unit = it.get("unit") or key[2:]
    if it["stop"] == "server":
        r = serve_op("stop", unit)
        what = f"Stopped {it['name']}. It stays off, reboots included, until you start it again under Your servers."
    else:
        r = sctl("stop", unit, capture=True)
        what = f"Stopped {it['name']}."
    if r.returncode != 0:
        return {"ok": False, "error": f"Couldn't stop {it['name']}: " + (r.stderr or r.stdout or "").strip()[-300:]}
    return {"ok": True, "message": what}


def portal_shared(args, missing):
    """Run `box shared ARGS --json` (a fresh process, as this user) and pass its JSON answer through.
    `missing` is the answer when this box's `box` has no `shared` command yet."""
    r = subprocess.run([sys.executable, "-I", os.path.abspath(__file__), "shared", *args, "--json"],
                       capture_output=True, text=True, errors="replace", timeout=240)
    for line in reversed(r.stdout.splitlines()):
        try:
            out = json.loads(line)
        except ValueError:
            continue
        if isinstance(out, dict):
            if isinstance(out.get("lines"), list):
                out["lines"] = portal_cap_lines(out["lines"])
            return out
    if r.returncode == 2 and "invalid choice" in r.stderr:
        return missing
    return {"ok": False, "error": "group servers: " + ((r.stderr or "").strip()[-300:] or "no answer")}


def portal_shared_ls():
    out = portal_shared(["ls"], {"ok": True, "servers": [], "unavailable": True})
    if out.get("ok") and not isinstance(out.get("servers"), list):
        out["servers"] = []
    return out


def portal_shared_ctl(name, op):
    name = portal_server_name(name)
    if not name or op not in PORTAL_SERVER_OPS:
        return {"ok": False, "error": "no such server"}
    return dict(portal_shared([op, name], {"ok": False, "unavailable": True,
                                           "error": "group servers aren't set up on this box yet"}),
                name=name, op=op)


def portal_shared_logs(name):
    name = portal_server_name(name)
    if not name:
        return {"ok": False, "error": "no such server"}
    return dict(portal_shared(["logs", name, "-n", str(PORTAL_LOG_LINES)],
                              {"ok": False, "unavailable": True,
                               "error": "group servers aren't set up on this box yet"}), name=name)


def portal_msg(req):
    """The dashboard's inbox (JSON from root on stdin, as this user): the same marks and requests as `box msg`."""
    import sbmsg
    now, user = time.time(), ME.pw_name
    root = sbmsg.mail_root()
    inbox, sent = os.path.join(root, user), os.path.join(root, user, "sent")
    op = req.get("op")
    st = sbmsg.load_state(ME.pw_dir, user)

    def card(m):
        c = {k: m.get(k) for k in ("id", "from", "to", "title", "level", "due", "status", "ts", "count", "reply_to",
                                   "seen")}
        c["context"] = str((m.get("brief") or {}).get("context") or "")[:600]
        c["due_text"] = sbmsg.fmt_due(m["due"], now) if m.get("due") else ""
        c["read"] = m["id"] in st["read"]
        return c
    if op == "inbox":
        every = sbmsg.list_dir(inbox)
        missing = sbmsg.unmirrored(st, {m["id"] for m in every})
        if missing:  # older marks root hasn't mirrored yet: tell it, so Telegram's /inbox agrees
            shared_request({"action": "msg-done", "ids": missing, "done": True}, 0)
        msgs = sorted((m for m in every if m["id"] not in st["done"]), key=lambda m: sbmsg.sort_key(m, now))
        mine = sorted(sbmsg.list_dir(sent), key=lambda m: -(m.get("ts") or 0))[:5]
        answered = {m.get("reply_to"): m.get("status") or "replied" for m in sbmsg.list_dir(inbox) if m.get("reply_to")}
        out = [dict(card(m), answer=answered.get(m["id"], "")) for m in mine]
        return {"ok": True, "messages": [card(m) for m in msgs[:20]], "open": len(msgs), "sent": out,
                "people": sbmsg.recipients(sb, CFG), "you": user}
    if op == "send":
        try:
            to = sbmsg.resolve(sb, CFG, str(req.get("to") or ""))
            m = {"action": "msg", "to": to, "title": str(req.get("title") or "")[:200],
                 "level": req.get("level") if req.get("level") in sbmsg.LEVELS else "normal",
                 "brief": {"context": str(req.get("context") or "")[:sbmsg.TEXT_MAX], "via": "web"}}
            if req.get("due"):
                m["due"] = sbmsg.parse_due(str(req["due"])[:60], now)
        except (sbmsg.MsgError, ValueError) as e:
            return {"ok": False, "error": str(e)}
        return shared_request(m)
    mid = str(req.get("id") or "")
    m = sbmsg._load(os.path.join(inbox, f"{mid}.json")) if sbmsg.ID_RE.match(mid) else None
    if not m:
        return {"ok": False, "error": "that message isn't in your inbox any more"}
    if op == "seen":
        if mid not in st["read"]:
            st["read"][mid] = int(now)
            shared_request({"action": "msg-seen", "ids": [mid]}, 0)
        sbmsg.save_state(ME.pw_dir, st)
        return {"ok": True}
    if op in ("done", "reply"):
        text = str(req.get("text") or "").strip()
        r = {"action": "msg", "reply_to": mid, "brief": {"context": text[:sbmsg.TEXT_MAX], "via": "web"}}
        if op == "done":
            r["status"] = "done"
        elif not text:
            return {"ok": False, "error": "write a reply first"}
        elif len(text) <= sbmsg.TITLE_MAX:
            r["title"] = text
        res = shared_request(r)
        if res.get("ok"):
            st["read"].setdefault(mid, int(now))
            if op == "done":
                st["done"][mid] = int(now)
                shared_request({"action": "msg-done", "ids": [mid], "done": True}, 0)
            sbmsg.save_state(ME.pw_dir, st)
            res["message"] = "Marked done; they'll see it." if op == "done" else "Reply sent."
        return res
    if op == "archive":
        st["done"][mid] = int(now)
        st["read"].setdefault(mid, int(now))
        sbmsg.save_state(ME.pw_dir, st)
        shared_request({"action": "msg-done", "ids": [mid], "done": True}, 0)
        return {"ok": True, "message": "Cleared from your inbox."}
    return {"ok": False, "error": "unknown action"}


def portal_where(req):
    """The dashboard's "where is everyone" card and your own status."""
    import sbmsg
    import sbwhere
    now = time.time()
    if req.get("op") == "private":  # the "others see: active 2h ago · Hide" toggle
        res = shared_request({"action": "presence", "private": bool(req.get("private"))})
        if res.get("ok"):
            res["message"] = ("Hidden. Others no longer see when you were last active." if req.get("private") else
                              "Others can see when you were last active again.")
        return res
    if req.get("op") == "set":
        r = {"action": "presence"}
        if req.get("clear"):
            r["clear"] = True
        else:
            r["status"] = str(req.get("status") or "")[:200]
            if req.get("until"):
                try:
                    r["until"] = sbmsg.parse_due(str(req["until"])[:60], now)
                except ValueError as e:
                    return {"ok": False, "error": str(e).replace("due:", "until:")}
        res = shared_request(r)
        if res.get("ok"):
            res["message"] = "Status cleared." if req.get("clear") else "Status saved. " + res.get("message", "")
        return res
    d = sbwhere.load()
    people = sbmsg.recipients(sb, CFG)
    return {"ok": True, "you": ME.pw_name, "people": [sbwhere.view(u, d.get(u) or {}, now) for u in people]}


def cmd_portal(a):
    try:
        if a.action == "status":
            out = portal_status()
            try:  # the page shows them, so save it a round trip
                out["servers"] = portal_serve_ls()["servers"]
            except (OSError, subprocess.SubprocessError):
                out["servers"] = None
            try:
                out["running"] = portal_running()
            except Exception:  # noqa: BLE001 - the rest of the dashboard must still load
                out["running"] = None
        elif a.action == "running-stop":
            out = portal_running_stop(a.key)
        elif a.action == "serve-ls":
            out = portal_serve_ls()
        elif a.action == "serve-ctl" and a.arg in PORTAL_SERVER_OPS:
            out = portal_serve_ctl(a.key, a.arg)
        elif a.action == "serve-logs":
            out = portal_serve_logs(a.key)
        elif a.action == "shared-ls":
            out = portal_shared_ls()
        elif a.action == "shared-ctl" and a.arg in PORTAL_SERVER_OPS:
            out = portal_shared_ctl(a.key, a.arg)
        elif a.action == "shared-logs":
            out = portal_shared_logs(a.key)
        elif a.action in ("t3-start", "t3-pair"):
            out = portal_t3(a.action == "t3-pair", app=a.key == "app")
        elif a.action == "login-start" and a.key in PORTAL_LOGINS:
            out = portal_login_start(a.key, console=a.arg == "console")
        elif a.action == "login-code" and a.key in PORTAL_LOGINS:
            out = portal_login_code(a.key, sys.stdin.read(4096))
        elif a.action == "add-key":
            out = portal_add_key(sys.stdin.read(8192))
        elif a.action == "login-check" and a.key in PORTAL_LOGINS:
            out = portal_login_wait(a.key, 5)
        elif a.action == "restore" and a.key:
            r = subprocess.run([sys.executable, "-I", os.path.abspath(__file__), "restore", a.key, "--json"],
                               capture_output=True, text=True, errors="replace", timeout=120)
            out = ({"ok": True, "message": f"Restored {a.key} to your home folder."} if r.returncode == 0 else
                   {"ok": False, "error": (r.stderr.strip().removeprefix("box restore: ") or "couldn't restore it")[:300]})
        elif a.action == "projects" and a.key and a.arg in ("on", "off"):  # the dashboard's Projects card
            import sbprojects
            ok, msg = sbprojects.set_choice(HOME, a.key, a.arg == "on")
            out = {"ok": ok, "message" if ok else "error": msg}
        elif a.action in ("peer-login", "peer-check") and a.key in PEER_LOGINS:
            out = portal_peer_login(a.key, check=a.action == "peer-check")
        elif a.action == "claude-token-info":  # federation: how new is this box's copy (never the token itself)
            out = {"ok": True, "mtime": int(os.path.getmtime(CLAUDE_TOKEN)) if os.path.exists(CLAUDE_TOKEN) else 0}
        elif a.action == "claude-token-put":  # federation: a newer token from another of this person's boxes
            try:
                req = json.loads(sys.stdin.read(4096) or "{}")
            except ValueError:
                req = {}
            mt = int(req.get("mtime") or 0) if isinstance(req, dict) else 0
            have = int(os.path.getmtime(CLAUDE_TOKEN)) if os.path.exists(CLAUDE_TOKEN) else 0
            if not isinstance(req, dict) or not CLAUDE_TOKEN_RE.fullmatch(str(req.get("token") or "")):
                out = {"ok": False, "error": "bad token"}
            elif mt <= have or mt > time.time() + 600:
                out = {"ok": True, "kept": True}
            else:
                save_claude_token(req["token"], mtime=mt)
                out = {"ok": True}
        elif a.action == "team":
            try:
                req = json.loads(sys.stdin.read(16 << 10) or "{}")
            except ValueError:
                req = None
            out = portal_team(req) if isinstance(req, dict) else {"ok": False, "error": "bad request"}
        elif a.action in ("msg", "where"):
            try:
                req = json.loads(sys.stdin.read(16 << 10) or "{}")
            except ValueError:
                req = None
            out = ((portal_msg if a.action == "msg" else portal_where)(req) if isinstance(req, dict)
                   else {"ok": False, "error": "bad request"})
        else:
            out = {"ok": False, "error": "unknown action"}
    except (OSError, subprocess.SubprocessError) as e:
        out = {"ok": False, "error": f"{type(e).__name__}: {e}"[:300]}
    print(json.dumps(out))


CLAUDE_HOOK = "box status --agent"
CLAUDE_HOOK_MARK = os.path.join(HOME, ".sharedbox", "claude-hook-added")


def sync_claude_hook():
    """Existing accounts get the SessionStart hook new ones get from skel (~/.claude/settings.json), once:
    merged in without touching anything else; a file that isn't valid JSON is left alone, and if the user
    removes the hook later it stays removed."""
    if os.path.exists(CLAUDE_HOOK_MARK):
        return
    path = os.path.join(HOME, ".claude", "settings.json")
    try:
        with open(path) as f:
            cfg = json.load(f)
    except FileNotFoundError:
        cfg = {}
    except (OSError, ValueError):
        return
    if not isinstance(cfg, dict):
        return
    hooks = cfg.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        return
    start = hooks.setdefault("SessionStart", [])
    if not isinstance(start, list):
        return
    have = any(isinstance(g, dict) and any(isinstance(h, dict) and str(h.get("command", "")).startswith(CLAUDE_HOOK)
                                           for h in (g.get("hooks") or []) if isinstance(g.get("hooks"), list))
               for g in start)
    if not have:
        start.append({"hooks": [{"type": "command", "command": CLAUDE_HOOK}]})
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = f"{path}.tmp-{os.getpid()}"
        with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            json.dump(cfg, f, indent=2)
            f.write("\n")
        try:
            os.chmod(tmp, os.stat(path).st_mode & 0o777)
        except OSError:
            pass
        os.replace(tmp, path)
    os.makedirs(os.path.dirname(CLAUDE_HOOK_MARK), exist_ok=True)
    open(CLAUDE_HOOK_MARK, "a").close()


LEGACY_HOOK = "box _auto-issues"  # an early session-start hook; `box status --agent` does the same work now


def drop_legacy_hook():
    """Remove the old `box _auto-issues` SessionStart hook where `box status --agent` is also there: it ran the
    same checks a second time at every session start (~0.1 s)."""
    path = os.path.join(HOME, ".claude", "settings.json")
    try:
        with open(path) as f:
            cfg = json.load(f)
        start = cfg["hooks"]["SessionStart"]
    except (OSError, ValueError, KeyError, TypeError):
        return
    if not isinstance(start, list):
        return

    def cmds(g):
        hs = g.get("hooks") if isinstance(g, dict) else None
        return [str(h.get("command", "")) for h in hs if isinstance(h, dict)] if isinstance(hs, list) else []
    if not any(c.startswith(CLAUDE_HOOK) for g in start for c in cmds(g)):
        return
    keep = [g for g in start if not (cmds(g) and all(c.startswith(LEGACY_HOOK) for c in cmds(g)))]
    if len(keep) == len(start):
        return
    cfg["hooks"]["SessionStart"] = keep
    tmp = f"{path}.tmp-{os.getpid()}"
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    try:
        os.chmod(tmp, os.stat(path).st_mode & 0o777)
    except OSError:
        pass
    os.replace(tmp, path)


