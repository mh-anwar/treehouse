LOGIN_KEYS = ("claude", "codex", "gh", "antigravity", "t3connect")


def cmd_login(a):
    """The dashboard's login buttons (Claude, ChatGPT, GitHub, Google for Antigravity, the T3 app), as commands.
    Start prints a link (and for some a code to type there); for Claude/Antigravity the page then shows a code that
    goes back in with --code (read from stdin). --check waits a few seconds for a finished login."""
    if not a.key:
        rows = {k: {"label": PORTAL_LOGINS[k][0], "ok": bool(portal_logged_in(k))} for k in LOGIN_KEYS
                if shutil.which(PORTAL_LOGINS[k][1][0])}
        if a.json:
            print(json.dumps({"ok": True, "logins": rows}))
        else:
            for k, r in rows.items():
                print(f"  {k:<12} {r['label']:<22} {'logged in' if r['ok'] else 'not yet: box login ' + k}")
        return
    if a.other_boxes:
        if a.key not in PEER_LOGINS:
            sys.exit(f"--other-boxes works for: {', '.join(PEER_LOGINS)} (Claude and GitHub are copied by themselves)")
        res = portal_peer_login(a.key, check=a.check)
        if a.json:
            print(json.dumps(res))
            return
        for r in res.get("boxes") or []:
            print(f"  {r['box']}: " + ("done" if r.get("done") else
                                      f"open {r['url']}" + (f" and enter {r['code']}" if r.get("code") else "")
                                      if r.get("url") else r.get("error") or "not yet"))
        if not res.get("boxes"):
            print("No other boxes answer over SSH yet (box boxes).")
        return
    if a.code:
        res = portal_login_code(a.key, read_secret("Code from the sign-in page: "))
    elif a.check:
        res = portal_login_wait(a.key, 5)
    else:
        res = portal_login_start(a.key, console=a.console)
    label = PORTAL_LOGINS[a.key][0]
    if res.get("ok") and res.get("done"):
        return emit(res, a.json, f"{label}: logged in.")
    if res.get("ok") and res.get("url"):
        text = (f"Open {res['url']}" + (f"\nand enter the code {res['code']}" if res.get("code") else "")
                + (f"\nThen paste the code it shows: box login {a.key} --code (reads it from stdin)"
                   if res.get("paste") else f"\nThen: box login {a.key} --check"))
        return emit(res, a.json, text)
    emit(res, a.json)


