def sudo_mode():
    """"yes" when this account can run sudo without a password, else "no". Only asks sudo (`sudo -n true`, never a
    prompt) when the account is in a sudo group, so accounts without it don't leave "not in sudoers" lines in the log."""
    if os.geteuid() == 0:
        return "yes"
    try:
        groups = {grp.getgrgid(g).gr_name for g in os.getgroups()}
    except (KeyError, OSError):
        groups = set()
    if not groups & {"sudo", "wheel", "admin"} or not shutil.which("sudo"):
        return "no"
    try:
        r = subprocess.run(["sudo", "-n", "true"], capture_output=True, timeout=10, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return "no"
    return "yes" if r.returncode == 0 else "no"


