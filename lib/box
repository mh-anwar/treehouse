UNIT_DIR = os.path.join(HOME, ".config", "systemd", "user")


def sctl(*args, capture=False):
    env = dict(os.environ, XDG_RUNTIME_DIR=f"/run/user/{ME.pw_uid}")
    return subprocess.run(["systemctl", "--user", *args], env=env, text=True,
                          capture_output=capture)


def unit(name):
    if not name.replace("-", "").replace("_", "").isalnum() or len(name) > 40:
        sys.exit("service name: letters, digits, - and _ only")
    if name in ("t3", "t3-proxy"):
        sys.exit(f"service name: {name} is taken by T3 Code; pick another")
    return f"sb-{name}.service"


def sd_escape(s):
    return s.replace("%", "%%").replace("$", "$$")


def list_services():
    r = sctl("list-units", "--all", "--plain", "--no-legend", "--type=service", "sb-*", capture=True)
    out = []
    for line in r.stdout.splitlines():
        parts = line.split(None, 4)
        if len(parts) >= 4 and parts[0].startswith("sb-") and parts[0] != T3_PROXY:  # part of T3, not theirs
            out.append({"name": parts[0][3:-8], "state": parts[3] if parts[2] == "active" else parts[2]})
    seen = {s["name"] for s in out}
    try:  # stopped with `box serve stop` (disabled): systemd unloads it, but its unit file is still ours
        files = sorted(os.listdir(UNIT_DIR))
    except OSError:
        files = []
    for fn in files:
        n = fn[3:-8] if fn.startswith("sb-") and fn.endswith(".service") else ""
        if n and n not in seen and fn != T3_PROXY and n not in ("t3", "t3-proxy"):
            out.append({"name": n, "state": "stopped"})
    return out


def cmd_serve(a):
    act = a.action
    if act == "ls":
        svcs = list_services()
        if not svcs:
            print("no services. create one with: box serve add NAME --port P -- COMMAND...")
        for s in svcs:
            port = ""
            try:
                with open(os.path.join(UNIT_DIR, f"sb-{s['name']}.service")) as f:
                    for l in f:
                        if l.startswith("Environment=PORT="):
                            port = l.strip().split("=", 2)[2]
            except OSError:
                pass
            print(f"{s['name']:<20} {s['state']:<10} port {port}")
        return
    if not a.name:
        sys.exit(f"usage: box serve {act} NAME")
    u = unit(a.name)
    if act == "add":
        cmd = a.cmd[1:] if a.cmd and a.cmd[0] == "--" else a.cmd
        if not cmd:
            sys.exit("usage: box serve add NAME [--port P] -- COMMAND...")
        exe = shutil.which(cmd[0])
        if not exe:
            sys.exit(f"command not found: {cmd[0]}")
        cmd[0] = exe
        r = ports()
        port = a.port
        if r and port is None:
            port = next((p for p in range(r[0] + 1, r[1]) if not port_in_use(p)), None)  # first+last: T3
        if r and port in r:
            sys.exit(f"port {port} is reserved for your T3 Code server; pick one from {r[0] + 1}-{r[1] - 1}")
        if r and port is not None and not (r[0] <= port <= r[1]):
            print(f"warning: port {port} is outside your range {r[0]}-{r[1]}", file=sys.stderr)
        wd = os.getcwd()
        if wd.startswith(HOME + "/") and wd != HOME:
            print(f"note: the project this runs from won't be archived while this service exists (even if stopped). "
                  f"`box serve rm {a.name}` releases it.", file=sys.stderr)
        os.makedirs(UNIT_DIR, exist_ok=True)
        body = [
            "[Unit]", f"Description=box serve {a.name}",
            "StartLimitIntervalSec=600", "StartLimitBurst=10", "",
            "[Service]", f"WorkingDirectory={sd_escape(wd)}",
            f"Environment=PATH={sd_escape(os.environ.get('PATH', '/usr/bin:/bin'))}",
        ]
        if port is not None:
            body.append(f"Environment=PORT={port}")
        body += [f"ExecStart={sd_escape(shlex.join(cmd))}", "Restart=on-failure", "RestartSec=5",
                 "", "[Install]", "WantedBy=default.target", ""]
        with open(os.path.join(UNIT_DIR, u), "w") as f:
            f.write("\n".join(body))
        sctl("daemon-reload")
        r2 = sctl("enable", "--now", u)
        if r2.returncode == 0:
            print(f"started {a.name}" + (f" on port {port} (also in $PORT)" if port else "")
                  + f". logs: box serve logs {a.name}")
        sys.exit(r2.returncode)
    if act == "logs":
        os.execvp("journalctl", ["journalctl", "--user", "-u", u, "-n", "200", "--no-pager"]
                  + (["-f"] if a.follow else []))
    if act == "rm":
        sctl("disable", "--now", u)
        try:
            os.unlink(os.path.join(UNIT_DIR, u))
        except FileNotFoundError:
            pass
        sctl("daemon-reload")
        print(f"removed {a.name}")
        return
    if act in PORTAL_SERVER_OPS:  # stop keeps it off across reboots; start/restart turn it back on for good
        r = serve_op(act, u)
        if r.returncode:
            sys.exit(f"box serve {act} {a.name}: " + (r.stderr or r.stdout or "failed").strip()[-300:])
        print(f"{a.name}: " + {"stop": "stopped (stays off across reboots until `box serve start`)",
                                 "start": "started", "restart": "restarted"}[act])
        return
    sys.exit(sctl(act, u).returncode)


