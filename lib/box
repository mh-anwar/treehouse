def fmt_ts(ts):
    # with the zone: agents otherwise guess UTC (the box's own clock is local time)
    return time.strftime("%a %b %d %H:%M %Z", time.localtime(ts))


# ---------- status ----------

def gather(sample=0.5):
    """sample: seconds to measure CPU over. Session start (every agent session waits for it) uses a short one;
    throttling there also comes from the kernel's own 10-second pressure average, so nothing is missed."""
    st = sb.read_json(STATUS_FILE, {}) or {}
    cg = sb.read_cgroup(sb.slice_path(ME.pw_uid))
    if cg:  # sample CPU over a short window
        time.sleep(sample)
        cg2 = sb.read_cgroup(sb.slice_path(ME.pw_uid))
        dt = cg2["t"] - cg["t"]
        cg2["cpu_pct"] = round((cg2["cpu_usec"] - cg["cpu_usec"]) / 1e6 / dt * 100) if dt else 0
        cg2["throttled"] = cg2["throttled_usec"] > cg["throttled_usec"] or cpu_pressure() > 10
        cg = cg2
    return {"user": ME.pw_name, "friend": is_friend(), "ports": ports(),
            "limits": my_limits() if is_friend() else None, "live": cg,
            "box": sb.box_load(), "janitor": st}


def cpu_pressure():
    """% of the last 10 s some of this account's processes waited for CPU (throttled at the quota, or a busy box)."""
    try:
        with open(os.path.join(sb.slice_path(ME.pw_uid), "cpu.pressure")) as f:
            return float(f.readline().split("avg10=")[1].split()[0])
    except (OSError, IndexError, ValueError):
        return 0.0


def reboot_days():
    return sb.reboot_days(CFG)


def archive_until_text():
    return f"restorable for {CFG['ARCHIVE_DAYS']} days with `box restore NAME`"


REBOOT_BACK = ("Comes back by itself: `box serve` services, group servers (`box shared`), T3 Code. "
               "Everything else stops (tmux, nohup, running builds): save work and finish long jobs before then.")


def advice(g):
    out = []
    al = sb.security_alert(ME.pw_name)
    if al:
        # only a cleaned program name: the command line is chosen by whatever tripped the wire, and this text
        # lands in every agent's instructions (no room for injected "instructions")
        prog = re.sub(r"[^A-Za-z0-9._+-]", "", os.path.basename(str(al.get("exe") or str(al.get("cmd") or "?").split()[0])))[:40] or "?"
        out.append(f"SECURITY: on {fmt_ts(al['ts'])} a program running as this user "
                   f"(`{prog}`) opened the box's decoy secrets "
                   f"({sb.printable(str(al.get('file') or '?'))[:120]}). Tell the user at the start of your next reply, in plain words: nothing "
                   "real leaked, but something on their account looked for passwords/keys, usually a "
                   "malicious package or script. Offer to check recently installed npm/pip packages, "
                   "autostarts (~/.config/autostart, systemd --user units, shell rc files) and running "
                   "processes. Never open files under the decoy directory yourself.")
    for n in agent_notices()[-3:]:
        out.append(f"Agent UPDATED for security on {fmt_ts(n['ts'])}: {n['name']} {n['from']} -> {n['to']} "
                   f"({n['why']}). Mention it to the user if they ask why a tool changed.")
    for n in other_notices(3)[-5:]:
        out.append(f"{fmt_ts(n['ts'])}: {sb.printable(n['text'])} Tell the user if it's what they were waiting for.")
    rb = sb.reboot_info(CFG)
    if rb["postponed"]:
        out.append(f"The box is about to REBOOT (its scheduled reboot, {rb['schedule']}). It's waiting for agents "
                   f"to finish their current turn, until {fmt_ts(rb['latest'])} at the latest. Wrap up now; don't "
                   f"start long jobs. {REBOOT_BACK}")
    elif rb["at"] and rb["why"] == "updates":
        out.append(f"The box will REBOOT on {fmt_ts(rb['at'])} for security updates. {REBOOT_BACK}")
    elif rb["at"] and rb["at"] - time.time() < 12 * 3600:
        out.append(f"The box will REBOOT on {fmt_ts(rb['at'])}: its scheduled reboot, {rb['schedule']}. If an agent "
                   f"is mid-turn it waits up to 2 hours. {REBOOT_BACK}")
    b = g["box"]
    if b["level"] == "busy":
        out.append("The box is BUSY right now. Postpone heavy builds/tests if possible; "
                   "if not, use `box heavy --` and reduce parallelism.")
    elif b["level"] == "moderate":
        out.append("The box is moderately loaded. Use `box heavy --` for builds.")
    live = g["live"] or {}
    if live.get("mem_high") and live["mem"] > 0.85 * live["mem_high"]:
        out.append("You are close to your RAM limit. Don't start more; stop build helpers you started yourself "
                   "(e.g. `./gradlew --stop`). Ask the user before stopping any of their servers or databases.")
    if live.get("throttled"):
        out.append("Your CPU is being throttled at your quota. Lower parallelism.")
    j = g["janitor"]
    if j.get("over_budget"):
        out.append(f"You are OVER your disk budget. Caches and build outputs were wiped. "
                   f"Delete things you don't need, or the oldest idle projects will be removed "
                   f"after {fmt_ts(j['over_budget_deadline'])}." if j.get("over_budget_deadline")
                   else "You are OVER your disk budget. Free space now.")
    for p in j.get("projects", []):
        if p.get("delete_on"):
            out.append(f"Project ~/projects/{p['name']} will be ARCHIVED on {fmt_ts(p['delete_on'])} "
                       f"(idle {p['idle_days']}d; then {archive_until_text()}). Touch it to keep it, or push it to git.")
    try:  # live from disk (a restore shows up right away); the janitor's last report otherwise
        import sbclean
        arch = [{"name": x["name"], "until": x["until"]}
                for x in sbclean.list_archives(HOME, sb.cfg_int(CFG, "ARCHIVE_DAYS")) if os.path.isdir(x["path"])]
    except (ImportError, OSError, ValueError):
        arch = j.get("archives", [])
    arch = [a for a in arch if a.get("until", 0) > time.time()]
    if arch:
        out.append("ARCHIVED projects (" + archive_until_text() + "): "
                   + ", ".join(f"{a['name']} (until {fmt_ts(a['until'])})" for a in arch[:8]) + ".")
    if b["disk_free"] < b["disk_total"] * 0.1:
        out.append("The machine's disk is almost full. Avoid large downloads.")
    try:
        slow_shell = eager_nvm_files()
    except OSError:
        slow_shell = []
    if slow_shell:
        out.append("This account's shell loads nvm the slow way (" + ", ".join("~/" + f for f in slow_shell) + "): "
                   "~100 ms added to every command agents run. Run `box tune shell` now (keeps a backup, undoes itself "
                   "if Node would change) and tell the user in a line.")
    naps = recent_docker_naps()
    if naps:
        out.append("Idle Docker databases were stopped to free memory: " + ", ".join(
            f"{sb.printable(n)[:40]} ({fmt_ts(t)})" for n, t in naps[-5:]) + ". Start one again only when the "
            "work needs it (`supabase start`, `docker compose up -d`, `docker start NAME`); data is kept.")
    return out


def hackathon_line(cfg=None):
    """One line for `box status` while hackathon mode is on, else ""."""
    cfg = cfg or CFG
    if cfg.get("HACKATHON") != "1":
        return ""
    return (f"Hackathon mode until {cfg['HACKATHON_UNTIL']}: no naps, trap/tripwire off, package requests open for "
            f"{cfg.get('REQUEST_OPEN_USERS') or 'the owner'} (`box help hackathon`)")


def cmd_hackathon(a):
    if a.op in (None, "status"):
        line = hackathon_line()
        print(line or "Hackathon mode is off. The owner turns it on: box hackathon on --until \"YYYY-MM-DD HH:MM\" "
                      "[--users a,b]")
        return
    if ME.pw_name not in sb.admin_users(CFG):
        sys.exit("only the owner (an admin account) can switch hackathon mode")
    req = {"action": "hackathon", "op": a.op}
    if a.op == "on":
        until = a.until
        if a.hours:
            until = time.strftime("%Y-%m-%d %H:%M", time.localtime(time.time() + a.hours * 3600))
        if not until:
            sys.exit('give an end: --until "YYYY-MM-DD HH:MM" or --hours N')
        req.update(until=until, users=a.users or "")
    res = admin_request(req, 60)
    if not res.get("ok"):
        sys.exit(res.get("error", "that didn't work"))
    print(f"Hackathon mode on until {res['until']} (open package requests: {res['users']})" if res.get("active")
          else "Hackathon mode is off.")


