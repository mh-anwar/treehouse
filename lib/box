# Everything a person can press on their page, their agent can do from here: the same code paths (root's drop for
# what needs root, `box _portal`'s functions for what runs as this account), with --json for agents.

def emit(res, as_json, text=None):
    """Print a result for a person (text, or the message/error) or an agent (--json); exit 1 when it failed."""
    if as_json:
        print(json.dumps(res))
    elif res.get("ok"):
        print(text if text is not None else res.get("message") or "Done.")
    else:
        print(res.get("error") or "that didn't work", file=sys.stderr)
    if not res.get("ok"):
        sys.exit(1)


def read_secret(prompt):
    """One line from stdin (piped), or typed without echo: secrets never go on the command line."""
    if sys.stdin.isatty():
        import getpass
        return getpass.getpass(prompt)
    return sys.stdin.readline()


