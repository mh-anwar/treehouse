                     "whether or not there are updates.") if reboot_days() else "", slots=CFG["HEAVY_SLOTS"], jobs=CFG["BUILD_JOBS"],
        tools=tl, extras="\n".join(extras), notices=nt, portal=portal_url()).strip()


def updates_text():
    """First sentence of the Reboots section in AGENTS.md: how this box gets its updates."""
    if sbdistro.current() == "arch":
        return ("System updates are installed by the owner, not automatically. When one needs a reboot "
                "(usually a kernel update), the box usually")
    return ("Security updates install automatically every night. When one needs a reboot (usually a kernel "
            "update), the box")


def burst_text(lim, key, what):
    """'5 cores (500%) while the box is quiet, 3 cores when it's busy' style text for the rules."""
    base, burst = lim[key], lim.get("BURST_" + key)
    fmt = (lambda v: f"{float(str(v).rstrip('%')) / 100:g} cores") if what == "cores" else str
    if not burst or burst == base:
        return fmt(base)
    return f"up to {fmt(burst)} while the box is quiet, {fmt(base)} when it's busy"


def burst_now(lim, key):
    """The limit in force right now, according to the guard's last balancing run."""
    st = sb.read_json(os.path.join(sb.STATE_DIR, "balance.json"), {}) or {}
    busy = st.get("cpu_busy") if key == "CPU_QUOTA" else st.get("mem_tight")
    burst = lim.get("BURST_" + key)
    if not burst or busy:
        return f"{lim[key]}{' (box busy)' if burst else ''}"
    return f"{burst} (box quiet; {lim[key]} when busy)"


def sync_agent_files(notices=()):
    block = f"{BEGIN}\n{render_rules(notices)}\n{END}"
    for rel in AGENT_FILES:
        p = os.path.join(HOME, rel)
        try:
            with open(p) as f:
                cur = f.read()
        except FileNotFoundError:
            cur = ""
        if BEGIN in cur and END in cur:
            pre, rest = cur.split(BEGIN, 1)
            post = rest.split(END, 1)[1]
            new = pre + block + post
        else:
            new = block + "\n" + ("\n" + cur if cur else "")
        if new != cur:
            os.makedirs(os.path.dirname(p), exist_ok=True)
            with open(p, "w") as f:
                f.write(new)


def cmd_rules(a):
    print(render_rules())


