        lines.append(hackathon_line())
    if lim:
        mem_cap = size_text(lim["MEMORY_MAX"])
        mem_lim = (f"{size_text(lim['MEMORY_LOW'])} guaranteed, up to {mem_cap}" if lim.get("MEMORY_LOW") else mem_cap)
        lines.append(f"You: CPU {live.get('cpu_pct', 0)}% | "
                     f"RAM {size_text(live.get('mem_used') if live.get('mem_used') is not None else live.get('mem', 0))} ({mem_lim}) | "
                     f"processes {live.get('pids', 0)} of {lim['TASKS_MAX']} | "
