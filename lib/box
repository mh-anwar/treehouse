def sync_agent_files(notices=()):
    block = f"{BEGIN}\n{render_rules(notices)}{team_rules()}\n{END}"
    for rel in AGENT_FILES:
        p = os.path.join(HOME, rel)
        try:
            with open(p) as f:
                cur = f.read()
        except FileNotFoundError:
            cur = ""
        b, e_ = cur.find(BEGIN), cur.find(END)
        if b != -1 and e_ > b:
            new = cur[:b] + block + cur[e_ + len(END):]
        else:
            # no block yet, or a damaged one (a marker missing or out of order): drop any stray markers' lines and
            # put a fresh block on top, so the file never grows a second copy
            kept = "\n".join(ln for ln in cur.splitlines() if BEGIN not in ln and END not in ln).strip()
            new = block + ("\n\n" + kept + "\n" if kept else "\n")
        if new != cur:
            os.makedirs(os.path.dirname(p), exist_ok=True)
            with open(p, "w") as f:
                f.write(new)


