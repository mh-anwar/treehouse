        subprocess.run(["git", "config", "--global", "user.name", full or login])
    if not email:
        subprocess.run(["git", "config", "--global", "user.email", f"{uid}+{login}@users.noreply.github.com"])


def portal_status():
    out = {"logins": {}, "t3": None}
    for key, (label, cmd, _) in PORTAL_LOGINS.items():
        if shutil.which(cmd[0]):
            out["logins"][key] = {"label": label, "ok": portal_logged_in(key)}
            if out["logins"][key]["ok"]:
                mark_setup_done(key)  # also covers friends who logged in before setup-done was written here
    if out["logins"].get("gh", {}).get("ok") and not all(git_ident()):
        gh_finish()
    r, host = ports(), sb.tailscale_ip4()
    if r and host and shutil.which("t3"):
        _, _, env = t3_env()
        out["t3"] = {"url": f"http://{host}:{r[0]}/", "running": t3_up(host, env)}
        out["t3"]["app"] = t3_app_paired()  # the start card leads with "Open T3" once the app has connected
    name, email = git_ident()
    out["git"] = {"name": name, "email": email}
    out["ssh"] = bool(ssh_keys())
    return out


def portal_t3(pair, app=False):
    if not shutil.which("t3"):
        return {"ok": False, "error": "T3 Code isn't installed on this box yet. Ask the owner."}
    r, host = ports(), sb.tailscale_ip4()
    if not r or not host:
        return {"ok": False, "error": "Tailscale isn't running on the box. Ask the owner."}
    host, port, env = t3_env()
    t3_ensure(host, port, env, quiet=True)
    if not pair:
        return {"ok": True}
    deadline = time.time() + 150  # the very first start downloads T3
    while not t3_up(host, env):
        if time.time() > deadline:
            return {"ok": False, "starting": True,
                    "error": "T3 Code is still starting (the first start downloads it). Try again in a minute."}
        time.sleep(2)
    time.sleep(2)
    env = t3_live_env(host, env)
    t3_starter(env)
    label = f"{ME.pw_name} T3 app" if app else f"{ME.pw_name} (join page)"  # the label lets us spot the app later
    r = subprocess.run(["t3", "pair", "--ttl", "30m", "--label", label],
                       env=dict(user_env(), **env), capture_output=True, text=True, timeout=60)
    url = next((l.split(":", 1)[1].strip() for l in r.stdout.splitlines() if l.startswith("Pairing URL:")), None)
    if not url:
        return {"ok": False, "error": "pairing failed; try again, or ask the owner to check `box t3 logs`"}
    url = public_t3_url(url, host, port)
    out = {"ok": True, "pair_url": url, "app_link": sbconnect.t3_app_link(url), "url": f"http://{host}:{port}/"}
    if app:  # for the setup prompt: the apps already connected (the laptop agent can't read the app's settings)
        out["apps"] = t3_app_sessions()
    return out


def app_setup_prompt(url):
    """The setup prompt for the agent on the friend's laptop, with what the box knows (their Tailscale account,
    T3 apps already connected): the same text as the dashboard's "Make my setup prompt"."""
    rec = (sb.registry().get("users") or {}).get(ME.pw_name) or {}
    ts = sbconnect.ts_facts(sb.tailscale_status(), rec)
    return sbconnect.app_prompt(url, portal_url(), socket.gethostname(), ts_login=ts["login"], ts_mode=ts["mode"],
                                apps=t3_app_sessions(), expires=sbconnect.pair_expires(time.time()))


def t3_starter(env):
    """First time only: a ready-made project, so T3 opens straight into something to chat in."""
    marker = os.path.join(HOME, ".sharedbox", "t3-starter")
    if os.path.exists(marker):
        return
    d = os.path.join(HOME, "my-first-app")
    os.makedirs(d, exist_ok=True)
    if not os.path.exists(os.path.join(d, ".git")):
        subprocess.run(["git", "init", "-q", "-b", "main", d], capture_output=True)
        with open(os.path.join(d, "README.md"), "w") as f:
            f.write("# My first app\n\nAsk your agent to build something here, e.g. "
                    "\"make me a simple website about my favourite movies and give me the link\".\n")
    r = subprocess.run(["t3", "project", "add", d, "--title", "My first app"],
                       env=dict(user_env(), **env), capture_output=True, text=True, timeout=60)
    if r.returncode == 0:
        os.makedirs(os.path.dirname(marker), exist_ok=True)
        open(marker, "w").close()


def ssh_keys():
    try:
        with open(os.path.join(HOME, ".ssh", "authorized_keys")) as f:
            return [l.strip() for l in f if l.strip() and not l.startswith("#")]
    except OSError:
        return []


def portal_add_key(key):
    key, err = sb.validate_pubkey(key)
    if err:
        return {"ok": False, "error": err}
    keys = ssh_keys()
    if key.split()[:2] not in [k.split()[:2] for k in keys]:
        os.makedirs(os.path.join(HOME, ".ssh"), mode=0o700, exist_ok=True)
        path = os.path.join(HOME, ".ssh", "authorized_keys")
        with open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600), "w") as f:
            f.write(key + "\n")
    return {"ok": True, "key_added": True}


def mark_setup_done(key):
    """A browser login to an AI worked: the friend is set up, so SSH logins show `box status`, not the welcome."""
    if key == "gh":
        return
    try:
        os.makedirs(os.path.join(HOME, ".sharedbox"), exist_ok=True)
        open(os.path.join(HOME, ".sharedbox", "setup-done"), "a").close()
    except OSError:
        pass


def portal_login_start(key, console=False):
    label, cmd, paste = PORTAL_LOGINS[key]
    if not shutil.which(cmd[0]):
        return {"ok": False, "error": f"{label} isn't installed on this box. Ask the owner."}
    if portal_logged_in(key):
        if key == "gh":
            gh_finish()
        mark_setup_done(key)
        return {"ok": True, "done": True}
    if key == "claude" and console:
        cmd = cmd + ["--console"]
    tmux("kill-session", "-t", key)
    # keep the pane around after the login exits so its last words can be read
    # gh asks extra y/n questions when it has a terminal; with no terminal it just prints the code
    run = '"$@" </dev/null 2>&1 | cat' if key == "gh" else '"$@"'
    wrapped = ["sh", "-c", run + '; echo "[login exited $?]"; sleep 300', "sh", *cmd]
    tm = ["tmux", "-L", LOGIN_SOCK, "new-session", "-d", "-s", key, "-x", "250", "-y", "60", "--", *wrapped]
    # a scope under the user's own systemd keeps it alive after the (root-run) caller exits
    r = subprocess.run(["systemd-run", "--user", "--scope", "--quiet", "--collect", "--", *tm],
                       env=user_env(), capture_output=True, text=True, timeout=30)
    if r.returncode != 0:
        subprocess.run(tm, env=user_env(), capture_output=True, timeout=30)
    deadline = time.time() + 25
    while time.time() < deadline:
        time.sleep(1)
        screen = login_screen(key)
        urls = URL_RE.findall(screen)
        codes = [] if paste else DEVICE_CODE_RE.findall(screen)
        if urls and (paste or codes):
            return {"ok": True, "url": urls[0], "code": codes[0] if codes else None, "paste": paste}
        if "[login exited" in screen:
            if portal_logged_in(key):
                mark_setup_done(key)
                return {"ok": True, "done": True}
            break
    err = f"{label} login didn't start: " + tail(login_screen(key))
    tmux("kill-session", "-t", key)  # don't leave a half-started login running
    return {"ok": False, "error": err}


def portal_login_code(key, code):
    code = (code or "").strip()
    if not PASTE_RE.fullmatch(code):
        return {"ok": False, "error": "that code doesn't look right; copy it again from the browser"}
    if tmux("has-session", "-t", key).returncode != 0:
        return {"ok": False, "error": "that login expired; start it again"}
    tmux("send-keys", "-t", key, "-l", "--", code)
    tmux("send-keys", "-t", key, "Enter")
    return portal_login_wait(key, 30)


def portal_login_wait(key, seconds):
    label = PORTAL_LOGINS[key][0]
    deadline = time.time() + seconds
    while time.time() < deadline:
        if portal_logged_in(key):
            if key == "gh":
                gh_finish()
            if key == "t3connect":
                # T3 links "on next start": restart this account's T3 Code so its relay comes up
                sctl("restart", "--no-block", T3_UNIT, capture=True)
            tmux("kill-session", "-t", key)
            mark_setup_done(key)
            return {"ok": True, "done": True}
        if "[login exited" in login_screen(key):
            break
        time.sleep(1)
    if portal_logged_in(key):
        mark_setup_done(key)
        return {"ok": True, "done": True}
    screen = login_screen(key)
    if "[login exited" in screen:  # it's over (failed or cancelled): clean it up; a pending one keeps waiting
        tmux("kill-session", "-t", key)
    return {"ok": False, "error": f"{label} login hasn't finished: " + tail(screen)}


def tail(screen, n=4):
    lines = [l.strip() for l in screen.splitlines()
             if l.strip() and "[login exited" not in l and "https://" not in l]
    return " / ".join(lines[-n:])[-400:] or "no output"


def portal_url():
    """The user's dashboard: the public site when there is one (works anywhere), else the tailnet page."""
    pub = sb.public_url(CFG)
    # the Tailscale IP, not the name: friends who joined the owner's tailnet as shared-in users can't resolve it
    return f"{pub}/_box/me" if pub else f"http://{sb.tailscale_ip4() or socket.gethostname()}:{CFG['WEB_PORT']}/me"


# servers from the web page: the friend's own `box serve` units
PORTAL_SERVER_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]{0,39}")  # never starts with "-": no option injection
PORTAL_SERVER_OPS = ("start", "stop", "restart")
PORTAL_LOG_LINES = 100
PORTAL_LOG_BYTES = 48 * 1024


def portal_server_name(name):
    """A NAME the web page may act on, or None. Same rules as unit(), minus non-ASCII and leading -/_."""
    name = name or ""
    return name if PORTAL_SERVER_RE.fullmatch(name) and name.isascii() else None


def portal_unit_port(name):
    try:
        with open(os.path.join(UNIT_DIR, f"sb-{name}.service")) as f:
            for l in f:
                if l.startswith("Environment=PORT="):
                    return l.strip().split("=", 2)[2]
    except OSError:
        pass
    return ""


def portal_own_server(name):
    """NAME if it's one of this user's own `box serve` units (a unit file we wrote), else None. Never sb-t3."""
    name = portal_server_name(name)
    if not name or name in ("t3", "t3-proxy") or not os.path.isfile(os.path.join(UNIT_DIR, f"sb-{name}.service")):
        return None
    return name


def portal_cap_lines(lines):
    """The last PORTAL_LOG_LINES lines, at most PORTAL_LOG_BYTES in total, as printable text."""
    out, size = [], 0
    for l in reversed([str(x) for x in lines][-PORTAL_LOG_LINES:]):
        l = l[:2000]
        size += len(l) + 1
        if size > PORTAL_LOG_BYTES:
            break
        out.append(l)
    return out[::-1]


def portal_serve_ls():
    seen, servers = set(), []
    for s in list_services():
        if s["name"] != "t3" and portal_server_name(s["name"]):
            seen.add(s["name"])
            servers.append({"name": s["name"], "state": s["state"], "port": portal_unit_port(s["name"])})
    try:  # a stopped, unloaded unit still has its file
        files = sorted(os.listdir(UNIT_DIR))
    except OSError:
        files = []
    for fn in files:
        n = fn[3:-8] if fn.startswith("sb-") and fn.endswith(".service") else ""
        if n and n != "t3" and n not in seen and portal_server_name(n):
            servers.append({"name": n, "state": "stopped", "port": portal_unit_port(n)})
    return {"ok": True, "servers": sorted(servers, key=lambda s: s["name"])}


def portal_serve_ctl(name, op):
    name = portal_own_server(name)
    if not name or op not in PORTAL_SERVER_OPS:
        return {"ok": False, "error": "no such server"}
    r = sctl(op, f"sb-{name}.service", capture=True)
    if r.returncode != 0:
        return {"ok": False, "error": f"{op} {name} failed: " + (r.stderr or r.stdout or "").strip()[-300:]}
    state = next((s["state"] for s in list_services() if s["name"] == name), "stopped")
    return {"ok": True, "name": name, "op": op, "state": state,
            "message": f"{name}: {'stopped' if op == 'stop' else op + 'ed'}"}


def portal_serve_logs(name):
    name = portal_own_server(name)
    if not name:
        return {"ok": False, "error": "no such server"}
    r = subprocess.run(["journalctl", "--user", "-u", f"sb-{name}.service", "-n", str(PORTAL_LOG_LINES),
                        "--no-pager", "-o", "short-iso"], env=user_env(), capture_output=True,
                       text=True, errors="replace", timeout=30)
    return {"ok": True, "name": name, "lines": portal_cap_lines(r.stdout.splitlines())}


def cmd_portal(a):
    try:
        if a.action == "status":
            out = portal_status()
            try:  # the page shows them, so save it a round trip
                out["servers"] = portal_serve_ls()["servers"]
            except (OSError, subprocess.SubprocessError):
                out["servers"] = None
        elif a.action == "serve-ls":
            out = portal_serve_ls()
        elif a.action == "serve-ctl" and a.arg in PORTAL_SERVER_OPS:
            out = portal_serve_ctl(a.key, a.arg)
        elif a.action == "serve-logs":
            out = portal_serve_logs(a.key)
        elif a.action in ("t3-start", "t3-pair"):
            out = portal_t3(a.action == "t3-pair", app=a.key == "app")
        elif a.action == "login-start" and a.key in PORTAL_LOGINS:
            out = portal_login_start(a.key, console=a.arg == "console")
        elif a.action == "login-code" and a.key in PORTAL_LOGINS:
            out = portal_login_code(a.key, sys.stdin.read(4096))
        elif a.action == "add-key":
            out = portal_add_key(sys.stdin.read(8192))
        elif a.action == "login-check" and a.key in PORTAL_LOGINS:
            out = portal_login_wait(a.key, 5)
        else:
            out = {"ok": False, "error": "unknown action"}
    except (OSError, subprocess.SubprocessError) as e:
        out = {"ok": False, "error": f"{type(e).__name__}: {e}"[:300]}
    print(json.dumps(out))


CLAUDE_HOOK = "box status --agent"
CLAUDE_HOOK_MARK = os.path.join(HOME, ".sharedbox", "claude-hook-added")


def sync_claude_hook():
    """Existing accounts get the SessionStart hook new ones get from skel (~/.claude/settings.json), once:
    merged in without touching anything else; a file that isn't valid JSON is left alone, and if the user
    removes the hook later it stays removed."""
    if os.path.exists(CLAUDE_HOOK_MARK):
        return
    path = os.path.join(HOME, ".claude", "settings.json")
    try:
        with open(path) as f:
            cfg = json.load(f)
    except FileNotFoundError:
        cfg = {}
    except (OSError, ValueError):
        return
    if not isinstance(cfg, dict):
        return
    hooks = cfg.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        return
    start = hooks.setdefault("SessionStart", [])
    if not isinstance(start, list):
        return
    have = any(isinstance(g, dict) and any(isinstance(h, dict) and str(h.get("command", "")).startswith(CLAUDE_HOOK)
                                           for h in (g.get("hooks") or []) if isinstance(g.get("hooks"), list))
               for g in start)
    if not have:
        start.append({"hooks": [{"type": "command", "command": CLAUDE_HOOK}]})
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = f"{path}.tmp-{os.getpid()}"
        with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            json.dump(cfg, f, indent=2)
            f.write("\n")
        try:
            os.chmod(tmp, os.stat(path).st_mode & 0o777)
        except OSError:
            pass
        os.replace(tmp, path)
    os.makedirs(os.path.dirname(CLAUDE_HOOK_MARK), exist_ok=True)
    open(CLAUDE_HOOK_MARK, "a").close()


LEGACY_HOOK = "box _auto-issues"  # an early session-start hook; `box status --agent` does the same work now


def drop_legacy_hook():
    """Remove the old `box _auto-issues` SessionStart hook where `box status --agent` is also there: it ran the
    same checks a second time at every session start (~0.1 s)."""
    path = os.path.join(HOME, ".claude", "settings.json")
    try:
        with open(path) as f:
            cfg = json.load(f)
        start = cfg["hooks"]["SessionStart"]
    except (OSError, ValueError, KeyError, TypeError):
        return
    if not isinstance(start, list):
        return

    def cmds(g):
        hs = g.get("hooks") if isinstance(g, dict) else None
        return [str(h.get("command", "")) for h in hs if isinstance(h, dict)] if isinstance(hs, list) else []
    if not any(c.startswith(CLAUDE_HOOK) for g in start for c in cmds(g)):
        return
    keep = [g for g in start if not (cmds(g) and all(c.startswith(LEGACY_HOOK) for c in cmds(g)))]
    if len(keep) == len(start):
        return
    cfg["hooks"]["SessionStart"] = keep
    tmp = f"{path}.tmp-{os.getpid()}"
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    try:
        os.chmod(tmp, os.stat(path).st_mode & 0o777)
    except OSError:
        pass
    os.replace(tmp, path)


T3_PROJECT_DIR = "~/"
T3_PROJECT_DIR_MARK = os.path.join(HOME, ".sharedbox", "t3-project-dir-home")


def sync_t3_project_dir():
    """T3's "Add project" folder picker starts in the home folder, once per account. Some accounts had
    ~/Projects (and a short-lived treehouse release set ~/projects), which confused people. Any other folder
    someone picked is kept, and so is a later change of theirs. A running T3 watches the file and picks this up."""
    if os.path.exists(T3_PROJECT_DIR_MARK):
        return
    path = os.path.join(os.environ.get("T3CODE_HOME") or os.path.join(HOME, ".t3"), "userdata", "settings.json")
    try:
        with open(path) as f:
            cfg = json.load(f)
    except FileNotFoundError:
        cfg = None  # T3's own default is the home folder already
    except (OSError, ValueError):
        return
    cur = cfg.get("addProjectBaseDirectory") if isinstance(cfg, dict) else None
    if isinstance(cur, str) and cur.rstrip("/") in ("~/Projects", "~/projects", os.path.join(HOME, "Projects")):
        cfg["addProjectBaseDirectory"] = T3_PROJECT_DIR
        tmp = f"{path}.tmp-{os.getpid()}"
        with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            json.dump(cfg, f, indent=2)
            f.write("\n")
        try:
            os.chmod(tmp, os.stat(path).st_mode & 0o777)
        except OSError:
            pass
        os.replace(tmp, path)
    os.makedirs(os.path.dirname(T3_PROJECT_DIR_MARK), exist_ok=True)
    open(T3_PROJECT_DIR_MARK, "a").close()


def sync_hooks():
    try:
        drop_legacy_hook()
    except OSError:
        pass
    try:
        sync_claude_hook()
    except OSError:
        pass  # a broken ~/.claude must never stop rules from syncing
    try:
        sync_t3_project_dir()
    except OSError:
        pass


def cmd_init_home(a):
