REBOOT_BACK = ("Comes back by itself: `box serve` services, group servers (`box shared`), T3 Code. "
               "Everything else stops (tmux, nohup, running builds): save work and finish long jobs before then.")


def advice(g):
    out = []
    for n in other_notices(3)[-5:]:
        out.append(f"{fmt_ts(n['ts'])}: {sb.printable(n['text'])} Tell the user if it's what they were waiting for.")
    rb = sb.reboot_info(CFG)
    if rb["postponed"]:
        out.append(f"The box is about to REBOOT (its scheduled reboot, {rb['schedule']}). It's waiting for agents "
                   f"to finish their current turn, until {fmt_ts(rb['latest'])} at the latest. Wrap up now; don't "
                   f"start long jobs. {REBOOT_BACK}")
    elif rb["at"] and rb["why"] == "updates":
        out.append(f"The box will REBOOT on {fmt_ts(rb['at'])} for security updates. {REBOOT_BACK}")
    elif rb["at"] and rb["at"] - time.time() < 12 * 3600:
        out.append(f"The box will REBOOT on {fmt_ts(rb['at'])}: its scheduled reboot, {rb['schedule']}. If an agent "
                   f"is mid-turn it waits up to 2 hours. {REBOOT_BACK}")
    b = g["box"]
    live = g["live"] or {}
    used = live.get("mem_used") if live.get("mem_used") is not None else live.get("mem", 0)
    cap = live.get("mem_max") or live.get("mem_high")
    if cap and used > 0.85 * cap:
        out.append(f"You are using {sb.human(used)} of the {sb.human(cap)} this account can have. If memory runs out, "
                   "the box stops whatever uses the most: free what you don't need (`box running`) and tell the user.")
    elif b.get("mem_avail") is not None and b["mem_avail"] < 0.1 * b["mem_total"]:
        out.append(f"The box is nearly out of memory ({sb.human(b['mem_avail'])} free). Avoid starting big jobs; "
                   "`box running` shows what this account runs.")
    for k in recent_oom_kills():
        out.append(f"{fmt_ts(k['ts'])}: the box ran out of memory and stopped {k['what']} to keep everything "
                   "else running. Tell the user in a line; start it again if it's needed, with less memory.")
    big = g.get("running")
    if big:
        out.append("Running for this user: " + "; ".join(running_line(it) for it in big[:6])
                   + (f"; and {len(big) - 6} more" if len(big) > 6 else "")
                   + ". Full list: `box running`. Don't stop these yourself; if one has been up for days and nothing "
                     "in this conversation uses it, mention it to the user.")
    j = g["janitor"]
    if j.get("over_budget"):
        out.append(f"You are OVER your disk budget. Caches and build outputs were wiped. "
                   f"Delete things you don't need, or the oldest idle, fully pushed projects will be removed "
                   f"after {fmt_ts(j['over_budget_deadline'])}." if j.get("over_budget_deadline")
                   else "You are OVER your disk budget. Free space now.")
    for p in j.get("projects", []):
        if p.get("delete_on"):
            out.append(f"Project ~/{p['name']} will be ARCHIVED on {fmt_ts(p['delete_on'])} "
                       f"(idle {p['idle_days']}d, everything pushed; then {archive_until_text()}). Touch it to keep it.")
    try:  # live from disk (a restore shows up right away); the janitor's last report otherwise
        import sbclean
        arch = [{"name": x["name"], "until": x["until"]}
                for x in sbclean.list_archives(HOME, sb.cfg_int(CFG, "ARCHIVE_DAYS")) if os.path.isdir(x["path"])]
    except (ImportError, OSError, ValueError):
        arch = j.get("archives", [])
    arch = [a for a in arch if a.get("until", 0) > time.time()]
    if arch:
        out.append("ARCHIVED projects (" + archive_until_text() + "): "
                   + ", ".join(f"{a['name']} (until {fmt_ts(a['until'])})" for a in arch[:8]) + ".")
    if b["disk_free"] < b["disk_total"] * 0.1:
        out.append("The machine's disk is almost full. Avoid large downloads.")
    try:
        slow_shell = eager_nvm_files()
    except OSError:
        slow_shell = []
    if slow_shell:
        out.append("This account's shell loads nvm the slow way (" + ", ".join("~/" + f for f in slow_shell) + "): "
                   "~100 ms added to every command agents run. Run `box tune shell` now (keeps a backup, undoes itself "
                   "if Node would change) and tell the user in a line.")
    return out


def hackathon_line(cfg=None):
    """One line for `box status` while hackathon mode is on, else ""."""
    cfg = cfg or CFG
    if cfg.get("HACKATHON") != "1":
        return ""
    return (f"Hackathon mode until {cfg['HACKATHON_UNTIL']}: package requests open for "
            f"{cfg.get('REQUEST_OPEN_USERS') or 'the owner'} (`box help hackathon`)")


def cmd_hackathon(a):
    if a.op in (None, "status"):
        line = hackathon_line()
        print(line or "Hackathon mode is off. The owner turns it on: box hackathon on --until \"YYYY-MM-DD HH:MM\" "
                      "[--users a,b]")
        return
    if ME.pw_name not in sb.admin_users(CFG):
        sys.exit("only the owner (an admin account) can switch hackathon mode")
    req = {"action": "hackathon", "op": a.op}
    if a.op == "on":
        until = a.until
        if a.hours:
            until = time.strftime("%Y-%m-%d %H:%M", time.localtime(time.time() + a.hours * 3600))
        if not until:
            sys.exit('give an end: --until "YYYY-MM-DD HH:MM" or --hours N')
        req.update(until=until, users=a.users or "")
    res = admin_request(req, 60)
    if not res.get("ok"):
        sys.exit(res.get("error", "that didn't work"))
    print(f"Hackathon mode on until {res['until']} (open package requests: {res['users']})" if res.get("active")
          else "Hackathon mode is off.")


def cmd_reboot(a):
    op = a.op or "status"
    if op == "status":
        rb = sb.reboot_info(CFG)
        data = {"hold_until": CFG.get("REBOOT_HOLD_UNTIL", "").strip() if rb.get("hold_until") else "",
                "next_reboot": fmt_ts(rb["at"]) if rb.get("at") else "",
                "why": rb.get("why") or "", "schedule": rb.get("schedule") or ""}
        if a.json:
            print(json.dumps(data))
            return
        if data["hold_until"]:
            print(f"Automatic reboots paused until {data['hold_until']}.")
        if data["next_reboot"]:
            print(f"Next reboot: {data['next_reboot']} ({data['why']}).")
        else:
            print("No reboot scheduled.")
        return
    if ME.pw_name not in sb.admin_users(CFG):
        sys.exit("only the owner (an admin account) can pause or resume automatic reboots")
    if op in ("off", "resume"):
        req = {"action": "reboot-hold", "op": "off"}
    else:
        until = a.until
        if a.hours is not None:
            if a.hours <= 0:
                sys.exit("--hours must be greater than 0")
            until = time.strftime("%Y-%m-%d %H:%M", time.localtime(time.time() + a.hours * 3600))
        if not until:
            until = time.strftime("%Y-%m-%d %H:%M", time.localtime(time.time() + 24 * 3600))
        req = {"action": "reboot-hold", "op": "on", "until": until}
    res = admin_request(req, 60)
    if not res.get("ok"):
        sys.exit(res.get("error", "that didn't work"))
    if a.json:
        print(json.dumps(res))
        return
    if res.get("active"):
        extra = " Cancelled a pending scheduled reboot." if res.get("cancelled") else ""
        nxt = f" Next scheduled reboot: {fmt_ts(res['next_reboot'])}." if res.get("next_reboot") else ""
        print(f"Automatic reboots paused until {res['until']}.{extra}{nxt}")
    else:
        nxt = f" Next scheduled reboot: {fmt_ts(res['next_reboot'])}." if res.get("next_reboot") else ""
        print(f"Automatic reboots resumed.{nxt}")


