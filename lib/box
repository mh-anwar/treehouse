# ---------- T3 Code (web UI for agents) ----------

T3_UNIT = "sb-t3.service"
T3_SOCKET = "sb-t3.socket"        # holds the friend's T3 port while T3 naps; the first connection starts it
T3_PROXY = "sb-t3-proxy.service"  # passes connections from that port to T3's own port
T3_SLEEPING = os.path.join(HOME, ".sharedbox", "t3-sleeping")  # napping: stopped for being unused, wakes on use
PROXYD = "/usr/lib/systemd/systemd-socket-proxyd"

# T3 Code naps when nobody uses it and wakes on the next connection, so it's always "there" for the T3 app
# and the browser but only takes memory while in use:
#   sb-t3.socket        listens on the friend's T3 port (first port of their block, what everyone connects to)
#   sb-t3-proxy.service started by that socket; forwards to T3 on the last port of the block (same address,
#                       so T3 still runs as a remote-reachable server: binding loopback instead would make it
#                       refuse pairing links and revoke every paired device)
#   sb-t3.service       T3 itself; counts as started only once it answers, so a waking connection just waits
# The janitor's nap check stops sb-t3.service (the proxy goes with it); the socket stays.


def t3_sleep():
    """Nap: stop T3 Code (the janitor decides, this runs as the user). The socket stays, so the next connection
    (T3 app, browser, the gate) wakes it. Older setups without the socket are switched over first."""
    if shutil.which("t3") and ports() and sb.tailscale_ip4():
        host, _, env = t3_env()
        t3_write_units(host, env)
    r = sctl("stop", T3_PROXY, T3_UNIT, capture=True)  # an older T3 holds the public port: free it first
    sctl("reset-failed", T3_UNIT, T3_PROXY, capture=True)
    sctl("enable", "--now", T3_SOCKET, capture=True)
    if r.returncode == 0:
        os.makedirs(os.path.dirname(T3_SLEEPING), exist_ok=True)
        with open(T3_SLEEPING, "w") as f:
            f.write(f"{int(time.time())}\n")
    return r.returncode == 0


def t3_db_state():
    """(agent turn running, scheduled tasks on) from a read-only look at T3's own database. An agent waiting on a
    slow download or a CI run barely uses CPU; scheduled tasks only fire while T3 runs (T3 skips a fixed-time
    run it was down for). Unknown layout or trouble = (False, False): the other checks still apply."""
    import sqlite3
    db = os.path.join(os.environ.get("T3CODE_HOME") or os.path.join(HOME, ".t3"), "userdata", "statev2.sqlite")
    if not os.path.exists(db):
        return False, False
    running = scheduled = False
    try:
        con = sqlite3.connect(f"file:{urllib.parse.quote(db)}?mode=ro", uri=True, timeout=5)
        try:
            day_ago = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(time.time() - 86400))
            try:  # a 'running' turn older than a day is a leftover from a crash
                running = bool(con.execute(
                    "SELECT 1 FROM orchestration_v2_projection_provider_turns WHERE status = 'running' "
                    "AND completed_at IS NULL AND started_at > ? LIMIT 1", (day_ago,)).fetchone())
            except sqlite3.Error:
                pass
            try:
                scheduled = bool(con.execute("SELECT 1 FROM scheduled_tasks WHERE enabled = 1 LIMIT 1").fetchone())
            except sqlite3.Error:
                pass
        finally:
            con.close()
    except sqlite3.Error:
        pass
    return running, scheduled


def t3_app_sessions():
    """The T3 apps (desktop, or paired by the setup prompt: "<user> T3 app", see portal_t3) that are connected to
    this friend's T3 right now: not revoked, not expired (T3 sessions last 30 days). Newest first, as dicts with
    os, ip (the laptop's Tailscale IP as the box saw it), version and last (date it last connected).
    A read-only look at T3's database; trouble = []."""
    import sqlite3
    db = os.path.join(os.environ.get("T3CODE_HOME") or os.path.join(HOME, ".t3"), "userdata", "statev2.sqlite")
    if not os.path.exists(db):
        return []
    now = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime())
    try:
        con = sqlite3.connect(f"file:{urllib.parse.quote(db)}?mode=ro", uri=True, timeout=5)
        try:
            cols = {r[1] for r in con.execute("PRAGMA table_info(auth_sessions)")}
            want = [c for c in ("client_os", "client_ip_address", "client_app_version", "last_connected_at",
                                "client_surface", "expires_at") if c in cols]
            rows = con.execute(f"SELECT {', '.join(['client_label'] + want)} FROM auth_sessions "
                               "WHERE revoked_at IS NULL", ()).fetchall()
        finally:
            con.close()
    except sqlite3.Error:
        return []
    out = []
    for row in rows:
        r = dict(zip(["client_label"] + want, row))
        if r["client_label"] != f"{ME.pw_name} T3 app" and r.get("client_surface") != "desktop":
            continue
        if r.get("expires_at") and r["expires_at"] <= now:
            continue
        out.append({"os": r.get("client_os") or "", "ip": r.get("client_ip_address") or "",
                    "version": r.get("client_app_version") or "", "last": (r.get("last_connected_at") or "")[:10]})
    return sorted(out, key=lambda a: a["last"], reverse=True)


def t3_app_paired():
    """Has the T3 app on a laptop actually connected (and is that session still valid)?"""
    return bool(t3_app_sessions())


def t3_busy():
    """Why T3 must stay up even though nothing looks active, or ""."""
    running, scheduled = t3_db_state()
    return "agent turn running" if running else "scheduled tasks on" if scheduled else ""


def t3_env():
    """(tailscale ip, public T3 port, env for `t3 serve`/`t3 pair`). T3 itself listens on the block's last port."""
    r = ports()
    host = sb.tailscale_ip4()
    if not r or not host:
        sys.exit("box t3: needs a friend account and Tailscale running on the box")
    return host, r[0], {"T3CODE_HOST": host, "T3CODE_PORT": str(r[1]),
                        "T3CODE_PROJECT_ROOT": os.path.join(HOME, "projects"), "T3CODE_NO_BROWSER": "1"}


def t3_legacy(host):
    """An older T3 (from before naps) still running on the public port itself, without the socket?"""
    return (sctl("is-active", T3_SOCKET, capture=True).stdout.strip() != "active"
            and listening(host, ports()[0]))


def t3_up(host, env):
    """Is T3 itself running (not just the socket that wakes it)?"""
    return listening(host, int(env["T3CODE_PORT"])) or t3_legacy(host)


def t3_live_env(host, env):
    """Env for talking to the running T3 (`t3 pair`): an older one listens on the public port."""
    return dict(env, T3CODE_PORT=str(ports()[0])) if t3_legacy(host) else env


def public_t3_url(url, host, port):
    """`t3 pair` prints T3's own port; people connect to the public one."""
    u = urllib.parse.urlsplit(url)
    return urllib.parse.urlunsplit(u._replace(netloc=f"{host}:{port}")) if u.netloc else url


def t3_pair(host, port, env, ttl="30m", label=None):
    r = subprocess.run(["t3", "pair", "--ttl", ttl, "--label", label or f"{ME.pw_name} (box t3)"],
                       env=dict(os.environ, **env), capture_output=True, text=True, timeout=60)
    url = next((l.split(":", 1)[1].strip() for l in r.stdout.splitlines()
                if l.startswith("Pairing URL:")), None)
    if not url:
        sys.exit("box t3: pairing failed:\n" + (r.stdout + r.stderr)[-1500:])
    return public_t3_url(url, host, port)


def listening(host, port):
    try:
        socket.create_connection((host, port), timeout=1).close()
        return True
    except OSError:
        return False


def t3_write_units(host, env):
    """Write the T3, proxy and socket user units. True if any changed (then daemon-reload has run)."""
    public, inner = ports()[0], env["T3CODE_PORT"]
    ready = (f"for i in $(seq 600); do c=$(curl -s -o /dev/null -w %{{http_code}} --max-time 2 "
             f"http://{host}:{inner}/api/auth/session); [ \"$c\" = 200 ] && exit 0; sleep 0.5; done; exit 1")
    t3 = ["[Unit]", "Description=T3 Code (box t3; naps when unused, " + T3_SOCKET + " wakes it)",
          "StartLimitIntervalSec=600", "StartLimitBurst=10", "",
          "[Service]", "WorkingDirectory=%h/projects",
          "Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"]
    t3 += [f"Environment={k}={sd_escape(v)}" for k, v in env.items()]
    t3 += ["ExecStart=/usr/local/bin/t3 serve",
           f"ExecStartPost=/bin/bash -c '{sd_escape(ready)}'",  # started = answering (first start downloads T3)
           "TimeoutStartSec=330", "SuccessExitStatus=143 SIGTERM", "Restart=on-failure", "RestartSec=5", ""]
    proxy = ["[Unit]", "Description=T3 Code wake-up proxy", f"Requires={T3_UNIT}", f"After={T3_UNIT}",
             f"BindsTo={T3_UNIT}", "", "[Service]", f"ExecStart={PROXYD} {host}:{inner}", ""]
    sock = ["[Unit]", "Description=T3 Code port (wakes T3 on the first connection)", "",
            "[Socket]", f"ListenStream={host}:{public}", "FreeBind=yes", f"Service={T3_PROXY}", "",
            "[Install]", "WantedBy=sockets.target", ""]
    changed = False
    for name, lines in ((T3_UNIT, t3), (T3_PROXY, proxy), (T3_SOCKET, sock)):
        path, body = os.path.join(UNIT_DIR, name), "\n".join(lines)
        try:
            same = open(path).read() == body
        except FileNotFoundError:
            same = False
        if not same:
            with open(path, "w") as f:
                f.write(body)
            changed = True
    if changed:
        sctl("disable", T3_UNIT, capture=True)  # older setups started T3 at boot; now the socket does, on demand
        sctl("daemon-reload", capture=True)
    return changed


def t3_ensure(host, port, env, quiet=False):
    """Make sure the T3 units are current, the socket is on, and T3 is starting. Doesn't wait for it."""
    try:
        os.unlink(T3_SLEEPING)  # awake again
    except OSError:
        pass
    os.makedirs(os.path.join(HOME, "projects"), exist_ok=True)
    os.makedirs(UNIT_DIR, exist_ok=True)
    if t3_legacy(host):
        return  # an older T3 is running (maybe mid-task): leave it; it switches over when it next naps
    if t3_write_units(host, env):
        # an older T3 may hold the public port itself, or run with old settings: restart it the new way
        sctl("stop", T3_PROXY, T3_UNIT, capture=True)
        sctl("restart", T3_SOCKET, capture=True)
    sctl("enable", "--now", T3_SOCKET, capture=True)
    sctl("start", "--no-block", T3_UNIT, capture=quiet)


def owner_t3():
