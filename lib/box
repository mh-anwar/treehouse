    s.add_parser("_auto-issues").set_defaults(fn=lambda a: auto_issues())  # silent; for agent hooks
    import sbmsg  # noqa: E402
    sbmsg.add_parsers(s, sb, CFG, ME.pw_name, HOME, lambda req, wait=30: shared_request(req, wait))
    import sbwhere  # noqa: E402
    sbwhere.add_parsers(s, sb, CFG, ME.pw_name, lambda req: shared_request(req, 30))
    # ---- multi-box (lib/sbmulti.py): `box boxes`, `box run --anywhere` ----
    import sbmulti  # noqa: E402
    sbmulti.add_parsers(s, sb, CFG, ME.pw_name, HOME, os.path.abspath(sys.argv[0]))
    # ---- end multi-box ----
    # `box -h` lists the main commands only; `box help commands` has the rest (internal `_` ones never show)
    p.cmd_helps = {c.dest: c.help for c in s._choices_actions}
    s._choices_actions = [s._ChoicesPseudoAction(k, (), v) for k, v in MAIN_COMMANDS if k in s.choices]
    return p


def main():
    if sys.argv[1:2] == ["team"]:  # argparse's REMAINDER drops leading options (--team, -h): hand over raw argv
        return cmd_team(argparse.Namespace(rest=sys.argv[2:]))
    p = build_parser()
    a = p.parse_args()
    if not a.sub:
        a = p.parse_args(["status"])
    a.fn(a)


if __name__ == "__main__":
    main()
