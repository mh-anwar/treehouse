                           text=True, errors="replace", timeout=120, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as ex:
        return False, type(ex).__name__
    if r.returncode == 0 or "already exists" in (r.stdout + r.stderr):
