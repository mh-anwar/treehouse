    sb.write_json(FED_STATE, st, mode=0o600)


def portal_peer_login(key, check=False):
    """Start (or check) a login on each of this person's other boxes. Each box answers with its own sign-in link
    and code, or done. [{"box", "done", "url", "code", "error"}]"""
    out = []
    for peer in sorted(fed_peers()):
        cmd = f"box _portal {'login-check' if check else 'login-start'} {shlex.quote(key)}"
        r = fed_remote_json(peer, cmd, timeout=90)
        row = {"box": peer, "done": bool(r.get("done"))}
        if r.get("done"):
            fed_peer_note(peer, key, True)
        elif r.get("ok") and r.get("url"):
            row.update(url=str(r["url"]), code=r.get("code") or "", paste=bool(r.get("paste")))
        elif not check:
            row["error"] = str(r.get("error") or "no answer")[:200]
        out.append(row)
    return {"ok": True, "boxes": out}


