def cmd_invite(a):
    """Ask root for a one-time invite link. Only accounts in ADMIN_USERS get an answer."""
    if ME.pw_name not in sb.admin_users(CFG):
        sys.exit("only the box owner's accounts (ADMIN_USERS) can invite people. "
                 "Ask the owner, or `box request \"invite <name>\"`.")
    rid = f"{os.getpid()}{int(time.time() * 1000)}{os.urandom(4).hex()}"
    req = {"action": "invite", "note": (a.note or "")[:120], "days": a.days, "tailscale": a.tailscale,
           "create": not a.no_create}
    if a.username:
        if a.no_create:
            sys.exit("--username needs the account to be created now; drop --no-create")
        req["username"] = a.username.strip()[:32]
    if a.email:
        req["email"] = a.email.strip()[:254]
    elif sb.public_mode(CFG) == "cloudflare" and not a.tailscale:
        sys.exit("this box uses Cloudflare Access: give the friend's email, e.g. "
                 "box invite --email sam@example.com --note \"Sam\" (they log in with it)")
    path = os.path.join(sb.ADMIN_DROP, f"{rid}.json")
    tmp = os.path.join(sb.ADMIN_DROP, f".{rid}.tmp")
    try:
        with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as f:
            json.dump(req, f)
        os.rename(tmp, path)  # the path unit only reacts to *.json, so it never sees a half-written file
    except OSError as e:
        sys.exit(f"could not reach the box's provisioner ({e}). Is sharedbox installed and up to date?")
    reply = os.path.join(sb.ADMIN_REPLIES, f"{rid}.json")
    # creating the account (and, in cloudflare mode, updating the Access allow list) takes a while
    wait = 30 if a.no_create and not a.email else 120
    deadline = time.time() + wait
    while time.time() < deadline:
        try:
            with open(reply) as f:
                res = json.load(f)
            break
        except (FileNotFoundError, ValueError):
            time.sleep(0.25)
    else:
        sys.exit(f"no answer from the provisioner after {wait} s (is sharedbox-provision.path running?)")
    if a.json:
        print(json.dumps(res))
        return
    if not res.get("ok"):
        sys.exit(res.get("error", "invite failed"))
    print(res["message"])
    if res.get("username"):
        what = (f"login link {res['id']} works once until "
                f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(res['expires']))}; " if res.get("id") else "")
        print(f"\n(account {res['username']} created; {what}undo: sudo sharedbox-admin remove {res['username']})",
              file=sys.stderr)
    elif res.get("id"):
        exp = time.strftime("%Y-%m-%d %H:%M", time.localtime(res["expires"]))
        print(f"\n(invite {res['id']}, single use, expires {exp})", file=sys.stderr)
    elif res.get("note"):
        print(f"\n({res['note']})", file=sys.stderr)


# ---------- shared skills (a catalog; nothing is installed until the owner says so) ----------

SKILL_LINK_DIRS = [".claude/skills", ".agents/skills"]  # Claude Code + opencode, Codex + opencode


def skill_catalog():
    """name -> {"path", "description", "source"}; admin-shared skills override the built-in ones."""
    out = {}
    for src, root in (("built-in", sb.SKILLS_BUILTIN), ("shared", sb.SKILLS_SHARED)):
        try:
            names = sorted(os.listdir(root))
        except OSError:
            continue
        for n in names:
            d = os.path.join(root, n)
            md = os.path.join(d, "SKILL.md")
            if not re.match(sb.SKILL_NAME_RE, n) or not os.path.isfile(md):
                continue
            desc = ""
            try:
                with open(md) as f:
                    head = f.read(4096)
                m = re.search(r"^description:\s*(?:>-?\s*\n)?(.+?)(?:\n\S|\n---)", head, re.M | re.S)
                desc = " ".join(m.group(1).split()) if m else ""
            except OSError:
                pass
            by = (sb.read_json(os.path.join(d, ".sharedbox.json"), {}) or {}).get("by")
            out[n] = {"path": d, "description": desc, "source": f"shared by {by}" if by else src}
    return out


def skill_state(name, path):
    """'installed', 'yours' (a skill of your own with that name), or ''."""
    states = set()
    for rel in SKILL_LINK_DIRS:
        p = os.path.join(HOME, rel, name)
        if os.path.islink(p):
            states.add("installed" if os.path.realpath(p) == os.path.realpath(path) else "yours")
        elif os.path.exists(p):
            states.add("yours")
    return "yours" if "yours" in states else ("installed" if states else "")


def need_skill(cat, name):
    if name not in cat:
        sys.exit(f"no shared skill called {name!r}. See `box skills`.")
    return cat[name]


def cmd_skills(a):
    cat = skill_catalog()
    if a.action == "ls":
        if a.json:
