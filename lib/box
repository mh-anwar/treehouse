def cmd_telegram(a):
    """Phone alerts (the Account tab's Telegram row) and, for the owner, the machine's bot (Settings tab)."""
    op = a.op or "status"
    if op in ("setup", "off"):
        if ME.pw_name not in sb.admin_users(CFG):
            sys.exit("only the owner sets up the machine's Telegram bot")
        req = {"action": "telegram-setup", "op": "off"} if op == "off" else {
            "action": "telegram-setup", "token": read_secret("Bot token from @BotFather: ").strip()[:200]}
        res = admin_request(req, 60)
        if op == "off" and res.get("ok"):
            res.setdefault("message", "Telegram is off. Everyone's phone connections are kept and work again when it's back on.")
        return emit(res, a.json)
    req = {"action": "telegram", "op": op}
    if op == "notify":
        if a.level not in ("all", "important", "off"):
            sys.exit("box telegram notify all|important|off")
        req["level"] = a.level
    res = shared_request(req, 60)
    if op == "status" and res.get("ok"):
        if not res.get("ready"):
            text = ("Telegram isn't set up on this machine yet. "
                    + ("Set it up: make a bot with @BotFather, then `box telegram setup` (token on stdin)."
                       if ME.pw_name in sb.admin_users(CFG) else "The owner turns it on."))
        elif res.get("linked"):
            text = (f"Telegram connected ({res.get('handle') or 'linked'}) to @{res.get('bot')}, "
                    f"notify: {res.get('notify') or 'all'}.")
        else:
            text = f"Telegram is available (@{res.get('bot')}) but not connected: `box telegram link`."
        return emit(res, a.json, text)
    if op == "link" and res.get("ok"):
        return emit(res, a.json, f"Open this link on the phone with Telegram and press Start (it works once):\n"
                                 f"{res['url']}\nThen `box telegram status` shows it connected.")
    emit(res, a.json)


LOGIN_KEYS = ("claude", "codex", "gh", "antigravity", "t3connect")


def cmd_login(a):
    """The dashboard's login buttons (Claude, ChatGPT, GitHub, Google for Antigravity, the T3 app), as commands.
    Start prints a link (and for some a code to type there); for Claude/Antigravity the page then shows a code that
    goes back in with --code (read from stdin). --check waits a few seconds for a finished login."""
    if not a.key:
        rows = {k: {"label": PORTAL_LOGINS[k][0], "ok": bool(portal_logged_in(k))} for k in LOGIN_KEYS
                if shutil.which(PORTAL_LOGINS[k][1][0])}
        for k, r in rows.items():
            if r["ok"] and k in ACCOUNT_KEYS + ("gh",):
                r["account"] = login_account(k)
        if a.json:
            print(json.dumps({"ok": True, "logins": rows}))
        else:
            for k, r in rows.items():
                print(f"  {k:<12} {r['label']:<22} " + (("logged in" + (f" as {r['account']}" if r.get("account") else ""))
                                                         if r["ok"] else "not yet: box login " + k))
            print("Other machines: box login KEY --on MACHINE (each machine can have its own account).")
        return
    a.on, a.logout = getattr(a, "on", None), getattr(a, "logout", False)
    if a.on or a.logout:
        if a.key not in ACCOUNT_KEYS + (PEER_LOGINS if not a.logout else ()):
            sys.exit(f"box login: --on / --logout work for: {', '.join(ACCOUNT_KEYS)}" + ("" if a.logout else ", t3connect"))
        here = not a.on or a.on == me_box()
        if a.logout:
            res = portal_logout(a.key) if here else portal_peer_logout(a.key, a.on)
            return emit(res, a.json)
        if not here:
            if a.code:
                res = portal_peer_code(a.key, a.on, read_secret("Code from the sign-in page: "))
                return emit(res, a.json)
            res = portal_peer_login(a.key, check=a.check, box=a.on)
            if not res.get("ok"):
                return emit(res, a.json)
            r = (res.get("boxes") or [{}])[0]
            if a.json:
                print(json.dumps(dict(r, ok=not r.get("error"))))
                return
            if r.get("done"):
                print(f"{PORTAL_LOGINS[a.key][0]}: signed in on {a.on}.")
            elif r.get("url"):
                print(f"Open {r['url']}" + (f"\nand enter the code {r['code']}" if r.get("code") else "")
                      + (f"\nThen paste the code it shows: box login {a.key} --on {a.on} --code (reads it from stdin)"
                         if r.get("paste") else f"\nThen: box login {a.key} --on {a.on} --check"))
            else:
                sys.exit(r.get("error") or "not signed in there yet")
            return
        if a.key == "claude" and not a.check and not a.code:
            claude_own(True)  # signed in for this machine only
    if a.other_boxes:
        if a.key not in PEER_LOGINS:
            sys.exit(f"--other-boxes works for: {', '.join(PEER_LOGINS)} (Claude and GitHub are copied by themselves)")
        res = portal_peer_login(a.key, check=a.check)
        if a.json:
            print(json.dumps(res))
            return
        for r in res.get("boxes") or []:
            print(f"  {r['box']}: " + ("done" if r.get("done") else
                                      f"open {r['url']}" + (f" and enter {r['code']}" if r.get("code") else "")
                                      if r.get("url") else r.get("error") or "not yet"))
        if not res.get("boxes"):
            print("No other machines answer over SSH yet (box boxes).")
        return
    if a.code:
        res = portal_login_code(a.key, read_secret("Code from the sign-in page: "))
    elif a.check:
        res = portal_login_wait(a.key, 5)
    else:
        res = portal_login_start(a.key, console=a.console)
    label = PORTAL_LOGINS[a.key][0]
    if res.get("ok") and res.get("done"):
        return emit(res, a.json, f"{label}: logged in.")
    if res.get("ok") and res.get("url"):
        text = (f"Open {res['url']}" + (f"\nand enter the code {res['code']}" if res.get("code") else "")
                + (f"\nThen paste the code it shows: box login {a.key} --code (reads it from stdin)"
                   if res.get("paste") else f"\nThen: box login {a.key} --check"))
        return emit(res, a.json, text)
    emit(res, a.json)


def cmd_teammates(a):
