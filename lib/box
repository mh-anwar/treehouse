# ---------- ports ----------

def port_in_use(p):
    for fam, addr in ((socket.AF_INET, "0.0.0.0"), (socket.AF_INET6, "::")):
        s = socket.socket(fam, socket.SOCK_STREAM)
        try:
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.bind((addr, p))
        except OSError:
            return True
        finally:
            s.close()
    return False


def cmd_ports(a):
    r = ports()
    if not r:
        sys.exit(f"you are not a {BRAND} friend account; any free port is fine")
    used = [p for p in range(r[0], r[1] + 1) if port_in_use(p)]
    print(f"your ports: {r[0]}-{r[1]}  ({r[0]} and {r[1]} are reserved for your T3 Code server)")
    print("in use: " + (", ".join(map(str, used)) or "none"))


