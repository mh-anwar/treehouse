def shared_request(req, wait=60):
    """Drop a request for root in SHARED_DROP and wait for the answer (always a dict)."""
    rid = f"{os.getpid()}{int(time.time() * 1000)}{os.urandom(4).hex()}"
    path = os.path.join(sb.SHARED_DROP, f"{rid}.json")
    tmp = os.path.join(sb.SHARED_DROP, f".{rid}.tmp")
    try:
        with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as f:
            json.dump(req, f)
        os.rename(tmp, path)  # the path unit only reacts to *.json, so it never sees a half-written file
    except OSError as e:
        if not wait:
            return {"ok": False}
        return {"ok": False, "error": provisioner_trouble(f"the machine couldn't take this request ({e.strerror or e})")}
    if not wait:  # fire and forget (e.g. "seen" receipts)
        return {"ok": True, "queued": True}
    reply = os.path.join(sb.SHARED_REPLIES, f"{rid}.json")
    deadline = time.time() + wait
    while time.time() < deadline:
        try:
            with open(reply) as f:
                res = json.load(f)  # root prunes replies after 10 min
            return res if isinstance(res, dict) else {"ok": False, "error": "The machine gave an answer this "
                                                      "command doesn't understand. Try again in a minute."}
        except (FileNotFoundError, ValueError):
            time.sleep(0.25)
    return {"ok": False, "error": provisioner_trouble(f"the machine didn't answer within {wait} seconds")}


def cmd_shared(a):
    def done(res):
        if a.json:
            print(json.dumps(res))
            sys.exit(0 if res.get("ok") else 1)
        if not res.get("ok"):
            sys.exit(f"box shared {a.action}: {res.get('error', 'failed')}")
        if "lines" in res:
            print("\n".join(res["lines"]) or "(no log lines yet)")
        elif "servers" not in res:
            print(res.get("message", "done"))
        sys.exit(0)

    import sbshared
    err = sbshared.parse_tail(a)
    if err:
        done({"ok": False, "error": err})
    if a.action == "ls":
        servers = sbshared.list_servers(CFG)
        if not a.json:
            if not servers:
                print("no shared servers yet. make one: box shared create NAME --desc \"what it does\"")
            for x in servers:
                print(f"{x['name']:<20} {x['state']:<10} port {x['port'] or '-':<6} "
                      f"{sb.printable(' '.join(x['cmd'])) or '(nothing set to run)'}\n"
                      f"{'':<20} {sb.printable(x.get('desc') or '') or '(no description yet: box shared describe ' + x['name'] + ' TEXT)'}\n"
                      f"{'':<20} {x['dir']}  by {x['created_by']}, last change {x['updated_by']} "
                      f"{fmt_ts(x['updated']) if x.get('updated') else ''}")
        done({"ok": True, "servers": servers})
    if ME.pw_name not in sb.admin_users(CFG) and not is_friend():
        done({"ok": False, "error": "only friends and the owner's accounts can manage shared servers"})
    if not a.name:
        done({"ok": False, "error": f"usage: box shared {a.action} NAME"})
    if not sbshared.NAME_RE.match(a.name):
        done({"ok": False, "error": "name: 2-31 lowercase letters, digits or -, starting with a letter"})
    req = {"action": a.action, "name": a.name}
    if a.action == "create":
        if not getattr(a, "desc", None) or a.cmd:
            done({"ok": False, "error": "usage: box shared create NAME --desc \"what it does and who it's for\""})
        req["desc"] = a.desc
    elif a.action == "describe":
        if "--json" in (a.cmd or []):  # typed after the text: an option, not part of the description
            a.json = True
        text = " ".join(w for w in a.cmd or [] if w != "--json") or getattr(a, "desc", None)
        if not text:
            done({"ok": False, "error": "usage: box shared describe NAME \"what it does and who it's for\""})
        req["desc"] = text
        a.cmd = None
    if a.action == "set":
        if not a.cmd:
            done({"ok": False, "error": "usage: box shared set NAME [--port P] -- COMMAND..."})
        req.update(cmd=a.cmd, port=a.port)
    elif a.action not in ("create", "describe") and (a.cmd or a.port is not None):
        done({"ok": False, "error": f"box shared {a.action} takes only a NAME"})
    if a.action == "logs":
        req["lines"] = a.lines
    done(shared_request(req))


