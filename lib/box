SECURITY_NOTE = ("Serious security fixes are applied to everyone, even on manual: if your version has a "
                 "serious security advisory that the newest version fixes, you're moved to the newest.")


def agent_info():
    """(mode, pending, {npm name: {current, mine, bins}}): which agent versions this user runs."""
    st = sb.read_json(sb.TOOLS_JSON, {}) or {}
    mode, chose = sb.agent_pref(CFG, HOME)
    pdir = os.path.join(sb.AGENT_PINS, ME.pw_name)
    try:
        applied = os.stat(os.path.join(pdir, ".applied")).st_mtime
    except OSError:
        applied = 0
    pending = mode == "manual" and (chose > applied or not applied)  # pinned at the next nightly run
    out = {}
    for name, ag in (st.get("agents") or {}).items():
        mine = ag.get("current")
        if mode == "manual" and not pending:
            try:
                mine = os.path.basename(os.readlink(os.path.join(pdir, sb.agent_slug(name))))
            except OSError:
                pass
        out[name] = dict(ag, mine=mine)
    return mode, pending, out


