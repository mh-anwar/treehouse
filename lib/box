def member_request(req, wait=60):
    """Drop a request for root in MEMBER_DROP and wait for the answer (always a dict)."""
    rid = f"{os.getpid()}{int(time.time() * 1000)}{os.urandom(4).hex()}"
    path = os.path.join(sb.MEMBER_DROP, f"{rid}.json")
    tmp = os.path.join(sb.MEMBER_DROP, f".{rid}.tmp")
    try:
        with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as f:
            json.dump(req, f)
        os.rename(tmp, path)  # the path unit only reacts to *.json, so it never sees a half-written file
    except OSError as e:
        return {"ok": False, "error": provisioner_trouble(f"the box couldn't take this request ({e.strerror or e})")}
    reply = os.path.join(sb.MEMBER_REPLIES, f"{rid}.json")
    deadline = time.time() + wait
    while time.time() < deadline:
        try:
            with open(reply) as f:
                res = json.load(f)  # root prunes replies after 10 min
            return res if isinstance(res, dict) else {"ok": False, "error": "bad answer from the provisioner"}
        except (FileNotFoundError, ValueError):
            time.sleep(0.25)
    return {"ok": False, "error": provisioner_trouble(f"the box didn't answer within {wait} seconds")}


# ---------- shared skills (a catalog; nothing is installed until the owner says so) ----------

SKILL_LINK_DIRS = [".claude/skills", ".agents/skills"]  # Claude Code + opencode, Codex + opencode


def skill_catalog():
    """name -> {"path", "description", "source"}; admin-shared skills override the built-in ones."""
    out = {}
    for src, root in (("built-in", sb.SKILLS_BUILTIN), ("shared", sb.SKILLS_SHARED)):
        try:
            names = sorted(os.listdir(root))
        except OSError:
            continue
        for n in names:
            d = os.path.join(root, n)
            md = os.path.join(d, "SKILL.md")
            if not re.match(sb.SKILL_NAME_RE, n) or not os.path.isfile(md):
                continue
            desc = ""
            try:
                with open(md) as f:
                    head = f.read(4096)
                m = re.search(r"^description:\s*(?:>-?\s*\n)?(.+?)(?:\n\S|\n---)", head, re.M | re.S)
                desc = " ".join(m.group(1).split()) if m else ""
            except OSError:
                pass
            by = (sb.read_json(os.path.join(d, ".sharedbox.json"), {}) or {}).get("by")
            out[n] = {"path": d, "description": desc, "source": f"shared by {by}" if by else src}
    return out


def skill_state(name, path):
    """'installed', 'yours' (a skill of your own with that name), or ''."""
    states = set()
    for rel in SKILL_LINK_DIRS:
        p = os.path.join(HOME, rel, name)
        if os.path.islink(p):
            states.add("installed" if os.path.realpath(p) == os.path.realpath(path) else "yours")
        elif os.path.exists(p):
            states.add("yours")
    return "yours" if "yours" in states else ("installed" if states else "")


def need_skill(cat, name):
    if name not in cat:
        sys.exit(f"no shared skill called {name!r}. See `box skills`.")
    return cat[name]


def cmd_skills(a):
    cat = skill_catalog()
    if a.action == "ls":
        if a.json:
            print(json.dumps({n: dict(v, state=skill_state(n, v["path"])) for n, v in cat.items()}))
            return
