        res = sbtelemetry.read(path, lambda con: sbtelemetry.summary(con, a.hours, a.box))
        print(json.dumps(res, default=str) if a.json else sbtelemetry.render_summary(res))
    elif op == "patterns":
        path, label = telemetry_source(a)
        res = sbtelemetry.read(path, lambda con: sbtelemetry.patterns(con, a.days, a.box))
        print(json.dumps(res, default=str) if a.json else sbtelemetry.render_patterns(res))
    elif op == "sql":
        if not args:
            sys.exit('usage: box telemetry sql "SELECT ..." (read-only; tables and examples: box help telemetry)')
        path, _ = telemetry_source(a)
        try:
            cols, rows = sbtelemetry.sql(path, " ".join(args))
        except Exception as e:  # noqa: BLE001 - a bad query: say why
            sys.exit(f"box telemetry sql: {e}")
        if a.json:
            print(json.dumps([dict(zip(cols, r)) for r in rows]))
        else:
            print("\t".join(cols))
            for r in rows:
                print("\t".join("" if v is None else str(v) for v in r))
    elif op == "pull":
        import sbmulti
        local, _ = sbtelemetry.readable_db(sb.STATE_DIR, ME.pw_name)
        sbme_dir()
        out = sbtelemetry.pull(ME.pw_dir, local, projects_peers(), sbmulti.SSH_OPTS,
                               max_mb=2 * sbtelemetry.cfg_num(CFG, "TELEMETRY_MAX_MB", 1024))
        print(json.dumps(out) if a.json else "\n".join(f"{k}: {v}" for k, v in out.items()) or "nothing to pull")
    elif op == "usage":
        sub = args[0] if args else "status"
        if sub not in ("status", "on", "off", "now"):
            sys.exit("usage: box telemetry usage [on|off|now]")
        sbme_dir()
        if sub in ("on", "off"):
            sbtelemetry.usage_set(ME.pw_dir, sub == "on")
        res = {"on": sbtelemetry.usage_on(ME.pw_dir)}
        if sub in ("on", "now"):
            res |= sbtelemetry.poll_usage(ME.pw_dir, ME.pw_name, me_box(), notify=telemetry_notify, force=True)
        if a.json:
            print(json.dumps(res))
            return
        print(f"Plan usage checks: {'on (every ~10 minutes, box msg at 80% and 90%)' if res['on'] else 'off'}")
        for k, w in (res.get("windows") or {}).items():
            print(f"  {k}: {w['utilization']:.0f}% (resets {w['resets_at'] or '?'})")
        if res.get("error"):
            print(f"  {res['error']}")
        if sub == "status" and not res["on"]:
            print("Turn on: box telemetry usage on")
    elif op == "info":
        path, label = telemetry_source(a)

        def info(con):
            q = lambda s: con.execute(s).fetchone()[0]  # noqa: E731
            return {"path": path, "reads": label, "size_mb": round(os.path.getsize(path) / 1e6, 1),
                    "boxes": sbtelemetry.boxes_in(con), "minute_rows_from": q("SELECT min(ts) FROM samples"),
                    "hourly_rows_from": q("SELECT min(ts) FROM samples_hourly"), "events": q("SELECT count(*) FROM events")}
        res = sbtelemetry.read(path, info)
        if a.json:
            print(json.dumps(res))
            return
        when = lambda t: time.strftime("%Y-%m-%d %H:%M", time.localtime(t)) if t else "-"  # noqa: E731
        print(f"{res['path']} ({res['reads']}): {res['size_mb']} MB, boxes {', '.join(res['boxes']) or '-'}, "
              f"minute rows since {when(res['minute_rows_from'])}, hourly since {when(res['hourly_rows_from'])}, "
              f"{res['events']} events")
    else:
        sys.exit(TELEMETRY_USAGE)


