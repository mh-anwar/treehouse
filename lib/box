def my_limits():
    rec = sb.registry().get("users", {}).get(ME.pw_name)
    lim = sb.user_limits(CFG, rec)
    if not rec and ME.pw_name in sb.admin_users(CFG):
        # the janitor never enforces a disk budget on the owner's accounts: theirs is only what their agents are
        # told to stay within, so they set it themselves (`box limits disk N`)
        own = sb.read_json(OWNER_LIMITS, {}) or {}
        if str(own.get("DISK_BUDGET_GB", "")).isdigit():
            lim["DISK_BUDGET_GB"] = own["DISK_BUDGET_GB"]
