            print(f"{n:22} {mark}{v['description'][:100]}  ({v['source']})")
        print(f"\nCatalog: {sb.SKILLS_BUILTIN}/README.md. Agents: ask your owner before `box skills add NAME`.")
    elif a.action == "show":
        v = need_skill(cat, a.name)
        print(f"# {v['path']}\n")
