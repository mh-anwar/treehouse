FED_KEY = os.path.join(HOME, ".ssh", "id_treehouse")
FED_STATE = os.path.join(HOME, ".sharedbox", "boxes-state.json")


def fed_read(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ""


def fed_ssh(dest, cmd, input_text=None, timeout=120):
    import sbmulti
    return subprocess.run(["ssh", *sbmulti.SSH_OPTS, dest, cmd], input=input_text, capture_output=True, text=True,
                          timeout=timeout, stdin=None if input_text is not None else subprocess.DEVNULL)


def fed_remote_json(dest, cmd, input_text=None, timeout=120):
    try:
        r = fed_ssh(dest, cmd, input_text, timeout)
        return json.loads((r.stdout.strip().splitlines() or ["{}"])[-1])
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return {"ok": False, "error": "no answer"}


def fed_link_peer(peer, ip, home, notes):
    """One other machine: can we log in; T3 there linked into T3 here; GitHub token + git identity (from the home
    box only); which agent logins are missing there."""
    out = {"ssh": False}
    if fed_ssh(peer, "true", timeout=20).returncode != 0:
        notes.append(f"can't ssh to {peer} yet")
        return out
    out["ssh"] = True
    if home and gh_ok():  # a GitHub OAuth token doesn't rotate: the same one works on both machines
        st = fed_remote_json(peer, "box _portal status", timeout=60)
        if not (st.get("logins") or {}).get("gh", {}).get("ok"):
            tok = subprocess.run(["gh", "auth", "token"], capture_output=True, text=True, timeout=20).stdout.strip()
            if tok:
                r = fed_ssh(peer, "gh auth login --hostname github.com --git-protocol https --with-token && "
                                  "gh auth setup-git", input_text=tok + "\n", timeout=60)
                out["gh"] = r.returncode == 0
                if r.returncode == 0:
                    notes.append(f"GitHub login copied to {peer}")
    # Claude: the one-year token (doesn't rotate). The newest copy wins: whichever box has a newer one pushes it.
    mine = "" if os.path.exists(CLAUDE_OWN) else fed_read(CLAUDE_TOKEN).strip()
    if mine:
        info = fed_remote_json(peer, "box _portal claude-token-info", timeout=60)
        mt = int(os.path.getmtime(CLAUDE_TOKEN))
        if info.get("ok") and not info.get("own") and int(info.get("mtime") or 0) < mt:
            r = fed_remote_json(peer, "box _portal claude-token-put", json.dumps({"token": mine, "mtime": mt}),
                                timeout=60)
            if r.get("ok"):
                notes.append(f"Claude login copied to {peer}")
    if home:
        name, email = git_ident()
        if name and email:
            q = shlex.quote
            fed_ssh(peer, f"git config --global user.name >/dev/null || git config --global user.name {q(name)}; "
                          f"git config --global user.email >/dev/null || git config --global user.email {q(email)}",
                    timeout=30)
    # T3: link the other box's T3 into this one (each box does this, so the link goes both ways)
    if shutil.which("t3") and is_friend():
        lo = ports()[0]
        url = f"http://{ip}:{lo}"
        try:
            envs = json.loads(subprocess.run(["t3", "environment", "list", "--json"], env=user_env(),
                                             capture_output=True, text=True, timeout=60).stdout or "[]")
        except (ValueError, OSError, subprocess.TimeoutExpired):
            envs = []
        import sbfed
        if sbfed.link_due(envs, url, time.time()):
            pr = fed_remote_json(peer, "box _portal t3-pair", timeout=240)
            tok = sbfed.pair_token(pr.get("pair_url", ""))
            if tok:
                r = subprocess.run(sbfed.link_argv(url, tok), env=user_env(), capture_output=True, text=True,
                                   timeout=120)
                out["t3"] = r.returncode == 0
                notes.append(f"T3 on {peer} linked" if r.returncode == 0 else
                             f"T3 link to {peer} failed: {(r.stderr or r.stdout).strip()[-150:]}")
            else:
                notes.append(f"T3 on {peer} didn't give a pairing code: {pr.get('error', '')[:100]}")
        else:
            out["t3"] = True
    st = fed_remote_json(peer, "box _portal status", timeout=60)
    there = {k: v.get("ok") for k, v in (st.get("logins") or {}).items()}
    out["missing_logins"] = [k for k in ("claude", "codex") if portal_logged_in(k) and there.get(k) is False]
    out["logins"] = {k: bool(v) for k, v in there.items() if k in PEER_LOGINS + ("claude", "gh", "antigravity")}
    acc = st.get("accounts") if isinstance(st.get("accounts"), dict) else {}
    out["accounts"] = {k: v for k, v in acc.items() if k in ACCOUNT_KEYS and isinstance(v, str)
                       and (EMAIL_RE.fullmatch(v) or v == "an API key")}
    out["claude_own"] = bool(st.get("claude_own"))
    return out


# Logins that can't be copied between boxes (a T3 Connect authorization belongs to one machine; OpenAI says a
# Codex auth.json must not be shared): the dashboard starts them on the person's other boxes at once and shows
# one approve link per box.
PEER_LOGINS = ("t3connect", "codex")


def fed_peers():
    """{box: ip} of this person's other machines that answer over SSH (from the last federation link pass)."""
    st = sb.read_json(FED_STATE, {}) or {}
    boxes = sb.boxes(CFG)
    return {p: boxes.get(p, "") for p, v in (st.get("peers") or {}).items() if isinstance(v, dict) and v.get("ssh")}


def fed_peer_note(peer, key, ok):
    """Remember a login's state on a peer between link passes (the dashboard's "Your machines" line)."""
    st = sb.read_json(FED_STATE, {}) or {}
    p = (st.setdefault("peers", {}).setdefault(peer, {}))
    p.setdefault("logins", {})[key] = bool(ok)
    sb.write_json(FED_STATE, st, mode=0o600)


def portal_peer_login(key, check=False, box=None):
    """Start (or check) a login on each of this person's other machines, or only on `box`. Each machine answers with its
    own sign-in link and code, or done. [{"box", "done", "url", "code", "paste", "error"}]
    A Claude sign-in started for one machine makes that machine keep its own Claude account ("local")."""
    peers = sorted(fed_peers())
    if box:
        if box not in peers:
            return {"ok": False, "error": f"{box} isn't connected to this machine yet. Machines connect by themselves "
                                          "within a few minutes; try again later."}
        peers = [box]
    out = []
    for peer in peers:
        local = " local" if key == "claude" and box and not check else ""
        cmd = f"box _portal {'login-check' if check else 'login-start'} {shlex.quote(key)}{local}"
        r = fed_remote_json(peer, cmd, timeout=90)
        row = {"box": peer, "done": bool(r.get("done"))}
        if r.get("done"):
            fed_peer_note(peer, key, True)
        elif r.get("ok") and r.get("url"):
            row.update(url=str(r["url"]), code=r.get("code") or "", paste=bool(r.get("paste")))
        elif not check:
            row["error"] = str(r.get("error") or "no answer")[:200]
        out.append(row)
    return {"ok": True, "boxes": out}


def portal_peer_code(key, box, code):
    """The code a Claude / Google sign-in page showed, for a login started on another machine."""
    if box not in fed_peers():
        return {"ok": False, "error": f"{box} isn't connected to this machine yet."}
    r = fed_remote_json(box, f"box _portal login-code {shlex.quote(key)}", (code or "").strip()[:1000], timeout=90)
    if r.get("done") or (r.get("ok") and r.get("done") is not False and not r.get("error")):
        fed_peer_note(box, key, True)
        return {"ok": True, "done": True, "message": f"Signed in on {box}."}
    return {"ok": False, "error": str(r.get("error") or f"{box} didn't confirm the sign-in. Try again.")[:300]}


def portal_peer_logout(key, box):
    if box not in fed_peers():
        return {"ok": False, "error": f"{box} isn't connected to this machine yet."}
    r = fed_remote_json(box, f"box _portal logout {shlex.quote(key)}", timeout=60)
    if r.get("ok"):
        fed_peer_note(box, key, False)
        st = sb.read_json(FED_STATE, {}) or {}
        ((st.get("peers") or {}).get(box) or {}).get("accounts", {}).pop(key, None)
        sb.write_json(FED_STATE, st, mode=0o600)
    return r if r.get("ok") else {"ok": False, "error": str(r.get("error") or f"{box} didn't answer.")[:300]}


