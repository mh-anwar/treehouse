def projects_remote(dest, req):
    """Run `box _projects-here` on another box as this person, at low priority. Its answer, or an error."""
    import sbprojects
    try:
        r = fed_ssh(dest, shlex.join([*sbprojects.NICE, "box", "_projects-here"]), json.dumps(req),
                    timeout=sbprojects.PEER_TIMEOUT)
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": "That box took too long to answer; trying again at the next sync."}
    except OSError as ex:
        return {"ok": False, "error": str(ex)[:200]}
    if "invalid choice" in r.stderr and "_projects-here" in r.stderr:
        return {"ok": False, "error": "That box needs a treehouse update first."}
    if r.returncode == 255:
        return {"ok": False, "error": ("Not connected yet. Your boxes connect to each other by themselves within a few minutes; "
                                      "if this stays for a day, the owner can fix it.")}
    try:
        return json.loads((r.stdout.strip().splitlines() or ["{}"])[-1])
    except ValueError:
        return {"ok": False, "error": "No answer: " + (r.stderr.strip().splitlines() or ["?"])[-1][:150]}


