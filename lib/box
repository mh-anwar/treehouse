def fed_peer_note(peer, key, ok):
    """Remember a login's state on a peer between link passes (the dashboard's "Your boxes" line)."""
    st = sb.read_json(FED_STATE, {}) or {}
    p = (st.setdefault("peers", {}).setdefault(peer, {}))
