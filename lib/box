AGY_TOKEN = os.path.join(HOME, ".gemini", "antigravity-cli", "antigravity-oauth-token")
AGY_CHECK = os.path.join(HOME, ".sharedbox", "antigravity-check.json")
AGY_OK_TTL = 600  # a "signed in" answer is re-checked after this many seconds: Google can revoke or expire the grant
#                   without the CLI ever rewriting the token file


def antigravity_ok(fresh=False):
    """Signed in to Antigravity: its token file has something in it, and `antigravity models` doesn't ask to sign in
    (~1 s; when it can't tell, e.g. offline, the file decides). A "signed out" answer is kept for that version of the
    token file (a new sign-in rewrites it); a "signed in" one only for AGY_OK_TTL. fresh=True skips the cache."""
    try:
        st = os.stat(AGY_TOKEN)
    except OSError:
        return False
    if not st.st_size:
        return False
    seen = sb.read_json(AGY_CHECK, {}) or {}
    if not fresh and isinstance(seen, dict) and seen.get("key") == f"{st.st_mtime_ns}:{st.st_size}":
        if not seen.get("ok"):
            return False
        at = seen.get("at")
        if isinstance(at, (int, float)) and 0 <= time.time() - at < AGY_OK_TTL:
            return True
    ok = True
    try:
        r = subprocess.run(["antigravity", "models"], env=dict(user_env(), AGY_CLI_DISABLE_AUTO_UPDATE="true"),
                           stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=20)
        ok = r.returncode == 0 or "sign in" not in (r.stdout + r.stderr).lower()
    except (OSError, subprocess.TimeoutExpired):
        pass
    try:  # the check may have refreshed the token: remember the file as it is now
        st = os.stat(AGY_TOKEN)
        os.makedirs(os.path.dirname(AGY_CHECK), exist_ok=True)
        sb.write_json(AGY_CHECK, {"key": f"{st.st_mtime_ns}:{st.st_size}", "ok": ok, "at": time.time()},
                      mode=0o600)
    except OSError:
        pass
    return ok


def portal_logged_in(key, fresh=False):
    if key == "gh":
        return gh_ok()
    if key == "t3connect":
        return t3_connect_on()
    if key == "antigravity":
        return antigravity_ok(fresh)
    for name, _, _, files, envs, _ in AGENTS:
        if name == key:
            return logged_in(files, envs)
    return False


# ---------- which account each AI login is (the Account tab's per-machine table) ----------
# The owner may sign in to different Claude / ChatGPT / Google accounts on each machine, so the page names the
# account on each one. Read from the agents' own files; never a token, only the email they record.
ACCOUNT_KEYS = ("claude", "codex", "antigravity")
EMAIL_RE = re.compile(r"[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9.-]{1,190}\.[A-Za-z]{2,24}")
# Claude's one-year token is copied between this person's machines (the newest wins). This marker keeps this
# machine's Claude account its own: federation neither copies a token here nor takes this one elsewhere.
CLAUDE_OWN = os.path.join(HOME, ".config", "treehouse", "claude-own-account")


def _jwt_claims(tok):
    import base64
    try:
        part = tok.split(".")[1]
        return json.loads(base64.urlsafe_b64decode(part + "=" * (-len(part) % 4)))
    except (IndexError, ValueError, TypeError):
        return {}


def login_account(key):
    """The email (or GitHub login) a finished login belongs to, "" when the files don't say."""
    try:
        if key == "claude":
            if not nonempty(os.path.join(HOME, ".claude", ".credentials.json")):
                return ""  # the one-year token (`claude setup-token`) doesn't carry an email
            with open(os.path.join(HOME, ".claude.json")) as f:
                v = ((json.load(f) or {}).get("oauthAccount") or {}).get("emailAddress")
        elif key == "codex":
            with open(os.path.join(HOME, ".codex", "auth.json")) as f:
                d = json.load(f) or {}
            if not (d.get("tokens") or {}).get("id_token"):
                return "an API key" if d.get("OPENAI_API_KEY") else ""
            v = _jwt_claims(d["tokens"]["id_token"]).get("email")
        elif key == "antigravity":
            with open(AGY_TOKEN) as f:
                v = (json.load(f) or {}).get("id_token_email")
        elif key == "gh":
            with open(os.path.join(HOME, ".config", "gh", "hosts.yml")) as f:
                m = re.search(r"^\s+user:\s*([A-Za-z0-9-]{1,39})\s*$", f.read(), re.M)
            return m.group(1) if m else ""
        else:
            return ""
    except (OSError, ValueError, AttributeError, TypeError):
        return ""
    return v if isinstance(v, str) and EMAIL_RE.fullmatch(v) else ""


def portal_logout(key):
    """Sign this machine out of one AI account (the per-machine table's "Sign out"), so a different account can sign
    in here. Claude: this machine also keeps its own account from now on (federation would copy the other
    machines' sign-in straight back)."""
    files = {"claude": [os.path.join(HOME, ".claude", ".credentials.json"), CLAUDE_TOKEN],
             "codex": [os.path.join(HOME, ".codex", "auth.json")], "antigravity": [AGY_TOKEN]}[key]
    for f in files:
        try:
            os.unlink(f)
        except FileNotFoundError:
            pass
    if key == "claude":
        claude_own(True)
    if key == "antigravity":
        try:
            os.unlink(AGY_CHECK)
        except FileNotFoundError:
            pass
    label = {"claude": "Claude", "codex": "ChatGPT", "antigravity": "Google (Antigravity)"}[key]
    return {"ok": True, "message": f"Signed out of {label} on {me_box()}. You can sign in again with any account."}


def claude_own(on):
    if on:
        os.makedirs(os.path.dirname(CLAUDE_OWN), mode=0o700, exist_ok=True)
        with open(CLAUDE_OWN, "w") as f:
            f.write(str(int(time.time())) + "\n")
    else:
        try:
            os.unlink(CLAUDE_OWN)
        except FileNotFoundError:
            pass


