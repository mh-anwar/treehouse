def cmd_clean(a):
    """The weekly safe cleanup (lib/sbweekly.py) for this account, on demand. Never touches ~/keep, git repos,
    ~/.claude, ~/.codex, ~/.t3, Docker volumes, tagged images or containers."""
    import sbweekly
    rep = sbweekly.run_user(sbweekly.plan_from(CFG, a.dry_run))
    if a.json:
        print(json.dumps(rep))
        return
    if a.verbose:
        for d in rep["deleted"]:
            print(f"{'would delete' if a.dry_run else 'deleted'} {sb.size_text(d['bytes']):>8}  {d['path']}  ({d['reason']})")
    else:
        for line in sbweekly.summarize(rep["deleted"], a.dry_run, sb.human):
            print(line)
    if not rep["deleted"]:
        print("Nothing to clean.")
    print(f"total: {sb.size_text(rep['freed'])}" + (" (dry run: nothing was deleted)" if a.dry_run else ""))


def cmd_weekly_clean(a):
    """The janitor's weekly pass for this account (root runs it as us; plan on stdin, report on stdout)."""
