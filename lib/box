            print(f.read())
        extra = [os.path.relpath(os.path.join(r, fn), v["path"]) for r, _, fs in os.walk(v["path"]) for fn in fs
                 if fn not in ("SKILL.md", ".sharedbox.json")]
        if extra:
            print("other files: " + ", ".join(sorted(extra)))
    elif a.action == "add":
        v = need_skill(cat, a.name)
        todo = []
        for rel in SKILL_LINK_DIRS:  # check every location before touching any, so nothing is half-installed
            p = os.path.join(HOME, rel, a.name)
            if os.path.islink(p) and os.path.realpath(p) == os.path.realpath(v["path"]):
                continue
            if os.path.lexists(p):
                sys.exit(f"~/{rel}/{a.name} already exists and isn't the shared one; "
                         "rename or remove yours first (box never overwrites your own skills)")
            todo.append(p)
        for p in todo:
            os.makedirs(os.path.dirname(p), exist_ok=True)
            os.symlink(v["path"], p)
        print(f"installed {a.name} for Claude Code, Codex and opencode (new agent sessions pick it up)")
    elif a.action == "rm":
        removed = 0
        roots = [os.path.realpath(r) for r in (sb.SKILLS_BUILTIN, sb.SKILLS_SHARED)]
        for rel in SKILL_LINK_DIRS:
            p = os.path.join(HOME, rel, a.name)
            if os.path.islink(p) and os.path.dirname(os.path.realpath(p)) in roots:
                os.unlink(p)
                removed += 1
        print(f"removed {a.name}" if removed else f"{a.name} isn't installed from the catalog (your own skills are left alone)")
    elif a.action in ("share", "unshare"):
        if ME.pw_name not in sb.admin_users(CFG):
            sys.exit("only box admins (ADMIN_USERS) can publish skills. Ask the owner, "
                     "or `box request \"share skill <name>\"`.")
        if a.action == "unshare":
            res = admin_request({"action": "unshare-skill", "name": a.name}, 30)
        else:
            res = admin_request(pack_skill(a.name), 30)
        if not res.get("ok"):
            sys.exit(res.get("error", "failed"))
        print(res.get("message", "done"))


def pack_skill(src):
    """A skill directory as a JSON request (text files only, size-capped)."""
    src = os.path.abspath(os.path.expanduser(src or ""))
    name = os.path.basename(src.rstrip("/"))
    if not re.match(sb.SKILL_NAME_RE, name):
        sys.exit(f"skill directory name {name!r} must be lowercase letters, digits and dashes")
    if not os.path.isfile(os.path.join(src, "SKILL.md")):
        sys.exit(f"{src} has no SKILL.md")
    files, total = {}, 0
    for root, dirs, fns in os.walk(src):
        dirs[:] = [d for d in dirs if not d.startswith(".")]
        for fn in fns:
            if fn.startswith("."):
                continue
            p = os.path.join(root, fn)
            rel = os.path.relpath(p, src)
            if os.path.islink(p) or not os.path.isfile(p):
                sys.exit(f"{rel}: only regular files can be shared (no symlinks)")
            try:
                with open(p, encoding="utf-8") as f:
                    text = f.read()
            except UnicodeDecodeError:
                sys.exit(f"{rel}: only text files can be shared")
            total += len(text.encode())
            files[rel] = {"text": text, "exec": bool(os.stat(p).st_mode & 0o111)}
    if len(files) > sb.SKILL_MAX_FILES or total > sb.SKILL_MAX_BYTES:
        sys.exit(f"too big to share: {len(files)} files, {total} bytes "
                 f"(limit {sb.SKILL_MAX_FILES} files, {sb.SKILL_MAX_BYTES} bytes)")
    return {"action": "share-skill", "name": name, "files": files}


def admin_request(req, wait):
    """Drop a request for root (owner-only actions without sudo) and wait for its answer."""
    rid = f"{os.getpid()}{int(time.time() * 1000)}{os.urandom(4).hex()}"
    path = os.path.join(sb.ADMIN_DROP, f"{rid}.json")
    tmp = os.path.join(sb.ADMIN_DROP, f".{rid}.tmp")
    try:
        with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as f:
            json.dump(req, f)
        os.rename(tmp, path)  # the path unit only reacts to *.json, so it never sees a half-written file
    except OSError as e:
        sys.exit(f"could not reach the box's provisioner ({e}). Is sharedbox installed and up to date?")
    reply = os.path.join(sb.ADMIN_REPLIES, f"{rid}.json")
    deadline = time.time() + wait
    while time.time() < deadline:
        try:
            with open(reply) as f:
                return json.load(f)
        except (FileNotFoundError, ValueError):
            time.sleep(0.25)
    sys.exit(f"no answer from the provisioner after {wait} s (is sharedbox-provision.path running, "
             "and is sharedbox up to date? `box skills share` needs the latest install.sh)")


# ---------- issues (agents log friction; the owner reads everyone's) ----------

ISSUES_FILE = os.path.join(HOME, sb.ISSUES_REL)
ISSUES_MAX_BYTES = 1 << 20
AUTO_STATE = os.path.join(HOME, ".sharedbox", "auto-issues.json")
AGENT_COMMS = {"claude": "claude", "codex": "codex", "gemini": "gemini", "opencode": "opencode",
               "aider": "aider", "cursor-agent": "cursor", "goose": "goose", "amp": "amp"}


def which_agent():
    """Best guess at the coding agent this runs under (env first, then the process tree)."""
    if os.environ.get("CLAUDECODE"):
        return "claude"
    if os.environ.get("AI_AGENT"):
        return os.environ["AI_AGENT"].split("_")[0][:40]
    for k, name in (("CODEX_SANDBOX", "codex"), ("CODEX_THREAD_ID", "codex"),
                    ("GEMINI_CLI", "gemini"), ("OPENCODE", "opencode")):
        if os.environ.get(k):
            return name
    pid = os.getppid()
    for _ in range(12):
        try:
            with open(f"/proc/{pid}/stat") as f:
                st = f.read()
            comm = st[st.index("(") + 1:st.rindex(")")]
            pid = int(st[st.rindex(")") + 2:].split()[1])
        except (OSError, ValueError, IndexError):
            break
        for k, name in AGENT_COMMS.items():
            if comm.startswith(k):
                return name
        if pid <= 1:
            break
    return "human" if sys.stdin.isatty() else "unknown"


def log_issue(text, kind="other", auto=False, dedupe_s=600):
    """Append one issue; skip exact repeats from the last `dedupe_s` seconds. True if written."""
    text = " ".join(text.split())[:2000]
    if not text:
        return False
    now = time.time()
    recent = [r for r in read_my_issues() if now - r.get("ts", 0) < dedupe_s]
    if any(r.get("text") == text for r in recent):
        return False
    cwd = os.getcwd() if os.path.exists(".") else ""
    rec = {"ts": round(now), "kind": kind if kind in sb.ISSUE_KINDS else "other", "text": text,
           "agent": which_agent(), "cwd": cwd, "auto": auto,
           "session": os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("CODEX_THREAD_ID")
           or os.environ.get("T3CODE_THREAD_ID") or ""}
    os.makedirs(os.path.dirname(ISSUES_FILE), mode=0o700, exist_ok=True)
    fd = os.open(ISSUES_FILE, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write(json.dumps(rec) + "\n")
        size = f.tell()
    if size > ISSUES_MAX_BYTES:  # keep the newest half
        with open(ISSUES_FILE, "rb") as f:
            f.seek(size - ISSUES_MAX_BYTES // 2)
            f.readline()
            tail = f.read()
        tmp = ISSUES_FILE + ".tmp"
        with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600), "wb") as f:
            f.write(tail)
        os.replace(tmp, ISSUES_FILE)
    return True


def read_my_issues(since=0):
    out = []
    try:
        with open(ISSUES_FILE, errors="replace") as f:
            for line in f:
                try:
                    r = json.loads(line)
                    if r.get("ts", 0) >= since:
                        out.append(r)
                except ValueError:
                    pass
    except OSError:
        pass
    return out


def auto_issues():
    """Log slowdowns the agent can't see itself: RAM soft-limit throttling, CPU throttling, OOM kills.

    Called at session start (`box status --agent`); at most one entry per signal per day.
    """
    path = sb.slice_path(ME.pw_uid)
    cur = {}
    try:
        with open(os.path.join(path, "memory.events")) as f:
            ev = dict(l.split() for l in f if l.strip())
        cur["mem_high"], cur["oom_kill"] = int(ev.get("high", 0)), int(ev.get("oom_kill", 0))
        with open(os.path.join(path, "cpu.stat")) as f:
            cs = dict(l.split() for l in f if l.strip())
        cur["throttled_usec"] = int(cs.get("throttled_usec", 0))
    except (OSError, ValueError):
        return
    st = sb.read_json(AUTO_STATE, {}) or {}
    prev, last = st.get("counters"), st.get("logged", {})
    now = time.time()
    if prev:
        cg = sb.read_cgroup(path) or {}
        d_high = cur["mem_high"] - prev.get("mem_high", 0)
        d_oom = cur["oom_kill"] - prev.get("oom_kill", 0)
        d_thr = (cur["throttled_usec"] - prev.get("throttled_usec", 0)) / 1e6
        found = []
        if d_oom > 0:
            found.append(("oom", "limit", f"{d_oom} process(es) of {ME.pw_name} were OOM-killed "
                          f"(hard RAM limit {sb.human(cg.get('mem_max')) if cg.get('mem_max') else 'max'})"))
        if d_high > 100:
            found.append(("mem_high", "slow", f"RAM soft limit hit {d_high} times since last session "
                          f"(memory.high {sb.human(cg.get('mem_high')) if cg.get('mem_high') else 'max'}, "
                          f"now using {sb.human(cg.get('mem', 0))}); processes were throttled"))
        if d_thr > 60:
            found.append(("cpu", "slow", f"CPU quota throttled processes for {d_thr / 60:.0f} min since "
                          "last session"))
        for key, kind, text in found:
            if now - last.get(key, 0) > 86400:
                if log_issue(text, kind, auto=True):
                    last[key] = now
    os.makedirs(os.path.dirname(AUTO_STATE), mode=0o700, exist_ok=True)
    sb.write_json(AUTO_STATE, {"counters": cur, "logged": last}, mode=0o600)


def cmd_issue(a):
    text = " ".join(a.text).strip()
    if not text:
        sys.exit('usage: box issue [--kind slow|broken|missing|limit|confusing|other] "what happened, '
                 'what you tried, what it cost"')
    if log_issue(text, a.kind, dedupe_s=600):
        print(f"logged to {ISSUES_FILE}. The box owner reviews these. Keep working around it.")
    else:
        print("already logged in the last 10 minutes; not repeated.")


def cmd_issues(a):
    rows = read_my_issues(time.time() - a.days * 86400)
    if a.json:
        print(json.dumps(rows, indent=2))
        return
    if not rows:
        print(f"no issues logged in the last {a.days} days ({ISSUES_FILE})")
    for r in rows:
        print(f"{fmt_ts(r.get('ts', 0))}  [{r.get('kind', '?')}]{' (auto)' if r.get('auto') else ''} "
              f"{r.get('agent', '?')}: {sb.printable(r.get('text', ''))}")


# ---------- internal (called by root tools via setpriv, as this user) ----------

# ---------- web portal helpers (box _portal; called as the user by sharedbox-admin) ----------
# Lets someone with only a browser start T3 and log in to their agents/GitHub from the join page.
# Every action prints exactly one JSON line on stdout.

PORTAL_LOGINS = {
    # key: (label, command, the user pastes a code back?)
    "claude": ("Claude", ["claude", "auth", "login"], True),
    "codex": ("Codex (ChatGPT)", ["codex", "login", "--device-auth"], False),
    "gh": ("GitHub", ["gh", "auth", "login", "--hostname", "github.com", "--git-protocol", "https", "--web"],
           False),
}
LOGIN_SOCK = "sblogin"
URL_RE = re.compile(r"https://[^\s\"'<>]+")
DEVICE_CODE_RE = re.compile(r"(?:code:?\s*|^\s*)([A-Z0-9]{4}-[A-Z0-9]{4,6})\s*$", re.M)  # alone or after "code:"
PASTE_RE = re.compile(r"[A-Za-z0-9#_.~+/=-]{4,600}")


def portal_logged_in(key):
    if key == "gh":
        return gh_ok()
    for name, _, _, files, envs, _ in AGENTS:
        if name == key:
            return logged_in(files, envs)
    return False


def user_env():
    return dict(os.environ, PATH=f"{HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin",
                XDG_RUNTIME_DIR=f"/run/user/{ME.pw_uid}")


def tmux(*args):
    return subprocess.run(["tmux", "-L", LOGIN_SOCK, *args], env=user_env(),
                          capture_output=True, text=True, timeout=20)


def login_screen(key):
    return tmux("capture-pane", "-p", "-J", "-S", "-300", "-t", key).stdout


def gh_finish():
    """After a GitHub login: git credential helper + a git identity if none is set."""
    env = user_env()
    subprocess.run(["gh", "auth", "setup-git"], env=env, capture_output=True, timeout=30)
    name, email = git_ident()
    if name and email:
        return
    r = subprocess.run(["gh", "api", "user", "--jq", '[.id, .login, .name // ""] | @tsv'],
                       env=env, capture_output=True, text=True, timeout=30)
    try:
        uid, login, full = r.stdout.rstrip("\n").split("\t")
    except ValueError:
        return
    if not name:
        subprocess.run(["git", "config", "--global", "user.name", full or login])
    if not email:
        subprocess.run(["git", "config", "--global", "user.email", f"{uid}+{login}@users.noreply.github.com"])


def portal_status():
    out = {"logins": {}, "t3": None}
    for key, (label, cmd, _) in PORTAL_LOGINS.items():
        if shutil.which(cmd[0]):
            out["logins"][key] = {"label": label, "ok": portal_logged_in(key)}
    if out["logins"].get("gh", {}).get("ok") and not all(git_ident()):
        gh_finish()
    r, host = ports(), sb.tailscale_ip4()
    if r and host and shutil.which("t3"):
        out["t3"] = {"url": f"http://{host}:{r[0]}/", "running": listening(host, r[0])}
    name, email = git_ident()
    out["git"] = {"name": name, "email": email}
    out["ssh"] = bool(ssh_keys())
    out["updates"] = sb.agent_pref(CFG, HOME)[0]
    return out


def portal_t3(pair):
    if not shutil.which("t3"):
        return {"ok": False, "error": "T3 Code isn't installed on this box yet. Ask the owner."}
    r, host = ports(), sb.tailscale_ip4()
    if not r or not host:
        return {"ok": False, "error": "Tailscale isn't running on the box. Ask the owner."}
    host, port, env = t3_env()
    t3_ensure(host, port, env, quiet=True)
    if not pair:
        return {"ok": True}
    deadline = time.time() + 150  # the very first start downloads T3
    while not listening(host, port):
        if time.time() > deadline:
            return {"ok": False, "starting": True,
                    "error": "T3 Code is still starting (the first start downloads it). Try again in a minute."}
        time.sleep(2)
    time.sleep(2)
    t3_starter(env)
    r = subprocess.run(["t3", "pair", "--ttl", "30m", "--label", f"{ME.pw_name} (join page)"],
                       env=dict(user_env(), **env), capture_output=True, text=True, timeout=60)
    url = next((l.split(":", 1)[1].strip() for l in r.stdout.splitlines() if l.startswith("Pairing URL:")), None)
    if not url:
        return {"ok": False, "error": "pairing failed; try again, or ask the owner to check `box t3 logs`"}
    return {"ok": True, "pair_url": url, "url": f"http://{host}:{port}/"}


def t3_starter(env):
    """First time only: a ready-made project, so T3 opens straight into something to chat in."""
    marker = os.path.join(HOME, ".sharedbox", "t3-starter")
    if os.path.exists(marker):
        return
    d = os.path.join(HOME, "projects", "my-first-app")
    os.makedirs(d, exist_ok=True)
    if not os.path.exists(os.path.join(d, ".git")):
        subprocess.run(["git", "init", "-q", "-b", "main", d], capture_output=True)
        with open(os.path.join(d, "README.md"), "w") as f:
            f.write("# My first app\n\nAsk your agent to build something here, e.g. "
                    "\"make me a simple website about my favourite movies and give me the link\".\n")
    r = subprocess.run(["t3", "project", "add", d, "--title", "My first app"],
                       env=dict(user_env(), **env), capture_output=True, text=True, timeout=60)
    if r.returncode == 0:
        os.makedirs(os.path.dirname(marker), exist_ok=True)
        open(marker, "w").close()


def ssh_keys():
    try:
        with open(os.path.join(HOME, ".ssh", "authorized_keys")) as f:
            return [l.strip() for l in f if l.strip() and not l.startswith("#")]
    except OSError:
        return []


def portal_add_key(key):
    key, err = sb.validate_pubkey(key)
    if err:
        return {"ok": False, "error": err}
    keys = ssh_keys()
    if key.split()[:2] not in [k.split()[:2] for k in keys]:
        os.makedirs(os.path.join(HOME, ".ssh"), mode=0o700, exist_ok=True)
        path = os.path.join(HOME, ".ssh", "authorized_keys")
        with open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600), "w") as f:
            f.write(key + "\n")
    return {"ok": True, "key_added": True}


def portal_login_start(key, console=False):
    label, cmd, paste = PORTAL_LOGINS[key]
    if not shutil.which(cmd[0]):
        return {"ok": False, "error": f"{label} isn't installed on this box. Ask the owner."}
    if portal_logged_in(key):
        if key == "gh":
            gh_finish()
        return {"ok": True, "done": True}
    if key == "claude" and console:
        cmd = cmd + ["--console"]
    tmux("kill-session", "-t", key)
    # keep the pane around after the login exits so its last words can be read
    # gh asks extra y/n questions when it has a terminal; with no terminal it just prints the code
    run = '"$@" </dev/null 2>&1 | cat' if key == "gh" else '"$@"'
    wrapped = ["sh", "-c", run + '; echo "[login exited $?]"; sleep 1200', "sh", *cmd]
    tm = ["tmux", "-L", LOGIN_SOCK, "new-session", "-d", "-s", key, "-x", "250", "-y", "60", "--", *wrapped]
    # a scope under the user's own systemd keeps it alive after the (root-run) caller exits
    r = subprocess.run(["systemd-run", "--user", "--scope", "--quiet", "--collect", "--", *tm],
                       env=user_env(), capture_output=True, text=True, timeout=30)
    if r.returncode != 0:
        subprocess.run(tm, env=user_env(), capture_output=True, timeout=30)
    deadline = time.time() + 25
    while time.time() < deadline:
        time.sleep(1)
        screen = login_screen(key)
        urls = URL_RE.findall(screen)
        codes = [] if paste else DEVICE_CODE_RE.findall(screen)
        if urls and (paste or codes):
            return {"ok": True, "url": urls[0], "code": codes[0] if codes else None, "paste": paste}
        if "[login exited" in screen:
            if portal_logged_in(key):
                return {"ok": True, "done": True}
            break
    return {"ok": False, "error": f"{label} login didn't start: " + tail(login_screen(key))}


def portal_login_code(key, code):
    code = (code or "").strip()
    if not PASTE_RE.fullmatch(code):
        return {"ok": False, "error": "that code doesn't look right; copy it again from the browser"}
    if tmux("has-session", "-t", key).returncode != 0:
        return {"ok": False, "error": "that login expired; start it again"}
    tmux("send-keys", "-t", key, "-l", "--", code)
    tmux("send-keys", "-t", key, "Enter")
    return portal_login_wait(key, 30)


def portal_login_wait(key, seconds):
    label = PORTAL_LOGINS[key][0]
    deadline = time.time() + seconds
    while time.time() < deadline:
        if portal_logged_in(key):
            if key == "gh":
                gh_finish()
            tmux("kill-session", "-t", key)
            return {"ok": True, "done": True}
        if "[login exited" in login_screen(key):
            break
        time.sleep(1)
    if portal_logged_in(key):
        return {"ok": True, "done": True}
    return {"ok": False, "error": f"{label} login hasn't finished: " + tail(login_screen(key))}


def tail(screen, n=4):
    lines = [l.strip() for l in screen.splitlines()
             if l.strip() and "[login exited" not in l and "https://" not in l]
    return " / ".join(lines[-n:])[-400:] or "no output"


def portal_url():
    return f"http://{socket.gethostname()}:{CFG['WEB_PORT']}/me"


# servers from the web page: the friend's own `box serve` units, and the group's `box shared` ones
PORTAL_SERVER_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]{0,39}")  # never starts with "-": no option injection
PORTAL_SERVER_OPS = ("start", "stop", "restart")
PORTAL_LOG_LINES = 100
PORTAL_LOG_BYTES = 48 * 1024


def portal_server_name(name):
    """A NAME the web page may act on, or None. Same rules as unit(), minus non-ASCII and leading -/_."""
    name = name or ""
    return name if PORTAL_SERVER_RE.fullmatch(name) and name.isascii() else None


def portal_unit_port(name):
    try:
        with open(os.path.join(UNIT_DIR, f"sb-{name}.service")) as f:
            for l in f:
                if l.startswith("Environment=PORT="):
                    return l.strip().split("=", 2)[2]
    except OSError:
        pass
    return ""


def portal_own_server(name):
    """NAME if it's one of this user's own `box serve` units (a unit file we wrote), else None. Never sb-t3."""
    name = portal_server_name(name)
    if not name or name == "t3" or not os.path.isfile(os.path.join(UNIT_DIR, f"sb-{name}.service")):
        return None
    return name


def portal_cap_lines(lines):
    """The last PORTAL_LOG_LINES lines, at most PORTAL_LOG_BYTES in total, as printable text."""
    out, size = [], 0
    for l in reversed([str(x) for x in lines][-PORTAL_LOG_LINES:]):
        l = l[:2000]
        size += len(l) + 1
        if size > PORTAL_LOG_BYTES:
            break
        out.append(l)
    return out[::-1]


def portal_serve_ls():
    seen, servers = set(), []
    for s in list_services():
        if s["name"] != "t3" and portal_server_name(s["name"]):
            seen.add(s["name"])
            servers.append({"name": s["name"], "state": s["state"], "port": portal_unit_port(s["name"])})
    try:  # a stopped, unloaded unit still has its file
        files = sorted(os.listdir(UNIT_DIR))
    except OSError:
        files = []
    for fn in files:
        n = fn[3:-8] if fn.startswith("sb-") and fn.endswith(".service") else ""
        if n and n != "t3" and n not in seen and portal_server_name(n):
            servers.append({"name": n, "state": "stopped", "port": portal_unit_port(n)})
    return {"ok": True, "servers": sorted(servers, key=lambda s: s["name"])}


def portal_serve_ctl(name, op):
    name = portal_own_server(name)
    if not name or op not in PORTAL_SERVER_OPS:
        return {"ok": False, "error": "no such server"}
    r = sctl(op, f"sb-{name}.service", capture=True)
    if r.returncode != 0:
        return {"ok": False, "error": f"{op} {name} failed: " + (r.stderr or r.stdout or "").strip()[-300:]}
    state = next((s["state"] for s in list_services() if s["name"] == name), "stopped")
    return {"ok": True, "name": name, "op": op, "state": state,
            "message": f"{name}: {'stopped' if op == 'stop' else op + 'ed'}"}


def portal_serve_logs(name):
    name = portal_own_server(name)
    if not name:
        return {"ok": False, "error": "no such server"}
    r = subprocess.run(["journalctl", "--user", "-u", f"sb-{name}.service", "-n", str(PORTAL_LOG_LINES),
                        "--no-pager", "-o", "short-iso"], env=user_env(), capture_output=True,
                       text=True, errors="replace", timeout=30)
    return {"ok": True, "name": name, "lines": portal_cap_lines(r.stdout.splitlines())}


def portal_shared(args, missing):
    """Run `box shared ARGS --json` (a fresh process, as this user) and pass its JSON answer through.
    `missing` is the answer when this box's `box` has no `shared` command yet."""
    r = subprocess.run([sys.executable, "-I", os.path.abspath(__file__), "shared", *args, "--json"],
                       capture_output=True, text=True, errors="replace", timeout=240)
    for line in reversed(r.stdout.splitlines()):
        try:
            out = json.loads(line)
        except ValueError:
            continue
        if isinstance(out, dict):
            if isinstance(out.get("lines"), list):
                out["lines"] = portal_cap_lines(out["lines"])
            return out
    if r.returncode == 2 and "invalid choice" in r.stderr:
        return missing
    return {"ok": False, "error": "group servers: " + ((r.stderr or "").strip()[-300:] or "no answer")}


def portal_shared_ls():
    out = portal_shared(["ls"], {"ok": True, "servers": [], "unavailable": True})
    if out.get("ok") and not isinstance(out.get("servers"), list):
        out["servers"] = []
    return out


def portal_shared_ctl(name, op):
    name = portal_server_name(name)
    if not name or op not in PORTAL_SERVER_OPS:
        return {"ok": False, "error": "no such server"}
    return dict(portal_shared([op, name], {"ok": False, "unavailable": True,
                                           "error": "group servers aren't set up on this box yet"}),
                name=name, op=op)


def portal_shared_logs(name):
    name = portal_server_name(name)
    if not name:
        return {"ok": False, "error": "no such server"}
    return dict(portal_shared(["logs", name, "-n", str(PORTAL_LOG_LINES)],
                              {"ok": False, "unavailable": True,
                               "error": "group servers aren't set up on this box yet"}), name=name)


def cmd_portal(a):
    try:
        if a.action == "status":
            out = portal_status()
            try:  # the page shows them, so save it a round trip
                out["servers"] = portal_serve_ls()["servers"]
            except (OSError, subprocess.SubprocessError):
                out["servers"] = None
        elif a.action == "serve-ls":
            out = portal_serve_ls()
        elif a.action == "serve-ctl" and a.arg in PORTAL_SERVER_OPS:
            out = portal_serve_ctl(a.key, a.arg)
        elif a.action == "serve-logs":
            out = portal_serve_logs(a.key)
        elif a.action == "shared-ls":
            out = portal_shared_ls()
        elif a.action == "shared-ctl" and a.arg in PORTAL_SERVER_OPS:
            out = portal_shared_ctl(a.key, a.arg)
        elif a.action == "shared-logs":
            out = portal_shared_logs(a.key)
        elif a.action in ("t3-start", "t3-pair"):
            out = portal_t3(a.action == "t3-pair")
        elif a.action == "login-start" and a.key in PORTAL_LOGINS:
            out = portal_login_start(a.key, console=a.arg == "console")
        elif a.action == "login-code" and a.key in PORTAL_LOGINS:
            out = portal_login_code(a.key, sys.stdin.read(4096))
        elif a.action == "add-key":
            out = portal_add_key(sys.stdin.read(8192))
        elif a.action == "login-check" and a.key in PORTAL_LOGINS:
            out = portal_login_wait(a.key, 5)
        elif a.action == "updates-set" and a.key in ("auto", "manual"):
            set_agent_pref(a.key)
            out = {"ok": True, "updates": a.key}
        else:
            out = {"ok": False, "error": "unknown action"}
    except (OSError, subprocess.SubprocessError) as e:
        out = {"ok": False, "error": f"{type(e).__name__}: {e}"[:300]}
    print(json.dumps(out))


def cmd_init_home(a):
    key = sys.stdin.read().strip()
    os.umask(0o077)
    for d in ("projects", "services", "keep", ".sharedbox", ".ssh"):
        os.makedirs(os.path.join(HOME, d), exist_ok=True)
    with open(os.path.join(HOME, ".ssh", "authorized_keys"), "w") as f:
        f.write(key + "\n")
    os.chmod(os.path.join(HOME, ".ssh"), 0o700)
    os.chmod(os.path.join(HOME, ".ssh", "authorized_keys"), 0o600)
    skel = os.path.join(sb.SHARE_DIR, "skel")
    jobs = CFG["BUILD_JOBS"]
    for root, _, files in os.walk(skel):
        for fn in files:
            src = os.path.join(root, fn)
            dst = os.path.join(HOME, os.path.relpath(src, skel))
            if os.path.exists(dst):
                continue
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            with open(src) as f:
                txt = f.read().replace("@BUILD_JOBS@", jobs)
            with open(dst, "w") as f:
                f.write(txt)
    sync_agent_files()


NOTICE_KEYS = ("SECURITY", "DELETED", "OVER", "REBOOT")


def rule_notices(box=None, janitor=None):
    """Notices worth baking into agent rule files (the long-lived ones)."""
    if janitor is None:
        janitor = sb.read_json(STATUS_FILE, {}) or {}
    return [n for n in advice({"box": box or sb.box_load(), "live": {}, "janitor": janitor})
            if any(k in n for k in NOTICE_KEYS)]


def cmd_sync_rules(a):
    sync_agent_files(rule_notices())


def cmd_pass(a):
    import sbclean
    plan = json.load(sys.stdin)
    rep = sbclean.run_pass(plan)
    rep["services"] = list_services()
    status = {"measured": int(time.time()), "disk": plan.get("usage"),
              "budget": plan.get("budget"), "over_budget": plan.get("over"),
              "over_budget_deadline": plan.get("over_deadline"),
              "projects": rep["projects"], "services": rep["services"],
              "last_deleted": rep["deleted"][-20:]}
    if not plan.get("dry_run"):
        os.makedirs(os.path.dirname(STATUS_FILE), exist_ok=True)
        sb.write_json(STATUS_FILE, status, mode=0o600)
        sync_agent_files(rule_notices(plan.get("box"), status))
    json.dump(rep, sys.stdout)


def main():
    p = argparse.ArgumentParser(prog="box", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    s = p.add_subparsers(dest="cmd")
    x = s.add_parser("status"); x.add_argument("--agent", action="store_true")
    x.add_argument("--json", action="store_true"); x.set_defaults(fn=cmd_status)
    s.add_parser("ports").set_defaults(fn=cmd_ports)
    x = s.add_parser("heavy"); x.add_argument("cmd", nargs=argparse.REMAINDER)
    x.set_defaults(fn=cmd_heavy)
    x = s.add_parser("serve")
    x.add_argument("action", choices=["add", "ls", "logs", "restart", "stop", "start", "rm"])
    x.add_argument("name", nargs="?"); x.add_argument("--port", type=int)
    x.add_argument("-f", "--follow", action="store_true")
    x.add_argument("cmd", nargs=argparse.REMAINDER); x.set_defaults(fn=cmd_serve)
    x = s.add_parser("clean"); x.add_argument("--dry-run", action="store_true")
    x.set_defaults(fn=cmd_clean)
    s.add_parser("rules").set_defaults(fn=cmd_rules)
    x = s.add_parser("setup"); x.add_argument("--check", action="store_true")
    x.set_defaults(fn=cmd_setup)
    s.add_parser("agents").set_defaults(fn=cmd_agents)
    x = s.add_parser("updates"); x.add_argument("action", nargs="?", choices=["status", "auto", "manual", "now"])
    x.set_defaults(fn=cmd_updates)
    x = s.add_parser("t3"); x.add_argument("action", nargs="?", default="start",
                                           choices=["start", "pair", "status", "stop", "logs"])
    x.set_defaults(fn=cmd_t3)
    s.add_parser("welcome").set_defaults(fn=cmd_welcome)
    x = s.add_parser("request"); x.add_argument("text", nargs="+"); x.set_defaults(fn=cmd_request)
    x = s.add_parser("issue"); x.add_argument("--kind", "-k", default="other", choices=sb.ISSUE_KINDS)
    x.add_argument("text", nargs="+"); x.set_defaults(fn=cmd_issue)
    x = s.add_parser("issues"); x.add_argument("--days", type=int, default=14)
    x.add_argument("--json", action="store_true"); x.set_defaults(fn=cmd_issues)
    s.add_parser("_init-home").set_defaults(fn=cmd_init_home)
    x = s.add_parser("_portal"); x.add_argument("action"); x.add_argument("key", nargs="?")
    x.add_argument("arg", nargs="?"); x.set_defaults(fn=cmd_portal)
    x = s.add_parser("invite", help="(owner) create a friend's account and a message to send them, no sudo")
    x.add_argument("--note", help="who it's for, e.g. 'Sam from work'"); x.add_argument("--days", type=int)
    x.add_argument("--tailscale", action="store_true"); x.add_argument("--json", action="store_true")
    x.add_argument("--email", help="the friend's email (required when the box uses Cloudflare Access)")
    x.add_argument("--username", help="the new account's name (default: picked for you)")
    x.add_argument("--no-create", action="store_true",
                   help="old style: an invite link and the friend picks a username on a signup form")
    x.set_defaults(fn=cmd_invite)
    x = s.add_parser("skills", help="shared skill catalog: ls, show NAME, add NAME, rm NAME, share DIR (admins)")
    x.add_argument("action", nargs="?", default="ls", choices=["ls", "show", "add", "rm", "share", "unshare"])
    x.add_argument("name", nargs="?"); x.add_argument("--json", action="store_true")
    x.set_defaults(fn=lambda a: (a.action != "ls" and not a.name and sys.exit(f"box skills {a.action}: which skill?"))
                   or cmd_skills(a))
    s.add_parser("_pass").set_defaults(fn=cmd_pass)
    s.add_parser("_sync-rules").set_defaults(fn=cmd_sync_rules)
    s.add_parser("_auto-issues").set_defaults(fn=lambda a: auto_issues())  # silent; for agent hooks
    a = p.parse_args()
    if not a.cmd:
        a = p.parse_args(["status"])
    a.fn(a)


if __name__ == "__main__":
    main()
