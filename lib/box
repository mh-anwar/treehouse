            sys.exit(f"box shared {a.action}: {res.get('error', 'failed')}")
        if "lines" in res:
            print("\n".join(res["lines"]) or "(no log lines yet)")
        elif "servers" not in res:
            print(res.get("message", "done"))
        sys.exit(0)

    import sbshared
    err = sbshared.parse_tail(a)
    if err:
        done({"ok": False, "error": err})
    if a.action == "ls":
        servers = sbshared.list_servers(CFG)
        if not a.json:
            if not servers:
                print("no shared servers yet. make one: box shared create NAME")
            for x in servers:
                print(f"{x['name']:<20} {x['state']:<10} port {x['port'] or '-':<6} "
                      f"{sb.printable(' '.join(x['cmd'])) or '(nothing set to run)'}\n"
                      f"{'':<20} {x['dir']}  by {x['created_by']}, last change {x['updated_by']} "
                      f"{fmt_ts(x['updated']) if x.get('updated') else ''}")
        done({"ok": True, "servers": servers})
    if ME.pw_name not in sb.admin_users(CFG) and not is_friend():
        done({"ok": False, "error": "only friends and the box owner's accounts can manage shared servers"})
    if not a.name:
        done({"ok": False, "error": f"usage: box shared {a.action} NAME"})
    if not sbshared.NAME_RE.match(a.name):
        done({"ok": False, "error": "name: 2-31 lowercase letters, digits or -, starting with a letter"})
    req = {"action": a.action, "name": a.name}
    if a.action == "set":
