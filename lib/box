            pass
    g = gather()
    if a.json:
        g["advice"] = advice(g)
        print(json.dumps(g, indent=2))
        return
    b, live, lim, j = g["box"], g["live"] or {}, g["limits"], g["janitor"]
    lines = []
    if a.agent:
        lines.append(f"## Shared box status for {g['user']} ({time.strftime('%H:%M')})")
    lines.append(f"Box: {b['level']} | load {b['loadavg'][0]:.1f}/{b['ncpu']} cpus | "
                 f"RAM avail {sb.human(b['mem_avail'])}/{sb.human(b['mem_total'])} | "
                 f"disk free {sb.human(b['disk_free'])}/{sb.human(b['disk_total'])}")
    if lim:
        lines.append(f"You: CPU {live.get('cpu_pct', 0)}% (cap {burst_now(lim, 'CPU_QUOTA')}) | "
                     f"RAM {sb.human(live.get('mem', 0))} (soft {burst_now(lim, 'MEMORY_HIGH')}, hard {lim['MEMORY_MAX']}) | "
                     f"procs {live.get('pids', 0)}/{lim['TASKS_MAX']} | "
                     f"disk {sb.human(j.get('disk')) if j.get('disk') else '?'} / {lim['DISK_BUDGET_GB']}G"
                     + (f" (measured {fmt_ts(j['measured'])})" if j.get('measured') else ""))
        lines.append(f"Ports: {g['ports'][0]}-{g['ports'][1]}  |  servers: "
                     + (", ".join(f"{s['name']}({s['state']})" for s in j.get("services", [])) or "none"))
    for ad in advice(g):
        lines.append(("- " if a.agent else "! ") + ad)
    if a.agent and lim:
        lines.append("Rules: use ~/projects (auto-deleted when idle), ~/services, ~/keep; prefix heavy "
                     "jobs with `box heavy --`; servers via `box serve`; log anything about this machine that "
                     "slows you down or fails with `box issue \"...\"`. Full rules: `box rules`.")
    print("\n".join(lines))


# ---------- ports ----------

def port_in_use(p):
    for fam, addr in ((socket.AF_INET, "0.0.0.0"), (socket.AF_INET6, "::")):
        s = socket.socket(fam, socket.SOCK_STREAM)
        try:
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.bind((addr, p))
        except OSError:
            return True
        finally:
            s.close()
    return False


def cmd_ports(a):
    r = ports()
    if not r:
        sys.exit("you are not a sharedbox friend account; any free port is fine")
    used = [p for p in range(r[0], r[1] + 1) if port_in_use(p)]
    print(f"your ports: {r[0]}-{r[1]}  ({r[0]} is reserved for your T3 Code server)")
    print("in use: " + (", ".join(map(str, used)) or "none"))


# ---------- heavy ----------

def cmd_heavy(a):
    cmd = a.cmd[1:] if a.cmd and a.cmd[0] == "--" else a.cmd
    if not cmd:
        sys.exit("usage: box heavy -- COMMAND...")
    n = sb.cfg_int(CFG, "HEAVY_SLOTS")
    deadline = time.time() + sb.cfg_int(CFG, "HEAVY_WAIT_MAX_MIN") * 60
    fd, announced, last = None, False, 0
    while fd is None and os.environ.get("SHAREDBOX_HEAVY") != "1":  # nested: parent holds a slot
        opened = 0
        for i in range(n):
            try:
                f = os.open(os.path.join(sb.SLOTS, f"slot-{i}"), os.O_RDONLY)
            except OSError:
                continue
            opened += 1
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                fd = f
                break
            except BlockingIOError:
                os.close(f)
        if fd is not None or opened == 0:  # no queue installed: just run
            break
        if time.time() > deadline:
            print("box heavy: waited too long for a slot, running anyway at lowest priority",
                  file=sys.stderr)
            break
        if not announced or time.time() - last > 60:
            print(f"box heavy: {n} heavy job(s) already running on the box; waiting for a slot…",
                  file=sys.stderr)
            announced, last = True, time.time()
        time.sleep(5)
    waited = time.time() - (deadline - sb.cfg_int(CFG, "HEAVY_WAIT_MAX_MIN") * 60)
    if announced and waited > 300:
        try:
            log_issue(f"`box heavy` waited {waited / 60:.0f} min for a slot ({n} slot(s)) before "
                      f"running: {shlex.join(cmd)[:200]}", "slow", auto=True, dedupe_s=3600)
        except OSError:
            pass
    if fd is not None:
        os.set_inheritable(fd, True)  # lock is held until the command exits
    jobs = CFG["BUILD_JOBS"]
    env = dict(os.environ, MAKEFLAGS=f"-j{jobs}", CMAKE_BUILD_PARALLEL_LEVEL=jobs,
               CARGO_BUILD_JOBS=jobs, SHAREDBOX_HEAVY="1")
    prefix = ["nice", "-n", "10"] + (["ionice", "-c", "2", "-n", "7"] if shutil.which("ionice") else [])
    try:
        os.execvpe(prefix[0], prefix + cmd, env)
    except FileNotFoundError:
        sys.exit(f"box heavy: command not found: {cmd[0]}")


# ---------- serve ----------

UNIT_DIR = os.path.join(HOME, ".config", "systemd", "user")


def sctl(*args, capture=False):
    env = dict(os.environ, XDG_RUNTIME_DIR=f"/run/user/{ME.pw_uid}")
    return subprocess.run(["systemctl", "--user", *args], env=env, text=True,
                          capture_output=capture)


def unit(name):
    if not name.replace("-", "").replace("_", "").isalnum() or len(name) > 40:
        sys.exit("service name: letters, digits, - and _ only")
    return f"sb-{name}.service"


def sd_escape(s):
    return s.replace("%", "%%").replace("$", "$$")


def list_services():
    r = sctl("list-units", "--all", "--plain", "--no-legend", "--type=service", "sb-*", capture=True)
    out = []
    for line in r.stdout.splitlines():
        parts = line.split(None, 4)
        if len(parts) >= 4 and parts[0].startswith("sb-"):
            out.append({"name": parts[0][3:-8], "state": parts[3] if parts[2] == "active" else parts[2]})
    return out


def cmd_serve(a):
    act = a.action
    if act == "ls":
        svcs = list_services()
        if not svcs:
            print("no services. create one with: box serve add NAME --port P -- COMMAND...")
        for s in svcs:
            port = ""
            try:
                with open(os.path.join(UNIT_DIR, f"sb-{s['name']}.service")) as f:
                    for l in f:
                        if l.startswith("Environment=PORT="):
                            port = l.strip().split("=", 2)[2]
            except OSError:
                pass
            print(f"{s['name']:<20} {s['state']:<10} port {port}")
        return
    if not a.name:
        sys.exit(f"usage: box serve {act} NAME")
    u = unit(a.name)
    if act == "add":
        cmd = a.cmd[1:] if a.cmd and a.cmd[0] == "--" else a.cmd
        if not cmd:
            sys.exit("usage: box serve add NAME [--port P] -- COMMAND...")
        exe = shutil.which(cmd[0])
        if not exe:
            sys.exit(f"command not found: {cmd[0]}")
        cmd[0] = exe
        r = ports()
        port = a.port
        if r and port is None:
            port = next((p for p in range(r[0] + 1, r[1] + 1) if not port_in_use(p)), None)
        if r and port is not None and not (r[0] <= port <= r[1]):
            print(f"warning: port {port} is outside your range {r[0]}-{r[1]}", file=sys.stderr)
        wd = os.getcwd()
        if wd.startswith(os.path.join(HOME, "projects") + "/"):
            print("note: this runs from ~/projects. The project won't be auto-deleted while this "
                  f"service exists (even if stopped). `box serve rm {a.name}` releases it.", file=sys.stderr)
        os.makedirs(UNIT_DIR, exist_ok=True)
        body = [
            "[Unit]", f"Description=box serve {a.name}",
            "StartLimitIntervalSec=600", "StartLimitBurst=10", "",
            "[Service]", f"WorkingDirectory={sd_escape(wd)}",
            f"Environment=PATH={sd_escape(os.environ.get('PATH', '/usr/bin:/bin'))}",
        ]
        if port is not None:
            body.append(f"Environment=PORT={port}")
        body += [f"ExecStart={sd_escape(shlex.join(cmd))}", "Restart=on-failure", "RestartSec=5",
                 "", "[Install]", "WantedBy=default.target", ""]
        with open(os.path.join(UNIT_DIR, u), "w") as f:
            f.write("\n".join(body))
        sctl("daemon-reload")
        r2 = sctl("enable", "--now", u)
        if r2.returncode == 0:
            print(f"started {a.name}" + (f" on port {port} (also in $PORT)" if port else "")
                  + f". logs: box serve logs {a.name}")
        sys.exit(r2.returncode)
    if act == "logs":
        os.execvp("journalctl", ["journalctl", "--user", "-u", u, "-n", "200", "--no-pager"]
                  + (["-f"] if a.follow else []))
    if act == "rm":
        sctl("disable", "--now", u)
        try:
            os.unlink(os.path.join(UNIT_DIR, u))
        except FileNotFoundError:
            pass
        sctl("daemon-reload")
        print(f"removed {a.name}")
        return
    sys.exit(sctl(act, u).returncode)


