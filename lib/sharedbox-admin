SYSTEMD_DIR = "/etc/systemd/system"
MANAGED_PROPS = {
    "CPU_QUOTA": "CPUQuota",
    "CPU_WEIGHT": "CPUWeight",
    "IO_WEIGHT": "IOWeight",
    "MEMORY_HIGH": "MemoryHigh",
    "MEMORY_MAX": "MemoryMax",
    "MEMORY_SWAP_MAX": "MemorySwapMax",
    "TASKS_MAX": "TasksMax",
}


def die(msg, code=1):
    print(f"sharedbox-admin: {msg}", file=sys.stderr)
    sys.exit(code)


def run(cmd, check=True, **kw):
    return subprocess.run(cmd, check=check, **kw)


def as_user(pw, cmd, input_text=None, timeout=None):
    """Run cmd as the friend (never write into a friend's home as root)."""
    env = {"HOME": pw.pw_dir, "USER": pw.pw_name, "LOGNAME": pw.pw_name,
           "PATH": "/usr/local/bin:/usr/bin:/bin",
           "XDG_RUNTIME_DIR": f"/run/user/{pw.pw_uid}",
           "SHAREDBOX_LIB": sb.LIB_DIR, "SHAREDBOX_SHARE": sb.SHARE_DIR,
           "SHAREDBOX_CONF": sb.CONF_PATH, "SHAREDBOX_STATE": sb.STATE_DIR}
    return subprocess.run(
        ["setpriv", f"--reuid={pw.pw_uid}", f"--regid={pw.pw_gid}", "--init-groups",
         "--reset-env", "--"] + cmd,
        input=input_text, text=True, capture_output=True, env=env, cwd=pw.pw_dir, timeout=timeout)


def daemon_reload():
    run(["systemctl", "daemon-reload"])


# ---------- limits ----------

def write_dropins(cfg, name, rec, uid):
    lim = sb.user_limits(cfg, rec)
    lines = ["# managed by sharedbox — edit with: sharedbox-admin limits " + name,
             "# CPUQuota/MemoryHigh are the burst values; sharedbox-janitor guard lowers them at runtime",
             "# to CPU_QUOTA/MEMORY_HIGH while the box is busy", "[Slice]"]
    for key, prop in MANAGED_PROPS.items():
        val = lim.get("BURST_" + key) or lim.get(key)
        if val:
            lines.append(f"{prop}={val}")
    d = os.path.join(SYSTEMD_DIR, f"user-{uid}.slice.d")
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, "60-sharedbox.conf"), "w") as f:
        f.write("\n".join(lines) + "\n")
    # user manager (and so the friend's long-running services) is first in line for the OOM killer
    d = os.path.join(SYSTEMD_DIR, f"user@{uid}.service.d")
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, "60-sharedbox.conf"), "w") as f:
        f.write("# managed by sharedbox\n[Service]\n"
                f"OOMScoreAdjust={cfg['OOM_SCORE_ADJ']}\n")


def remove_dropins(uid):
    for d in (f"user-{uid}.slice.d", f"user@{uid}.service.d"):
        p = os.path.join(SYSTEMD_DIR, d, "60-sharedbox.conf")
        if os.path.exists(p):
            os.unlink(p)
        try:
            os.rmdir(os.path.join(SYSTEMD_DIR, d))
        except OSError:
            pass


# ---------- registry ----------

def save_registry(reg):
    sb.write_json(sb.REGISTRY, reg, mode=0o644)


def require_friend(name):
    reg = sb.registry()
    if name not in reg["users"]:
        die(f"{name} is not a sharedbox user")
    return reg, reg["users"][name]


def next_uid(cfg):
    lo, hi = sb.cfg_int(cfg, "FRIEND_UID_MIN"), sb.cfg_int(cfg, "FRIEND_UID_MAX")
    used = {p.pw_uid for p in pwd.getpwall()} | {g.gr_gid for g in grp.getgrall()}
    for uid in range(lo, hi + 1):
        if uid not in used:
            return uid
    raise RuntimeError("no free uid in friend range")


# ---------- create ----------

def create_user(cfg, name, key, login=None, ts_id=None, node=None, email=None):
    """Create a friend account. Returns (record, error)."""
    err = sb.validate_username(name, cfg)
    if err:
        return None, err
    if (key or "").strip():  # optional: most friends only use the web UI and never SSH in
        key, err = sb.validate_pubkey(key)
        if err:
            return None, err
    else:
        key = ""
    reg = sb.registry()
    if ts_id and any(r.get("ts_id") == ts_id for r in reg["users"].values()):
        return None, "this Tailscale account already has a user on this box"
    if len(reg["users"]) >= sb.cfg_int(cfg, "MAX_USERS"):
        return None, "the box is full (MAX_USERS reached) — ask the admin"

    uid = next_uid(cfg)
    gecos = f"sharedbox {login or ''}".strip()
    run(["useradd", "--create-home", "--uid", str(uid), "--user-group",
         "--groups", cfg["FRIENDS_GROUP"], "--shell", "/bin/bash",
         "--comment", gecos, "-K", "HOME_MODE=0700", name])
    run(["usermod", "-p", "*", name])  # no password; key-only login
    add_to_shared(cfg, name)  # before their user manager starts, so their sessions have the group
    pw = pwd.getpwnam(name)
    lo, hi = sb.port_range(cfg, uid)

    # home layout + key, written as the user
    r = as_user(pw, [sys.executable, "-I", os.path.join(sb.LIB_DIR, "box"), "_init-home"],
                 input_text=key + "\n")
    if r.returncode != 0:
        run(["userdel", "-r", name], check=False)
        return None, "failed to initialise home: " + (r.stderr or r.stdout)[-500:]

    rec = {"login": login, "ts_id": ts_id, "node": node, "created": int(time.time()),
           "status": "active", "limits": {}, "uid": uid}
    if email:
        rec["email"] = email
    reg["users"][name] = rec
    save_registry(reg)

    write_dropins(cfg, name, rec, uid)
    daemon_reload()
    run(["loginctl", "enable-linger", name], check=False)
    # last step: grant ssh access
    run(["gpasswd", "-a", name, cfg["SSH_GROUP"]], stdout=subprocess.DEVNULL)
    # start their T3 Code now (first start downloads it), so the join page's button is quick
    run(["systemctl", "start", f"user@{uid}.service"], check=False)
    box_portal(pw, ["t3-start"])
    sb.log_event("user_created", name, login=login, ports=f"{lo}-{hi}")
    return rec, None


# ---------- spool (join requests from the web service) ----------

def read_untrusted(path, uid, limit=64 << 10):
    """Read a small regular file owned by `uid` from a directory others can write.

    No symlinks (O_NOFOLLOW), no FIFOs/devices (O_NONBLOCK + S_ISREG), no hardlinks to
    someone else's file (owner + link count checked on the opened fd). None if anything is off.
    """
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return None
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_nlink != 1:
            return None
        return f.read(limit + 1)[:limit].decode(errors="replace")


def admin_uids(cfg):
    out = {}
    for name in sb.admin_users(cfg):
        try:
            out[pwd.getpwnam(name).pw_uid] = name
        except KeyError:
            pass
    return out


def _secure_dir(path, mode, owner=0):
    os.makedirs(path, mode=mode, exist_ok=True)
    st = os.lstat(path)
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
        raise RuntimeError(f"{path} is not a directory")
    if st.st_uid != owner or stat.S_IMODE(st.st_mode) != mode:
        os.chown(path, owner, 0)
        os.chmod(path, mode)


# ---------- Cloudflare Access (PUBLIC_MODE=cloudflare) ----------

_verifier = None


def cf_mode(cfg):
    return sb.public_mode(cfg) == "cloudflare"


def cf_email(cfg, jwt):
    """The verified email in a Cloudflare Access token, else None. Root checks it itself: the web and gate
    processes only pass the raw token along."""
    global _verifier
    import sbaccess
    try:
        if _verifier is None:
            _verifier = sbaccess.Verifier(cfg.get("CF_TEAM_DOMAIN"), cfg.get("CF_ACCESS_AUD"),
                                          cache_file=sb.CF_CERTS_CACHE)
        return _verifier.verify(jwt if isinstance(jwt, str) else "")["email"]
    except (sbaccess.InvalidToken, ValueError):
        return None


def cf_access(cfg, add=(), remove=(), quiet=False):
    """Change the Access allow list. Returns None on success, else the error text (also printed)."""
    if not cf_mode(cfg):
        return None
    import sbcloudflare
    try:
        sbcloudflare.update_policy(cfg, sbcloudflare.client(cfg), add=add, remove=remove)
        sb.log_event("cf_access", None, added=sorted(add), removed=sorted(remove))
        return None
    except sbcloudflare.CFError as e:
        if not quiet:
            print(f"warning: Cloudflare Access not updated: {e}", file=sys.stderr)
        return str(e)


SKILL_PART_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._-]{0,63}$")


def share_skill(req, user):
    """Publish (or withdraw) an admin's skill in the box-wide catalog, SKILLS_SHARED/<name>.

    The request carries the files' text (never a path root would open). Users only ever get a
    read-only copy; installing it is each user's own `box skills add`.
    """
    name = str(req.get("name") or "")
    if not re.match(sb.SKILL_NAME_RE, name):
        return {"ok": False, "error": "bad skill name"}
    _secure_dir(sb.SKILLS_SHARED, 0o755)
    dest = os.path.join(sb.SKILLS_SHARED, name)
    if req["action"] == "unshare-skill":
        meta = sb.read_json(os.path.join(dest, ".sharedbox.json"), {}) or {}
        if not os.path.isdir(dest):
            return {"ok": False, "error": f"{name} isn't a shared skill"}
        subprocess.run(["rm", "-rf", "--one-file-system", dest], check=True)
        sb.log_event("skill_unshared", user, skill=name, was_by=meta.get("by"))
        return {"ok": True, "message": f"removed {name} from the catalog (installed copies now dangle; "
                                       "`box skills rm` cleans them up)"}
    files = req.get("files")
    if not isinstance(files, dict) or "SKILL.md" not in files or len(files) > sb.SKILL_MAX_FILES:
        return {"ok": False, "error": f"need a SKILL.md and at most {sb.SKILL_MAX_FILES} files"}
    total = 0
    for rel, f in files.items():
        parts = str(rel).split("/")
        if len(parts) > 4 or not all(SKILL_PART_RE.match(x) for x in parts) or not isinstance(f, dict) \
                or not isinstance(f.get("text"), str):
            return {"ok": False, "error": f"bad file entry {str(rel)[:80]!r}"}
        total += len(f["text"].encode())
    if total > sb.SKILL_MAX_BYTES:
        return {"ok": False, "error": f"too big ({total} bytes > {sb.SKILL_MAX_BYTES})"}
    m = re.search(r"^name:\s*['\"]?([^'\"\n]+?)['\"]?\s*$", files["SKILL.md"]["text"].split("\n---", 1)[0], re.M)
    if not files["SKILL.md"]["text"].startswith("---") or not m or m.group(1) != name:
        return {"ok": False, "error": f"SKILL.md needs front matter with `name: {name}` (matching the folder)"}
    tmp = os.path.join(sb.SKILLS_SHARED, f".{name}.{secrets.token_hex(4)}")
    os.mkdir(tmp, 0o755)
    try:
        for rel, f in files.items():
            p = os.path.join(tmp, rel)
            os.makedirs(os.path.dirname(p), mode=0o755, exist_ok=True)
            fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o755 if f.get("exec") else 0o644)
            with os.fdopen(fd, "w") as out:
                out.write(f["text"])
        sb.write_json(os.path.join(tmp, ".sharedbox.json"), {"by": user, "at": int(time.time())})
        old = None
        if os.path.lexists(dest):
            old = f"{tmp}.old"
            os.rename(dest, old)
        os.rename(tmp, dest)
        if old:
            subprocess.run(["rm", "-rf", "--one-file-system", old], check=False)
    except BaseException:
        subprocess.run(["rm", "-rf", "--one-file-system", tmp], check=False)
        raise
    sb.log_event("skill_shared", user, skill=name, files=len(files), bytes=total)
    return {"ok": True, "message": f"{name} is in the catalog for everyone (`box skills`); "
                                   f"people install it with `box skills add {name}`"}


def process_admin_drop(cfg):
    """Requests from ADMIN_USERS accounts, without sudo (`box invite`).

    Anyone can create a file in the drop box (1733), so the file's owner is the identity: only
    files owned by an ADMIN_USERS account are acted on. The answer goes to admin-replies/<id>.json,
    owned by and readable only by that account.
    """
    _secure_dir(sb.ADMIN_DROP, 0o1733)
    _secure_dir(sb.ADMIN_REPLIES, 0o711)
    admins = admin_uids(cfg)
    for path in sorted(glob.glob(os.path.join(sb.ADMIN_DROP, "*.json"))):
        rid = os.path.basename(path)[:-5]
        try:
            owner = os.lstat(path).st_uid
        except FileNotFoundError:
            continue
        raw = read_untrusted(path, owner, limit=4 * sb.SKILL_MAX_BYTES)  # skill shares; others capped below
        try:
            os.unlink(path)
        except FileNotFoundError:
            continue
        if owner not in admins or raw is None or not (rid.isascii() and rid.isalnum() and len(rid) <= 64):
            if owner not in admins:
                sb.log_event("admin_drop_refused", None, uid=owner)
            continue
        try:
            req = json.loads(raw)
        except ValueError:
            req = None
        user = admins[owner]
        if isinstance(req, dict) and req.get("action") in ("share-skill", "unshare-skill"):
            try:
                res = share_skill(req, user)
            except (ValueError, TypeError, OSError, RuntimeError) as e:
                res = {"ok": False, "error": f"could not share the skill: {e}"}
        elif len(raw) <= 4096 and isinstance(req, dict) and req.get("action") in FRIENDS_ACTIONS:
            try:
                res = friends_action(cfg, user, req)
            except (ValueError, TypeError, OSError, RuntimeError, subprocess.SubprocessError) as e:
                res = {"ok": False, "error": f"that didn't work: {e}"}
        elif len(raw) > 4096 or not isinstance(req, dict) or req.get("action") != "invite":
            res = {"ok": False, "error": "unknown request"}
        elif sb.public_url(cfg) and not req.get("tailscale") and req.get("create", True):
            try:
                res = invite_account(cfg, req.get("days"), str(req.get("note") or ""), by=user,
                                     email=str(req.get("email") or "")[:300] or None,
                                     username=str(req.get("username") or "")[:32] or None)
            except InviteError as e:
                res = {"ok": False, "error": str(e)}
            except (ValueError, TypeError, OSError) as e:
                res = {"ok": False, "error": f"could not create the invite: {e}"}
        elif sb.public_url(cfg) and not req.get("tailscale"):
            try:
                text, h, exp = public_invite(cfg, req.get("days"), str(req.get("note") or ""), by=user,
                                             email=str(req.get("email") or "")[:300] or None)
                link = next((ln.strip() for ln in text.splitlines() if "/i/" in ln), "")
                res = {"ok": True, "message": text, "username": None, "link": link, "id": h[:12],
                       "email": str(req.get("email") or "").strip().lower() or None, "expires": exp}
            except InviteError as e:
                res = {"ok": False, "error": str(e)}
            except (ValueError, TypeError, OSError) as e:
                res = {"ok": False, "error": f"could not create the invite: {e}"}
        else:
            res = {"ok": True, "message": tailscale_invite(cfg), "username": None, "link": "", "id": "",
                   "email": None, "expires": None,
                   "note": "PUBLIC_URL is not set, so this is the Tailscale invite (each friend needs a share)"
                           + ("; " + TAILSCALE_NOTE if req.get("create", True) and not sb.public_url(cfg) else "")
                           + "."}
        sb.write_json(os.path.join(sb.ADMIN_REPLIES, f"{rid}.json"), res, mode=0o600, owner=(owner, 0))
    for path in glob.glob(os.path.join(sb.ADMIN_REPLIES, "*.json")):
        try:
            if time.time() - os.lstat(path).st_mtime > 600:
                os.unlink(path)
        except FileNotFoundError:
            pass


def add_to_shared(cfg, name):
    """Friends and admins share SHARED_GROUP (group-owned servers). No-op until install.sh made it."""
    try:
        grp.getgrnam(cfg["SHARED_GROUP"])
    except KeyError:
        return
    run(["gpasswd", "-a", name, cfg["SHARED_GROUP"]], check=False, stdout=subprocess.DEVNULL)


def shared_uids(cfg):
    """uid -> name of everyone who may manage shared servers: active friends and ADMIN_USERS."""
    out = {r["uid"]: n for n, r in sb.friend_users().items() if r.get("status", "active") == "active"}
    out.update(admin_uids(cfg))
    return out


def shared_handle(cfg, user, req):
    """sbshared.handle, with every failure turned into a reply (one bad request never wedges the path unit)."""
    try:
        return sbshared.handle(cfg, user, req)
    except KeyError as e:
        return {"ok": False, "error": f"shared servers aren't set up on this box yet ({e} is missing); "
                                      "ask the owner to re-run install.sh"}
    except Exception as e:  # noqa: BLE001
        print(f"shared request {req.get('action')!r}: {e!r}", file=sys.stderr)
        return {"ok": False, "error": "internal error; ask the owner"}


def process_shared_drop(cfg):
    """`box shared` requests: same pattern as process_admin_drop. The file's owner is the identity, and
    only active friends and ADMIN_USERS get an answer (shared-replies/<id>.json, readable only by them)."""
    _secure_dir(sb.SHARED_DROP, 0o1733)
    _secure_dir(sb.SHARED_REPLIES, 0o711)
    allowed = shared_uids(cfg)
    for path in sorted(glob.glob(os.path.join(sb.SHARED_DROP, "*.json"))):
        rid = os.path.basename(path)[:-5]
        try:
            owner = os.lstat(path).st_uid
        except FileNotFoundError:
            continue
        raw = read_untrusted(path, owner, limit=16 << 10)
        try:
            os.unlink(path)
        except FileNotFoundError:
            continue
        if owner not in allowed or raw is None or not (rid.isascii() and rid.isalnum() and len(rid) <= 64):
            if owner not in allowed:
                sb.log_event("shared_drop_refused", None, uid=owner)
            continue
        try:
            req = json.loads(raw)
        except ValueError:
            req = None
        res = shared_handle(cfg, allowed[owner], req) if isinstance(req, dict) else \
            {"ok": False, "error": "unknown request"}
        sb.write_json(os.path.join(sb.SHARED_REPLIES, f"{rid}.json"), res, mode=0o600, owner=(owner, 0))
    for path in glob.glob(os.path.join(sb.SHARED_REPLIES, "*.json")):
        try:
            if time.time() - os.lstat(path).st_mtime > 600:
                os.unlink(path)
        except FileNotFoundError:
            pass


def process_drops(cfg):
    for fn in (process_admin_drop, process_shared_drop):
        try:
            fn(cfg)
        except Exception as e:  # noqa: BLE001 - never block joins
            print(f"{fn.__name__}: {e!r}", file=sys.stderr)


def process_spool(cfg):
    svc = pwd.getpwnam(cfg["SERVICE_USER"])
    process_drops(cfg)

    def answer(rid, fn, req):
        try:
            result = fn(cfg, rid, req)
        except Exception as e:  # one bad request must not wedge the path unit
            print(f"request {rid}: {e!r}", file=sys.stderr)
            result = {"ok": False, "error": "internal error; ask the owner"}
        sb.write_json(os.path.join(sb.SPOOL, f"res-{rid}.json"), result, mode=0o640,
                      owner=(0, svc.pw_gid))

    # joins run one at a time (registry, uids); portal actions (logins, T3) can take a while,
    # so they run in parallel, and we keep picking up new requests until everything is done
    with ThreadPoolExecutor(max_workers=8) as pool:
        running = set()
        while True:
            paths = sorted(glob.glob(os.path.join(sb.SPOOL, "req-*.json")))
            running = {f for f in running if not f.done()}
            if glob.glob(os.path.join(sb.ADMIN_DROP, "*.json")) or glob.glob(os.path.join(sb.SHARED_DROP, "*.json")):
                process_drops(cfg)
            if not paths and not running:
                break
            for path in paths:
                rid = os.path.basename(path)[4:-5]
                raw = read_untrusted(path, svc.pw_uid)
                try:
                    os.unlink(path)  # unlink never follows symlinks
                except FileNotFoundError:
                    continue
                if not (rid.isascii() and rid.isalnum() and len(rid) <= 64) or raw is None:
                    continue
                try:
                    req = json.loads(raw)
                except ValueError:
                    continue
                if not isinstance(req, dict):
                    continue
                if req.get("action", "join") == "join":
                    answer(rid, handle_join, req)
                elif req.get("action") in GATE_ACTIONS:
                    answer(rid, handle_gate, req)  # quick, and must not race (single-use tokens)
                elif req.get("action") == "owner-pair":
                    running.add(pool.submit(answer, rid, handle_owner_pair, req))
                else:
                    running.add(pool.submit(answer, rid, handle_portal, req))
            time.sleep(0.2)
    gate_prune()
    try:  # after the joins: signups waiting for approval reach the owner by email
        notify_signups(cfg)
    except Exception as e:  # noqa: BLE001
        print(f"notify_signups: {e!r}", file=sys.stderr)
    # results nobody collected
    for path in glob.glob(os.path.join(sb.SPOOL, "res-*.json")):
        try:
            if time.time() - os.lstat(path).st_mtime > 3600:
                os.unlink(path)
        except FileNotFoundError:
            pass


def handle_join(cfg, rid, req):
    if req.get("invite") is not None:
        return handle_invite_join(cfg, rid, req)
    ip = str(req.get("ip", ""))
    who = sb.tailscale_whois(ip) if ip else None
    # re-verify identity ourselves rather than trusting the web process
    if not who or who["id"] != str(req.get("ts_id")):
        return {"ok": False, "error": "could not verify your Tailscale identity"}
    if ip == sb.tailscale_ip4():
        return {"ok": False, "error": "requests from the box itself are not allowed"}
    mode = cfg["JOIN_MODE"]
    if mode == "closed":
        return {"ok": False, "error": "signups are closed"}
    name = str(req.get("username", ""))
    err = sb.validate_username(name, cfg)
    key, kerr = "", None
    if str(req.get("key", "")).strip():
        key, kerr = sb.validate_pubkey(str(req.get("key", "")))
    # every account has an email: it's the login on the public site (Cloudflare Access) and where notices go
    email, eerr = sb.validate_email(str(req.get("email", ""))[:300])
    email = (email or "").lower()
    if not eerr and not email:
        eerr = "please give your email"
    if not eerr and sb.email_taken(email):
        eerr = "that email already has an account here"
    if err or kerr or eerr:
        return {"ok": False, "error": err or kerr or eerr}
    if mode == "approve":
        os.makedirs(sb.PENDING, mode=0o700, exist_ok=True)
        if any((sb.read_json(p, {}) or {}).get("ts_id") == who["id"]
               for p in glob.glob(os.path.join(sb.PENDING, "*.json"))):
            return {"ok": True, "pending": True}
        sb.write_json(os.path.join(sb.PENDING, f"{rid}.json"),
                      {"username": name, "key": key, "login": who["login"], "email": email,
                       "ts_id": who["id"], "node": who["node"], "ts": int(time.time())},
                      mode=0o600)
        sb.log_event("join_pending", name, login=who["login"])
        return {"ok": True, "pending": True}
    rec, err = create_joined(cfg, name, key, who["login"], who["id"], who["node"], email)
    if err:
        return {"ok": False, "error": err}
    lo, hi = sb.port_range(cfg, rec["uid"])
    return {"ok": True, "username": name, "ports": [lo, hi]}


def create_joined(cfg, name, key, login, ts_id, node, email):
    """A Tailscale self-signup (or an approved one): the account, with its email allowed through Cloudflare
    Access when the box uses it, so the friend can also come in from the public site."""
    if email and cf_mode(cfg):
        err = cf_access(cfg, add=[email], quiet=True)
        if err:
            return None, f"couldn't allow {email} in Cloudflare Access: {err}"
    rec, err = create_user(cfg, name, key, login, ts_id, node, email=email or None)
    if err and email and cf_mode(cfg):
        cf_access(cfg, remove=[email], quiet=True)
    return rec, err


# ---------- public front door: invites, sessions, device logins (records read by sharedbox-gate) ----------
# Every token is 32 random bytes, handed out once and stored only as sha256 in GATE_DIR/<kind>/<hash>.json
# (0640 root:sharedbox). Only root mints or consumes them; the gate and web only read, so neither a friend
# nor a compromised web/gate process can forge an invite, a session or a login link.

GATE_ACTIONS = ("redeem", "session-refresh", "logout")


def gate_dirs():
    gid = grp.getgrnam(sb.load_config()["SERVICE_USER"]).gr_gid
    for d in [sb.GATE_DIR] + [os.path.join(sb.GATE_DIR, k) for k in sb.GATE_KINDS]:
        os.makedirs(d, mode=0o750, exist_ok=True)
        st = os.lstat(d)
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
            raise RuntimeError(f"{d} is not a directory")
        if (st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode)) != (0, gid, 0o750):
            os.chown(d, 0, gid)
            os.chmod(d, 0o750)
    return gid


def gate_mint(kind, ttl, **fields):
    """Create a token of `kind`; returns (token, hash). The token itself is never stored."""
    gid = gate_dirs()
    tok = secrets.token_urlsafe(32)
    h = sb.token_hash(tok)
    now = int(time.time())
    sb.write_json(sb.gate_path(kind, h), dict(fields, hash=h, created=now, expires=now + int(ttl)),
                  mode=0o640, owner=(0, gid))
    return tok, h


def gate_consume(kind, tok):
    """Single use: the record if `tok` is live, deleted in the same step (only root does this)."""
    rec, h = sb.gate_lookup(kind, tok)
    if not rec:
        return None
    try:
        os.unlink(sb.gate_path(kind, h))
    except FileNotFoundError:
        return None
    return rec


def gate_delete(kind, pred):
    n = 0
    for h, rec in sb.gate_records(kind):
        if pred(h, rec):
            try:
                os.unlink(sb.gate_path(kind, h))
                n += 1
            except FileNotFoundError:
                pass
    return n


def gate_prune():
    now = time.time()
    for kind in sb.GATE_KINDS:
        gate_delete(kind, lambda h, r: float(r.get("expires", 0) or 0) < now)


def revoke_user_gate(name):
    """Log USER out everywhere: every public session and unused login link."""
    return (gate_delete("sessions", lambda h, r: r.get("user") == name)
            + gate_delete("logins", lambda h, r: r.get("user") == name))


def session_ttl(cfg):
    return sb.cfg_int(cfg, "SESSION_DAYS") * 86400


def mint_session(cfg, name, via, label=""):
    tok, h = gate_mint("sessions", session_ttl(cfg), user=name, via=via, label=sb.printable(label)[:80])
    sb.log_event("gate_login", name, via=via, session=h[:12])
    return tok


def session_identity(cfg, secret):
    """(username, record, hash) for a live session of an active friend, else (None, None, None)."""
    rec, h = sb.gate_lookup("sessions", secret if isinstance(secret, str) else "")
    if not rec or not sb.active_friend(rec.get("user")):
        return None, None, None
    return rec["user"], rec, h


def mint_login_link(cfg, name):
    """One-time public login link for an existing friend (10 minutes). At most 5 open per user."""
    pub = sb.public_url(cfg)
    if not pub or cf_mode(cfg):  # cloudflare mode: any device is logged in by signing in with the email
        return None
    mine = sorted((r.get("created", 0), h) for h, r in sb.gate_records("logins") if r.get("user") == name)
    for _, h in mine[:max(0, len(mine) - 4)]:
        try:
            os.unlink(sb.gate_path("logins", h))
        except FileNotFoundError:
            pass
    tok, _ = gate_mint("logins", sb.cfg_int(cfg, "LOGIN_LINK_MINUTES") * 60, user=name)
    return f"{pub}/login/{tok}"


def handle_invite_join(cfg, rid, req):
    """Signup through a public invite link. The invite is re-verified here, not trusted from the web."""
    if not sb.public_url(cfg):
        return {"ok": False, "error": "public signups are turned off; ask your friend"}
    tok = str(req.get("invite", ""))
    inv, _ = sb.gate_lookup("invites", tok)
    if not inv:
        return {"ok": False, "bad_invite": True,
                "error": "this invite link was already used or has expired; ask your friend for a new one"}
    name = str(req.get("username", ""))
    err = sb.validate_username(name, cfg)
    if cf_mode(cfg):
        # identity = the Access token's email, verified here; the invite must have been made for it
        email, eerr = cf_email(cfg, req.get("cf_jwt")), None
        if not email:
            return {"ok": False, "error": "your Cloudflare login couldn't be verified; reload the page"}
        if str(inv.get("email") or "").lower() != email:
            return {"ok": False, "error": "this invite was made for a different email address"}
        if sb.email_taken(email):
            return {"ok": False, "error": "that email already has an account here; open the start page"}
    else:
        email, eerr = sb.validate_email(str(req.get("email", ""))[:300])
    if err or eerr:
        return {"ok": False, "error": err or eerr}
    # an invite is the owner's approval, so JOIN_MODE (open/approve/closed) doesn't apply; MAX_USERS does
    rec, err = create_user(cfg, name, "", login="cloudflare" if cf_mode(cfg) else "invite", email=email or None)
    if err:
        return {"ok": False, "error": err}
    # consumed only once the account exists, so a taken username can simply be retried
    gate_consume("invites", tok)
    sb.log_event("invite_used", name, invite=inv["hash"][:12], note=inv.get("note", ""))
    if cf_mode(cfg):  # no session of ours: Cloudflare's login is the session
        lo, hi = sb.port_range(cfg, rec["uid"])
        return {"ok": True, "username": name, "ports": [lo, hi]}
    session = mint_session(cfg, name, "invite", str(req.get("ua", "")))
    lo, hi = sb.port_range(cfg, rec["uid"])
    return {"ok": True, "username": name, "ports": [lo, hi], "session": session}


def handle_gate(cfg, rid, req):
    action = req.get("action")
    if not sb.public_url(cfg):
        return {"ok": False, "error": "the public gateway is turned off"}
    if cf_mode(cfg):
        return {"ok": False, "error": "not used here: sign in through Cloudflare with your email"}
    if action == "redeem":
        rec = gate_consume("logins", str(req.get("login", "")))
        if not rec:
            return {"ok": False, "error": "this login link was already used or has expired; get a new one"}
        if not sb.active_friend(rec.get("user")):
            return {"ok": False, "error": "that account is suspended or gone; ask the owner"}
        return {"ok": True, "username": rec["user"],
                "session": mint_session(cfg, rec["user"], "login-link", str(req.get("ua", "")))}
    name, rec, h = session_identity(cfg, req.get("session"))
    if not name:
        return {"ok": False, "relogin": True, "error": "you're logged out"}
    if action == "logout":
        gate_delete("sessions", lambda hh, r: hh == h)
        sb.log_event("gate_logout", name, session=h[:12])
        return {"ok": True}
    if action == "session-refresh":  # sliding expiry: a session in use keeps living
        rec["expires"] = int(time.time()) + session_ttl(cfg)
        rec["seen"] = int(time.time())
        sb.write_json(sb.gate_path("sessions", h), rec, mode=0o640, owner=(0, gate_dirs()))
        return {"ok": True, "expires": rec["expires"]}
    return {"ok": False, "error": "unknown action"}


# ---------- portal (web page actions for an existing account) ----------

PORTAL_KEYS = ("claude", "codex", "gh", "t3connect")


def box_portal(pw, args, input_text=None):
    try:  # runs the friend's own binaries (their PATH), so never wait on them forever
        r = as_user(pw, [sys.executable, "-I", os.path.join(sb.LIB_DIR, "box"), "_portal", *args],
                    input_text=input_text, timeout=300)
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": "that took too long; try again"}
    for line in reversed((r.stdout or "").splitlines()):
        try:
            out = json.loads(line)
        except ValueError:
            continue
        if isinstance(out, dict):
            return out
    return {"ok": False, "error": "internal error; ask the owner"}


def owner_t3_user(cfg):
    return sb.owner_account(cfg)


def handle_owner_pair(cfg, rid, req):
    """The owner opened the public site in a new browser: mint a one-time pairing token for their own T3 Code
    (OWNER_T3_PORT), so they go straight in instead of seeing T3's "paste a pairing token" screen."""
    email = cf_email(cfg, req.get("cf_jwt")) if cf_mode(cfg) else None
    if not email or email not in sb.owner_emails(cfg) or not cfg.get("OWNER_T3_PORT", "").strip().isdigit():
        return {"ok": False, "error": "not the owner"}
    pw = owner_t3_user(cfg)
    if not pw:
        return {"ok": False, "error": "OWNER_T3_USER doesn't exist"}
    # the owner's own T3 runtime (newest), else the system one
    bins = sorted(glob.glob(os.path.join(pw.pw_dir, ".t3/runtime/versions/*/t3")), key=os.path.getmtime)
    t3 = bins[-1] if bins else "/usr/local/bin/t3"
    try:
        r = as_user(pw, [t3, "pair", "--ttl", "10m", "--label", "owner (treehouse)"], timeout=60)
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": "pairing took too long"}
    m = re.search(r"Pairing URL:\s*(\S+)", r.stdout or "")
    if not m:
        return {"ok": False, "error": "pairing failed: " + (r.stderr or r.stdout or "")[-200:]}
    sb.log_event("owner_paired", pw.pw_name)
    return {"ok": True, "pair_url": m.group(1)}


# what the owner's /_box/me page may do as the owner's own account: the dashboard's server controls only.
# Their logins, SSH keys, agent updates and T3 Code are their own business, set up on the box itself.
REQUEST_PORTAL_ACTIONS = ("request-approve", "request-done", "request-decline")
OWNER_PORTAL_ACTIONS = ("status", "serve-ls", "shared-ls", "serve-ctl", "serve-logs", "shared-ctl",
                        "shared-logs", "self-update", "invite") + REQUEST_PORTAL_ACTIONS


def start_update(cfg, by):
    """Install the latest treehouse from UPDATE_SOURCE, detached (it restarts the services that asked for it)."""
    src = (cfg.get("UPDATE_SOURCE") or "").strip()
    if not src:
        return {"ok": False, "error": "updates from the dashboard aren't set up (UPDATE_SOURCE in sharedbox.conf)"}
    st = sb.read_json(os.path.join(sb.STATE_DIR, "update.json"), {}) or {}
    if st.get("state") == "running" and time.time() - float(st.get("started") or 0) < 1800:
        return {"ok": True, "message": "An update is already running. Refresh in a minute."}
    r = run(["systemd-run", f"--unit=sharedbox-update-{int(time.time())}", "--collect", "--quiet",
             os.path.join(sb.LIB_DIR, "sharedbox-update"), str(by)], check=False, capture_output=True, text=True)
    if r.returncode != 0:
        return {"ok": False, "error": "couldn't start the update: " + (r.stderr or "")[-200:]}
    sb.log_event("treehouse_update_started", by)
    return {"ok": True, "message": "Updating treehouse. This page may blink for a few seconds; refresh in a minute."}


def handle_portal(cfg, rid, req):
    owner = False
    if req.get("cf_jwt") is not None:  # cloudflare mode: identity = the Access token's email, verified here
        email = cf_email(cfg, req.get("cf_jwt")) if cf_mode(cfg) else None
        name, _ = sb.user_by_email(email) if email else (None, None)
        if not name and email and email in sb.owner_emails(cfg) and not sb.email_taken(email):
            pw = owner_t3_user(cfg)  # CF_OWNER_EMAILS act as the owner's own account (never a friend's)
            if not pw:
                return {"ok": False, "error": "OWNER_T3_USER doesn't exist"}
            name, owner = pw.pw_name, True
        if not name:
            return {"ok": False, "relogin": True, "error": "your Cloudflare login couldn't be verified; reload"}
    elif req.get("session") is not None:  # public gateway: identity = a root-minted session token
        name, _, _ = session_identity(cfg, req.get("session"))
        if not name or not sb.public_url(cfg) or cf_mode(cfg):
            return {"ok": False, "relogin": True, "error": "you're logged out; open your login link again"}
    else:
        ip = str(req.get("ip", ""))
        who = sb.tailscale_whois(ip) if ip else None
        # re-verify identity ourselves rather than trusting the web process
        if not who or who["id"] != str(req.get("ts_id")) or ip == sb.tailscale_ip4():
            return {"ok": False, "error": "could not verify your Tailscale identity"}
        name = next((n for n, r in sb.friend_users().items() if r.get("ts_id") == who["id"]), None)
        if not name:
            return {"ok": False, "error": "no account for this Tailscale login yet"}
    if owner:
        if req.get("action") not in OWNER_PORTAL_ACTIONS:
            return {"ok": False, "error": "not available for the owner's account"}
        if req.get("action") == "self-update":
            return start_update(cfg, name)
        if req.get("action") == "invite":  # the owner's dashboard: same as `box invite --email ... --note ...`
            try:
                res = invite_account(cfg, None, str(req.get("note") or "")[:120], by=name,
                                     email=str(req.get("email") or "")[:300] or None)
            except InviteError as e:
                return {"ok": False, "error": str(e)}
            return {"ok": True, "invite_message": res.get("message", ""), "invite_user": res.get("username") or ""}
        if req.get("action") in REQUEST_PORTAL_ACTIONS:  # the dashboard's buttons on a friend's `box request`
            try:
                return request_act(cfg, str(req.get("key") or "")[:200], req["action"][8:], by=name)
            except FriendError as e:
                return {"ok": False, "error": str(e)}
        rec = {}
    else:
        rec = sb.friend_users()[name]
    if rec.get("status", "active") != "active":
        return {"ok": False, "error": "your account is suspended; ask the owner"}
    if rec.get("welcome"):  # made at invite time: the gate stops sending / to the portal now it's been seen
        reg = sb.registry()
        if (reg["users"].get(name) or {}).pop("welcome", None):
            save_registry(reg)
    pw = pwd.getpwnam(name)
    action, key = req.get("action"), req.get("key")
    if action == "status":
        return box_portal(pw, ["status"])
    if action == "t3":
        return box_portal(pw, ["t3-pair"])
    if action == "device-link":  # works for Tailscale friends too: their way off Tailscale
        url = mint_login_link(cfg, name)
        if not url:
            return {"ok": False, "error": "the public link isn't set up on this box; ask the owner"}
        return {"ok": True, "login_url": url, "minutes": sb.cfg_int(cfg, "LOGIN_LINK_MINUTES")}
    if action == "add-key":
        key, err = sb.validate_pubkey(str(req.get("sshkey", "")))
        return {"ok": False, "error": err} if err else box_portal(pw, ["add-key"], input_text=key + "\n")
    if action == "updates":
        if key not in ("auto", "manual"):
            return {"ok": False, "error": "unknown choice"}
        return box_portal(pw, ["updates-set", key])
    if action in ("serve-ls", "shared-ls"):
        return box_portal(pw, [action])
    if action in ("serve-ctl", "serve-logs", "shared-ctl", "shared-logs"):
        # `box _portal` checks again (and only touches sb-* units the friend made); never pass a leading "-"
        if not isinstance(key, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,39}", key) \
                or (action.startswith("serve-") and key == "t3"):
            return {"ok": False, "error": "no such server"}
        if action.endswith("-logs"):
            return box_portal(pw, [action, key])
        op = req.get("op")
        if op not in ("start", "stop", "restart"):
            return {"ok": False, "error": "unknown action"}
        return box_portal(pw, [action, key, op])
    if key not in PORTAL_KEYS:
        return {"ok": False, "error": "unknown login"}
    if action == "login":
        return box_portal(pw, ["login-start", key] + (["console"] if req.get("console") else []))
    if action == "code":
        return box_portal(pw, ["login-code", key], input_text=str(req.get("code", ""))[:1000])
    if action == "check":
        return box_portal(pw, ["login-check", key])
    return {"ok": False, "error": "unknown action"}


def cmd_invite(cfg, a):
    """A message to paste to a friend. No terminal anywhere in it. By default the account exists already."""
    pub = sb.public_url(cfg)
    if a.list or a.revoke:
        return invite_admin(a)
    if a.username and a.no_create:
        die("--username needs the account to be created now; drop --no-create")
    if pub and not a.tailscale and not a.no_create:
        try:
            res = invite_account(cfg, a.days, a.note, email=a.email, username=a.username)
        except InviteError as e:
            die(str(e))
        if a.json:
            print(json.dumps(res))
            return
        print(res["message"])
        print(f"\n({res['summary']})", file=sys.stderr)
        return
    if pub and not a.tailscale:
        try:
            text, h, exp = public_invite(cfg, a.days, a.note, email=a.email)
        except InviteError as e:
            die(str(e))
        if a.json:
            link = next((ln.strip() for ln in text.splitlines() if "/i/" in ln), "")
            print(json.dumps({"ok": True, "message": text, "username": None, "link": link, "id": h[:12],
                              "email": (a.email or "").strip().lower() or None, "expires": exp}))
            return
        print(text)
        print(f"\n(invite {h[:12]}, expires {time.strftime('%Y-%m-%d %H:%M', time.localtime(exp))};"
              f" cancel it: sharedbox-admin invite --revoke {h[:12]})", file=sys.stderr)
        return
    text = tailscale_invite(cfg)
    if a.json:
        print(json.dumps({"ok": True, "message": text, "username": None, "link": "", "id": "",
                          "email": None, "expires": None, "note": TAILSCALE_NOTE}))
        return
    print(text)
    if not a.no_create:
        print(f"\n({TAILSCALE_NOTE})", file=sys.stderr)


