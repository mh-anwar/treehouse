    return [req_public(r) for r in recs if include_closed or r.get("state") in REQ_OPEN]


def notify_signups(cfg):
    """Email the owner once per signup waiting for approval (JOIN_MODE=approve)."""
    state = sb.read_json(NOTIFIED, {}) or {}
    pend = signup_list()
    told = state.get("pending") or {}
    new = [p for p in pend if p["id"] not in told]
    fresh = {"pending": {p["id"]: told.get(p["id"], int(time.time())) for p in pend}}
    if fresh != state:  # before mailing: at most one email per signup, even on errors
        sb.write_json(NOTIFIED, fresh, mode=0o600)
    if not new:
        return
    import sbmail
    if not sbmail.configured(cfg):
        return
    lines = [f"{sb.printable(p['username'])} ({sb.printable(p['login'] or '?')}) wants an account.\n"
             f"  Ask your agent: \"approve {sb.printable(p['username'])}\" (box friends approve {p['id']}) "
             f"or deny it (box friends deny {p['id']}).\n" for p in new]
    try:
        sbmail.send(cfg, f"{sb.printable(new[0]['username'])} wants to join"
                    + (f" (+{len(new) - 1} more)" if len(new) > 1 else ""), "\n".join(lines))
    except Exception as e:  # noqa: BLE001
        print(f"signup mail failed: {e!r}", file=sys.stderr)


