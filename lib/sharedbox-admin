            res = access_list(cfg)
            for r in res["emails"]:
                print(f"{sb.printable(r['email']):<40} {r['who']}")
            print(f"\n{res['used']} allowed (limit {res['limit']}). remove: sharedbox-admin access remove EMAIL")
            return
        if a.what == "add":
            print(access_add(cfg, a.email, a.user)["message"])
            return
        c = sbcloudflare.client(cfg)
        email, err = sb.validate_email(a.email or "")
        if err or not email:
            die(err or "give an email address")
        email = email.lower()
        if email in sb.owner_emails(cfg):
            die(f"{email} is in CF_OWNER_EMAILS; the owner is never removed")
        sbcloudflare.update_policy(cfg, c, remove=[email])
        n = gate_delete("invites", lambda h, r: str(r.get("email") or "").lower() == email)
        print(f"removed {email} from Cloudflare Access" + (f"; revoked {n} open invite(s)" if n else ""))
        taken = sb.email_taken(email)
        if taken:
            print(f"note: the account {taken} still exists (sharedbox-admin suspend/remove {taken})")
        sb.log_event("cf_access", None, what="remove", email=email)
    except sbcloudflare.CFError as e:
        die(str(e))
    except FriendError as e:
        die(str(e))


# ---------- owner self-serve: `box friends` (admin drop) and the sharedbox-admin commands share these ----------
# Each returns a dict (or raises FriendError with a message for the owner) and never weakens a check:
# the owner's own accounts (ADMIN_USERS, OWNER_T3_USER, root) are never removed or suspended from here,
# emails are validated, and the Cloudflare allow list stays under CF_SEAT_LIMIT (sbcloudflare.update_policy).

class FriendError(Exception):
    pass


NOTIFIED = os.path.join(sb.STATE_DIR, "notified.json")       # root-only: signups the owner was told about
REQUESTS_JSON = os.path.join(sb.STATE_DIR, "requests.json")  # 0640 root:sharedbox: open requests for the dashboard
REQUEST_ID_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,120}")
FRIENDS_ACTIONS = ("friends-list", "friends-remove", "friends-suspend", "friends-resume", "friends-email",
                   "friends-access", "friends-requests", "friends-request", "friends-issues",
                   "friends-approve", "friends-deny", "friends-update", "tune-service")


def friend_record(cfg, name):
    """(registry, record) of a friend account, refusing anything that is one of the owner's own accounts."""
    name = str(name or "").strip()
    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", name):
        raise FriendError(f"{sb.printable(name)[:40]!r} isn't a username")
    owner = sb.owner_account(cfg)
    if name == "root" or name in sb.admin_users(cfg) or (owner and owner.pw_name == name):
        raise FriendError(f"{name} is one of the owner's own accounts; those can't be changed from here")
    reg = sb.registry()
    rec = reg["users"].get(name)
    if not isinstance(rec, dict):
        raise FriendError(f"{name} is not a friend account on this box (see: box friends)")
    lo, hi = sb.cfg_int(cfg, "FRIEND_UID_MIN"), sb.cfg_int(cfg, "FRIEND_UID_MAX")
    if not lo <= int(rec.get("uid") or 0) <= hi:
        raise FriendError(f"{name} isn't in the friends' uid range; refusing")
    return reg, rec


def friend_suspend(cfg, name, by="root"):
    reg, rec = friend_record(cfg, name)
    run(["gpasswd", "-d", name, cfg["SSH_GROUP"]], check=False, stdout=subprocess.DEVNULL)
    # no more editing shared servers' code either (the servers themselves keep running)
    run(["gpasswd", "-d", name, cfg["SHARED_GROUP"]], check=False, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL)
    # an expired account fails PAM's account phase, so cron/at stop starting jobs for it too
    run(["usermod", "--expiredate", "1", name], check=False)
    stop_everything(name)
    revoke_user_gate(name)  # public-gateway sessions and login links
    rec["status"] = "suspended"
    save_registry(reg)
    warnings = []
    if rec.get("email"):
        err = cf_access(cfg, remove=[rec["email"]])  # Cloudflare stops letting them in, too
        if err:
            warnings.append(f"Cloudflare Access not updated: {err}")
    sb.log_event("user_suspended", name, by=by)
    return {"ok": True, "username": name, "status": "suspended", "warnings": warnings,
            "message": f"suspended {name}: ssh access removed, processes stopped, files kept"}


def friend_resume(cfg, name, by="root"):
    reg, rec = friend_record(cfg, name)
    run(["usermod", "--expiredate", "", name], check=False)
    run(["loginctl", "enable-linger", name], check=False)
    run(["gpasswd", "-a", name, cfg["SSH_GROUP"]], stdout=subprocess.DEVNULL)
    add_to_shared(cfg, name)
    rec["status"] = "active"
    save_registry(reg)
    warnings = []
    if rec.get("email"):
        err = cf_access(cfg, add=[rec["email"]])
        if err:
            warnings.append(f"Cloudflare Access not updated: {err}")
    sb.log_event("user_resumed", name, by=by)
    return {"ok": True, "username": name, "status": "active", "warnings": warnings, "message": f"resumed {name}"}


def friend_remove(cfg, name, archive=False, by="root"):
    reg, rec = friend_record(cfg, name)
    try:
        pw = pwd.getpwnam(name)
    except KeyError:
        raise FriendError(f"{name} is in the registry but has no Linux account; fix it by hand") from None
    if pw.pw_uid != rec.get("uid"):
        raise FriendError(f"{name}'s uid doesn't match the registry; refusing")
    run(["gpasswd", "-d", name, cfg["SSH_GROUP"]], check=False, stdout=subprocess.DEVNULL)
    stop_everything(name)
    out, warnings = None, []
    if archive:
        dest = os.path.join(sb.STATE_DIR, "archive")
        os.makedirs(dest, mode=0o700, exist_ok=True)
        out = os.path.join(dest, f"{name}-{time.strftime('%Y%m%d-%H%M%S')}.tar.gz")
        run(["tar", "--one-file-system", "-czf", out, "-C", os.path.dirname(pw.pw_dir),
             os.path.basename(pw.pw_dir)], check=False)
    run(["crontab", "-r", "-u", name], check=False, stderr=subprocess.DEVNULL)
    kill_stragglers(name)
    r = run(["userdel", "-r", name], check=False, capture_output=True, text=True)
    if r.returncode != 0:
        try:
            pwd.getpwnam(name)
        except KeyError:  # account is gone, only the home/mail cleanup failed (e.g. exit 12)
            warnings.append(f"userdel: {r.stderr.strip()}; check {pw.pw_dir}")
        else:
            raise FriendError(f"userdel failed ({r.returncode}): {r.stderr.strip()}; "
                              "registry and limits left as they were")
    remove_dropins(pw.pw_uid)
    daemon_reload()
    revoke_user_gate(name)
    if rec.get("email"):
        err = cf_access(cfg, remove=[rec["email"]])
        if err:
            warnings.append(f"Cloudflare Access not updated: {err}")
    reg = sb.registry()  # re-read: stop/kill took a while
    reg["users"].pop(name, None)
    save_registry(reg)
    sb.log_event("user_removed", name, by=by, archive=out)
    return {"ok": True, "username": name, "archive": out, "warnings": warnings,
            "message": f"removed {name}" + (f" (home archived to {out})" if out else "")}


def last_active_map(days=7, floor=0.05):
    """name -> ts of the newest health sample where that account used at least `floor` cores."""
    path = os.path.join(sb.STATE_DIR, "health", "metrics.jsonl")
    cutoff, out, prev = time.time() - days * 86400, {}, {}
    try:
        with open(path, "rb") as f:
            size = os.fstat(f.fileno()).st_size
            f.seek(max(0, size - (8 << 20)))
            data = f.read().decode(errors="replace")
    except OSError:
        return out
    for line in data.splitlines():
        try:
            r = json.loads(line)
            ts = float(r["ts"])
            users = r.get("users") or {}
        except (ValueError, KeyError, TypeError, AttributeError):
            continue
        if ts < cutoff or not isinstance(users, dict):
            continue
        for name, u in users.items():
            if not (isinstance(u, list) and len(u) >= 2 and isinstance(u[0], (int, float))):
                continue
            p = prev.get(name)
            if p and 0 < ts - p[0] <= 3600 and u[0] >= p[1] and (u[0] - p[1]) / 1e6 / (ts - p[0]) >= floor:
                out[name] = ts
            prev[name] = (ts, u[0])
    return out


