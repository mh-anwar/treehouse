2. Accept the "shared machine" invite I sent you (check your email), using that same Tailscale account.
3. Open {url}
   Pick a username, then click through: log in to your AI, then "Open my T3 Code". That's it.

Bookmark {url.replace('/join', '/me')} for later. Stuck? Ask the agent, or text me.""")


# ---------- commands ----------

def cmd_list(cfg, a):
    users = sb.friend_users()
    usage = (sb.read_json(sb.USAGE, {}) or {}).get("users", {})
    print(f"{'USER':<16}{'UID':<6}{'STATUS':<11}{'DISK':>8}  {'PORTS':<12} LOGIN")
    for name, r in sorted(users.items()):
        lo, hi = sb.port_range(cfg, r["uid"])
        d = usage.get(name, {}).get("disk")
        print(f"{name:<16}{r['uid']:<6}{r.get('status', '?'):<11}{sb.human(d) if d else '-':>8}  "
              f"{lo}-{hi:<6} {sb.printable(r.get('login') or '')}")


def cmd_add(cfg, a):
    rec, err = create_user(cfg, a.user, a.key, a.login)
    if err:
        die(err)
    lo, hi = sb.port_range(cfg, rec["uid"])
    print(f"created {a.user} (uid {rec['uid']}, ports {lo}-{hi})")


def cmd_pending(cfg, a):
    for p in sorted(glob.glob(os.path.join(sb.PENDING, "*.json"))):
        r = sb.read_json(p, {})
        print(f"{os.path.basename(p)[:-5]}  {r['username']:<16} {sb.printable(r['login'])}  "
              f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(r['ts']))}")


def cmd_approve(cfg, a):
    p = os.path.join(sb.PENDING, f"{a.id}.json")
    r = sb.read_json(p)
    if not r:
        die("no such pending request")
    rec, err = create_user(cfg, r["username"], r["key"], r["login"], r["ts_id"], r["node"])
    if err:
        die(err)
    os.unlink(p)
    print(f"approved {r['username']}")


def cmd_deny(cfg, a):
    p = os.path.join(sb.PENDING, f"{a.id}.json")
    if not os.path.exists(p):
        die("no such pending request")
    os.unlink(p)
    print("denied")


def cmd_limits(cfg, a):
    reg, rec = require_friend(a.user)
    if not a.settings:
        print(json.dumps(sb.user_limits(cfg, rec), indent=2))
        return
    allowed = set(MANAGED_PROPS) | {"DISK_BUDGET_GB"}
    for s in a.settings:
        k, _, v = s.partition("=")
        if k not in allowed:
            die(f"unknown limit {k}; allowed: {', '.join(sorted(allowed))}")
        if v in ("", "default"):
            rec["limits"].pop(k, None)
        else:
            rec["limits"][k] = v
    save_registry(reg)
    write_dropins(cfg, a.user, rec, pwd.getpwnam(a.user).pw_uid)
    daemon_reload()
    sb.log_event("limits_changed", a.user, limits=rec["limits"])
    print(json.dumps(sb.user_limits(cfg, rec), indent=2))


def kill_stragglers(name):
    """Processes outside the user's slice (cron/at sessions have no pam_systemd) survive a
    slice stop; kill everything the uid still runs. Repeat to catch forks in flight."""
    for _ in range(5):
        if run(["pkill", "-KILL", "-u", name], check=False).returncode == 1:  # 1 = none left
            return
        time.sleep(0.2)


def stop_everything(name):
    uid = pwd.getpwnam(name).pw_uid
    run(["loginctl", "disable-linger", name], check=False)
    run(["systemctl", "stop", f"user-{uid}.slice"], check=False)
    kill_stragglers(name)


def cmd_suspend(cfg, a):
    reg, rec = require_friend(a.user)
    run(["gpasswd", "-d", a.user, cfg["SSH_GROUP"]], check=False, stdout=subprocess.DEVNULL)
    # an expired account fails PAM's account phase, so cron/at stop starting jobs for it too
    run(["usermod", "--expiredate", "1", a.user], check=False)
    stop_everything(a.user)
    rec["status"] = "suspended"
    save_registry(reg)
    sb.log_event("user_suspended", a.user)
    print(f"suspended {a.user}: ssh access removed, processes stopped, files kept")


def cmd_resume(cfg, a):
    reg, rec = require_friend(a.user)
    run(["usermod", "--expiredate", "", a.user], check=False)
    run(["loginctl", "enable-linger", a.user], check=False)
    run(["gpasswd", "-a", a.user, cfg["SSH_GROUP"]], stdout=subprocess.DEVNULL)
    rec["status"] = "active"
    save_registry(reg)
    sb.log_event("user_resumed", a.user)
    print(f"resumed {a.user}")


def cmd_kill(cfg, a):
    require_friend(a.user)
    uid = pwd.getpwnam(a.user).pw_uid
    run(["systemctl", "stop", f"user-{uid}.slice"], check=False)
    kill_stragglers(a.user)
    if sb.registry()["users"][a.user].get("status") == "active":
        run(["systemctl", "start", f"user@{uid}.service"], check=False)  # bring their services back
    sb.log_event("user_killed", a.user)
    print(f"stopped all processes of {a.user}; their enabled services restart via linger")


def cmd_remove(cfg, a):
    reg, rec = require_friend(a.user)
    pw = pwd.getpwnam(a.user)
    run(["gpasswd", "-d", a.user, cfg["SSH_GROUP"]], check=False, stdout=subprocess.DEVNULL)
    stop_everything(a.user)
    if a.archive:
        dest = os.path.join(sb.STATE_DIR, "archive")
        os.makedirs(dest, mode=0o700, exist_ok=True)
        out = os.path.join(dest, f"{a.user}-{time.strftime('%Y%m%d-%H%M%S')}.tar.gz")
        run(["tar", "--one-file-system", "-czf", out, "-C", os.path.dirname(pw.pw_dir),
             os.path.basename(pw.pw_dir)], check=False)
        print(f"archived to {out}")
    run(["crontab", "-r", "-u", a.user], check=False, stderr=subprocess.DEVNULL)
    kill_stragglers(a.user)
    r = run(["userdel", "-r", a.user], check=False, capture_output=True, text=True)
    if r.returncode != 0:
        try:
            pwd.getpwnam(a.user)
        except KeyError:  # account is gone, only the home/mail cleanup failed (e.g. exit 12)
            print(f"warning: userdel: {r.stderr.strip()}; check {pw.pw_dir}", file=sys.stderr)
        else:
            die(f"userdel failed ({r.returncode}): {r.stderr.strip()}; registry and limits left as they were")
    remove_dropins(pw.pw_uid)
    daemon_reload()
    del reg["users"][a.user]
    save_registry(reg)
    sb.log_event("user_removed", a.user)
    print(f"removed {a.user}")


def cmd_requests(cfg, a):
    if a.done:
        p = os.path.join(sb.REQUESTS, os.path.basename(a.done))
        os.unlink(p)
        print("closed")
        return
    # friends can write this directory: lstat only, and every byte shown is sanitized
    files = []
    for p in glob.glob(os.path.join(sb.REQUESTS, "*.txt")):
        try:
            files.append((p, os.lstat(p)))
        except FileNotFoundError:
            pass
    files.sort(key=lambda x: x[1].st_mtime)
    if not files:
        print("no open requests")
    for p, st in files:
        try:
            who = pwd.getpwuid(st.st_uid).pw_name  # owner, not the claimed filename
        except KeyError:
            who = "?"
        text = read_untrusted(p, st.st_uid, 1000)
        text = "(not a plain file; ignored)" if text is None else text.strip()
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(st.st_mtime))
        print(f"{sb.printable(os.path.basename(p))}\n  {when}  {who}: {sb.printable(text)}")
    if files:
        print("\nfulfil e.g. with: sharedbox-tools add apt PKG   then: sharedbox-admin requests --done FILE")


def cmd_issues(cfg, a):
    since = time.time() - a.days * 86400
    rows = sb.read_issues(since, users=[a.user] if a.user else None)
    if not rows:
        print(f"no agent-reported issues in the last {a.days} days")
        return
    P = sb.printable
    if a.raw:
        for r in rows:
            print(f"{time.strftime('%m-%d %H:%M', time.localtime(r['ts']))}  {r['user']:<10} "
                  f"[{r['kind']}]{' auto' if r.get('auto') else ''} {P(r.get('agent', '?'))}  "
                  f"{P(r['text'])}\n      cwd {P(r.get('cwd', ''))}")
        return
    groups = sb.group_issues(rows)
    print(f"{len(rows)} issue(s) from {len({r['user'] for r in rows})} user(s), {len(groups)} distinct, "
          f"last {a.days} days (most widespread first):\n")
    for n, users, first, last, r in groups:
        print(f"{n:>3}x [{r['kind']}]{' auto' if r.get('auto') else ''} {P(r['text'])}\n"
              f"      {', '.join(users)} · last {time.strftime('%a %d %b %H:%M', time.localtime(last))}"
              f" · {P(r.get('agent', '?'))} in {P(r.get('cwd', ''))}")
    print("\nraw lines: sharedbox-admin issues --raw   files: ~USER/.sharedbox/issues.jsonl")


def cmd_reapply(cfg, a):
    for name, rec in sb.friend_users().items():
        write_dropins(cfg, name, rec, rec["uid"])
        print(f"rewrote limits for {name}")
    daemon_reload()


def main():
    if os.geteuid() != 0:
        die("must run as root")
    cfg = sb.load_config()
    p = argparse.ArgumentParser(prog="sharedbox-admin", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    s = p.add_subparsers(dest="cmd", required=True)
    s.add_parser("list").set_defaults(fn=cmd_list)
    x = s.add_parser("add"); x.add_argument("user"); x.add_argument("--key", required=True)
    x.add_argument("--login"); x.set_defaults(fn=cmd_add)
    s.add_parser("pending").set_defaults(fn=cmd_pending)
    x = s.add_parser("approve"); x.add_argument("id"); x.set_defaults(fn=cmd_approve)
    x = s.add_parser("deny"); x.add_argument("id"); x.set_defaults(fn=cmd_deny)
    x = s.add_parser("limits"); x.add_argument("user"); x.add_argument("settings", nargs="*")
    x.set_defaults(fn=cmd_limits)
    for n, fn in (("suspend", cmd_suspend), ("resume", cmd_resume), ("kill", cmd_kill)):
        x = s.add_parser(n); x.add_argument("user"); x.set_defaults(fn=fn)
    x = s.add_parser("remove"); x.add_argument("user"); x.add_argument("--archive", action="store_true")
    x.set_defaults(fn=cmd_remove)
    s.add_parser("reapply").set_defaults(fn=cmd_reapply)
    x = s.add_parser("requests"); x.add_argument("--done"); x.set_defaults(fn=cmd_requests)
    x = s.add_parser("issues"); x.add_argument("--days", type=int, default=7); x.add_argument("--user")
    x.add_argument("--raw", action="store_true"); x.set_defaults(fn=cmd_issues)
    s.add_parser("process-spool").set_defaults(fn=lambda c, a: process_spool(c))
    a = p.parse_args()
    a.fn(cfg, a)


if __name__ == "__main__":
    main()
