def username_free(cfg, name, reg):
    """Free for a new account: valid, not a system user/group, not reserved, not in the registry."""
    return not sb.validate_username(name, cfg) and name not in reg.get("users", {})


def _name_base(text):
    s = re.sub(r"[^a-z0-9]", "", (text or "").lower())
    s = re.sub(r"^[^a-z]+", "", s)[:16]
    return s if len(s) >= 3 else ""


def auto_username(cfg, email=None, note=None):
    """A free username for a new friend (AUTO_USERNAMES): never an existing account or system user."""
    reg = sb.registry()
    if (cfg.get("AUTO_USERNAMES") or "email").strip().lower() == "lotr":
        bases = [n for n in LOTR_NAMES if _name_base(n) == n]
    else:
        words = (note or "").split()
        cands = [(email or "").split("@")[0], words[0] if words else "", note or "", "friend"]
        bases = [b for b in map(_name_base, cands) if b][:1]
    for b in bases:
        if username_free(cfg, b, reg):
            return b
    for i in range(2, 10000):  # every base taken: append digits (frodo2, sam2, ...)
        for b in bases:
            cand = b[:16 - len(str(i))] + str(i)
            if username_free(cfg, cand, reg):
                return cand
    raise InviteError("couldn't find a free username; give one with --username")


def invite_account(cfg, days=None, note=None, by=None, email=None, username=None):
    """Create the friend's account now (public front door on) and return what to send them: a dict with
    message, username, link, id, email, expires, summary.

    cloudflare: the account is bound to `email`, which goes on the Access allow list; signing in with it is
    the whole login. funnel: a one-time login link, valid for the invite's lifetime, logs them in."""
    pub, cf = sb.public_url(cfg), cf_mode(cfg)
    days = max(1, min(int(days or sb.cfg_int(cfg, "INVITE_DAYS")), 30))
    note = sb.printable(note or "")[:120]
    email, err = sb.validate_email(email or "")
    if err:
        raise InviteError(err)
    email = (email or "").lower()
    if cf and not email:
        raise InviteError("this box uses Cloudflare Access: give the friend's email, e.g. "
                          "--email sam@example.com (they log in with it)")
    taken = sb.email_taken(email) if email else None
    if taken:
        raise InviteError(f"{email} already belongs to the account {taken}")
    if username:
        username = username.strip().lower()
        if username in sb.registry().get("users", {}):
            raise InviteError("that username is taken")
        err = sb.validate_username(username, cfg)
        if err:
            raise InviteError(err)
    else:
        username = auto_username(cfg, email, note)
    if cf:
        err = cf_access(cfg, add=[email], quiet=True)
        if err:
            raise InviteError(f"couldn't allow {email} in Cloudflare Access: {err}")
    # an invite is the owner's approval, so JOIN_MODE doesn't apply; MAX_USERS does (inside create_user)
    rec, err = create_user(cfg, username, "", login="cloudflare" if cf else "invite", email=email or None)
    if err:
        if cf:
            cf_access(cfg, remove=[email], quiet=True)
        raise InviteError(f"couldn't create the account {username}: {err}")
    reg = sb.registry()
    if username in reg["users"]:  # first visit to / goes to the portal (log in to an AI) instead of T3
        reg["users"][username].update(welcome=True, invited_by=by or "root", **({"note": note} if note else {}))
        save_registry(reg)
    hello = ("Hey! I've set you up on my coding machine. You get your own AI coding agent (Claude or ChatGPT) "
             "that\nbuilds things for you in your browser and keeps running when you close your laptop. "
             "Works on your phone too.\n" + SUBSCRIPTION_LINE)
    if cf:
        sb.log_event("invite_created", by, account=username, email=email, note=note)
        message = f"""{hello}

Open {pub}/ on any device, enter {email}, and type the code Cloudflare emails you. That's it.
The first time, it walks you through logging in to your AI, then "Open T3 in browser". Your username is {username}.
Stuck? Ask the agent, or text me."""
        return {"ok": True, "message": message, "username": username, "link": f"{pub}/", "id": "",
                "email": email, "expires": None,
                "summary": f"account {username} created for {email} and allowed in Cloudflare Access; "
                           f"undo: box friends remove {username}"}
    tok, h = gate_mint("logins", days * 86400, user=username, invite=True, note=note, by=by or "root")
    exp = int(time.time()) + days * 86400
    sb.log_event("invite_created", by, invite=h[:12], account=username, email=email or None, note=note)
    link = f"{pub}/login/{tok}"
    message = f"""{hello}

1. Open this link. It logs you straight in (it works once, for the next {days} days):
   {link}
2. Tap "Log in", then click through: log in to your AI, then "Open T3 in browser". That's it.

Later, just open {pub}/ in the same browser. On a new device, open {pub}/_box/ on the old one and
tap "Add a device". Stuck? Ask the agent, or text me."""
    return {"ok": True, "message": message, "username": username, "link": link, "id": h[:12],
            "email": email or None, "expires": exp,
            "summary": f"account {username} created; login link {h[:12]} works once until "
                       f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(exp))}; "
                       f"undo: box friends remove {username}"}


