def req_mail_owner(cfg):
    """One email per request that needs the owner (never twice), and the hourly FYI of automatic installs."""
    import sbmail
    if not sbmail.configured(cfg):
        return

    def pick(db):
        todo = [dict(r) for r in db["requests"].values() if r.get("state") == "waiting" and not r.get("mailed")]
        for r in todo:
            db["requests"][r["id"]]["mailed"] = int(time.time())  # before sending: at most one email each
        fyi = []
        if db["fyi"] and time.time() - db.get("last_fyi", 0) >= FYI_EVERY:
            fyi, db["fyi"], db["last_fyi"] = db["fyi"], [], int(time.time())
        return todo, fyi
    todo, fyi = req_update(pick)
    link = req_link(cfg)
    if todo:
        lines = []
        for r in todo:
            lines.append(f"{r['user']} asked (box request): {req_summary(r)}\n"
                         + (f"  Why it wasn't installed automatically: {r['reason']}\n" if r.get("reason") else "")
                         + f"  {'Approve installs it' if r.get('kind') == 'install' else 'Your agent can do it'}"
                         f" (ask your agent: \"handle {r['user']}'s request {r['id']}\"), or Done / Decline.\n")
        extra = f" (+{len(todo) - 1} more)" if len(todo) > 1 else ""
        try:
            sbmail.send(cfg, f"{todo[0]['user']} asked: {req_summary(todo[0])[:60]}{extra}",
                        "\n".join(lines) + f"\nApprove / Done / Decline: {link}\n")
        except Exception as e:  # noqa: BLE001 - mail trouble never blocks the provisioner
            print(f"request mail failed: {e!r}", file=sys.stderr)
    if fyi:
        lines = [f"- {f['user']}: {' '.join(f['packages'])} ({time.strftime('%a %H:%M', time.localtime(f['ts']))})"
                 for f in fyi]
        try:
            sbmail.send(cfg, f"FYI: installed {sum(len(f['packages']) for f in fyi)} requested package(s)",
                        "Installed automatically for friends' `box request install` (REQUEST_AUTO_INSTALL):\n"
                        + "\n".join(lines) + "\n\nNothing to do. Undo one: sudo sharedbox-tools remove pkg NAME\n")
        except Exception as e:  # noqa: BLE001
            print(f"request FYI mail failed: {e!r}", file=sys.stderr)


def process_requests(cfg):
    """sharedbox-requests.service: ingest, decide, install (one at a time), tell everyone. Loops until idle."""
    with _Locked(REQ_WORKER_LOCK, block=False) as got:
        if not got:
            return
        for _ in range(100):
            req_ingest(cfg)
            db = req_db()
            work = [r for r in db["requests"].values() if r.get("state") in ("new", "approved")]
            if not work:
                break
            for r in sorted(work, key=lambda r: r.get("ts", 0)):
                owner_ok = r["state"] == "approved"
                if r.get("kind") != "install":
                    req_update(lambda db, rid=r["id"]: db["requests"][rid].update(state="waiting"))
                    continue
                verdict, names, why = req_check(cfg, r, req_db(), owner_ok)
                if verdict == "installed":
                    req_finish(cfg, r["id"], "installed", why, by=r.get("by"), installed=[], auto=not owner_ok)
                elif verdict == "waiting":
                    if owner_ok:  # the owner said yes but it can't be installed: they need to know why
                        req_update(lambda db, rid=r["id"], why=why: db["requests"][rid].update(
                            state="waiting", reason=why, mailed=0))
                    else:
                        req_update(lambda db, rid=r["id"], why=why: db["requests"][rid].update(
                            state="waiting", reason=why))
                else:
                    req_update(lambda db, rid=r["id"]: db["requests"][rid].update(state="installing"))
                    write_request_views(cfg)
                    ok, err = req_install(names)
                    if ok:
                        req_finish(cfg, r["id"], "installed", by=r.get("by"), installed=names, auto=not owner_ok)
                    else:  # back to the owner, with the reason
                        req_update(lambda db, rid=r["id"], err=err: db["requests"][rid].update(
                            state="waiting", reason=f"the install failed: {err}", mailed=0))
                write_request_views(cfg)
        write_request_views(cfg)
        req_mail_owner(cfg)


def request_act(cfg, rid, op, by="root", reason=""):
    """The owner's answer to a request: approve (install it, REQUEST_DENY aside) / done / decline."""
    rid = os.path.basename(str(rid or "").strip())
    rid = rid[:-4] if rid.endswith(".txt") else rid
    if op not in ("approve", "done", "decline"):
        raise FriendError("unknown answer; use approve, done or decline")
    r = req_db()["requests"].get(rid) if REQUEST_ID_RE.fullmatch(rid) else None
    if not r:
        raise FriendError(f"no request {sb.printable(rid)[:80]} (see: box friends requests)")
    if r.get("state") not in REQ_OPEN:
        raise FriendError(f"that request is already {r.get('state')}")
    if op == "approve" and r.get("kind") == "install":
        if r.get("state") == "installing":
            raise FriendError("it's being installed right now")
        req_update(lambda db: db["requests"][rid].update(state="approved", by=by, updated=int(time.time())))
        sb.log_event("request_approved", r.get("user"), id=rid, by=by)
        write_request_views(cfg)
        run(["systemctl", "start", "--no-block", "sharedbox-requests.service"], check=False,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return {"ok": True, "id": rid, "user": r.get("user"), "state": "approved",
                "message": f"approved: installing {' '.join(r.get('packages') or [])} for {r.get('user')} now; "
                           "their agent is told when it's done"}
    state = "declined" if op == "decline" else "done"
    req_finish(cfg, rid, state, sb.printable(reason)[:200], by=by)
    write_request_views(cfg)
    return {"ok": True, "id": rid, "user": r.get("user"), "state": state,
            "message": f"{'declined' if state == 'declined' else 'closed'} {r.get('user')}'s request; "
                       "their agent will see it"}


def requests_list(include_closed=False):
