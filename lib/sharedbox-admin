#!/usr/bin/python3 -I
"""sharedbox-admin: root-only management of friend accounts.

  sharedbox-admin list
  sharedbox-admin add USER --key 'ssh-ed25519 AAAA...' [--login someone@example.com]
  sharedbox-admin pending | approve ID | deny ID
  sharedbox-admin limits USER [KEY=VALUE ...]     e.g. MEMORY_MAX=8G CPU_QUOTA=400% DISK_BUDGET_GB=40
  sharedbox-admin suspend USER | resume USER
  sharedbox-admin kill USER                       stop every process the user has (account stays)
  sharedbox-admin remove USER [--archive]
  sharedbox-admin requests [--done ID]            package/other requests filed with `box request`
  sharedbox-admin issues [--days N] [--user U] [--raw]   what agents logged with `box issue` (all users)
  sharedbox-admin reapply                         rewrite every friend's limit drop-ins (+ shared-sync)
  sharedbox-admin shared-sync                     shared servers: dirs, slice, SHARED_GROUP membership
  sharedbox-admin shared ls | ACTION NAME ...     act on a shared server as root (same as `box shared`)
  sharedbox-admin invite [--days N] [--note TEXT] [--tailscale] [--email ADDR]   a message to paste to a new
                                                  friend (with PUBLIC_URL set: includes a one-time signup link;
                                                  PUBLIC_MODE=cloudflare: --email is required and is allowed in)
  sharedbox-admin invite --list | --revoke ID      outstanding invite links
  sharedbox-admin login-link USER                 one-time public login link for USER (new device/phone)
  sharedbox-admin sessions [USER] [--revoke ID|all]   public-gateway logins (browsers/devices)
  sharedbox-admin public status                   is the public front door (sharedbox-gate + Funnel) set up?
  sharedbox-admin cloudflare setup --hostname box.example.com --owner-email you@example.com [--no-enable]
                                                  one-time Cloudflare Tunnel + Access setup (idempotent)
  sharedbox-admin cloudflare enable | status      start cloudflared + the gate | check everything
  sharedbox-admin cloudflare ssh                  SSH through Cloudflare for friends' laptops (SSH_HOST; idempotent)
  sharedbox-admin access list | add EMAIL [--user NAME] | remove EMAIL   who Cloudflare Access lets in
  sharedbox-admin process-spool                   (run by sharedbox-provision.service)
  sharedbox-admin process-requests                (run by sharedbox-requests.service: `box request`s)

Never touches admin accounts, sshd, tailscaled, networking or the firewall.
"""

