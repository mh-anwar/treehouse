def main():
    if os.geteuid() != 0:
        die("must run as root")
    cfg = sb.load_config()
    p = argparse.ArgumentParser(prog="sharedbox-admin", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    s = p.add_subparsers(dest="cmd", required=True)
    s.add_parser("list").set_defaults(fn=cmd_list)
    x = s.add_parser("add"); x.add_argument("user"); x.add_argument("--key", required=True)
    x.add_argument("--login"); x.set_defaults(fn=cmd_add)
    s.add_parser("pending").set_defaults(fn=cmd_pending)
    x = s.add_parser("approve"); x.add_argument("id"); x.set_defaults(fn=cmd_approve)
    x = s.add_parser("deny"); x.add_argument("id"); x.set_defaults(fn=cmd_deny)
    x = s.add_parser("limits"); x.add_argument("user"); x.add_argument("settings", nargs="*")
    x.set_defaults(fn=cmd_limits)
    for n, fn in (("suspend", cmd_suspend), ("resume", cmd_resume), ("kill", cmd_kill)):
        x = s.add_parser(n); x.add_argument("user"); x.set_defaults(fn=fn)
    x = s.add_parser("remove"); x.add_argument("user"); x.add_argument("--archive", action="store_true")
    x.set_defaults(fn=cmd_remove)
    s.add_parser("reapply").set_defaults(fn=cmd_reapply)
    x = s.add_parser("requests"); x.add_argument("--done"); x.set_defaults(fn=cmd_requests)
    x = s.add_parser("issues"); x.add_argument("--days", type=int, default=7); x.add_argument("--user")
    x.add_argument("--raw", action="store_true"); x.set_defaults(fn=cmd_issues)
    x = s.add_parser("invite"); x.add_argument("--days", type=int); x.add_argument("--note")
    x.add_argument("--tailscale", action="store_true", help="the Tailscale invite text even if PUBLIC_URL is set")
    x.add_argument("--list", action="store_true"); x.add_argument("--revoke", metavar="ID")
    x.set_defaults(fn=cmd_invite)
    x = s.add_parser("login-link"); x.add_argument("user"); x.set_defaults(fn=cmd_login_link)
    x = s.add_parser("sessions"); x.add_argument("user", nargs="?"); x.add_argument("--revoke", metavar="ID|all")
    x.set_defaults(fn=cmd_sessions)
    x = s.add_parser("public"); x.add_argument("what", choices=["status"]); x.set_defaults(fn=cmd_public)
    s.add_parser("process-spool").set_defaults(fn=lambda c, a: process_spool(c))
    a = p.parse_args()
    a.fn(cfg, a)


if __name__ == "__main__":
    main()
