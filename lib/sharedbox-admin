def kill_stragglers(name):
    """Processes outside the user's slice (cron/at sessions have no pam_systemd) survive a
    slice stop; kill everything the uid still runs. Repeat to catch forks in flight."""
    for _ in range(5):
        if run(["pkill", "-KILL", "-u", name], check=False).returncode == 1:  # 1 = none left
            return
        time.sleep(0.2)


def stop_everything(name):
    uid = pwd.getpwnam(name).pw_uid
    run(["loginctl", "disable-linger", name], check=False)
    run(["systemctl", "stop", f"user-{uid}.slice"], check=False)
    kill_stragglers(name)


