GATE_DROPIN = os.path.join(SYSTEMD_DIR, "sharedbox-gate.service.d", "cloudflare.conf")


def cloudflare_enable(cfg):
    """Install cloudflared, run it as a hardened unit with the tunnel token, let the gate fetch Access keys,
    (re)start the gate and web. Root; touches only sharedbox's own units."""
    import sbdistro
    if not os.path.exists(cfg["CF_TUNNEL_ENV"]):
        die(f"{cfg['CF_TUNNEL_ENV']} is missing; run: sudo sharedbox-admin cloudflare setup ...")
    print("installing cloudflared (if needed)...", flush=True)
    sbdistro.install_cloudflared()
    unit = os.path.join(SYSTEMD_DIR, "sharedbox-cloudflared.service")
    if not os.path.exists(unit):  # install.sh puts it there (not enabled) with the other units
        die(f"{unit} is missing; re-run install.sh --apply from the treehouse checkout")
    os.makedirs(os.path.dirname(GATE_DROPIN), mode=0o755, exist_ok=True)
    with open(GATE_DROPIN, "w") as f:
        f.write("# managed by sharedbox (PUBLIC_MODE=cloudflare): the gate fetches Cloudflare Access's signing keys\n"
                "# from https://<team>.cloudflareaccess.com/cdn-cgi/access/certs, so it needs outbound HTTPS.\n"
                "[Service]\nIPAddressDeny=\n")
    daemon_reload()
    run(["systemctl", "enable", "sharedbox-cloudflared.service", "sharedbox-gate.service"])
    run(["systemctl", "restart", "sharedbox-cloudflared.service", "sharedbox-gate.service"])
    run(["systemctl", "restart", "sharedbox-web.service"], check=False)
    print("cloudflared, sharedbox-gate and sharedbox-web (re)started")


