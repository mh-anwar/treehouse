def cmd_public(cfg, a):
    pub, port = sb.public_url(cfg), sb.cfg_int(cfg, "GATE_PORT")
    ok = True

    def line(good, text):
        nonlocal ok
        ok &= bool(good)
        print(f"  [{'ok' if good else '!!'}] {text}")

    print("public front door (friends need only a browser):")
    raw = (cfg.get("PUBLIC_URL") or "").strip()
    line(pub, f"PUBLIC_URL={raw or '(empty: gateway off)'}"
         + ("" if pub or not raw else "  <- must be https://<host>.<tailnet>.ts.net"))
    gate = run(["systemctl", "is-active", "sharedbox-gate.service"], check=False, capture_output=True, text=True)
    line(gate.stdout.strip() == "active", f"sharedbox-gate.service: {gate.stdout.strip() or '?'} (127.0.0.1:{port})")
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=2) as c:
            host = urllib.parse.urlsplit(pub).netloc if pub else "127.0.0.1"
            c.sendall(f"GET /_box/healthz HTTP/1.1\r\nHost: {host}\r\nConnection: close\r\n\r\n".encode())
            first = c.recv(200).split(b"\r\n")[0].decode(errors="replace")
        line(" 200 " in first + " ", f"gate answers on 127.0.0.1:{port}: {first}")
    except OSError as e:
        line(False, f"gate not reachable on 127.0.0.1:{port}: {e}")
    fun = run(["tailscale", "funnel", "status", "--json"], check=False, capture_output=True, text=True, timeout=10)
    target = f"http://127.0.0.1:{port}"
    try:
        fj = json.loads(fun.stdout or "{}")
    except ValueError:
        fj = {}
    funnel_on = any(bool(v) for v in (fj.get("AllowFunnel") or {}).values())
    proxies = json.dumps(fj.get("Web") or {})
    line(funnel_on and target in proxies, "Tailscale Funnel on :443 -> " + target
         + ("" if funnel_on else "  (not enabled)") + ("" if target in proxies else "  (not proxying to the gate)"))
    try:
        st = os.stat(sb.GATE_DIR)
        line(stat.S_IMODE(st.st_mode) == 0o750 and st.st_uid == 0, f"{sb.GATE_DIR} root-owned, 0750")
    except OSError:
        line(False, f"{sb.GATE_DIR} missing (created by install.sh or the first invite)")
    now = time.time()
    for kind in sb.GATE_KINDS:
        live = sum(1 for _, r in sb.gate_records(kind) if float(r.get("expires", 0) or 0) > now)
        print(f"  {kind}: {live} live")
    if not ok:
        try:
            dns = (json.loads(run(["tailscale", "status", "--json", "--peers=false"], check=False, capture_output=True,
                                  text=True, timeout=10).stdout or "{}").get("Self", {}).get("DNSName") or "").rstrip(".")
        except (ValueError, OSError, subprocess.SubprocessError):
            dns = ""
        print(f"""
To turn it on (once, as root):
  1. Tailnet policy (admin console > Access controls) must allow Funnel for this machine, e.g.
       "nodeAttrs": [{{"target": ["<this machine or its tag>"], "attr": ["funnel"]}}]
  2. sudo tailscale funnel --bg --https=443 {target}
  3. Set PUBLIC_URL=https://{dns or '<this machine>.<tailnet>.ts.net'} in {sb.CONF_PATH}
     (the name `tailscale funnel status` prints), then:  sudo ./install.sh --apply
     (or: sudo systemctl enable --now sharedbox-gate && sudo systemctl restart sharedbox-web)
  Undo: sudo tailscale funnel --https=443 off; empty PUBLIC_URL; sudo systemctl disable --now sharedbox-gate""")


