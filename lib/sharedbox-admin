def access_list(cfg):
    import sbcloudflare
    if not cf_mode(cfg):
        raise FriendError("this box doesn't use Cloudflare Access, so there's no allow list")
    try:
        emails = sbcloudflare.policy_emails(sbcloudflare.get_policy(cfg, sbcloudflare.client(cfg)))
    except sbcloudflare.CFError as e:
        raise FriendError(f"couldn't read the Cloudflare allow list: {e}") from None
    reg = sb.registry()
    inv = {}
    for _, r in sb.gate_records("invites"):
        if r.get("email"):
            inv[str(r["email"]).lower()] = "invited" + (" (expired)" if float(r.get("expires", 0)) < time.time() else "")
    owners = sb.owner_emails(cfg)
    rows = []
    for e in emails:
        acct = sb.email_taken(e)
        who = ("owner" if e in owners else
               f"account {acct} ({reg['users'][acct].get('status', 'active')})" if acct else
               inv.get(e, "no account, no open invite"))
        rows.append({"email": e, "who": who, "account": acct, "owner": e in owners})
    return {"ok": True, "emails": rows, "used": len(emails), "limit": sb.cfg_int(cfg, "CF_SEAT_LIMIT")}


def access_add(cfg, email, user=None, by="root"):
    """Allow EMAIL through Cloudflare Access, and with `user` link it to that friend account (they log in as it)."""
    import sbcloudflare
    if not cf_mode(cfg):
        raise FriendError("this box doesn't use Cloudflare Access (PUBLIC_MODE isn't cloudflare)")
    email, err = sb.validate_email(email or "")
    if err or not email:
        raise FriendError(err or "give an email address")
    email = email.lower()
    if user:
        friend_record(cfg, user)
        if email in sb.owner_emails(cfg):
            raise FriendError(f"{email} is an owner email (CF_OWNER_EMAILS); it can't log in as a friend")
        other = sb.email_taken(email)
        if other and other != user:
            raise FriendError(f"{email} already belongs to {other}")
    try:
        sbcloudflare.update_policy(cfg, sbcloudflare.client(cfg), add=[email])
    except sbcloudflare.CFError as e:
        raise FriendError(f"couldn't allow {email} in Cloudflare Access: {e}") from None
    if user:
        reg, rec = friend_record(cfg, user)
        rec["email"] = email
        save_registry(reg)
    sb.log_event("cf_access", user, what="add", email=email, by=by)
    return {"ok": True, "email": email, "username": user or None,
            "message": f"allowed {email} in Cloudflare Access" + (f"; it logs in as {user}" if user else "")}


def friends_action(cfg, by, req):
    """One `box friends` request from an ADMIN_USERS account (the drop file's owner, checked by the caller)."""
    act, name = req.get("action"), str(req.get("name") or "")[:64]
    try:
        if act == "friends-list":
            return friends_list(cfg)
        if act == "friends-update":
            return start_update(cfg, by)
        if act == "friends-remove":
            return friend_remove(cfg, name, bool(req.get("archive")), by=by)
        if act == "friends-suspend":
            return friend_suspend(cfg, name, by=by)
        if act == "friends-resume":
            return friend_resume(cfg, name, by=by)
        if act == "friends-email":
            return access_add(cfg, str(req.get("email") or "")[:300], name, by=by)
        if act == "friends-access":
            return access_list(cfg)
        if act == "friends-requests":
            return {"ok": True, "requests": requests_list(bool(req.get("all")))}
        if act == "friends-request":
            return request_act(cfg, str(req.get("id") or "")[:200], str(req.get("op") or ""), by=by,
                               reason=str(req.get("reason") or "")[:200])
        if act == "friends-issues":
            res = issues_summary(req.get("days") if isinstance(req.get("days"), int) else 7)
            res.pop("raw")
            return res
        if act == "friends-approve":
            return signup_approve(cfg, str(req.get("id") or "")[:64], by=by)
        if act == "friends-deny":
            return signup_deny(cfg, str(req.get("id") or "")[:64], by=by)
        if act == "tune-service":
            return tune_service(str(req.get("op") or ""), str(req.get("unit") or "")[:80], by=by)
    except FriendError as e:
        return {"ok": False, "error": str(e)}
    return {"ok": False, "error": "unknown request"}


TUNE_STATE = os.path.join(sb.STATE_DIR, "tune.json")


def tune_service(op, unit, by):
    """`box tune disable|enable NAME` (owner only, after the owner said yes): a service from sharedbox-tune's
    fixed list of ones a server rarely needs. Never anything else; reversible with enable; logged."""
    import importlib.machinery
    import importlib.util
    loader = importlib.machinery.SourceFileLoader("sbtune", os.path.join(sb.LIB_DIR, "sharedbox-tune"))
    tune = importlib.util.module_from_spec(importlib.util.spec_from_loader("sbtune", loader))
    loader.exec_module(tune)
    unit = unit if unit.endswith(".service") else unit + ".service"
    if op not in ("disable", "enable"):
        raise FriendError("use: box tune disable NAME  or  box tune enable NAME")
    if unit not in tune.SWITCHABLE:
        raise FriendError(f"{sb.printable(unit)[:60]} isn't on the list treehouse may switch "
                          f"({', '.join(sorted(u.removesuffix('.service') for u in tune.SWITCHABLE))})")
    if op == "disable" and unit == "wpa_supplicant.service" and tune.wireless_in_use():
        raise FriendError("a Wi-Fi link is up: the box may be using wpa_supplicant for its network, so it stays on")
    r = run(["systemctl", f"{op}", "--now", unit], check=False, capture_output=True, text=True, timeout=120)
    if r.returncode != 0:
        raise FriendError(f"systemctl {op} {unit} failed: {(r.stderr or '').strip()[-300:]}")
    st = sb.read_json(TUNE_STATE, {}) or {}
    st.setdefault("services", {})[unit] = {"state": op + "d", "by": by, "ts": int(time.time())}
    sb.write_json(TUNE_STATE, st, mode=0o644)
    sb.log_event("tune_service", by, unit=unit, op=op)
    return {"ok": True, "message": f"{unit.removesuffix('.service')} {op}d"
            + (" (turn it back on any time: box tune enable " + unit.removesuffix(".service") + ")"
               if op == "disable" else "")}


# ---------- `box request`: friends ask, root installs packages itself or asks the owner ----------
# Friends drop REQUESTS/<id>.txt (free text) or <id>.json ({"install": [...], "why": ...}); the file's owner is
# who asked. sharedbox-requests.service (its .path unit watches the drop) moves each into REQ_DB (root-only) and
# deletes the file, then: a package request that passes every REQUEST_* check is installed right away (with
# `sharedbox-tools add pkg`, so it survives reinstalls); anything else waits for the owner, who gets one email
# per request and Approve / Done / Decline on the dashboard (or `box friends requests ...`). Every outcome goes
# into the friend's agent notices and their own status file (`box request status`).

REQ_DB = os.path.join(sb.STATE_DIR, "requests-db.json")
REQ_LOCK = os.path.join(sb.STATE_DIR, ".requests.lock")
REQ_WORKER_LOCK = os.path.join(sb.STATE_DIR, ".requests-worker.lock")
REQ_OPEN = ("new", "queued", "installing", "approved", "waiting")
REQ_KEEP_DAYS = 30
REQ_INSTALL_TIMEOUT = 1800
FYI_EVERY = 3600


class _Locked:
    def __init__(self, path, block=True):
        self.path, self.block, self.f = path, block, None

    def __enter__(self):
        import fcntl
        self.f = open(self.path, "a")
        try:
            fcntl.flock(self.f, fcntl.LOCK_EX | (0 if self.block else fcntl.LOCK_NB))
        except BlockingIOError:
            self.f.close()
            self.f = None
        return self.f is not None

    def __exit__(self, *exc):
        if self.f:
            self.f.close()


def req_db():
    db = sb.read_json(REQ_DB, {}) or {}
    db.setdefault("requests", {})
    db.setdefault("fyi", [])
    return db


def req_save(db):
    cut = time.time() - REQ_KEEP_DAYS * 86400
    db["requests"] = {k: r for k, r in db["requests"].items()
                      if r.get("state") in REQ_OPEN or r.get("updated", r.get("ts", 0)) > cut}
    sb.write_json(REQ_DB, db, mode=0o600)


def req_update(fn):
    """Read-modify-write REQ_DB under its lock; returns fn(db)."""
    with _Locked(REQ_LOCK):
        db = req_db()
        out = fn(db)
        req_save(db)
        return out


def req_public(r):
    """What the owner and the friend see of a record."""
    keys = ("id", "user", "kind", "packages", "why", "text", "ts", "state", "reason", "updated", "by", "auto",
            "installed")
    return {k: r.get(k) for k in keys if r.get(k) not in (None, [], "")}


def req_summary(r):
    if r.get("kind") == "install":
        return "install " + " ".join(r.get("packages") or []) + (f" ({r['why']})" if r.get("why") else "")
    return r.get("text") or ""


def req_ingest(cfg):
    """Move every dropped request file into REQ_DB; each file is deleted whatever it holds. Returns new ids."""
    try:
        names = os.listdir(sb.REQUESTS)
    except FileNotFoundError:
        return []
    found = []
    for fn in sorted(names):
        p = os.path.join(sb.REQUESTS, fn)
        try:
            st = os.lstat(p)
        except FileNotFoundError:
            continue
        if fn.startswith(".") and time.time() - st.st_mtime < 600:
            continue  # `box request` is still writing it (it renames it into place when done)
        raw = read_untrusted(p, st.st_uid, 8192) if stat.S_ISREG(st.st_mode) else None
        try:
            os.unlink(p)
        except OSError:
            continue
        try:
            user = pwd.getpwuid(st.st_uid).pw_name
        except KeyError:
            continue
        if raw is None or fn.startswith(".") or not fn.endswith((".txt", ".json")):
            continue
        stem = fn.rsplit(".", 1)[0]
        rec = {"user": user, "ts": int(st.st_mtime), "state": "new", "updated": int(time.time())}
        req = None
        if fn.endswith(".json"):
            try:
                req = json.loads(raw)
            except ValueError:
                req = None
        if isinstance(req, dict) and isinstance(req.get("install"), list) and req["install"]:
            pkgs = [str(x).strip().lower() for x in req["install"]][:20]
            rec.update(kind="install", packages=pkgs, why=sb.printable(str(req.get("why") or ""))[:300])
            bad = [x for x in pkgs if not sbdistro().PKG_NAME_RE.fullmatch(x)]
            if bad:
                rec.update(kind="text", text=sb.printable("install " + " ".join(pkgs))[:300],
                           packages=[], reason="not valid package names: " + " ".join(map(sb.printable, bad))[:200])
        else:
            text = req.get("text") if isinstance(req, dict) else raw
            rec.update(kind="text", text=sb.printable(" ".join(str(text or "").split()))[:1000])
        found.append((stem, rec))

    def put(db):
        ids = []
        for stem, rec in found:
            rid = stem if REQUEST_ID_RE.fullmatch(stem) else f"{rec['user']}-{rec['ts']}"
            base, n = rid, 2
            while rid in db["requests"]:
                rid, n = f"{base}-{n}", n + 1
            db["requests"][rid] = dict(rec, id=rid)
            ids.append(rid)
            sb.log_event("request_filed", rec["user"], id=rid, what=req_summary(rec)[:200])
        return ids
    return req_update(put) if found else []


