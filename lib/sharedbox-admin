    s.add_parser("shared-sync").set_defaults(fn=cmd_shared_sync)
    x = s.add_parser("shared"); x.add_argument("action", choices=("ls",) + sbshared.ACTIONS)
    x.add_argument("name", nargs="?"); x.add_argument("--port", type=int)
    x.add_argument("-n", "--lines", type=int, default=100)
    x.add_argument("cmd", nargs=argparse.REMAINDER); x.set_defaults(fn=cmd_shared)
