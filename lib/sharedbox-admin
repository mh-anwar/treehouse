    return d


def deny_globs(cfg):
    return [g for g in re.split(r"[\s,]+", cfg.get("REQUEST_DENY") or "") if g]


def denied(cfg, names):
    import fnmatch
    globs = deny_globs(cfg)
    return [n for n in names if any(fnmatch.fnmatchcase(n, g) for g in globs)]


def auto_installed_today(db, user):
    cut = time.time() - 86400
    return sum(len(r.get("installed") or []) for r in db["requests"].values()
               if r.get("user") == user and r.get("auto") and r.get("updated", 0) > cut)


def req_check(cfg, rec, db, owner_ok=False):
    """Decide a package request: ("install", native names, "") / ("installed", [], why) / ("waiting", [], why).
    The owner's approval (owner_ok) skips REQUEST_DENY, the dependency cap and the daily limit, nothing else."""
    d = sbdistro()
    try:
        pkgs = d.native_names(rec.get("packages") or [])
        if not pkgs:
            return "waiting", [], "no packages named"
        missing = [p for p in pkgs if not d.installed(p)]
        if not missing:
            return "installed", [], "already installed"
        if not owner_ok:
            if not sb.cfg_bool(cfg, "REQUEST_AUTO_INSTALL"):
                return "waiting", [], "automatic installs are off (REQUEST_AUTO_INSTALL)"
            bad = denied(cfg, missing)
            if bad:
                return "waiting", [], f"{' '.join(bad)} needs the owner's OK (REQUEST_DENY)"
            limit = sb.cfg_int(cfg, "REQUEST_DAILY_LIMIT")
            if limit and auto_installed_today(db, rec["user"]) + len(missing) > limit:
                return "waiting", [], f"over {limit} automatic installs today for {rec['user']}"
        for p in missing:  # a vetted third-party package (e.g. Google Chrome): set up its vendor repo first
            if p in getattr(d, "VETTED", {}) and (owner_ok or sb.cfg_bool(cfg, "REQUEST_VETTED_SOURCES")):
                try:
                    d.ensure_vetted_source(p)
                except (OSError, RuntimeError, subprocess.SubprocessError) as ex:
                    return "waiting", [], f"couldn't add the official source for {p}: {str(ex)[:150]}"
        ok, new, err = d.simulate_install(missing)
        if not ok:
            return "waiting", [], f"not installable from the distro's repos: {err}"
        if not owner_ok:
            cap = sb.cfg_int(cfg, "REQUEST_MAX_DEPS")
            if cap and len(new) > cap:
                return "waiting", [], f"it would pull in {len(new)} packages (limit {cap})"
            bad = denied(cfg, [n for n in new if n not in missing])
            if bad:
                return "waiting", [], f"it would pull in {' '.join(bad[:5])}, which needs the owner's OK"
        return "install", missing, ""
    except d.Unsupported as e:
        return "waiting", [], str(e)[:200]


def req_install(names):
    """Install with sharedbox-tools (records them in tools.local, refreshes tools.json). (ok, error)."""
    d = sbdistro()
    try:
        r = run([os.path.join(sb.LIB_DIR, "sharedbox-tools"), "add", "pkg", *names], check=False,
                capture_output=True, text=True, timeout=REQ_INSTALL_TIMEOUT)
        tail = (r.stderr or r.stdout or "").strip().splitlines()[-1:] or [""]
    except subprocess.TimeoutExpired:
        return False, f"the install took over {REQ_INSTALL_TIMEOUT // 60} minutes and was stopped"
    left = [n for n in names if not d.installed(n)]
    if left:
        return False, f"{' '.join(left)} didn't install: {tail[0][:200]}"
    return True, ""


def req_finish(cfg, rid, state, reason="", by=None, installed=None, auto=None):
    """Set a record's outcome, tell the friend's agents, refresh the views."""
    def upd(db):
        r = db["requests"].get(rid)
        if not r:
            return None
        r.update(state=state, reason=reason, updated=int(time.time()))
        if by:
            r["by"] = by
        if installed is not None:
            r["installed"] = installed
        if auto is not None:
            r["auto"] = auto
        if state == "installed" and auto:
            db["fyi"].append({"user": r["user"], "packages": installed or [], "ts": int(time.time())})
        return dict(r)
    r = req_update(upd)
    if not r:
        return None
    what = req_summary(r)
    msg = {"installed": (f"{' '.join(r.get('packages') or [])} is installed now (your `box request`)"
                         + (f"; {reason}" if reason else "") + "."),
           "done": f"The owner marked your `box request` as done: {what}",
           "declined": f"The owner declined your `box request`: {what}" + (f" ({reason})" if reason else ""),
           "failed": f"Your `box request` ({what}) failed: {reason}. The owner has been told."}.get(state)
    if msg and r.get("user") in sb.friend_users():
        add_notice(r["user"], "request-" + state, msg)
    sb.log_event("request_" + state, r.get("user"), id=rid, by=by or "auto", what=what[:200],
                 **({"reason": reason} if reason else {}))
    return r


def write_request_views(cfg, db=None):
    """The open requests for the owner's dashboard (REQUESTS_JSON, 0640 root:sharedbox), and each friend's own
    requests in AGENT_PINS/<user>/requests.json (0640 root:<their group>) for `box request status`."""
    db = db or req_db()
    recs = sorted(db["requests"].values(), key=lambda r: r.get("ts", 0))
    open_ = [req_public(r) for r in recs if r.get("state") in REQ_OPEN]
    try:
        owner, mode = (0, grp.getgrnam(cfg["SERVICE_USER"]).gr_gid), 0o640
    except KeyError:
        owner, mode = None, 0o600
    if (sb.read_json(REQUESTS_JSON, {}) or {}).get("requests") != open_:
        sb.write_json(REQUESTS_JSON, {"generated": int(time.time()), "requests": open_}, mode=mode, owner=owner)
    by_user = {}
    for r in recs:
        by_user.setdefault(r.get("user"), []).append(req_public(r))
    for user in set(by_user) | {u for u in sb.friend_users()}:
        try:
            pw = pwd.getpwnam(user)
        except (KeyError, TypeError):
            continue
        d = os.path.join(sb.AGENT_PINS, user)
        path = os.path.join(d, "requests.json")
        mine = by_user.get(user, [])
        if not mine and not os.path.exists(path):
            continue
        if (sb.read_json(path, {}) or {}).get("requests") == mine:
            continue
        os.makedirs(d, mode=0o755, exist_ok=True)
        if not os.path.islink(d):
            sb.write_json(path, {"requests": mine}, mode=0o640, owner=(0, pw.pw_gid))


