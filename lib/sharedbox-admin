#!/usr/bin/python3 -I
"""sharedbox-admin: root-only management of friend accounts.

  sharedbox-admin list
  sharedbox-admin add USER --key 'ssh-ed25519 AAAA...' [--login someone@example.com]
  sharedbox-admin pending | approve ID | deny ID
  sharedbox-admin limits USER [KEY=VALUE ...]     e.g. MEMORY_MAX=8G CPU_QUOTA=400% DISK_BUDGET_GB=40
  sharedbox-admin suspend USER | resume USER
  sharedbox-admin kill USER                       stop every process the user has (account stays)
  sharedbox-admin remove USER [--archive]
  sharedbox-admin requests [--done FILE]          package/other requests filed with `box request`
  sharedbox-admin issues [--days N] [--user U] [--raw]   what agents logged with `box issue` (all users)
  sharedbox-admin reapply                         rewrite every friend's limit drop-ins
  sharedbox-admin process-spool                   (run by sharedbox-provision.service)

Never touches admin accounts, sshd, tailscaled, networking or the firewall.
"""

import argparse
import glob
import grp
import json
import os
import pwd
import shutil
import stat
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor

sys.path.insert(0, os.environ.get("SHAREDBOX_LIB", "/usr/lib/sharedbox"))
import sbcommon as sb  # noqa: E402

SYSTEMD_DIR = "/etc/systemd/system"
MANAGED_PROPS = {
    "CPU_QUOTA": "CPUQuota",
    "CPU_WEIGHT": "CPUWeight",
    "IO_WEIGHT": "IOWeight",
    "MEMORY_HIGH": "MemoryHigh",
    "MEMORY_MAX": "MemoryMax",
    "MEMORY_SWAP_MAX": "MemorySwapMax",
    "TASKS_MAX": "TasksMax",
}


def die(msg, code=1):
    print(f"sharedbox-admin: {msg}", file=sys.stderr)
    sys.exit(code)


def run(cmd, check=True, **kw):
    return subprocess.run(cmd, check=check, **kw)


def as_user(pw, cmd, input_text=None, timeout=None):
    """Run cmd as the friend (never write into a friend's home as root)."""
    env = {"HOME": pw.pw_dir, "USER": pw.pw_name, "LOGNAME": pw.pw_name,
           "PATH": "/usr/local/bin:/usr/bin:/bin",
           "XDG_RUNTIME_DIR": f"/run/user/{pw.pw_uid}",
           "SHAREDBOX_LIB": sb.LIB_DIR, "SHAREDBOX_SHARE": sb.SHARE_DIR,
           "SHAREDBOX_CONF": sb.CONF_PATH, "SHAREDBOX_STATE": sb.STATE_DIR}
    return subprocess.run(
        ["setpriv", f"--reuid={pw.pw_uid}", f"--regid={pw.pw_gid}", "--init-groups",
         "--reset-env", "--"] + cmd,
        input=input_text, text=True, capture_output=True, env=env, cwd=pw.pw_dir, timeout=timeout)


def daemon_reload():
    run(["systemctl", "daemon-reload"])


# ---------- limits ----------

def write_dropins(cfg, name, rec, uid):
    lim = sb.user_limits(cfg, rec)
    lines = ["# managed by sharedbox — edit with: sharedbox-admin limits " + name, "[Slice]"]
    for key, prop in MANAGED_PROPS.items():
        if lim.get(key):
            lines.append(f"{prop}={lim[key]}")
    d = os.path.join(SYSTEMD_DIR, f"user-{uid}.slice.d")
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, "60-sharedbox.conf"), "w") as f:
        f.write("\n".join(lines) + "\n")
    # user manager (and so the friend's long-running services) is first in line for the OOM killer
    d = os.path.join(SYSTEMD_DIR, f"user@{uid}.service.d")
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, "60-sharedbox.conf"), "w") as f:
        f.write("# managed by sharedbox\n[Service]\n"
                f"OOMScoreAdjust={cfg['OOM_SCORE_ADJ']}\n")


def remove_dropins(uid):
    for d in (f"user-{uid}.slice.d", f"user@{uid}.service.d"):
        p = os.path.join(SYSTEMD_DIR, d, "60-sharedbox.conf")
        if os.path.exists(p):
            os.unlink(p)
        try:
            os.rmdir(os.path.join(SYSTEMD_DIR, d))
        except OSError:
            pass


# ---------- registry ----------

def save_registry(reg):
    sb.write_json(sb.REGISTRY, reg, mode=0o644)


def require_friend(name):
    reg = sb.registry()
    if name not in reg["users"]:
        die(f"{name} is not a sharedbox user")
    return reg, reg["users"][name]


def next_uid(cfg):
    lo, hi = sb.cfg_int(cfg, "FRIEND_UID_MIN"), sb.cfg_int(cfg, "FRIEND_UID_MAX")
    used = {p.pw_uid for p in pwd.getpwall()} | {g.gr_gid for g in grp.getgrall()}
    for uid in range(lo, hi + 1):
        if uid not in used:
            return uid
    raise RuntimeError("no free uid in friend range")


# ---------- create ----------

def create_user(cfg, name, key, login=None, ts_id=None, node=None):
    """Create a friend account. Returns (record, error)."""
    err = sb.validate_username(name, cfg)
    if err:
        return None, err
    if (key or "").strip():  # optional: most friends only use the web UI and never SSH in
        key, err = sb.validate_pubkey(key)
        if err:
            return None, err
    else:
        key = ""
    reg = sb.registry()
    if ts_id and any(r.get("ts_id") == ts_id for r in reg["users"].values()):
        return None, "this Tailscale account already has a user on this box"
    if len(reg["users"]) >= sb.cfg_int(cfg, "MAX_USERS"):
        return None, "the box is full (MAX_USERS reached) — ask the admin"

    uid = next_uid(cfg)
    gecos = f"sharedbox {login or ''}".strip()
    run(["useradd", "--create-home", "--uid", str(uid), "--user-group",
         "--groups", cfg["FRIENDS_GROUP"], "--shell", "/bin/bash",
         "--comment", gecos, "-K", "HOME_MODE=0700", name])
    run(["usermod", "-p", "*", name])  # no password; key-only login
    pw = pwd.getpwnam(name)
    lo, hi = sb.port_range(cfg, uid)

    # home layout + key, written as the user
    r = as_user(pw, [sys.executable, "-I", os.path.join(sb.LIB_DIR, "box"), "_init-home"],
                 input_text=key + "\n")
    if r.returncode != 0:
        run(["userdel", "-r", name], check=False)
        return None, "failed to initialise home: " + (r.stderr or r.stdout)[-500:]

    rec = {"login": login, "ts_id": ts_id, "node": node, "created": int(time.time()),
           "status": "active", "limits": {}, "uid": uid}
    reg["users"][name] = rec
    save_registry(reg)

    write_dropins(cfg, name, rec, uid)
    daemon_reload()
    run(["loginctl", "enable-linger", name], check=False)
    # last step: grant ssh access
    run(["gpasswd", "-a", name, cfg["SSH_GROUP"]], stdout=subprocess.DEVNULL)
    # start their T3 Code now (first start downloads it), so the join page's button is quick
    run(["systemctl", "start", f"user@{uid}.service"], check=False)
    box_portal(pw, ["t3-start"])
    sb.log_event("user_created", name, login=login, ports=f"{lo}-{hi}")
    return rec, None


# ---------- spool (join requests from the web service) ----------

def read_untrusted(path, uid, limit=64 << 10):
    """Read a small regular file owned by `uid` from a directory others can write.

    No symlinks (O_NOFOLLOW), no FIFOs/devices (O_NONBLOCK + S_ISREG), no hardlinks to
    someone else's file (owner + link count checked on the opened fd). None if anything is off.
    """
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return None
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_nlink != 1:
            return None
        return f.read(limit + 1)[:limit].decode(errors="replace")


def process_spool(cfg):
    svc = pwd.getpwnam(cfg["SERVICE_USER"])

    def answer(rid, fn, req):
        try:
            result = fn(cfg, rid, req)
        except Exception as e:  # one bad request must not wedge the path unit
            print(f"request {rid}: {e!r}", file=sys.stderr)
            result = {"ok": False, "error": "internal error; ask the owner"}
        sb.write_json(os.path.join(sb.SPOOL, f"res-{rid}.json"), result, mode=0o640,
                      owner=(0, svc.pw_gid))

    # joins run one at a time (registry, uids); portal actions (logins, T3) can take a while,
    # so they run in parallel, and we keep picking up new requests until everything is done
    with ThreadPoolExecutor(max_workers=8) as pool:
        running = set()
        while True:
            paths = sorted(glob.glob(os.path.join(sb.SPOOL, "req-*.json")))
            running = {f for f in running if not f.done()}
            if not paths and not running:
                break
            for path in paths:
                rid = os.path.basename(path)[4:-5]
                raw = read_untrusted(path, svc.pw_uid)
                try:
                    os.unlink(path)  # unlink never follows symlinks
                except FileNotFoundError:
                    continue
                if not (rid.isascii() and rid.isalnum() and len(rid) <= 64) or raw is None:
                    continue
                try:
                    req = json.loads(raw)
                except ValueError:
                    continue
                if not isinstance(req, dict):
                    continue
                if req.get("action", "join") == "join":
                    answer(rid, handle_join, req)
                else:
                    running.add(pool.submit(answer, rid, handle_portal, req))
            time.sleep(0.2)
    # results nobody collected
    for path in glob.glob(os.path.join(sb.SPOOL, "res-*.json")):
        try:
            if time.time() - os.lstat(path).st_mtime > 3600:
                os.unlink(path)
        except FileNotFoundError:
            pass


def handle_join(cfg, rid, req):
    ip = str(req.get("ip", ""))
    who = sb.tailscale_whois(ip) if ip else None
    # re-verify identity ourselves rather than trusting the web process
    if not who or who["id"] != str(req.get("ts_id")):
        return {"ok": False, "error": "could not verify your Tailscale identity"}
    if ip == sb.tailscale_ip4():
        return {"ok": False, "error": "requests from the box itself are not allowed"}
    mode = cfg["JOIN_MODE"]
    if mode == "closed":
        return {"ok": False, "error": "signups are closed"}
    name = str(req.get("username", ""))
    err = sb.validate_username(name, cfg)
    key, kerr = "", None
    if str(req.get("key", "")).strip():
        key, kerr = sb.validate_pubkey(str(req.get("key", "")))
    if err or kerr:
        return {"ok": False, "error": err or kerr}
    if mode == "approve":
        os.makedirs(sb.PENDING, mode=0o700, exist_ok=True)
        if any((sb.read_json(p, {}) or {}).get("ts_id") == who["id"]
               for p in glob.glob(os.path.join(sb.PENDING, "*.json"))):
            return {"ok": True, "pending": True}
        sb.write_json(os.path.join(sb.PENDING, f"{rid}.json"),
                      {"username": name, "key": key, "login": who["login"],
                       "ts_id": who["id"], "node": who["node"], "ts": int(time.time())},
                      mode=0o600)
        sb.log_event("join_pending", name, login=who["login"])
        return {"ok": True, "pending": True}
    rec, err = create_user(cfg, name, key, who["login"], who["id"], who["node"])
    if err:
        return {"ok": False, "error": err}
    lo, hi = sb.port_range(cfg, rec["uid"])
    return {"ok": True, "username": name, "ports": [lo, hi]}


# ---------- portal (web page actions for an existing account) ----------

PORTAL_KEYS = ("claude", "codex", "gh")


def box_portal(pw, args, input_text=None):
    try:  # runs the friend's own binaries (their PATH), so never wait on them forever
        r = as_user(pw, [sys.executable, "-I", os.path.join(sb.LIB_DIR, "box"), "_portal", *args],
                    input_text=input_text, timeout=300)
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": "that took too long; try again"}
    for line in reversed((r.stdout or "").splitlines()):
        try:
            out = json.loads(line)
        except ValueError:
            continue
        if isinstance(out, dict):
            return out
    return {"ok": False, "error": "internal error; ask the owner"}


def handle_portal(cfg, rid, req):
    ip = str(req.get("ip", ""))
    who = sb.tailscale_whois(ip) if ip else None
    # re-verify identity ourselves rather than trusting the web process
    if not who or who["id"] != str(req.get("ts_id")) or ip == sb.tailscale_ip4():
        return {"ok": False, "error": "could not verify your Tailscale identity"}
    name = next((n for n, r in sb.friend_users().items() if r.get("ts_id") == who["id"]), None)
    if not name:
        return {"ok": False, "error": "no account for this Tailscale login yet"}
    rec = sb.friend_users()[name]
    if rec.get("status", "active") != "active":
        return {"ok": False, "error": "your account is suspended; ask the owner"}
    pw = pwd.getpwnam(name)
    action, key = req.get("action"), req.get("key")
    if action == "status":
        return box_portal(pw, ["status"])
    if action == "t3":
        return box_portal(pw, ["t3-pair"])
    if action == "add-key":
        key, err = sb.validate_pubkey(str(req.get("sshkey", "")))
        return {"ok": False, "error": err} if err else box_portal(pw, ["add-key"], input_text=key + "\n")
    if key not in PORTAL_KEYS:
        return {"ok": False, "error": "unknown login"}
    if action == "login":
        return box_portal(pw, ["login-start", key] + (["console"] if req.get("console") else []))
    if action == "code":
        return box_portal(pw, ["login-code", key], input_text=str(req.get("code", ""))[:1000])
    if action == "check":
        return box_portal(pw, ["login-check", key])
    return {"ok": False, "error": "unknown action"}


def cmd_invite(cfg, a):
    """A message to paste to a friend. No terminal anywhere in it."""
    host = socket.gethostname()
    try:
        st = json.loads(run(["tailscale", "status", "--json", "--peers=false"], capture_output=True,
                            text=True, timeout=10).stdout)
