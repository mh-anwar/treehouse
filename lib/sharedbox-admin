def invite_admin(a):
    if a.revoke:
        gone = [r for h, r in sb.gate_records("invites") if h.startswith(a.revoke.lower()) and len(a.revoke) >= 6]
        n = gate_delete("invites", lambda h, r: h.startswith(a.revoke.lower()) and len(a.revoke) >= 6)
        links = [r for h, r in sb.gate_records("logins") if r.get("invite") and h.startswith(a.revoke.lower())
                 and len(a.revoke) >= 6]
        n += gate_delete("logins", lambda h, r: r.get("invite") and h.startswith(a.revoke.lower())
                         and len(a.revoke) >= 6)
        print(f"revoked {n} invite(s)")
        for r in links:
            print(f"note: the account {sb.printable(r.get('user', '?'))} still exists "
                  f"(sharedbox-admin remove {sb.printable(r.get('user', '?'))})")
        cfg = sb.load_config()
        # the email leaves the Access list too, unless it has an account or another open invite
        still = {str(r.get("email") or "").lower() for _, r in sb.gate_records("invites")}
        drop = {str(r.get("email") or "").lower() for r in gone} - still - {""}
        drop = {e for e in drop if not sb.email_taken(e)}
        if drop and not cf_access(cfg, remove=drop):
            print(f"removed from Cloudflare Access: {', '.join(sorted(drop))}")
        return
    rows = sorted(sb.gate_records("invites") + [(h, r) for h, r in sb.gate_records("logins") if r.get("invite")],
                  key=lambda x: x[1].get("created", 0))
    if not rows:
        print("no open invites")
    for h, r in rows:
        exp = float(r.get("expires", 0) or 0)
        state = "expired" if exp < time.time() else "expires " + time.strftime("%Y-%m-%d %H:%M", time.localtime(exp))
        mail = f"{sb.printable(r['email'])}  " if r.get("email") else ""
        acct = f"login link for {sb.printable(r.get('user', '?'))}  " if r.get("invite") else ""
        print(f"{h[:12]}  {state:<24} {acct}{mail}{sb.printable(r.get('note', ''))}")


