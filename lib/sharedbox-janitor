#!/usr/bin/python3 -I
"""sharedbox-janitor: periodic housekeeping (root).

  sharedbox-janitor run [--dry-run] [--user NAME]   measure disk, clean, publish usage + notices
  sharedbox-janitor tick [--dry-run]                 every 10 min: note what systemd-oomd stopped, end old boosts, start T3 Code for
                                                     scheduled tasks after a reboot, hackathon on/off, rule refresh
  sharedbox-janitor reboot [--dry-run]               the scheduled reboot (sharedbox-reboot.service): waits up
                                                     to 2 hours while a friend's agent is mid-turn, then reboots

Root only *reads* (du, /proc) and decides. Every deletion and archive move runs as the friend via
setpriv. Scope: friends' homes and their own files in /tmp, /var/tmp. Never SHARED_DIR (box shared code).
"""

import argparse
import grp
import json
import os
import pwd
import re
import selectors
import subprocess
import sys
import time

sys.path.insert(0, os.environ.get("SHAREDBOX_LIB", "/usr/lib/sharedbox"))
import sbcommon as sb  # noqa: E402
import sbrunning  # noqa: E402

STATE = os.path.join(sb.STATE_DIR, "janitor-state.json")
TICK_STATE = os.path.join(sb.STATE_DIR, "tick.json")
PASS_TIMEOUT = 900          # per user; a friend must not stall the whole run
PASS_MAX_OUT = 4 << 20      # reply cap; root never buffers more than this from a friend
REBOOT_WAIT_MAX = 2 * 3600  # a scheduled reboot waits at most this long for agents to finish their turn


def du(path):
    try:
        r = subprocess.run(["du", "-sx", "--block-size=1", path], capture_output=True, text=True, timeout=600)
    except subprocess.TimeoutExpired:  # a hung filesystem must not stall the whole cleanup run
        return None
    try:
        return int(r.stdout.split()[0])
    except (IndexError, ValueError):
        return None


def user_pass(pw, plan, cmd="_pass", check=None):
    env = {"HOME": pw.pw_dir, "USER": pw.pw_name, "LOGNAME": pw.pw_name,
           "PATH": "/usr/local/bin:/usr/bin:/bin", "XDG_RUNTIME_DIR": f"/run/user/{pw.pw_uid}",
           "SHAREDBOX_LIB": sb.LIB_DIR, "SHAREDBOX_SHARE": sb.SHARE_DIR,
           "SHAREDBOX_CONF": sb.CONF_PATH, "SHAREDBOX_STATE": sb.STATE_DIR}
    p = subprocess.Popen(
        ["setpriv", f"--reuid={pw.pw_uid}", f"--regid={pw.pw_gid}", "--init-groups",
         "--reset-env", "--", sys.executable, "-I", os.path.join(sb.LIB_DIR, "box"), cmd],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        env=env, cwd=pw.pw_dir)
    out, err = bytearray(), bytearray()
    deadline = time.monotonic() + PASS_TIMEOUT
    try:
        try:
            p.stdin.write(json.dumps(plan).encode())
            p.stdin.close()
        except BrokenPipeError:
            pass
        # bounded read of both pipes: the friend controls them (size, and how long they stay open)
        with selectors.DefaultSelector() as sel:
            sel.register(p.stdout, selectors.EVENT_READ, out)
            sel.register(p.stderr, selectors.EVENT_READ, err)
            while sel.get_map():
                left = deadline - time.monotonic()
                if left <= 0:
                    raise RuntimeError(f"timed out after {PASS_TIMEOUT}s")
                for key, _ in sel.select(left):
                    chunk = os.read(key.fd, 1 << 16)
                    if not chunk:
                        sel.unregister(key.fileobj)
                        continue
                    key.data.extend(chunk)
                    if key.data is err:
                        del err[:-1000]
                    elif len(out) > PASS_MAX_OUT:
                        raise RuntimeError(f"reply larger than {PASS_MAX_OUT} bytes")
        rc = p.wait(timeout=max(1, deadline - time.monotonic()))
    finally:
        if p.poll() is None:
            p.kill()
            p.wait()
        for f in (p.stdin, p.stdout, p.stderr):
            f.close()
    if rc != 0:
        raise RuntimeError(err.decode(errors="replace"))
    rep = json.loads(out)
    if not (check or valid_reply)(rep):
        raise RuntimeError("malformed reply")
    return rep


def _is_int(v):
    return type(v) is int


def _rows(v, required):
    """List of flat dicts (str/number/bool values) carrying `required` {key: type check}."""
    return isinstance(v, list) and all(
        isinstance(d, dict)
        and all(isinstance(k, str) and isinstance(x, (str, int, float)) for k, x in d.items())
        and all(chk(d.get(k)) for k, chk in required.items())
        for d in v)


def valid_reply(rep):
    """The reply comes from code running as the friend: check every field root uses."""
    is_str = lambda v: isinstance(v, str)  # noqa: E731
    return (isinstance(rep, dict) and _is_int(rep.get("freed")) and rep["freed"] >= 0
            and _rows(rep.get("deleted"), {"path": is_str, "reason": is_str, "bytes": _is_int})
            and _rows(rep.get("projects"), {"name": is_str})
            and _rows(rep.get("services", []), {"name": is_str, "state": is_str})
            and _rows(rep.get("archived", []), {"name": is_str, "path": is_str, "bytes": _is_int})
            and _rows(rep.get("archives", []), {"name": is_str, "until": _is_int}))


# ---------- tick (every 10 minutes) ----------
# A T3 that isn't running (after a reboot: its port is held by sb-t3.socket and the first connection starts it) is
# started if it has scheduled tasks on (`box _t3-wake`): T3 skips a fixed-time run it was down for.

def t3_running(uid):
    base = f"/sys/fs/cgroup/user.slice/user-{uid}.slice/user@{uid}.service"
    for cg in (f"{base}/app.slice/sb-t3.service", f"{base}/sb-t3.service"):
        for root, _, files in os.walk(cg):
            try:
                with open(os.path.join(root, "cgroup.procs")) as f:
                    if f.read().split():
                        return True
            except OSError:
                pass
    return False


def heal_provision():
    """If the request handler's path unit ever ends up failed (it once hit systemd's start limit under a burst of
    retries), nothing on the box answers joins, logins or `box shared` until root resets it: do that here."""
    for unit in ("sharedbox-provision.service", "sharedbox-provision.path"):
        r = subprocess.run(["systemctl", "is-failed", "--quiet", unit], check=False)
        if r.returncode == 0:
            subprocess.run(["systemctl", "reset-failed", unit], check=False)
            sb.log_event("self_heal", None, unit=unit)
    subprocess.run(["systemctl", "start", "sharedbox-provision.path"], check=False)


OOM_LOG = os.path.join(sb.STATE_DIR, "oom.jsonl")
OOM_CURSOR = os.path.join(sb.STATE_DIR, "oom.cursor")
OOM_DIR = os.path.join(sb.STATE_DIR, "oom")
OOM_RE = re.compile(r"Killed (/\S+) due to (memory pressure|memory used|swap)")


def oom_label(cg):
    """(user, what) for a cgroup systemd-oomd stopped: '/user.slice/user-1002.slice/.../docker-ID.scope'."""
    m = re.search(r"/user-(\d+)\.slice", cg)
    if not m:
        return None, cg.rsplit("/", 1)[-1]
    uid = int(m.group(1))
    try:
        pw = pwd.getpwuid(uid)
    except KeyError:
        return None, cg.rsplit("/", 1)[-1]
    unit = cg.rstrip("/").rsplit("/", 1)[-1]
    d = sbrunning.DOCKER_SCOPE_RE.match(unit)
    if d:
        meta = sbrunning._docker_meta(pw.pw_dir, d.group(1), uid)
        what = f"the container {meta.get('name') or d.group(1)[:12]}"
    else:
        kind, name, _ = sbrunning._unit_kind(unit, [])
        what = {"server": f"the server {name}", "agent": f"an {name.lower()}" if name[0] in "AEIOU" else
                f"a {name.lower()}", "terminal": f"a {name}", "t3": "T3 Code"}.get(kind, name)
    return pw.pw_name, what


def record_oom_kills():
    """What systemd-oomd stopped since the last tick, per account: oom.jsonl (box status tells their agents, the
    dashboard shows it) and an event."""
    # journalctl takes --since or --cursor-file, not both: the first run looks back 15 minutes, then the cursor
    # file is seeded from the journal's newest entry; later runs read only what came after it
    try:
        good = os.path.getsize(OOM_CURSOR) > 0  # an empty file would make journalctl replay everything
    except OSError:
        good = False
    seed = None
    if good:
        cmd = ["journalctl", "-u", "systemd-oomd", "-o", "cat", "--no-pager", f"--cursor-file={OOM_CURSOR}"]
    else:  # first run (or a broken file): look back 15 minutes; the cursor is taken first so nothing falls between
        s = subprocess.run(["journalctl", "-n", "1", "--show-cursor", "-o", "cat", "--no-pager"],
                           capture_output=True, text=True, timeout=60, check=False)
        cur = [ln[len("-- cursor: "):] for ln in s.stdout.splitlines() if ln.startswith("-- cursor: ")]
        seed = cur[-1].strip() if cur else None
        cmd = ["journalctl", "-u", "systemd-oomd", "-o", "cat", "--no-pager", "--since=-15min"]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=60, check=False)
    if r.returncode != 0:
        print(f"oom kills: journalctl failed: {(r.stderr or '').strip()[-300:]}", file=sys.stderr)
        if good:  # an unreadable cursor: start over next tick instead of failing forever
            os.unlink(OOM_CURSOR)
        return
    if seed:
        with open(OOM_CURSOR + ".tmp", "w") as f:
            f.write(seed)
        os.replace(OOM_CURSOR + ".tmp", OOM_CURSOR)
    for line in r.stdout.splitlines():
        m = OOM_RE.search(line)
        if not m:
            continue
        try:
            user, what = oom_label(m.group(1))
        except Exception as e:  # noqa: BLE001 - one odd record never loses the rest
            print(f"oom record: {e!r}", file=sys.stderr)
            user, what = None, "a process group"
        rec = {"ts": int(time.time()), "user": user, "what": sbrunning.clean(what, 120), "why": m.group(2)}
        # the website (group sharedbox) reads all; each account reads only its own file (container names are private)
        oom_append(OOM_LOG, rec, "sharedbox")
        if user:
            oom_append(os.path.join(OOM_DIR, f"{user}.jsonl"), rec, user)
        sb.log_event("oom_kill", user, what=rec["what"])
        print(f"systemd-oomd stopped {rec['what']} ({user})")


def oom_append(path, rec, group):
    os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
    try:
        with open(path) as f:
            lines = f.readlines()[-299:]
    except OSError:
        lines = []
    lines.append(json.dumps(rec) + "\n")
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.writelines(lines)
    try:
        gid = grp.getgrnam(group).gr_gid
    except KeyError:
        gid = 0
    os.chown(tmp, 0, gid)
    os.chmod(tmp, 0o640)
    os.replace(tmp, path)


def cmd_tick(cfg, a):
    if not a.dry_run:
        try:
            heal_provision()
        except Exception as e:  # noqa: BLE001
            print(f"heal provision: {e!r}", file=sys.stderr)
        try:
            record_oom_kills()
        except Exception as e:  # noqa: BLE001
            print(f"oom kills: {e!r}", file=sys.stderr)
        try:  # MEMORY_MAX=auto is written as bytes: after a RAM change (an upgrade), work the limits out again
            with open("/sys/fs/cgroup/user.slice/memory.max") as f:
                live = f.read().strip()
            if live != str(sb.auto_memory_max(cfg)):
                subprocess.run([os.path.join(sb.LIB_DIR, "sharedbox-admin"), "reapply"], capture_output=True,
                               timeout=300, check=False)
                print(f"memory limits re-applied (user.slice was {live}, now {sb.auto_memory_max(cfg)})")
        except (OSError, subprocess.SubprocessError) as e:
            print(f"memory limits: {e!r}", file=sys.stderr)
        for what, fn in (("hackathon reconcile", sb.hackathon_reconcile), ("boosts", sb.boost_reconcile)):
            try:
                done = fn(cfg)
                if done:
                    print(f"hackathon mode {done}")
            except Exception as e:  # noqa: BLE001 - one part never stops the rest
                print(f"{what}: {e!r}", file=sys.stderr)
    state = sb.read_json(TICK_STATE, {}) or {}
    users = sb.friend_users()
    for name, rec in sorted(users.items()):
        if a.dry_run:
            continue
        try:
            pw = pwd.getpwnam(name)
            if t3_running(rec["uid"]) or not os.path.exists(
                    os.path.join(pw.pw_dir, ".config", "systemd", "user", "sb-t3.socket")):
                continue
            rep = user_pass(pw, {}, "_t3-wake",
                            check=lambda r: isinstance(r, dict) and isinstance(r.get("woke"), bool))
            if rep["woke"]:
                print(f"{name}: woke T3 Code for scheduled tasks")
        except Exception as e:  # one friend's trouble must not stop the others
            print(f"{name}: t3 wake error: {str(e)[-500:]!r}", file=sys.stderr)
    if not a.dry_run:
        refresh_presence(cfg, users)
        refresh_rules(cfg, users, state)
        sb.write_json(TICK_STATE, state, mode=0o600)


def refresh_presence(cfg, users):
    """`box where`'s rounded "active on the box" hint: newest agent session change per account."""
    try:
        import sbwhere
        homes = {}
        for name in set(users) | set(sb.admin_users(cfg)):
            try:
                homes[name] = pwd.getpwnam(name).pw_dir
            except KeyError:
                pass
        sbwhere.refresh_activity(homes)
    except Exception as e:  # noqa: BLE001 - never stop the tick
        print(f"presence: {e!r}", file=sys.stderr)


def boot_id():
    try:
        with open("/proc/sys/kernel/random/boot_id") as f:
            return f.read().strip()
    except OSError:
        return ""


def refresh_rules(cfg, users, state):
    """Agents read the reboot notice from their rule files, which the 6-hourly janitor pass rewrites. Rewrite them
    as soon as the reboot picture changes instead: a reboot got scheduled (updates at 03:00 for 04:00), was
    postponed, or just happened (new boot id). Otherwise a session after a reboot is told the box 'will reboot'
    at a time already past. Cheap: nothing runs unless the picture changed."""
    rb = sb.reboot_info(cfg)
    soon = bool(rb["at"]) and rb["at"] - time.time() < 12 * 3600  # `box` bakes a scheduled reboot in 12 h ahead
    key = [boot_id(), rb["at"] if rb["why"] == "updates" or rb["postponed"] else None, rb["postponed"], soon]
    meta = state.setdefault("_rules", {})
    if meta.get("key") == key:
        return
    names = set(users) | set(sb.admin_users(cfg))
    owner = sb.owner_account(cfg)
    if owner:
        names.add(owner.pw_name)
    for name in sorted(names):
        try:
            user_pass(pwd.getpwnam(name), {}, "_sync-rules",
                      check=lambda r: isinstance(r, dict) and r.get("synced") is True)
        except Exception as e:  # one account's trouble must not stop the others
            print(f"{name}: rule refresh error: {str(e)[-300:]!r}", file=sys.stderr)
    meta["key"] = key


# ---------- archive warnings ----------

def archive_warning(cfg, name, rec, st, projects, dry):
    """Email the friend once per project when it's WARN_DAYS from being archived."""
    due = {p["name"]: p["delete_on"] for p in projects if p.get("delete_on")}
    warned = {k: v for k, v in (st.get("warned") or {}).items() if k in due and abs(due[k] - v) < 86400}
    new = sorted((n for n in due if n not in warned), key=lambda n: due[n])
    email = str((rec or {}).get("email") or "").strip()
    if not new or not email or "@" not in email:
        st["warned"] = warned
        return
    days = sb.cfg_int(cfg, "ARCHIVE_DAYS")
    lines = "\n".join(f"  - ~/{n}  (on {time.strftime('%a %b %d', time.localtime(due[n]))})" for n in new)
    who = sb.brand_host(cfg)
    body = (f"Hi {name},\n\nThese projects on {who} haven't been touched in a while, so they'll be archived soon:\n\n"
            f"{lines}\n\nEverything in them is pushed to git, so nothing is lost. Archived projects can also be "
            f"restored for {days} days (ask your agent: \"restore my project NAME\", or run `box restore NAME`).\n\n"
            "To keep one where it is, open it in T3 Code and ask your agent anything about it.\n")
    if dry:
        print(f"{name}: would email {email}: archive warning for {', '.join(new)}")
        return
    try:
        import sbmail
        if sbmail.configured(cfg):
            sbmail.send(cfg, f"Your projects on {sb.brand(cfg)} will be archived soon", body, to=email)
            sb.log_event("archive_warned", name, projects=new)
        else:
            return  # not marked as warned: they get the email once mail is set up
    except Exception as e:  # mail trouble must not stop the cleanup
        print(f"{name}: archive warning email failed: {e!r}", file=sys.stderr)
        return
    warned.update({n: due[n] for n in new})
    st["warned"] = warned


def cmd_run(cfg, a):
    reg = sb.registry()
    users = sb.friend_users(reg)
    state = sb.read_json(STATE, {}) or {}
    now = int(time.time())
    box = sb.box_load()
    free_pct = 100 * box["disk_free"] / box["disk_total"]
    low = free_pct < float(cfg["DISK_LOW_FREE_PCT"])
    critical = free_pct < float(cfg["DISK_CRITICAL_FREE_PCT"])
    scale = 0.5 if low else 1.0
    grace = 0 if critical else sb.cfg_int(cfg, "OVER_BUDGET_GRACE_HOURS") * 3600
    if low:
        sb.log_event("disk_pressure", None, free_pct=round(free_pct, 1), critical=critical)

    usage_out = {"generated": now, "free_pct": round(free_pct, 1), "users": {}}
    prev = sb.read_json(sb.USAGE, {}) or {}
    for name, rec in sorted(users.items()):
        if a.user and name != a.user:
            usage_out["users"][name] = prev.get("users", {}).get(name, {})
            continue
        try:
            pw = pwd.getpwnam(name)
            lim = sb.user_limits(cfg, rec)
            budget = int(float(lim["DISK_BUDGET_GB"]) * (1 << 30))
            used = du(pw.pw_dir) or 0
            st = state.setdefault(name, {})
            over = used > budget
            if over and not st.get("over_since"):
                st["over_since"] = now
                sb.log_event("over_budget", name, used=used, budget=budget)
            elif not over:
                st.pop("over_since", None)
            deadline = st["over_since"] + grace if over else None
            plan = {
                "usage": used, "budget": budget, "over": over, "over_deadline": deadline,
                "over_budget_delete": bool(over and now >= deadline),
                "force_caches": critical,
                "project_ttl_days": sb.cfg_int(cfg, "PROJECT_TTL_DAYS") * scale,
                "cache_ttl_days": sb.cfg_int(cfg, "CACHE_TTL_DAYS") * scale,
                "tmp_ttl_days": sb.cfg_int(cfg, "TMP_TTL_DAYS"),
                "warn_days": sb.cfg_int(cfg, "WARN_DAYS"),
                "archive_days": sb.cfg_int(cfg, "ARCHIVE_DAYS"),
                "dry_run": a.dry_run, "box": box,
            }
            rep = user_pass(pw, plan)
            for d in rep.get("archived", []):
                if a.dry_run:
                    print(f"{name}: would archive {sb.human(d['bytes']):>8} ~/{sb.printable(d['name'])}")
                else:
                    sb.log_event("archived", name, project=d["name"], bytes=d["bytes"])
            archive_warning(cfg, name, rec, st, rep["projects"], a.dry_run)
            if rep["freed"]:
                used = max(0, used - rep["freed"]) if not a.dry_run else used
            for d in rep["deleted"]:
                if a.dry_run:
                    print(f"{name}: would delete {sb.human(d['bytes']):>8} {sb.printable(d['path'])}  "
                          f"({sb.printable(d['reason'])})")
                elif d["bytes"] > 50 << 20 or "project" in d["reason"]:
                    sb.log_event("deleted", name, path=d["path"], bytes=d["bytes"], reason=d["reason"])
            usage_out["users"][name] = {
                "disk": used, "budget": budget, "over": over, "over_deadline": deadline,
                "projects": len(rep["projects"]),
                "pending_deletions": [p["name"] for p in rep["projects"] if p.get("delete_on")],
                "archives": rep.get("archives", []),
                "services": rep.get("services", []), "freed": rep["freed"],
            }
        except Exception as e:  # one broken home (or hostile reply) must not stop the others
            # events.jsonl is world-readable: keep the friend-controlled error text in the journal only
            sb.log_event("janitor_error", name, error=type(e).__name__)
            print(f"{name}: error: {str(e)[-1000:]!r}", file=sys.stderr)
    owner_cache_passes(cfg, users, a)
    if not a.dry_run:
        sb.write_json(STATE, state, mode=0o600)
        sb.write_json(sb.USAGE, usage_out, mode=0o644)
    else:
        print(json.dumps({k: {kk: vv for kk, vv in v.items() if kk != "services"}
                          for k, v in usage_out["users"].items()}, indent=2))


def owner_cache_passes(cfg, users, a):
    """The owner's own accounts get no budget and no project archiving, but caches nothing has used for
    CACHE_TTL_DAYS (and what uv/pnpm can prune) still go: they otherwise grow without end."""
    names = set(sb.admin_users(cfg))
    owner = sb.owner_account(cfg)
    if owner:
        names.add(owner.pw_name)
    plan = {"cache_ttl_days": sb.cfg_int(cfg, "CACHE_TTL_DAYS"), "tmp_ttl_days": sb.cfg_int(cfg, "TMP_TTL_DAYS"),
            "dry_run": a.dry_run}
    for name in sorted(names - set(users)):
        if a.user and name != a.user:
            continue
        try:
            rep = user_pass(pwd.getpwnam(name), plan, "_cache-pass",
                            check=lambda r: isinstance(r, dict) and isinstance(r.get("deleted"), list))
            for d in rep["deleted"]:
                if a.dry_run:
                    print(f"{name}: would delete {sb.human(d.get('bytes', 0)):>8} {sb.printable(str(d.get('path')))}  "
                          f"({sb.printable(str(d.get('reason')))})")
            if rep.get("freed", 0) > 50 << 20 and not a.dry_run:
                sb.log_event("caches_pruned", name, bytes=rep["freed"])
        except Exception as e:  # one account's trouble must not stop the rest of the pass
            print(f"{name}: cache pass error: {str(e)[-500:]!r}", file=sys.stderr)


# ---------- scheduled reboot ----------

def cmd_reboot(cfg, a):
    """The SCHEDULED_REBOOT_DAYS reboot. While a friend's agent is mid-turn (claude/codex/opencode using CPU) it
    waits, up to REBOOT_WAIT_MAX, then reboots anyway with 5 minutes' warning. Reboots that security updates
    need are unattended-upgrades' and never wait here."""
    if cfg.get("HACKATHON") == "1":
        print("hackathon mode is on: skipping the scheduled reboot")
        return
    start = time.time()
    deadline = start + REBOOT_WAIT_MAX
    uids = {rec["uid"]: n for n, rec in sb.friend_users().items()}
    told = False
    while True:
        busy = sb.busy_agents(set(uids), seconds=5) if uids else {}
        if not busy or time.time() >= deadline:
            break
        users = sorted({uids.get(u, "?") for u, _ in busy.values()})
        if not told:
            sb.log_event("reboot_postponed", None, users=users, until=int(deadline))
            if not a.dry_run:
                sb.write_json(sb.REBOOT_STATE, {"state": "waiting", "since": int(start), "deadline": int(deadline),
                                                "users": len(users)}, mode=0o644)
            print(f"waiting for agents to finish ({', '.join(users)}), until "
                  f"{time.strftime('%H:%M', time.localtime(deadline))} at the latest", flush=True)
            told = True
        if a.dry_run:
            break
        time.sleep(60)
    sched = sb.reboot_schedule_text(cfg)
    msg = (f"{sb.brand(cfg)}: scheduled reboot in 5 minutes" + (f"; it reboots {sched}" if sched else "")
           + ". Your servers (box serve) and T3 Code come back by themselves.")
    cmd = ["/sbin/shutdown", "-r", "+5", msg]
    if a.dry_run:
        print("would run: " + " ".join(cmd))
        return
    sb.write_json(sb.REBOOT_STATE, {"state": "rebooting", "since": int(start), "ts": int(time.time()),
                                    "waited": int(time.time() - start)}, mode=0o644)
    sb.log_event("reboot_scheduled", None, waited_min=int((time.time() - start) // 60))
    sys.exit(subprocess.run(cmd).returncode)


def main():
    if os.geteuid() != 0:
        sys.exit("sharedbox-janitor: must run as root")
    cfg = sb.load_config()
    p = argparse.ArgumentParser(prog="sharedbox-janitor", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    s = p.add_subparsers(dest="cmd", required=True)
    x = s.add_parser("run"); x.add_argument("--dry-run", action="store_true")
    x.add_argument("--user"); x.set_defaults(fn=cmd_run)
    for n in ("tick", "t3-naps"):  # t3-naps: the old name, until install.sh swaps the timer
        x = s.add_parser(n); x.add_argument("--dry-run", action="store_true"); x.set_defaults(fn=cmd_tick)
    x = s.add_parser("reboot"); x.add_argument("--dry-run", action="store_true"); x.set_defaults(fn=cmd_reboot)
    a = p.parse_args()
    a.fn(cfg, a)


if __name__ == "__main__":
    main()
