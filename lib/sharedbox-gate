#!/usr/bin/python3 -I
"""sharedbox-gate: the public front door, so friends need nothing but a browser.

Tailscale Funnel terminates TLS for https://<box>.<tailnet>.ts.net and forwards to this process on
127.0.0.1:GATE_PORT. Funnel gives one hostname, so routing is by path and cookie:

  /i/<token>        invite signup        \\
  /login/<token>    one-time device login  > sharedbox-web (private unix socket), which renders the pages
  /_box/...         the friend's portal   /  and asks root to verify tokens / mint sessions
  /s/NAME/...       a group server (box shared), for any signed-in friend or the owner      \\  reverse proxy with
  /p/PORT/...       one of the signed-in friend's own `box serve` ports (their range), or a  > the prefix stripped
                    group server's port                                                    /  (X-Forwarded-Prefix)
  anything else     logged in: reverse proxy (HTTP + WebSocket) to that friend's own T3 Code
                    logged out: a landing page ("ask your friend for an invite link")

Runs unprivileged (the sharedbox user). It only reads session records (root writes them, hashed), so
it can't create logins; every action is re-verified by root. Stdlib asyncio, no dependencies.

PUBLIC_MODE=cloudflare: Cloudflare Access (login by email code) sits in front, and cloudflared forwards to this
process instead of Funnel. Then every request must carry a valid Access JWT (Cf-Access-Jwt-Assertion, or the
CF_Authorization cookie) for CF_ACCESS_AUD, checked here against the team's signing keys; anything else gets
403, which also stops local accounts from skipping Access via 127.0.0.1. Identity is the token's email: the
friend whose registry email it is gets their T3 and portal, with no cookies or device links of ours. A signed-in
email without an account only sees invite signups bound to that email, or "ask your friend for an invite".
"""

import asyncio
import os
import re
import secrets
import sys
import time
import urllib.parse
from collections import deque

sys.path.insert(0, os.environ.get("SHAREDBOX_LIB", "/usr/lib/sharedbox"))
import sbcommon as sb  # noqa: E402
import sbshared  # noqa: E402  (read side only: the registry root writes, 0644)

CFG = sb.load_config()
PUBLIC = sb.public_url(CFG)
CF = sb.public_mode(CFG) == "cloudflare"
VERIFIER = None             # sbaccess.Verifier, set in main() in cloudflare mode
CF_CACHE_SECS = 30          # a verified token is re-checked (expiry, account) after this long
PUBLIC_HOST = urllib.parse.urlsplit(PUBLIC).netloc.lower() if PUBLIC else ""
WEB_SOCK = os.environ.get("SHAREDBOX_WEB_SOCK", "/run/sharedbox-web/gate.sock")
COOKIE = sb.SESSION_COOKIE
SESSION_TTL = sb.cfg_int(CFG, "SESSION_DAYS") * 86400
MAX_HEAD = 64 << 10           # request/response head limit
HEAD_TIMEOUT = 30             # first request on a connection
IDLE_TIMEOUT = 75             # keep-alive: waiting for the next request
CONNECT_TIMEOUT = 10
RESPONSE_TIMEOUT = 600        # backend: time to the response head (T3 may long-poll)
MAX_CONNS = 2048
SESSION_CACHE_SECS = 5        # revocation takes effect within this long (open WebSockets: WS_RECHECK)
WS_RECHECK = 30

TOKEN_NAME = re.compile(rb"[!#$%&'*+.^_`|~0-9A-Za-z-]+")
REQUEST_LINE = re.compile(r"([A-Z]{1,20}) (/[^ ]*) (HTTP/1\.[01])")
STATUS_LINE = re.compile(rb"HTTP/1\.[01] ([0-9]{3})(?: [^\r\n]*)?")
HOP = {"connection", "keep-alive", "proxy-connection", "te", "trailer", "upgrade", "transfer-encoding",
       "content-length", "host", "proxy-authorization", "proxy-authenticate", "expect"}
# never let a client speak for the gate, Tailscale or a previous proxy
STRIP_PREFIXES = ("x-sharedbox-", "tailscale-", "x-forwarded-")
STRIP = HOP | {"forwarded", "x-real-ip", "cookie"}


class HTTPError(Exception):
    def __init__(self, code, msg=""):
        super().__init__(msg)
        self.code, self.msg = code, msg


# ---------- small caches ----------

_users = (0.0, {})
_ts_ip = (0.0, None)
_sessions = {}     # sha256 -> (checked_at, (user, record, hash) | None)
_refreshing = {}   # sha256 -> monotonic time of the last refresh request
_rate = {}         # bucket -> deque[timestamps]
_cf_tokens = {}    # sha256(jwt) -> (checked_at, claims | None)
_shared = (0.0, {})
_t3_seen = {}      # user -> monotonic time we last touched T3_SEEN/<user>
T3_SEEN_EVERY = 300


def t3_seen(user):
    """Note that `user` is using their T3 Code (the janitor stops T3 servers nobody used for T3_IDLE_DAYS).
    At most one touch per user every few minutes; never fails a request."""
    now = time.monotonic()
    if user == OWNER or now - _t3_seen.get(user, -T3_SEEN_EVERY) < T3_SEEN_EVERY:
        return
    _t3_seen[user] = now
    if not sb.USERNAME_RE.match(user or ""):
        return
    try:
        fd = os.open(os.path.join(sb.T3_SEEN, user), os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
        try:
            os.utime(fd)
        finally:
            os.close(fd)
    except OSError:
        pass


def users(max_age=SESSION_CACHE_SECS):
    global _users
    if time.monotonic() - _users[0] > max_age:
        _users = (time.monotonic(), sb.friend_users())
    return _users[1]


def backend_host():
    """The address friends' T3 listens on. `box t3` binds it to this box's Tailscale IPv4 (local, so
    reachable from here); GATE_BACKEND_HOST can name another address."""
    global _ts_ip
    h = CFG.get("GATE_BACKEND_HOST") or "tailscale"
    if h != "tailscale":
        return h
    if time.monotonic() - _ts_ip[0] > 60 or not _ts_ip[1]:
        _ts_ip = (time.monotonic(), sb.tailscale_ip4())
    return _ts_ip[1]


def backend_for(user):
    """(host, port) of `user`'s T3 Code.

    Today every account lives on this box: T3 listens on the first port of the user's block.
    Multi-box hook: a future BOXES= setting in sharedbox.conf (name=tailnet-ip pairs for the owner's other
    machines) plus a "box" field in the user's registry record would pick the machine here, e.g.
        host = boxes()[rec["box"]] if rec.get("box") else backend_host()
    The other box's T3 already listens on its tailnet IP, so this gate stays the single public front door.
    """
    if user == OWNER:
        port = CFG.get("OWNER_T3_PORT", "").strip()
        return (backend_host(), int(port)) if port.isdigit() else (None, None)
    rec = users().get(user)
    if not rec:
        return None, None
    lo, _ = sb.port_range(CFG, rec["uid"])
    return backend_host(), lo


# ---------- public links to friends' servers: /s/NAME/ (group) and /p/PORT/ (own) ----------

APP_PATH = re.compile(r"/([sp])/([^/?]*)(/[^?]*)?(\?.*)?", re.S)
SHARED_NAME = re.compile(r"[a-z][a-z0-9-]{1,30}")
APP_PORT = re.compile(r"[1-9][0-9]{0,4}")
# cookies an app behind /s/ or /p/ never sees or sets: ours, Cloudflare's, and the visitor's T3 Code session
APP_COOKIE_DENY = re.compile(r"(?i)(t3|cf_|__cf|__host-sbgate$)")
# headers an app could use to reach outside its own prefix on this shared origin
APP_RESP_DENY = {"service-worker-allowed", "clear-site-data"}


def shared_servers():
    """Group servers: name -> port (int), from the registry root writes. Cached briefly."""
    global _shared
    if time.monotonic() - _shared[0] > SESSION_CACHE_SECS:
        reg = sbshared.registry()
        _shared = (time.monotonic(), {n: r["port"] for n, r in reg.items()
                                      if isinstance(r.get("port"), int) and not isinstance(r["port"], bool)
                                      and 0 < r["port"] < 65536})
    return _shared[1]


def app_route(target):
    """("s"|"p", key, prefix, rest) for /s/NAME/... or /p/PORT/... (rest = path+query to forward, or None
    when the trailing slash is missing), ("bad", ...) for a malformed key under /s/ or /p/, else None."""
    m = APP_PATH.fullmatch(target)
    if not m:
        return None
    kind, key, rest, query = m.groups()
    if not (SHARED_NAME if kind == "s" else APP_PORT).fullmatch(key):
        return ("bad", key, None, None)
    prefix = f"/{kind}/{key}"
    return (kind, key, prefix, None if rest is None else rest + (query or ""))


def app_port(kind, key, user, owner):
    """(port, None) if this identity may open /s/NAME or /p/PORT, else (None, (code, title, text)).
    Group servers: any active friend or the owner. A port: the friend's own range except its first port
    (their T3 Code, which has its own front door at /), or any group server's port."""
    e = key  # keys are [a-z0-9-] only (checked by app_route): safe in HTML as is
    group = shared_servers()
    if not sb.cfg_bool(CFG, "SHARED_PUBLIC_LINKS"):
        group_off = (403, "Open it over Tailscale", "Group servers aren't on the public site: anyone in the group "
                     "can change their code, so they only open over Tailscale (see <a href='/_box/me'>your page</a>).")
        if kind == "s":
            return None, group_off
    if kind == "s":
        if key not in group:
            return None, (404, "No such server", f"There's no group server called <b>{e}</b>. "
                          "See <a href='/_box/me'>your page</a> for the list.")
        if not (user or owner):
            return None, (403, "Not allowed", "Group servers are for members of this box. "
                          "Ask your friend for an invite link.")
        return group[key], None
    port = int(key)
    if port in group.values():
        if (user or owner) and sb.cfg_bool(CFG, "SHARED_PUBLIC_LINKS"):
            return port, None
        return None, (403, "Open it over Tailscale", "That's a group server; group servers only open over Tailscale.")
    if user and user != OWNER:
        rec = users().get(user)
        if rec:
            lo, hi = sb.port_range(CFG, rec["uid"])
            if lo < port <= hi:
                return port, None
            if port == lo:
                return None, (403, "Not here", "That's your T3 Code's port: open it at <a href='/'>the start page</a>.")
    return None, (403, "Not yours", f"Port {e} isn't one of your servers, so you can't open it here. "
                  "Your own servers and the group's are listed on <a href='/_box/me'>your page</a>.")


def app_cookies(headers):
    """The visitor's cookies an app may see: none of ours, Cloudflare's or T3 Code's."""
    return "; ".join(p.strip() for v in values(headers, "cookie") for p in v.split(";")
                     if p.strip() and not APP_COOKIE_DENY.match(p.strip().partition("=")[0].strip()))


def app_location(v, prefix, port):
    """Keep an app's redirects inside its prefix: "/x" -> "/s/NAME/x"; absolute URLs to this site or to the
    app's own backend address become prefixed public URLs. Anything else (another site) is left alone."""
    v = v.strip()
    try:
        u = urllib.parse.urlsplit(v)
    except ValueError:
        return v
    if u.scheme or u.netloc:
        hosts = {PUBLIC_HOST, PUBLIC_HOST + ":443", f"{backend_host()}:{port}", f"127.0.0.1:{port}",
                 f"localhost:{port}"}
        if u.scheme not in ("http", "https", "") or u.netloc.lower() not in hosts:
            return v
        path = u.path or "/"
        if not (path == prefix or path.startswith(prefix + "/")):
            path = prefix + path
        return PUBLIC + urllib.parse.urlunsplit(("", "", path, u.query, u.fragment))
    if v.startswith("/") and not v.startswith("//") and not (v == prefix or v.startswith((prefix + "/", prefix + "?"))):
        return prefix + v
    return v


def app_set_cookie(v, prefix):
    """An app's Set-Cookie, confined to its prefix (Path forced under it, no Domain), or None to drop it."""
    parts = [p.strip() for p in v.split(";")]
    name = parts[0].partition("=")[0].strip()
    if not name or APP_COOKIE_DENY.match(name) or name.lower().startswith(("__host-", "__secure-")):
        return None  # __Host- demands Path=/; never let an app shadow a site-wide cookie
    path, attrs = "/", []
    for p in parts[1:]:
        k, _, val = p.partition("=")
        if k.strip().lower() == "path":
            path = val.strip() if val.strip().startswith("/") else "/"
        elif k.strip().lower() != "domain" and p:
            attrs.append(p)
    if not (path == prefix or path.startswith(prefix + "/")):
        path = prefix + path
    return "; ".join([parts[0], f"Path={path}"] + attrs)


def app_resp_headers(rheaders, prefix, port):
    out = []
    for n, v in rheaders:
        ln = n.lower()
        if ln in APP_RESP_DENY:
            continue
        if ln in ("location", "content-location"):
            v = app_location(v, prefix, port)
        elif ln == "set-cookie":
            v = app_set_cookie(v, prefix)
            if v is None:
                continue
        out.append((n, v))
    return out


def session_for(secret):
    """(user, record, hash) for a live session of an active friend, else None. Cached briefly."""
    if not secret or not sb.TOKEN_RE.fullmatch(secret):
        return None
    h = sb.token_hash(secret)
    now = time.monotonic()
    c = _sessions.get(h)
    if c and now - c[0] < SESSION_CACHE_SECS:
        return c[1]
    rec, _ = sb.gate_lookup("sessions", secret)
    res = (rec["user"], rec, h) if rec and sb.active_friend(rec.get("user"), users()) else None
    if len(_sessions) > 20000:
        _sessions.clear()
    _sessions[h] = (now, res)
    return res


async def cf_claims(token):
    """Verified Access claims for `token`, else None. Signature checks are cached briefly by token hash;
    expiry is re-checked on every hit."""
    if not token:
        return None
    h = sb.token_hash(token)
    now = time.monotonic()
    c = _cf_tokens.get(h)
    if not (c and now - c[0] < CF_CACHE_SECS):
        import sbaccess
        try:
            claims = await asyncio.to_thread(VERIFIER.verify, token)
        except (sbaccess.InvalidToken, ValueError):
            claims = None
        if len(_cf_tokens) > 20000:
            _cf_tokens.clear()
        c = _cf_tokens[h] = (now, claims)
    claims = c[1]
    if claims and time.time() >= float(claims["exp"]) + 60:
        return None
    return claims


def welcome_pending(user):
    """An account made at invite time that hasn't seen its portal yet: its first visit to / goes there
    (to log in to an AI) instead of straight into an empty T3. Root clears the flag on the first portal visit."""
    if not (users().get(user) or {}).get("welcome"):
        return False
    return bool((sb.registry().get("users", {}).get(user) or {}).get("welcome"))  # fresh, not the cache


OWNER = "\0owner"  # never a valid username


def owner_t3(email):
    """CF_OWNER_EMAILS may reach the owner's own T3 Code (on this box, OWNER_T3_PORT) when that is set."""
    return (CFG.get("OWNER_T3_PORT", "").strip().isdigit()
            and str(email or "").strip().lower() in sb.owner_emails(CFG))


OPEN_COOKIE = "tb_open"  # set for a minute by /_box/app ("Open T3 in browser"): this load of / goes to T3


def has_cookie(headers, name):
    return any(p.strip().partition("=")[0] == name for v in values(headers, "cookie") for p in v.split(";"))


def opened_from_outside(headers):
    """A top-level page load that didn't come from this site (typed URL, bookmark, link elsewhere)."""
    dest = values(headers, "sec-fetch-dest")
    site = values(headers, "sec-fetch-site")
    if dest and dest[0].strip().lower() != "document":
        return False
    return not site or site[0].strip().lower() in ("none", "cross-site")


def opened_as_page(headers):
    """A top-level page load (not an API call or asset fetch from inside T3)."""
    dest = values(headers, "sec-fetch-dest")
    return not dest or dest[0].strip().lower() == "document"


def has_t3_session(headers):
    """Does the browser carry a T3 Code session cookie (t3_session_<id>)? Without one T3 asks for a pairing token."""
    return any(p.strip().startswith("t3_session_") for v in values(headers, "cookie") for p in v.split(";"))


def cf_user(email):
    return sb.user_by_email(email, users())[0]


def cf_identity(email):
    """The friend account for this email, else OWNER for the owner's own T3 (T3's pairing is the second lock).
    An unknown email re-reads the registry: someone who just signed up through an invite is sent straight to their
    dashboard and may click "Open my T3 Code" before the cache would expire. (Only emails Cloudflare Access lets in
    get here, so this is rare and cheap.)"""
    user = cf_user(email) or (OWNER if owner_t3(email) else None)
    if not user:
        users(max_age=0)
        user = cf_user(email)
    return user


def rate_limited(bucket, n, window=600):
    q = _rate.get(bucket)
    if q is None:
        if len(_rate) > 50000:
            _rate.clear()
        q = _rate[bucket] = deque(maxlen=n + 1)
    now = time.monotonic()
    while q and now - q[0] > window:
        q.popleft()
    if len(q) >= n:
        return True
    q.append(now)
    return False


async def spool(req, wait=30):
    """Ask the root provisioner (same spool sharedbox-web uses)."""
    rid = secrets.token_hex(12)
    await asyncio.to_thread(sb.write_json, os.path.join(sb.SPOOL, f"req-{rid}.json"),
                            dict(req, ts=int(time.time())), 0o600)
    res_path = os.path.join(sb.SPOOL, f"res-{rid}.json")
    deadline = time.monotonic() + wait
    while time.monotonic() < deadline:
        await asyncio.sleep(0.25)
        res = sb.read_json(res_path)
        if res is not None:
            try:
                os.unlink(res_path)
            except OSError:
                pass
            return res
    return {"ok": False}


def maybe_refresh(secret, sess):
    """Sliding expiry: once a day of use, ask root to push the session's expiry out again."""
    user, rec, h = sess
    if float(rec.get("expires", 0)) - time.time() > SESSION_TTL - 86400:
        return False
    if time.monotonic() - _refreshing.get(h, -1e9) < 3600:
        return False
    _refreshing[h] = time.monotonic()
    asyncio.get_running_loop().create_task(spool({"action": "session-refresh", "session": secret}))
    return True


def session_cookie(secret, max_age=SESSION_TTL):
    return (f"{COOKIE}={secret}; Path=/; Max-Age={max_age}; HttpOnly; Secure; SameSite=Lax")


# ---------- HTTP parsing ----------

async def read_head(reader, timeout):
    try:
        data = await asyncio.wait_for(reader.readuntil(b"\r\n\r\n"), timeout)
    except asyncio.IncompleteReadError as e:
        if e.partial.strip():
            raise HTTPError(400, "incomplete request") from None
        return None
    except asyncio.LimitOverrunError:
        raise HTTPError(431, "request head too large") from None
    except (asyncio.TimeoutError, ConnectionError):
        return None
    return data


def parse_headers(lines):
    out = []
    for raw in lines:
        if not raw or raw[:1] in b" \t" or b"\r" in raw or b"\n" in raw or b"\0" in raw:
            raise HTTPError(400, "bad header line")  # no obs-fold, no bare CR/LF (request smuggling)
        name, sep, val = raw.partition(b":")
        if not sep or not TOKEN_NAME.fullmatch(name):
            raise HTTPError(400, "bad header name")
        out.append((name.decode("latin-1"), val.strip(b" \t").decode("latin-1")))
    return out


def values(headers, name):
    return [v for n, v in headers if n.lower() == name]


def tokens(headers, name):
    return {t.strip().lower() for v in values(headers, name) for t in v.split(",") if t.strip()}


def body_framing(headers, response=False):
    """("chunked", None) | ("length", n) | ("none", 0) | ("close", None). Ambiguity is an error."""
    te = [t.strip().lower() for v in values(headers, "transfer-encoding") for t in v.split(",") if t.strip()]
    cl = values(headers, "content-length")
    if te:
        if cl and not response:
            raise HTTPError(400, "both Content-Length and Transfer-Encoding")
        if te[-1] == "chunked":
            if te != ["chunked"] and not response:
                raise HTTPError(501, "unsupported transfer coding")
            return "chunked", None
        if response:
            return "close", None
        raise HTTPError(501, "unsupported transfer coding")
    if cl:
        vals = {v.strip() for c in cl for v in c.split(",")}
        if len(vals) != 1 or not next(iter(vals)).isdigit() or len(next(iter(vals))) > 15:
            raise HTTPError(400 if not response else 502, "bad Content-Length")
        return "length", int(next(iter(vals)))
    return ("close", None) if response else ("none", 0)


async def copy_exact(reader, writer, n):
    while n > 0:
        chunk = await reader.read(min(n, 65536))
        if not chunk:
            raise asyncio.IncompleteReadError(b"", n)
        n -= len(chunk)
        writer.write(chunk)
        await writer.drain()


async def copy_chunked(reader, writer, decode=False):
    """Re-frame a chunked body (extensions and trailers dropped). decode=True writes only the data."""
    while True:
        line = await reader.readuntil(b"\r\n")
        size_s = line[:-2].split(b";", 1)[0].strip()
        if not re.fullmatch(rb"[0-9A-Fa-f]{1,15}", size_s):
            raise HTTPError(400, "bad chunk")
        size = int(size_s, 16)
        if size == 0:
            while (await reader.readuntil(b"\r\n")) != b"\r\n":
                pass  # trailers
            if not decode:
                writer.write(b"0\r\n\r\n")
            await writer.drain()
            return
        if not decode:
            writer.write(b"%x\r\n" % size)
        await copy_exact(reader, writer, size)
        if await reader.readexactly(2) != b"\r\n":
            raise HTTPError(400, "bad chunk")
        if not decode:
            writer.write(b"\r\n")


async def copy_to_eof(reader, writer):
    while True:
        chunk = await reader.read(65536)
        if not chunk:
            return
        writer.write(chunk)
        await writer.drain()


# ---------- responses made by the gate itself ----------

REASONS = {200: "OK", 303: "See Other", 308: "Permanent Redirect", 400: "Bad Request", 401: "Unauthorized", 403: "Forbidden", 404: "Not Found",
           421: "Misdirected Request",
           429: "Too Many Requests", 431: "Request Header Fields Too Large", 501: "Not Implemented",
           502: "Bad Gateway", 503: "Service Unavailable", 504: "Gateway Timeout"}


def page(title, text):
    return (f"<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' "
            f"content='width=device-width,initial-scale=1'><title>{title}</title><style>body{{margin:0;"
            f"background:#0d0f12;color:#e6e9ef;font:15px/1.5 system-ui,sans-serif}}main{{max-width:560px;"
            f"margin:12vh auto;padding:0 20px}}a{{color:#5aa9ff}}</style></head><body><main><h2>{title}</h2>"
            f"<p>{text}</p></main></body></html>")


async def respond(writer, code, body, keep=False, headers=()):
    data = body.encode()
    head = [f"HTTP/1.1 {code} {REASONS.get(code, 'Error')}", "Content-Type: text/html; charset=utf-8",
            f"Content-Length: {len(data)}", "Cache-Control: no-store", "X-Frame-Options: DENY",
            "Referrer-Policy: same-origin", f"Connection: {'keep-alive' if keep else 'close'}"]
    head += [f"{k}: {v}" for k, v in headers]
    writer.write(("\r\n".join(head) + "\r\n\r\n").encode("latin-1") + data)
    await writer.drain()


# ---------- the proxy ----------

def reserved(path):
    """Paths the gate owns (served by sharedbox-web); everything else belongs to the friend's T3."""
    if path == "/_box" or path.startswith("/_box/"):
        return "box"
    for prefix in ("/i/", "/login/"):
        if path.startswith(prefix) and sb.TOKEN_RE.fullmatch(path[len(prefix):]):
            return "token"
    return None


def host_ok(headers, from_loopback):
    host = values(headers, "host")
    if len(host) != 1:
        return False
    h = host[0].strip().lower()
    if h in (PUBLIC_HOST, PUBLIC_HOST.removesuffix(":443")):
        return True
    # a proxy in front (Tailscale) that rewrote Host to the upstream address but says where it came from
    fwd = values(headers, "x-forwarded-host")
    return from_loopback and len(fwd) == 1 and fwd[0].strip().lower() in (PUBLIC_HOST, PUBLIC_HOST + ":443")


def split_cookies(headers):
    """(our session secret or None, the remaining Cookie header value or "")."""
    secret, rest = None, []
    for v in values(headers, "cookie"):
        for part in v.split(";"):
            name, _, val = part.strip().partition("=")
            if name == COOKIE:
                secret = secret or val.strip()
            elif part.strip():
                rest.append(part.strip())
    return secret, "; ".join(rest)


async def handle_request(reader, writer, head, peer):
    """One request. Returns True if the client connection may be reused."""
    lines = head[:-4].split(b"\r\n")
    while lines and not lines[0]:
        lines.pop(0)
    if not lines:
        raise HTTPError(400, "empty request")
    m = REQUEST_LINE.fullmatch(lines[0].decode("latin-1"))
    if not m:
        raise HTTPError(400, "bad request line")
    method, target, version = m.groups()
    headers = parse_headers(lines[1:])
    conn = tokens(headers, "connection")
    keep = version == "HTTP/1.1" and "close" not in conn
    framing, length = body_framing(headers)
    from_loopback = peer in ("127.0.0.1", "::1")
    if not host_ok(headers, from_loopback):
        raise HTTPError(421, "unknown host")
    xff = values(headers, "x-forwarded-for")
    # Funnel's proxy (tailscaled, on loopback) reports the visitor; only trust that hop's value
    client_ip = (xff[-1].split(",")[-1].strip() if xff else peer) if from_loopback else peer
    if CF and from_loopback and len(values(headers, "cf-connecting-ip")) == 1:
        client_ip = values(headers, "cf-connecting-ip")[0].strip()  # cloudflared's report of the visitor
    client_ip = client_ip[:64] or "?"
    path = urllib.parse.unquote(target.split("?", 1)[0])
    if ".." in path.split("/") or "\\" in path:
        raise HTTPError(400, "bad path")
    upgrade = "upgrade" in conn and {"websocket"} == tokens(headers, "upgrade") and method == "GET"
    set_cookie = []
    if CF and has_cookie(headers, OPEN_COOKIE) and target.split("?", 1)[0] == "/":
        set_cookie.append(f"{OPEN_COOKIE}=; Path=/; Max-Age=0; Secure; HttpOnly; SameSite=Lax")
    cf_jwt = claims = None
    if CF:
        # the second lock: no valid Access token for this app, no entry (whatever the path, whoever asks)
        import sbaccess
        cf_jwt = sbaccess.token_from_headers(headers)
        claims = await cf_claims(cf_jwt)
        if not claims:
            await respond(writer, 403, page("Not allowed", "Open this box through its Cloudflare login page: "
                                            f"<a href='{PUBLIC}/'>{PUBLIC}/</a>."))
            return False
        user = cf_identity(claims["email"])
        secret, sess = None, ((user, None, None) if user else None)
        other_cookies = "; ".join(p.strip() for v in values(headers, "cookie") for p in v.split(";")
                                  if p.strip() and p.strip().partition("=")[0] not in (COOKIE, "CF_Authorization"))
    else:
        secret, other_cookies = split_cookies(headers)
        sess = session_for(secret)
    kind = reserved(target.split("?", 1)[0])
    app = None if kind else app_route(target)
    fwd_target, prefix, app_kind = target, None, None

    if kind == "token" and (rate_limited("tok:" + client_ip, 30) or rate_limited("tok:*", 600)):
        await respond(writer, 429, page("Slow down", "Too many tries. Wait a few minutes and try again."))
        return False
    if kind:
        dest = ("unix", WEB_SOCK)
    elif app:
        app_kind, key, prefix, rest = app
        if app_kind == "bad":
            await respond(writer, 404, page("No such server", "That link doesn't point at a server. "
                                            "See <a href='/_box/me'>your page</a> for your servers' links."))
            return False
        owner = (sess and sess[0] == OWNER) or bool(CF and claims["email"] in sb.owner_emails(CFG))
        user = sess[0] if sess else None
        port, err = app_port(app_kind, key, user, owner)
        if err:
            await respond(writer, err[0], page(err[1], err[2]))
            return False
        if rest is None:  # /s/NAME -> /s/NAME/ so the app's relative links resolve under the prefix
            q = target.partition("?")
            await respond(writer, 308, "", headers=[("Location", prefix + "/" + q[1] + q[2])])
            return False
        host = backend_host()
        dest = ("tcp", host or "127.0.0.1", port)
        fwd_target = rest
    elif sess and method == "GET" and not upgrade and target.split("?", 1)[0] == "/" and welcome_pending(sess[0]):
        await respond(writer, 303, "", headers=[("Location", "/_box/me?welcome=1")])
        return False
    elif (CF and sess and method == "GET" and not upgrade and target.split("?", 1)[0] == "/"
          and not has_cookie(headers, OPEN_COOKIE) and opened_from_outside(headers)):
        # treehouse is a dashboard first: a bookmark, typed URL or outside link lands there; "Open T3 Code" on it
        # (a same-site navigation) and everything inside T3 go to T3
        await respond(writer, 303, "", headers=[("Location", "/_box/me")])
        return False
    elif (CF and sess and method == "GET" and not upgrade
          and target.split("?", 1)[0] == "/" and not has_t3_session(headers)):
        # this browser isn't paired with their T3 yet: pair it for them (sharedbox-web /_box/open)
        await respond(writer, 303, "", headers=[("Location", "/_box/open")])
        return False
    elif sess:
        host, port = backend_for(sess[0])
        if not host:
            await respond(writer, 502, page("Not available", "The box can't reach your T3 Code right now. "
                                            "Try again in a minute; if it keeps happening, tell the owner."))
            return False
        dest = ("tcp", host, port)
        t3_seen(sess[0])
        if not CF and maybe_refresh(secret, sess):
            set_cookie.append(session_cookie(secret))
    elif method in ("GET", "HEAD") and not upgrade:
        dest = ("unix", WEB_SOCK)  # landing page
    else:
        await respond(writer, 401, page("Logged out", "Open <a href='/'>the start page</a>."))
        return False
    to_web = dest[0] == "unix"

    out = [(n, v) for n, v in headers
           if n.lower() not in STRIP and not n.lower().startswith(STRIP_PREFIXES)
           and not (CF and n.lower().startswith(("cf-access-", "cf-connecting-")))]
    out.insert(0, ("Host", PUBLIC_HOST))
    if to_web:
        out.append(("X-Sharedbox-Client-IP", client_ip))
        if CF:  # verified above; root re-verifies the token itself before acting on it
            out += [("X-Sharedbox-Cf-Email", claims["email"]), ("X-Sharedbox-Cf-Jwt", cf_jwt)]
        elif sess:
            out.append(("X-Sharedbox-Session", secret))
    elif prefix:
        if app_cookies(headers):
            out.append(("Cookie", app_cookies(headers)))  # not ours, not Cloudflare's, not T3 Code's
        out.append(("X-Forwarded-Prefix", prefix))
    elif other_cookies:
        out.append(("Cookie", other_cookies))  # T3's own cookies; never ours
    out += [("X-Forwarded-For", client_ip), ("X-Forwarded-Proto", "https"), ("X-Forwarded-Host", PUBLIC_HOST)]
    if framing == "chunked":
        out.append(("Transfer-Encoding", "chunked"))
    elif framing == "length":
        out.append(("Content-Length", str(length)))
    if upgrade and not to_web:
        out += [("Connection", "Upgrade"), ("Upgrade", "websocket")]
    else:
        out.append(("Connection", "close"))

    try:
        if to_web:
            br, bw = await asyncio.wait_for(asyncio.open_unix_connection(dest[1], limit=MAX_HEAD), CONNECT_TIMEOUT)
        else:
            try:
                br, bw = await asyncio.wait_for(asyncio.open_connection(dest[1], dest[2], limit=MAX_HEAD),
                                                CONNECT_TIMEOUT)
            except ConnectionRefusedError:
                if not prefix or dest[1] == "127.0.0.1":
                    raise
                # a server that listens on loopback only
                br, bw = await asyncio.wait_for(asyncio.open_connection("127.0.0.1", dest[2], limit=MAX_HEAD),
                                                CONNECT_TIMEOUT)
    except (OSError, asyncio.TimeoutError):
        if to_web:
            msg = "The box is busy. Try again in a minute."
        elif app_kind == "s":
            msg = (f"The group server <b>{prefix[3:]}</b> isn't running (or isn't listening on its port, "
                   f"{dest[2]}). Start or restart it under <b>Group servers</b> on <a href='/_box/me'>your page</a>, "
                   "or with <code>box shared start NAME</code>.")
        elif app_kind == "p":
            msg = (f"Nothing is listening on port {dest[2]}. Start the server under <b>Your servers</b> on "
                   "<a href='/_box/me'>your page</a>, or with <code>box serve start NAME</code>.")
        else:
            if CF and method == "GET" and not upgrade and opened_as_page(headers):
                # T3 is stopped (idle, crashed, after a reboot): /_box/open starts it and pairs this browser again
                await respond(writer, 303, "", headers=[("Location", "/_box/open")])
                return False
            msg = ("Your T3 Code isn't running right now. Open <a href='/_box/open'>this link</a> to start it, "
                   "or use <a href='/_box/me'>your page</a>.")
        await respond(writer, 502, page("Not running", msg))
        return False
    try:
        bw.write((f"{method} {fwd_target} HTTP/1.1\r\n" + "".join(f"{n}: {v}\r\n" for n, v in out) + "\r\n")
                 .encode("latin-1"))
        if "100-continue" in tokens(headers, "expect") and framing != "none":
            writer.write(b"HTTP/1.1 100 Continue\r\n\r\n")  # we answer it; the backend gets the body directly
            await writer.drain()
        try:
            if framing == "chunked":
                await copy_chunked(reader, bw)
            elif framing == "length":
                await copy_exact(reader, bw, length)
            await bw.drain()
        except ConnectionError:
            # the backend hung up mid-request; it may still have answered (read below, else 502).
            # Part of the client's body may be unread, so this connection can't be reused.
            keep = False

        while True:
            try:
                rhead = await asyncio.wait_for(br.readuntil(b"\r\n\r\n"), RESPONSE_TIMEOUT)
            except (asyncio.IncompleteReadError, asyncio.LimitOverrunError, ConnectionError):
                await respond(writer, 502, page("Couldn't load this", "The app hung up before answering. Try reloading."))
                return False
            rlines = rhead[:-4].split(b"\r\n")
            sm = STATUS_LINE.fullmatch(rlines[0])
            if not sm:
                await respond(writer, 502, page("Couldn't load this", "The app answered in a way the box couldn't understand. Try reloading; "
                                                      "if it keeps happening, tell the owner."))
                return False
            code = int(sm.group(1))
            if 100 <= code < 200 and code != 101:
                continue  # informational: drop
            break
        rheaders = parse_headers(rlines[1:])
        if prefix:
            rheaders = app_resp_headers(rheaders, prefix, dest[2])

        if code == 101:
            if not (upgrade and not to_web):
                await respond(writer, 502, page("Couldn't load this", "The app tried to open a live connection the box doesn't allow "
                                                      "here. Try reloading; if it keeps happening, tell the owner."))
                return False
            resp = ["HTTP/1.1 101 Switching Protocols"]
            resp += [f"{n}: {v}" for n, v in rheaders
                     if n.lower() not in HOP and not n.lower().startswith("x-sharedbox-")
                     and not (n.lower() == "set-cookie" and v.strip().startswith(COOKIE + "="))]
            resp += ["Connection: Upgrade", "Upgrade: websocket"]
            writer.write(("\r\n".join(resp) + "\r\n\r\n").encode("latin-1"))
            await writer.drain()
            if CF:
                exp, email, user = float(claims["exp"]), claims["email"], sess[0] if sess else None

                def still_ok():
                    return (time.time() < exp + 60 and cf_identity(email) == user
                            and (not prefix or app_port(app_kind, key, user, owner)[0] == dest[2]))
            else:
                def still_ok():
                    s = session_for(secret)
                    return s and (not prefix or app_port(app_kind, key, s[0], False)[0] == dest[2])
            await tunnel(reader, writer, br, bw, still_ok)
            return False

        no_body = method == "HEAD" or code in (204, 304)
        rframing, rlength = ("none", 0) if no_body else body_framing(rheaders, response=True)
        decode = False
        if rframing == "close" or (rframing == "chunked" and version == "HTTP/1.0"):
            keep, decode = False, rframing == "chunked"
        resp = [rlines[0].decode("latin-1").replace("HTTP/1.0", "HTTP/1.1", 1)]
        for n, v in rheaders:
            ln = n.lower()
            if ln in HOP or ln.startswith("x-sharedbox-"):
                continue
            if ln == "set-cookie" and v.strip().startswith(COOKIE + "="):
                continue  # only the gate sets its own cookie
            resp.append(f"{n}: {v}")
        if to_web and not CF:  # sharedbox-web's private instructions (root minted the session)
            new = values(rheaders, "x-sharedbox-set-session")
            if new and sb.TOKEN_RE.fullmatch(new[0]):
                set_cookie.append(session_cookie(new[0]))
            if values(rheaders, "x-sharedbox-clear-session"):
                set_cookie.append(session_cookie("", 0))
        resp += [f"Set-Cookie: {c}" for c in set_cookie]
        if rframing == "chunked" and not decode:
            resp.append("Transfer-Encoding: chunked")
        elif rframing == "length":
            resp.append(f"Content-Length: {rlength}")
        elif no_body:
            resp += [f"Content-Length: {v}" for v in values(rheaders, "content-length")[:1]]
        resp.append(f"Connection: {'keep-alive' if keep else 'close'}")
        writer.write(("\r\n".join(resp) + "\r\n\r\n").encode("latin-1"))
        if rframing == "chunked":
            await copy_chunked(br, writer, decode=decode)
        elif rframing == "length":
            await copy_exact(br, writer, rlength)
        elif rframing == "close":
            await copy_to_eof(br, writer)
        await writer.drain()
        return keep
    finally:
        bw.close()


async def tunnel(cr, cw, br, bw, still_ok):
    """WebSocket (or any upgraded protocol): bytes both ways until either side closes. Dropped if the
    session is revoked (cloudflare mode: the Access token expires) or the account suspended meanwhile."""
    async def pipe(r, w):
        while True:
            data = await r.read(65536)
            if not data:
                return
            w.write(data)
            await w.drain()

    async def watchdog():
        while True:
            await asyncio.sleep(WS_RECHECK)
            if not still_ok():
                return

    tasks = [asyncio.ensure_future(pipe(cr, bw)), asyncio.ensure_future(pipe(br, cw)),
             asyncio.ensure_future(watchdog())]
    try:
        await asyncio.wait(tasks, return_when=asyncio.FIRST_COMPLETED)
    finally:
        for t in tasks:
            t.cancel()
        await asyncio.gather(*tasks, return_exceptions=True)


_conns = 0


async def client(reader, writer):
    global _conns
    peer = (writer.get_extra_info("peername") or ("?",))[0]
    if peer.startswith("::ffff:"):
        peer = peer[7:]
    _conns += 1
    try:
        if _conns > MAX_CONNS:
            await respond(writer, 503, page("Busy", "Too many connections. Try again shortly."))
            return
        timeout = HEAD_TIMEOUT
        while True:
            head = await read_head(reader, timeout)
            if head is None:
                return
            if not await handle_request(reader, writer, head, peer):
                return
            timeout = IDLE_TIMEOUT
    except HTTPError as e:
        try:
            await respond(writer, e.code, page(REASONS.get(e.code, "Error"), e.msg))
        except (ConnectionError, RuntimeError):
            pass
    except (ConnectionError, asyncio.IncompleteReadError, asyncio.LimitOverrunError, asyncio.TimeoutError):
        pass
    finally:
        _conns -= 1
        try:
            writer.close()
        except RuntimeError:
            pass


async def main():
    if not PUBLIC:  # off: exit cleanly (Restart=on-failure won't loop)
        print("sharedbox-gate: PUBLIC_URL is not set (or not https://...) in " + sb.CONF_PATH
              + "; nothing to do", file=sys.stderr)
        return
    global VERIFIER
    if CF:  # fail closed: without the Access settings nothing could be verified, so don't listen at all
        import sbaccess
        try:
            VERIFIER = sbaccess.Verifier(CFG.get("CF_TEAM_DOMAIN"), CFG.get("CF_ACCESS_AUD"),
                                         cache_file=sb.CF_CERTS_CACHE)
        except ValueError as e:
            sys.exit(f"sharedbox-gate: PUBLIC_MODE=cloudflare but {e}. Run: sudo sharedbox-admin cloudflare setup")
        if not await asyncio.to_thread(VERIFIER.keys.refresh) and not VERIFIER.keys.count():
            print(f"sharedbox-gate: can't fetch Cloudflare's signing keys yet ({VERIFIER.keys.last_error}); "
                  "retrying on the first request", file=sys.stderr, flush=True)
    port = int(os.environ.get("SHAREDBOX_GATE_PORT") or sb.cfg_int(CFG, "GATE_PORT"))
    srv = await asyncio.start_server(client, "127.0.0.1", port, limit=MAX_HEAD, backlog=512)
    print(f"sharedbox-gate on http://127.0.0.1:{port} for {PUBLIC}"
          + (f" (Cloudflare Access: {CFG['CF_TEAM_DOMAIN']}, {VERIFIER.keys.count()} signing keys)" if CF else ""),
          flush=True)
    async with srv:
        await srv.serve_forever()


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        pass
